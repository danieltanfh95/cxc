# https://rosettacode.org/wiki/Factorial

# OOP has no synchronous recursion, so factorial is a tail-call loop: thread
# the accumulator through self-send until n reaches 1.

def main:
    use console: Console
    -> running
        self :> step(10, 1)

    running <: step(n: Int, acc: Int):
        |:  n <= 1 -> end
            console.write(acc.to_string())
        |?: -> running
            self :> step(n - 1, acc * n)
