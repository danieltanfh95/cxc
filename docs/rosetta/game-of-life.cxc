# https://rosettacode.org/wiki/Conway%27s_Game_of_Life

def Cell:
    x: Int!
    y: Int!

def Grid:
    alive_cells: Set of Cell = [Cell(x: 1, y: 2),
                                Cell(x: 2, y: 2),
                                Cell(x: 3, y: 2)]
    offsets: List of Cell = [Cell(x: -1, y: -1),
                             Cell(x:  0, y: -1),
                             Cell(x:  1, y: -1),
                             Cell(x: -1, y:  0),
                             Cell(x:  1, y:  0),
                             Cell(x: -1, y:  1),
                             Cell(x:  0, y:  1),
                             Cell(x:  1, y:  1)]
    next_alive: Set of Cell = []
    width:      Int!        = 5
    height:     Int!        = 5

    alive(x: Int!, y: Int!) :- Bool!
        self.alive_cells.contains(Cell(x: x, y: y))

    neighbors(x: Int!, y: Int!) :- Int!
        self.offsets.map(o => self.alive(x: x + o.x, y: y + o.y).to_int()).sum()

    next_cell(x: Int!, y: Int!) :- Bool!
        alias a :- self.alive(x: x, y: y)
        alias n :- self.neighbors(x: x, y: y)
        n == 3 or (a and n == 2)

    row_at(y: Int!) :- String!
        alias w :- range(self.width)
        w.map(x => ||: self.alive(x: x, y: y) : "#" |?: ".").join(sep: "")

    -> running

    running <: start_frame -> running
        then:
            next_alive => self.next_alive.empty()

    running <: step_cell(x: Int!, y: Int!):
        |: self.next_cell(x: x, y: y) -> running
            then:
                next_alive => self.next_alive.insert(Cell(x: x, y: y))
        |: else -> running

    running <: commit -> running
        then:
            alive_cells => self.next_alive

    running <: render -> running
        then:
            range(self.height).for_each(y => print(self.row_at(y: y)))
            print("")

def main:
    g: Grid = Grid()

    -> running
        then:
            |> g.render()
            self :> tick(gen: 0, cursor: 0)

    running <: tick(gen: Int!, cursor: Int!):
        |: gen >= 2 -> end
        |: cursor == 0 -> running
            then:
                |> g.start_frame()
                |> g.step_cell(x: 0, y: 0)
                self :> tick(gen: gen, cursor: 1)
        |: cursor >= g.width * g.height -> running
            then:
                |> g.commit()
                |> g.render()
                self :> tick(gen: gen + 1, cursor: 0)
        |: else -> running
            then:
                |> g.step_cell(x: cursor % g.width,
                               y: cursor / g.width)
                self :> tick(gen: gen, cursor: cursor + 1)
