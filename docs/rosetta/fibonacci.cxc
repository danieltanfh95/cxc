# https://rosettacode.org/wiki/Fibonacci_sequence

def main:
    a: Int! = 0
    b: Int! = 1
    i: Int! = 0

    -> running
        then: self :> tick

    running <: tick -> end
        |: i >= 20

    running <: tick -> running
        then:
            print(a)
            a => b
            b => a + b
            i => i + 1
            self :> tick
