# https://rosettacode.org/wiki/Fibonacci_sequence

def main:
    a: Int! = 0
    b: Int! = 1
    i: Int! = 0

    -> running
        then: self :> tick

    running <: tick:
        |: i >= 20 -> end
        |: else    -> running
            then:
                print(a)
                a => b
                b => a + b
                i => i + 1
                self :> tick
