# https://rosettacode.org/wiki/Fibonacci_sequence

def main:
    use console: Console
    -> running
        self :> tick(0, 1, 0)

    running <: tick(a: Int, b: Int, i: Int):
        |:  i >= 20 -> end
        |?: -> running
            console.write(a.to_string())
            self :> tick(b, a + b, i + 1)
