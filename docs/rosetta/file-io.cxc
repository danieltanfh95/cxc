# https://rosettacode.org/wiki/File_input/output

# Fallible cap calls raise typed records. `or IOError(reason: let m):`
# recovers at the call site with the caller's own fallback. The recovery
# value is a proper expression; no exception tree, no Result wrapping.

def main:
    use fs: FileSystem
    use console: Console

    -> running
        let content: String! = fs.read_text("input.txt") or IOError(reason: let m):
            console.write("read failed: " + m)
            ""
        let _n: Int = fs.write_text("output.txt", content) or IOError(reason: let m):
            console.write("write failed: " + m)
            0
        console.write("copied " + content.length().to_string() + " chars")
