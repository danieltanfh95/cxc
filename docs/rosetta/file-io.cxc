# https://rosettacode.org/wiki/File_input/output
#
# Aspirational, pending hickey-cycle-313 fs.open-file-atom landing.
# This file does NOT compile under current cxc. Today's blocking surface
# at compiler/resources/prelude/target/shared/fs.cxc exposes read_text /
# write_text with `or IOError` recovery; this sample is on the ratified
# File-atom shape that replaces them. Plan:
# docs/decisions/hickey-cycle-313-fs-open-file-atom-plan.md

def main:
    use fs: FileSystem
    use console: Console
    src: File = fs.open_read("input.txt")
    dst: File = fs.open_write("output.txt")

    -> piping

    piping <: src.chunk(data: Bytes!) -> piping
        dst :> write(data)

    piping <: src.read_done -> finishing
        dst :> close

    finishing <: dst.closed -> end
        console.write("copied " + dst.bytes_written.to_string() + " bytes")

    * <: src.failed(err: IOError) -> end
        console.write("read failed: " + err.reason)
    * <: dst.failed(err: IOError) -> end
        console.write("write failed: " + err.reason)
