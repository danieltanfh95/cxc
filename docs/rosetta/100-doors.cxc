# https://rosettacode.org/wiki/100_doors

# Ticker emits one (pass, door) event per pass-door pair. main subscribes
# with an invariant guard `|: door % pass == 0`; messages that fail the
# guard are dropped before they reach the toggle body. No conditional
# inside the handler; no scheduler either — the invariant IS the filter.

def Ticker(passes: Int!):
    -> running
        self :> step(1, 1)

    running <: step(pass: Int, door: Int):
        |:  pass > self.passes -> end
            :> done
        |:  door > 100 -> running
            self :> step(pass + 1, 1)
        |?: -> running
            :> toggle(pass: pass, door: door)
            self :> step(pass, door + 1)

def main:
    use console: Console
    ticker:     Ticker      = Ticker(100)
    open_doors: List of Int = []

    -> running

    running <: ticker.toggle(pass: Int, door: Int):
        |:  door % pass == 0 -> running
            open_doors => ||: self.open_doors.contains(door) : self.open_doors.filter(d => d != door) |?: self.open_doors.append(door)
        |?: -> running

    running <: ticker.done -> printing
        self :> show(1)

    printing <: show(d: Int):
        |:  d > 100 -> end
        |:  self.open_doors.contains(d) -> printing
            console.write("door " + d.to_string() + " open")
            self :> show(d + 1)
        |?: -> printing
            self :> show(d + 1)
