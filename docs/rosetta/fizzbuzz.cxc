# https://rosettacode.org/wiki/FizzBuzz

def main:
    word_for(n: Int!) :- String!
        fizz     :- ||: n % 3 == 0 : "Fizz" |?: ""
        buzz     :- ||: n % 5 == 0 : "Buzz" |?: ""
        combined :- fizz + buzz
        combined.not_empty() ?? n.to_string()

    -> running
        self :> tick(1)

    running <: tick(n: Int!):
        |:  n > 100 -> end
        |?: running
            print(self.word_for(n))
            self :> tick(n + 1)
