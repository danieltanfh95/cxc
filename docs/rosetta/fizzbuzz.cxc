# https://rosettacode.org/wiki/FizzBuzz

def main:
    n: Int! = 1

    word_for :- String!
        fizz     :- ||: n % 3 == 0 : "Fizz" ||: else : ""
        buzz     :- ||: n % 5 == 0 : "Buzz" ||: else : ""
        combined :- fizz + buzz
        ||: combined != "" : combined ||: else : n.to_string()

    -> running
        then: self :> tick

    running <: tick -> end
        |: n > 100

    running <: tick -> running
        then:
            print(self.word_for)
            n => n + 1
            self :> tick
