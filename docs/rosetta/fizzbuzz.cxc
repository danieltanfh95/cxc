# https://rosettacode.org/wiki/FizzBuzz

def main:
    n: Int! = 1

    word_for :- String!
        ||: n % 15 == 0 : "FizzBuzz"
        ||: n % 3  == 0 : "Fizz"
        ||: n % 5  == 0 : "Buzz"
        ||: else        : n.to_string()

    -> running
        then: self :> tick

    running <: tick -> end
        |: n > 100

    running <: tick -> running
        then:
            print(self.word_for)
            n => n + 1
            self :> tick
