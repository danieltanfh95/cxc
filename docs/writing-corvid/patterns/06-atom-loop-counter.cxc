def Counter(limit: Int!):
    use console: Console
    n: Int = 0
    -> counting
        self :> tick

    counting <: tick -> counting
        |: n < limit
        console.write(n.to_string())
        n => n + 1
        self :> tick

    counting <: tick -> end
        |: n == limit
        console.write("done")
        :> finished

def main:
    counter: Counter = Counter(limit: 3)
    -> running

    running <: counter.finished -> end
