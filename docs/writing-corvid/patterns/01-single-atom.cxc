def Counter:
    n: Int! = 0

    idle <: bump -> idle
        n => n + 1
        print("bump: n=" + (n + 1).to_string())

    idle <: reset -> idle
        n => 0
        print("reset: n=0")

    idle <: report -> idle
        print("report: n=" + n.to_string())

def main:
    c: Counter! = Counter()

    -> running
        |> c.bump()
        |> c.bump()
        |> c.reset()
        |> c.bump()
        |> c.report()
