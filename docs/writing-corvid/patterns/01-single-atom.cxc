def Counter:
    use console: Console
    n: Int! = 0

    idle <: bump -> idle
        n => n + 1
        console.write("bump: n=" + (n + 1).to_string())

    idle <: reset -> idle
        n => 0
        console.write("reset: n=0")

    idle <: report -> idle
        console.write("report: n=" + n.to_string())

def main:
    c: Counter! = Counter()

    -> running
        |> c.bump()
        |> c.bump()
        |> c.reset()
        |> c.bump()
        |> c.report()
