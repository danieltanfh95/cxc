def Sink:
    use console: Console
    seen: Int! = 0

    idle <: put(v: Int) -> idle
        seen => seen + 1
        console.write("sink got: " + v.to_string())

def Doubler(target: Sink!):
    idle <: work(x: Int) -> idle
        |> target.put(v: x * 2)

def main:
    s: Sink! = Sink()
    d: Doubler! = Doubler(target: s)

    -> running
        |> d.work(x: 3)
        |> d.work(x: 7)
