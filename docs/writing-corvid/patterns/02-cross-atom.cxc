def Sink:
    seen: Int! = 0

    idle <: put(v: Int) -> idle
        then:
            seen => seen + 1
            print("sink got: " + v.to_string())

def Doubler(target: Sink!):
    idle <: work(x: Int) -> idle
        then:
            |> target.put(v: x * 2)

def main:
    s: Sink! = Sink()
    d: Doubler! = Doubler(target: s)

    -> running
        then:
            |> d.work(x: 3)
            |> d.work(x: 7)
