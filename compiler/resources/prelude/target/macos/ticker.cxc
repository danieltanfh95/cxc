def Ticker(rate_ms: Int, count: Int = 3):
    data:
        remaining: Int = count

    -> running
        do: native_schedule_periodic_beat(self, rate_ms)

    -> end
        do: :> done

    running <: beat -> running
        when: remaining > 0
        then: remaining => remaining - 1
        do: :> tick

    running <: beat -> end
        when: remaining == 0
