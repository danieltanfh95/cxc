def Args:
    length :- native_args_length()

    get_or(index: Int, fallback: String) :- native_args_get_or(index, fallback)

    all_after(index: Int) :- native_args_all_after(index)

    get_or_int(index: Int, fallback: Int) :- native_args_get_or(index, "").to_int_or(fallback)

    get_or_bool(index: Int, fallback: Bool) :- native_args_get_or(index, "").to_bool_or(fallback)

    -> running

    -> end
