def Http:
    # D1(ii) 2026-09-09 (hickey pass phase C 2026-09-14): `get` / `post`
    # return a typed `HttpResponse` record with `.status` / `.body`
    # fields — the JSON envelope from `native_http_*_envelope` is parsed
    # inside the capability so consumers never see it. `status == -1`
    # signals transport-layer failure before any HTTP response arrived
    # (DNS, TCP, TLS); `body` is empty in that case. Non-2xx statuses
    # populate `body` normally so callers can inspect error payloads
    # without an `or` arm.
    #
    # `head_status` keeps returning Int; -1 is a valid domain probe
    # (http-head-status test deliberately calls it with a bad URL and
    # asserts on -1). `download_to_file` keeps returning Int (rc-
    # sentinel probing pattern, same policy as fs.write_text).

    get(url: String, headers_json: String) :- HttpResponse
        let raw: String = native_http_get_envelope(url, headers_json)
        HttpResponse(status: native_json_field_int_or(raw, "status", -1),
                     body:   native_json_field_string_or(raw, "body", ""))

    post(url: String, headers_json: String, body: String) :- HttpResponse
        let raw: String = native_http_post_envelope(url, headers_json, body)
        HttpResponse(status: native_json_field_int_or(raw, "status", -1),
                     body:   native_json_field_string_or(raw, "body", ""))

    head_status(url: String) :- native_http_head_status(url)

    download_to_file(url: String, dest_path: String) :- native_http_download_to_file(url, dest_path)

    -> running

    -> end
