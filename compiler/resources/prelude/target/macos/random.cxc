def Random:
    next_u32 :- native_random_u32()

    below(n: Int) :- native_random_below(n)

    # `between(low, high)` returns a value in [low, high). Raises
    # RandomError when `high <= low` — `native_random_below` on a
    # non-positive argument is undefined at the OS boundary, so the
    # cap surfaces the misuse instead of passing it through.
    between(low: Int, high: Int) :- Int
        ||: high <= low : raise RandomError(reason: "Random.between: high must be > low")
        ||: else        : low + native_random_below(high - low)

    hex(nybbles: Int) :- native_random_hex(nybbles)

    uuid() :- native_random_uuid()

    -> running

    -> end
