def Clock(ticks: Int = 3):
    data:
        remaining: Int = ticks

    now :< native_millis_now()

    methods:
        function every(self, rate_ms: Int) -> Stream of Instant:
            return native_clock_every(self, rate_ms)

    -> running
        do: self :> beat

    -> end
        do: :> done

    running <: beat -> running
        when: remaining > 0
        then: remaining => remaining - 1
        do:
            :> tick
            self :> beat

    running <: beat -> end
        when: remaining == 0
