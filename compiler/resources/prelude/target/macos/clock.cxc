def Clock(ticks: Int! = 3):
    remaining: Int! = ticks

    now :< native_millis_now()

    every(rate_ms: Int) :< native_clock_every(self, rate_ms)

    -> running
        then: self :> beat

    -> end
        then: :> done

    running <: beat -> running
        when: remaining > 0
        then: remaining => remaining - 1
        then:
            :> tick
            self :> beat

    running <: beat -> end
        when: remaining == 0
