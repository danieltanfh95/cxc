def Json:
    encode_str(s: String) :- native_json_encode_str(s)

    field_string(json: String, key: String) :- native_json_field_string(json, key)

    field_int_or(json: String, key: String, fallback: Int) :- native_json_field_int_or(json, key, fallback)

    field_string_path(json: String, path: String) :- native_json_field_string_path(json, path)

    field_int_or_path(json: String, path: String, fallback: Int) :- native_json_field_int_or_path(json, path, fallback)

    -> running

    -> end
