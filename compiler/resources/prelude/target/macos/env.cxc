def Env:
    use plugin: Plugin

    get_or(name: String, fallback: String) :- plugin.get("getenv")(name).to_string() ?? fallback

    set(name: String, value: String) :- plugin.get("setenv")(name, value, 1)

    remove(name: String) :- plugin.get("unsetenv")(name)

    has(name: String) :- plugin.get("getenv")(name).to_string() != nil

    get_or_int(name: String, fallback: Int) :- (plugin.get("getenv")(name).to_string() ?? "").to_int_or(fallback)

    get_or_bool(name: String, fallback: Bool) :- (plugin.get("getenv")(name).to_string() ?? "").to_bool_or(fallback)

    -> running

    -> end
