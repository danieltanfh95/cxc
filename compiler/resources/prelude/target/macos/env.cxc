# Env split (D1(i) 2026-09-08). Two capability atoms in one file:
# `EnvVars` (read-only, total) and `EnvMut` (mutation). Read consumers
# `use env_vars: EnvVars`; only mutation-capable atoms `use env_mut:
# EnvMut`. Both share the prelude plugin FFI block (`std.prelude` in
# console.cxc) — no extra plugin marker here per prelude-plugin-
# consolidation discipline.
#
# EnvMut methods currently return the raw libc int (0 success / -1
# failure); the typed-raise wrapping to `EnvError(reason, name)` per
# D1(ii) is deferred until the parser lands statement-position bare
# `if <cond>: <block>` (only `if let <ident> = <expr>: <block>` is
# landed today, F39 L7). The spec surface (§1.13 EnvMut) already
# declares `raise EnvError(...)` — this file's implementation is the
# transitional shape. See D1(ii) landing sheet + [[corvid-cap-typed-errors]].

def EnvVars:
    use plugin: Plugin

    get_or(name: String, fallback: String) :- plugin.get("getenv")(name).to_string() ?? fallback

    get_or_int(name: String, fallback: Int) :- (plugin.get("getenv")(name).to_string() ?? "").to_int_or(fallback)

    get_or_bool(name: String, fallback: Bool) :- (plugin.get("getenv")(name).to_string() ?? "").to_bool_or(fallback)

    has(name: String) :- plugin.get("getenv")(name).to_string() != nil

    -> running

    -> end

def EnvMut:
    use plugin: Plugin

    set(name: String, value: String) :- plugin.get("setenv")(name, value, 1)

    remove(name: String) :- plugin.get("unsetenv")(name)

    -> running

    -> end
