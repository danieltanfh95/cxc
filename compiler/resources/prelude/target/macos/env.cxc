def Env:
    get_or(name: String, fallback: String) :- native_env_get_or_default(name, fallback)

    set(name: String, value: String) :- native_env_set(name, value)

    remove(name: String) :- native_env_remove(name)

    has(name: String) :- native_env_has(name)

    get_or_int(name: String, fallback: Int) :- native_env_get_or_default(name, "").to_int_or(fallback)

    get_or_bool(name: String, fallback: Bool) :- native_env_get_or_default(name, "").to_bool_or(fallback)

    -> running

    -> end
