def Reflection:
    # §4.18.3 — class metadata queries backed by compile-time tables
    # baked into the binary. Slice 1 ships names + fields; slice 2
    # adds method-name enumeration. Invariants, protocol conformance,
    # and reflective invoke land in later slices.
    #
    # Returns a newline-joined String of every user-authored class
    # name in the program. `_Cxc_*` synthesized containers and the
    # compiler-internal `Cxc*` support classes are elided.
    class_names :- native_class_names()

    # Returns a newline-joined String of data-field names on `cls_name`,
    # or an empty String when the class is unknown. Observations /
    # methods are surfaced via method_names_of.
    field_names_of(cls_name: String!) :- native_class_field_names(cls_name)

    # Returns a newline-joined String of method / observation selector-
    # head names declared on `cls_name`. Multi-arm dispatchers appear
    # once. Internal `cxc_*` selectors are elided. Empty string when
    # the class is unknown or carries no user-declared methods.
    method_names_of(cls_name: String!) :- native_class_method_names(cls_name)

    -> running

    -> end
