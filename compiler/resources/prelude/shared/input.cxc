def Key:
    case arrow_up
    case arrow_down
    case arrow_left
    case arrow_right
    case space
    case escape
    case f

def TestKeyboardInput(events: Int = 0):
    remaining: Int = events

    -> running
        do: self :> beat

    -> end
        do: :> done

    running <: beat -> running
        when: remaining > 0
        then: remaining => remaining - 1
        do:
            :> pressed(key: remaining)
            self :> beat

    running <: beat -> end
        when: remaining == 0
