#!/usr/bin/env bash
# trace-view — open a JSONL trace in the browser-based viewer.
#
# Usage:
#   ./trace-view <trace.jsonl>          # opens viewer + auto-loads trace
#   ./trace-view                        # opens empty viewer (drag-drop mode)
#
# Serves the current directory over HTTP so file:// CORS restrictions don't
# block the auto-load ?trace=<path> query. Port defaults to 8765; override
# with CXC_TRACE_VIEW_PORT.

set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PORT="${CXC_TRACE_VIEW_PORT:-8765}"

VIEWER_URL="http://localhost:$PORT/trace-viewer.html"
TRACE_ARG=""

if [ $# -ge 1 ]; then
  TRACE_ABS="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
  cp "$TRACE_ABS" "$HERE/.current-trace.jsonl"
  TRACE_ARG="?trace=.current-trace.jsonl"
fi

python3 -m http.server "$PORT" --directory "$HERE" >/tmp/trace-view.log 2>&1 &
SERVER_PID=$!
trap 'kill $SERVER_PID 2>/dev/null || true' EXIT INT TERM

sleep 0.5
echo "trace-view running at $VIEWER_URL$TRACE_ARG (pid $SERVER_PID)"
if command -v open >/dev/null 2>&1; then
  open "$VIEWER_URL$TRACE_ARG"
elif command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$VIEWER_URL$TRACE_ARG"
fi
echo "Ctrl-C to stop."
wait $SERVER_PID
