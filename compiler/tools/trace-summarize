#!/usr/bin/env python3
"""trace-summarize — print diagnostics for a --trace JSONL dump.

Mirrors the trace-viewer HTML side panel: overview, unclosed sends,
silent drops, per-atom inbox counts, and topology top-N. Fast path
when you don't want to open a browser.

Usage:
  trace-summarize <file.jsonl> [--top=N] [--silent-clock]
    --top=N        show top N topology edges (default 15)
    --silent-clock keep Clock.* messages in silent-drop list
                   (default: hide, they're periodic background noise)
"""
from __future__ import annotations
import json, os, sys
from collections import defaultdict, Counter


def load(path: str):
    events = []
    with open(path) as f:
        for i, line in enumerate(f, 1):
            line = line.strip()
            if not line:
                continue
            try:
                events.append(json.loads(line))
            except json.JSONDecodeError:
                print(f"warn: bad JSON at line {i}", file=sys.stderr)
    events.sort(key=lambda e: e["seq"])
    # Infer sender from most-recently-fired arm (single-queue mode).
    last_arm_atom = None
    last_arm_cls = None
    for e in events:
        if e.get("kind") == "arm":
            last_arm_atom = e.get("target")
            last_arm_cls = e.get("target_cls")
        elif e.get("kind") in ("send", "send_sync"):
            if not e.get("sender"):
                e["_sender_inferred"] = last_arm_atom
                e["_sender_cls_inferred"] = last_arm_cls
    return events


def analyze(events):
    pending = defaultdict(list)
    pairs = []
    unclosed = []
    silent_drops = []
    WINDOW = 6
    for i, e in enumerate(events):
        key = (e.get("target"), e.get("msg"))
        kind = e.get("kind")
        if kind in ("send", "send_sync"):
            pending[key].append(e)
        elif kind in ("recv", "recv_sync"):
            q = pending.get(key)
            if q:
                pairs.append((q.pop(0), e))
            msg = e.get("msg", "")
            if msg.startswith("self.cxc_emit_"):
                continue
            recv_base = msg.split(".")[-1]
            hit = False
            for j in range(i + 1, min(len(events), i + 1 + WINDOW)):
                n = events[j]
                if n.get("kind") != "arm":
                    continue
                if n.get("target") != e.get("target"):
                    continue
                arm_msg = n.get("msg", "")
                arm_base = arm_msg.split("With")[0].split(".")[0].split(":")[0]
                if arm_base == recv_base or arm_msg.startswith(recv_base):
                    hit = True
                    break
            if not hit:
                silent_drops.append(e)
    for q in pending.values():
        unclosed.extend(q)
    return pairs, unclosed, silent_drops


def topology(events):
    """(src_cls, dst_cls, msg) → count."""
    edges = Counter()
    for e in events:
        if e.get("kind") not in ("send", "send_sync"):
            continue
        src = e.get("_sender_cls_inferred") or "(root)"
        dst = e.get("target_cls") or "?"
        msg = (e.get("msg") or "?").split(".")[-1]
        edges[(src, dst, msg)] += 1
    return edges


def hbar(n, mx, width=20):
    if mx <= 0:
        return ""
    filled = int(round(width * n / mx))
    return "█" * filled + "·" * (width - filled)


def fmt_int(n): return f"{n:,}"


def print_report(events, opts):
    if not events:
        print("empty trace.")
        return
    dur = events[-1]["t"] - events[0]["t"] if len(events) > 1 else 0
    atoms = {e["target"] for e in events}
    classes = {e["target_cls"] for e in events}

    print(f"\033[1m═══ overview ═══\033[0m")
    print(f"  events    {fmt_int(len(events))}")
    print(f"  atoms     {len(atoms)}")
    print(f"  classes   {len(classes)}")
    print(f"  duration  {dur:.2f} ms")

    kinds = Counter(e["kind"] for e in events)
    mx = max(kinds.values())
    print(f"\n\033[1m─── by kind ───\033[0m")
    for k in sorted(kinds):
        print(f"  {k:<14} {fmt_int(kinds[k]):>7}  {hbar(kinds[k], mx)}")

    pairs, unclosed, silent = analyze(events)

    print(f"\n\033[1m─── diagnostics ───\033[0m")
    if not unclosed and not silent:
        print(f"  \033[32m✓ all sends closed, no silent drops\033[0m")
    if unclosed:
        print(f"  \033[31m⚠ unclosed sends: {len(unclosed)}\033[0m")
        for s in unclosed[:10]:
            print(f"    seq {s['seq']}: {s.get('msg')} → {s.get('target_cls')}[{s.get('target')}]")
        if len(unclosed) > 10:
            print(f"    …{len(unclosed) - 10} more")
    if silent:
        shown = [s for s in silent if opts["silent_clock"] or "Clock" not in (s.get("msg", "") + s.get("target_cls", ""))]
        clock_hidden = len(silent) - len(shown)
        label = f"silent drops: {len(silent)}"
        if clock_hidden:
            label += f" ({clock_hidden} Clock.* hidden)"
        print(f"  \033[31m⚠ {label}\033[0m")
        print(f"    (recv with no arm — phase mismatch, missing case)")
        for s in shown[:10]:
            print(f"    seq {s['seq']}: {s.get('msg')} → {s.get('target_cls')}[{s.get('target')}]")
        if len(shown) > 10:
            print(f"    …{len(shown) - 10} more")

    # Per-atom inbox
    print(f"\n\033[1m─── per-atom inbox ───\033[0m")
    per = defaultdict(lambda: Counter())
    cls_for = {}
    for e in events:
        per[e["target"]][e["kind"]] += 1
        cls_for.setdefault(e["target"], e.get("target_cls"))
    rows = []
    for tgt, c in per.items():
        s_in = c.get("send", 0) + c.get("send_sync", 0)
        r_in = c.get("recv", 0) + c.get("recv_sync", 0)
        rows.append({
            "tgt": tgt, "cls": cls_for[tgt] or "?",
            "sends": s_in, "recvs": r_in,
            "arms": c.get("arm", 0), "no_arm": c.get("no_arm", 0),
            "imbal": s_in - r_in,
        })
    rows.sort(key=lambda r: (-abs(r["imbal"]), -r["arms"]))
    print(f"  {'atom':<40} {'sends':>7} {'recvs':>7} {'arms':>7} {'no_arm':>7} {'imbal':>7}")
    print(f"  {'-'*40} {'-'*7} {'-'*7} {'-'*7} {'-'*7} {'-'*7}")
    for r in rows:
        atom_lbl = f"{r['cls']}[{r['tgt']}]"[:40]
        imbal_col = f"\033[31m{r['imbal']:>7}\033[0m" if r['imbal'] else f"{r['imbal']:>7}"
        no_arm_col = f"\033[31m{r['no_arm']:>7}\033[0m" if r['no_arm'] else f"{r['no_arm']:>7}"
        print(f"  {atom_lbl:<40} {r['sends']:>7} {r['recvs']:>7} {r['arms']:>7} {no_arm_col} {imbal_col}")

    # Topology top-N (by (src_cls, dst_cls, msg))
    print(f"\n\033[1m─── topology top-{opts['top']} ───\033[0m")
    top = topology(events).most_common(opts["top"])
    if not top:
        print("  (no send events)")
    else:
        mx = top[0][1]
        for (src, dst, msg), n in top:
            print(f"  {src:>16} → {dst:<16} {msg:<30} {n:>5}  {hbar(n, mx, 15)}")

    # Aggregated topology (src_cls → dst_cls without msg breakdown)
    agg = Counter()
    for (src, dst, _msg), n in topology(events).items():
        agg[(src, dst)] += n
    print(f"\n\033[1m─── topology (aggregate) ───\033[0m")
    if agg:
        mx = max(agg.values())
        for (src, dst), n in agg.most_common():
            arrow = "↺" if src == dst else "→"
            print(f"  {src:>16} {arrow} {dst:<16} {n:>5}  {hbar(n, mx, 15)}")


def main(argv):
    args = [a for a in argv[1:]]
    opts = {"top": 15, "silent_clock": False}
    positional = []
    for a in args:
        if a.startswith("--top="):
            opts["top"] = int(a.split("=", 1)[1])
        elif a == "--silent-clock":
            opts["silent_clock"] = True
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        else:
            positional.append(a)
    if not positional:
        print(__doc__, file=sys.stderr)
        return 2
    path = positional[0]
    if not os.path.exists(path):
        print(f"no such file: {path}", file=sys.stderr)
        return 2
    print_report(load(path), opts)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
