# Chapter-33 environment-builder slice (slice 39).
#
# Ports the environment builders at the head of `lower/lower`, in its
# order, on the node stream slice 38 prints (prelude nodes, then user
# nodes, with `(module <name>)` markers between files).
#
#   1. env/attribute-modules-to-decls, the decl-to-module table, and
#      env/module-map-from-attribution, its inverse seeded with every
#      prelude name.
#   2. The plugin runtime_shape scan at the head of lower and its
#      conflict check, then (lower mode) the `def main` check.
#   3. build-protocol-env with observable->method-entry and its two
#      default-value validators, then program-scan/sync-send-edges, then
#      build-enum-env.
#   4. (chapter 34) build-atom-env, the include-main? decision,
#      expand-phase-swallow-arms, the wildcard and concrete duplicate-arm
#      checks, the handler-shape split, the use-cap atom-type check, the
#      F41 field and ctor-param merge with its three duplicate checks,
#      fields-from-data-section with cxc-type->c and the invariant picker,
#      both default validators on the ctor params and the handler params,
#      ctor-params-normalized, the F8 and on_nil checks, and the message,
#      companion, stream, subscription, and slot indices. Then the
#      CxcStream seed and the prelude tree-shake (reachable-prelude-atoms).
#
# cxc-type->c reads `:resolves-to` through resolve-decl-lookup, so the
# stream comes with reference rows. A user file's rows are slice 37's
# refs mode on its slice-38 output, the prelude's are slice 38's prefs
# mode, and a ref with no module falls back to what lower's
# ensure-references-enriched adds (the prelude module, or `main` for a
# name declared before any module marker).
#
# argv.
#
#   <check> <stream> <index> <refs>
#       <check> is `lower` (every check lower makes, the `def main` check
#       included) or `envs` (no `def main` check, so a library file still
#       prints its environments). <stream> is a file holding
#       `(stream <node>*)`, the nodes in the slice-36 format with slice
#       38's rewrites and `(module <name>)` for a module marker, or an
#       `error|...` text, which passes through. <index> is the slice-37
#       prelude index, `<name>|<module>` lines. The stream holds a
#       `(piece)` marker ahead of each user file. <refs> holds
#       `(piece <n>)` lines, 0 for the prelude and n for the n-th user
#       file, each followed by that piece's slice-37 or slice-38 refs
#       rows. Only `(ref type ...)` rows are read.
#
# Output. The sections in lower's order, each a count row and its rows.
# When a step throws, the sections before it and then `error|<message>`.
#
#   (attribution <n>)     (decl <name> <module>), sorted by name.
#   (module-map <n>)      (module <module> <name>+), modules and names sorted.
#   (plugin-shapes <n>)   (plugin-shape "<name>"|nil <shape>) in stream
#                         order, then (runtime-shape <shape>).
#   (protocol-env <n>)    one row per protocol, sorted.
#       (protocol <name> (accepts <accept>*) (conforms <type>*) (defaults <default>*))
#       <accept>  = (accept <name> <params> <type>|nil)
#       <default> = (default <name> (params <p>+) <ret-ty>|nil <type>|nil <expr>)
#       <p>       = (self <owner>) | (p <name> <cxc-ty>|nil bang|plain <expr>|nil)
#   (sync-edges <n>)      (edge <source> <target> <msg>), sorted.
#   (enum-env <n>)        one row per enum, sorted.
#       (enum <name> tagged|plain (cases <c>*) (case-index (<c> <i>)*)
#             (entries <enum-case>*) (payload-index (<c> <params>)*)
#             (raw-values <v>+)|nil <raw-type>|nil)
#   (atom-env <n>)        one row per atom, sorted.
#       (atom <name> (fields <f>*) (ctor-params <c>*) (methods <m>*)
#             (observables <name>*) (invariants <prop>*)
#             (transitions <transition>*) (message-index (<msg> (payload <field>*))*)
#             (companion-index (<msg>_failed <msg> (reasons <r>*))*)
#             (use-caps (<name> <type-name>)*) (stream-index (<name> (keys <k>*))*)
#             (stream-order <name>*) (subscriptions (<field> <msg>+)*)
#             (slot-names <name>*) (on-nil (<method> <expr>)*) (extras <item>*)
#             (class-fns <item>*) <queue>|nil)
#       <f> = (f <name> <cxc-ty> bang|plain opt|raw "<scalar-c>" "<c-type>"
#               <default>|nil <type> [(map <k> <v>)] [weak|unowned] [(picked <lo> <hi>)])
#       <c> = (c <name> <cxc-ty> bang|plain "<c-type>" <default>|nil <type> [(map <k> <v>)])
#       <m> = (method <name> (params (self <atom>) <p>*) (block <stmt>*))
#       <r> = (typed <Type>) | violation
#   (tree-shake <n>)      (keep <name>) per atom-env key after the CxcStream
#                         seed and the tree-shake, sorted, CxcStream as
#                         (keep CxcStream runtime-provided).
#
# Every map is printed sorted by key, and a later declaration of a name
# replaces an earlier one, as `assoc` and `into {}` do. Params, types,
# expressions, and enum cases are verbatim spans of the stream.
#
# Method. The stream is read into the chapter-31 preorder arena (the
# reader is copied from slice 38). Each builder is one pass over the top
# nodes, inner loops walk items, params, fields, and cases by arena
# index, and maps with last-wins keys are `\n<key>\t<value>\n` tables.
# One selection sort serves every section and returns to the phase that
# asked through `sort_ret`. Chapter 33 read records through parametric
# observations and sorted none (the chapter 32 Linux notes). Compiler
# commit 40bfd77 retired the need and the code keeps its shape.
#
# build-atom-env (chapter 34) keeps each transition as a tab-separated
# row, `R` for a body arm with its guard, handler-shape, companion
# reasons, payload renderings, method params, and handler block computed
# in one scan, `S` for a synthesized swallow arm with its rendering. The
# merged ctor params and fields are text rows, every check is a loop
# over them, and the five sorted indices of one atom share one tagged
# sort. The default-value check is one scan subroutine (`kg`) that the
# ctor params, the handler params, and on_nil all enter and leave
# through `kret`.
#
# Scope notes. The duplicate-signature message names the first repeated
# signature in declaration order, which is Clojure's `frequencies` order
# for up to eight distinct names. base-type-name (a protocol default's
# return type under `!` or `?`, and a `|>` target's declared type) is
# ported for type refs, `!`, `?`, `List`, `Set`, and `Ptr` to a depth of
# four, `Map` over two plain type refs, and the unknown-node and
# unknown-outer messages. Named tuples and deeper or compound shapes
# print a port-only `port: out of scope` message the corpus never
# carries. The `|>` cycle warning goes to stderr in Clojure and is not
# ported. The non-protocol `class` check is unreachable (the parser only
# builds protocol classes).
#
# Chapter 34 scope notes. Clojure picks the first duplicate (wildcard
# arm, concrete arm, ctor param, field, on_nil entry) in `group-by` or
# `frequencies` order, which is first-seen order up to eight distinct
# keys, and the port uses first-seen order. The F8 field and observable
# collision walks a hash set, the port takes the first field, which
# agrees whenever one name collides. The swallow expansion walks its
# message map in first-seen order (exact up to eight messages). Stream
# emits are taken in rendering order, which is postwalk order unless an
# untargeted emit nests inside another's args. canonical-named-tuple-name
# is ported for flat shapes of up to four `T` or `T!` type-ref fields,
# the rest is `port: out of scope`. The tree-shake reads a name at the
# first child of the node kinds that carry `:name`, in a lambda's params,
# and after `TR:` in a type, not a named-tuple field name inside a type.
# The handler duplicate message is unreachable (two unguarded wildcard
# arms fail the wildcard check first, all-guarded ones become
# transitions), and so is the handler and method name collision (atoms
# have no `methods:` section).

def SNode:
    pre:    Int!
    kind:   Int!
    start:  Int!
    stop:   Int!
    depth:  Int!
    size:   Int!
    parent: Int!

def main:
    use args:    Args
    use console: Console
    use fs:      FileSystem

    mode:     String! = ""
    src:      String! = ""
    pidx:     String! = ""
    out:      String! = ""
    # Reader state.
    rp:       Int!    = 0
    rmode:    Int!    = 0
    rnest:    Int!    = 0
    tstart:   Int!    = 0
    sp:       Int!    = 0
    ncount:   Int!    = 0
    rstack:   List of SNode = []
    nodes:    List of SNode = []
    # Shared.
    ti:       Int!    = 2
    k:        Int!    = 0
    gc:       Int!    = 1
    rows:     List of String = []
    sort_ret: String! = ""
    sort_i:   Int!    = 0
    scan_best: String! = ""
    scan_has: Bool!   = false
    sorted:   String! = ""
    nsorted:  Int!    = 0
    # Attribution and module map.
    cur_mod:  String! = "main"
    atab:     String! = "\n"
    anames:   List of String = []
    msorted:  String! = ""
    cm:       String! = ""
    mrow:     String! = ""
    mtxt:     String! = ""
    nmod:     Int!    = 0
    # Runtime shape.
    fq:       Int!    = 0
    fend:     Int!    = 0
    p_shape:  String! = ""
    p_name:   String! = ""
    p_has_name: Bool! = false
    sh_rows:  String! = ""
    sh_n:     Int!    = 0
    nd_items: String! = ""
    nd_first: String! = ""
    nd_conf:  Bool!   = false
    has_main: Bool!   = false
    # Protocol env.
    pnm:      String! = ""
    ii:       Int!    = 0
    iend:     Int!    = 0
    acc_txt:  String! = ""
    an_txt:   String! = "\n"
    rtab:     String! = "\n"
    dk:       Int!    = 1
    pdup:     String! = ""
    dflt_txt: String! = ""
    qi:       Int!    = 0
    qend:     Int!    = 0
    q_seen:   Bool!   = false
    ar_bad:   String! = ""
    req_l:    String! = ""
    def_l:    String! = ""
    nc_name:  String! = ""
    nc_kw:    String! = ""
    prows:    String! = ""
    cj:       Int!    = 0
    cjend:    Int!    = 0
    cbad:     Bool!   = false
    ptab:     String! = "\n"
    pnames:   List of String = []
    # Sync edges.
    anm:      String! = "\n"
    ej:       Int!    = 0
    ejend:    Int!    = 0
    bstart:   Int!    = 0
    epass:    Int!    = 1
    fdata:    Int!    = -1
    fuses:    Int!    = -1
    ctab:     String! = "\n"
    dtab:     String! = "\n"
    utab:     String! = "\n"
    # Enum env.
    e_pending: Bool!  = false
    enm:      String! = ""
    ert:      String! = ""
    ci:       Int!    = 0
    cend:     Int!    = 0
    cidx:     Int!    = 0
    cases_t:  String! = ""
    ents_t:   String! = ""
    raw_t:    String! = ""
    tagged:   Bool!   = false
    ctab2:    String! = "\n"
    cnames:   List of String = []
    csorted:  String! = ""
    ci_txt:   String! = ""
    pi_txt:   String! = ""
    etab:     String! = "\n"
    enames:   List of String = []
    ectab:    String! = "\n"
    ec_v:     String! = ","
    # build-atom-env (chapter 34). Resolution inputs.
    reftab:   String! = "\n"
    rp_k:     String! = "0"
    rgc:      Int!    = 0
    rsrc:     String! = ""
    dmain:    String! = "\n"
    pc_cur:   Int!    = 0
    primtab:  String! = "\nInt\tint64_t\nInt8\tint8_t\nInt16\tint16_t\nInt32\tint32_t\nInt64\tint64_t\nUInt8\tuint8_t\nUInt16\tuint16_t\nUInt32\tuint32_t\nUInt64\tuint64_t\nFloat\tfloat\nDouble\tdouble\nString\tNSString *\nBool\tint\nUnit\tvoid\nNever\tvoid\nAny\tid\nBytes\tNSMutableData *\nBlock\tvoid (^)(void)\nByte\tuint8_t\nSizeT\tsize_t\nSsizeT\tssize_t\nCString\tconst char *\n"
    # The include-main? decision.
    a_resume: String! = "prep"
    atset:    String! = "\n"
    recset:   String! = "\n"
    othset:   String! = "\n"
    oth_any:  Bool!   = false
    main_i:   Int!    = -1
    m_flag:   Bool!   = false
    mj:       Int!    = 0
    mjend:    Int!    = 0
    # One atom.
    an:       String! = ""
    a_main:   Bool!   = false
    dsec:     Int!    = -1
    usec:     Int!    = -1
    onil:     Int!    = -1
    obs_t:    String! = ""
    obs_set:  String! = "\n"
    inv_t:    String! = ""
    cf_t:     String! = ""
    ex_t:     String! = ""
    props:    List of String = []
    txl:      List of String = []
    swl:      List of String = []
    mpn:      List of String = []
    mptab:    String! = "\n"
    cov:      String! = "\n"
    bi:       Int!    = 0
    bend:     Int!    = 0
    b_g:      Bool!   = false
    b_u:      Bool!   = false
    b_bare:   Bool!   = false
    b_rs:     String! = ""
    b_blk:    String! = ""
    pj:       Int!    = 0
    pjend:    Int!    = 0
    p_typed:  Bool!   = false
    p_pr:     String! = ""
    p_sig:    String! = ""
    p_syn:    String! = ""
    p_par:    String! = ""
    mk:       Int!    = 0
    s1:       String! = "\n"
    s2:       String! = "\n"
    s3:       String! = "\n"
    skeys:    String! = ""
    sctab:    String! = "\n"
    a_err:    String! = ""
    tl:       List of String = []
    hl:       List of String = []
    cmn:      String! = "\n"
    mgh:      String! = "\n"
    efn:      String! = "\n"
    mc_own:   String! = ""
    mc_f41:   String! = ""
    mc_cap:   String! = ""
    mf_f41:   String! = ""
    mf_raw:   String! = ""
    mf_cap:   String! = ""
    mc_t:     String! = ""
    mf_t:     String! = ""
    fl:       String! = ""
    bnd:      String! = "\n"
    bk:       Int!    = 0
    ft_t:     String! = ""
    ct_t:     String! = ""
    a_arb:    String! = ""
    a_req:    String! = ""
    a_def:    String! = ""
    a_seen:   Bool!   = false
    kj:       Int!    = 0
    kjend:    Int!    = 0
    kbad:     Bool!   = false
    kenv:     Bool!   = false
    kret:     String! = ""
    kname:    String! = ""
    kfail:    String! = ""
    kfkw:     String! = ""
    hk:       Int!    = 0
    hnames:   String! = "\n"
    m_t:      String! = ""
    mtab:     String! = "\n"
    c_key:    String! = ""
    c_of:     String! = ""
    c_rs:     String! = ""
    c_tok:    String! = ""
    ckeys:    List of String = []
    ctab3:    String! = "\n"
    expass:   Int!    = 1
    ex:       Int!    = 0
    exend:    Int!    = 0
    ea:       Int!    = 0
    eaend:    Int!    = 0
    e_pos:    Bool!   = false
    e_keys:   String! = ""
    stab:     String! = "\n"
    so_t:     String! = ""
    sbtab:    String! = "\n"
    sbkeys:   List of String = []
    sn_t:     String! = ""
    asorted:  String! = ""
    mi_t:     String! = ""
    ci_t:     String! = ""
    si_t:     String! = ""
    sb_t:     String! = ""
    on_t:     String! = ""
    aetab:    String! = "\n"
    aenames:  List of String = []
    tx_t:     String! = ""
    # The CxcStream seed and the prelude tree-shake.
    reached:  String! = "\n"
    wq:       List of String = []
    wk:       Int!    = 0
    pltab:     String! = "\n"
    sj:       Int!    = 0
    sjend:    Int!    = 0
    s_ex:     Bool!   = false
    tmode:    Int!    = 1
    tcur:     String! = ""
    uc_t:     String! = ""

    # Reader observations.
    r_end    :- rp >= src.length()
    rc       :- ||: r_end : -1 ||: else : src.code_at(rp)
    r_sp     :- rc == 32 or rc == 10 or rc == 9 or rc == 13
    r_open   :- rc == 40
    r_close  :- rc == 41
    r_quote  :- rc == 34
    r_bs     :- rc == 92
    r_plain  :- not r_end and not r_sp and not r_open and not r_close
    rtop     :- rstack.at((sp - 1).max(0)) ?? SNode(pre: -1, kind: 0, start: 0, stop: 0, depth: -1, size: 0, parent: -1)
    r_parent :- ||: sp == 0 : -1 ||: else : rtop.pre
    a_stop   :- r_end or r_sp or (r_close and rnest == 0)

    # Arena accessors.
    nn :- nodes.count()
    sx(i: Int!) :- SNode
        nodes.at(i.max(0)) ?? SNode(pre: -1, kind: -1, start: 0, stop: 0, depth: -1, size: 1, parent: -1)
    sx_text(i: Int!) :- String!
        ||: i < 0 or i >= nn : "" ||: else : src.substring(self.sx(i).start.max(0).min(src.length()), (self.sx(i).stop - self.sx(i).start).max(0).min(src.length()))
    sx_next(i: Int!) :- Int!
        i + self.sx(i).size.max(1)
    sx_head(i: Int!) :- String!
        ||: self.sx(i).kind == 0 and self.sx(i).size > 1 : self.sx_text(i + 1) ||: else : ""
    sx_end(i: Int!) :- Int!
        i + self.sx(i).size
    line_at(t: String!, k: Int!) :- String!
        ||: t.substring(k, t.length() - k).index_of("\n") < 0 : t.substring(k, t.length() - k) ||: else : t.substring(k, t.substring(k, t.length() - k).index_of("\n").max(0))
    cut(t: String!, k: Int!) :- String!
        t.substring(k.max(0).min(t.length()), t.length() - k.max(0).min(t.length()))

    # Tables. `look(tab, key)` is the rest of the `\n<key>\t...` line, ""
    # on a miss. A tab-separated row splits with f_first and f_rest.
    look(tab: String!, key: String!) :- String!
        ||: tab.index_of(("\n" + key) + "\t") < 0 : "" ||: else : self.line_at(tab, (tab.index_of(("\n" + key) + "\t") + key.length() + 2).max(0).min(tab.length()))
    has_key(tab: String!, key: String!) :- Bool!
        tab.contains(("\n" + key) + "\t")
    put_last(tab: String!, key: String!, v: String!) :- String!
        ||: self.has_key(tab, key) : tab.replace((("\n" + key) + ("\t" + self.look(tab, key))) + "\n", (("\n" + key) + ("\t" + v)) + "\n") ||: else : tab + ((key + "\t") + (v + "\n"))
    put_first(tab: String!, key: String!, v: String!) :- String!
        ||: self.has_key(tab, key) : tab ||: else : tab + ((key + "\t") + (v + "\n"))
    tab_cut(r: String!) :- Int!
        ||: r.index_of("\t") < 0 : r.length() ||: else : r.index_of("\t")
    f_first(r: String!) :- String!
        r.substring(0, self.tab_cut(r))
    f_rest(r: String!) :- String!
        r.substring((self.tab_cut(r) + 1).min(r.length()), (r.length() - self.tab_cut(r) - 1).max(0))
    plook(nm: String!) :- String!
        ||: pidx.index_of(("\n" + nm) + "|") < 0 : "" ||: else : self.line_at(pidx, (pidx.index_of(("\n" + nm) + "|") + nm.length() + 2).max(0).min(pidx.length()))
    pmod(nm: String!) :- String!
        ||: self.plook(nm) == "" : cur_mod ||: else : self.plook(nm)
    bar_at(ln: String!) :- Int!
        ln.index_of("|").max(0)
    sp_at(ln: String!) :- Int!
        ln.index_of(" ").max(0)
    nm_at(i: Int!) :- String!
        anames.at(i) ?? ""
    pn_at(i: Int!) :- String!
        pnames.at(i) ?? ""
    cn_at(i: Int!) :- String!
        cnames.at(i) ?? ""
    en_at(i: Int!) :- String!
        enames.at(i) ?? ""

    # Decode a pr-str string rendering for a message.
    dq(s: String!) :- String!
        ||: s.length() < 2 : s ||: else : s.substring(1, (s.length() - 2).max(0)).replace("\\\\", (1).to_char_string()).replace("\\\"", "\"").replace("\\n", "\n").replace("\\t", "\t").replace("\\r", "\r").replace((1).to_char_string(), "\\")

    # The Clojure node keyword of an expression rendering.
    kw_of(h: String!) :- String!
        ||: h == "int" : ":lit-int" ||: h == "float" : ":lit-float" ||: h == "string" : ":lit-string" ||: h == "char" : ":lit-char" ||: h == "bool" : ":lit-bool" ||: h == "nil" : ":lit-nil" ||: h == "multi-arm" : ":multi-arm-dispatch" ||: h == "do" : ":do-block-expr" ||: h == "variant" : ":variant-pattern" ||: h.starts_with("?") : ":" + h.substring(1, (h.length() - 1).max(0)) ||: else : ":" + h
    kw(i: Int!) :- String!
        ||: self.sx(i).kind == 1 and self.sx_text(i) == "else" : ":else-marker" ||: else : self.kw_of(self.sx_head(i))

    # The current top node.
    hd       :- self.sx_head(ti)
    tname    :- self.sx_text(ti + 2)
    is_decl  :- hd == "record" or hd == "agent" or hd == "enum"
    is_atom  :- hd == "agent" and tname != "main"

    # Runtime shape. A field's default is its fifth child.
    is_rs(d: Int!) :- Bool!
        self.sx_head(d) == "dot" and self.sx_text(d + 2) == "(ident RuntimeShape)"
    p_nm_out :- ||: p_has_name : p_name ||: else : "nil"
    nd_item  :- ((||: p_has_name : self.dq(p_name) ||: else : "<unnamed>") + " → RuntimeShape.") + p_shape.replace("-", "_")
    p_nd     :- p_shape != "" and p_shape != "dispatch-main"
    shape_txt :- (("\n(plugin-shapes " + sh_n.to_string()) + ")") + (sh_rows + (("\n(runtime-shape " + (||: nd_first == "" : "dispatch-main" ||: else : nd_first)) + ")"))
    m_conflict :- ("conflicting `runtime_shape` declarations across plugins: " + nd_items) + (". At most one non-default runtime_shape " + "is allowed per program; each shape owns the main thread differently and they can not coexist. See design/runtime-shape.md.")

    # canonical-named-tuple-name for a flat shape of up to four fields
    # whose types are `T` or `T!` over a type ref, in any order. Anything
    # else is a port-only `port: out of scope`.
    nt_body(t: String!) :- String!
        t.substring(4, (t.length() - 5).max(0))
    nt_one(x: String!) :- String!
        ||: x.index_of(",") < 0 : x ||: else : x.substring(0, x.index_of(",").max(0))
    nt_cut(x: String!) :- String!
        ||: x.index_of(",") < 0 : "" ||: else : self.cut(x, x.index_of(",") + 1)
    nt_it(t: String!, k: Int!) :- String!
        ||: k == 0 : self.nt_one(self.nt_body(t)) ||: k == 1 : self.nt_one(self.nt_cut(self.nt_body(t))) ||: k == 2 : self.nt_one(self.nt_cut(self.nt_cut(self.nt_body(t)))) ||: else : self.nt_one(self.nt_cut(self.nt_cut(self.nt_cut(self.nt_body(t)))))
    nt_n(t: String!) :- Int!
        ||: self.nt_body(t) == "" : 0 ||: self.nt_cut(self.nt_body(t)) == "" : 1 ||: self.nt_cut(self.nt_cut(self.nt_body(t))) == "" : 2 ||: self.nt_cut(self.nt_cut(self.nt_cut(self.nt_body(t)))) == "" : 3 ||: else : 4
    nt_more(t: String!) :- Bool!
        self.nt_cut(self.nt_cut(self.nt_cut(self.nt_cut(self.nt_body(t))))) != ""
    nt_fnm(it: String!) :- String!
        it.substring(0, it.index_of(":").max(0))
    nt_fty(it: String!) :- String!
        self.cut(it, it.index_of(":") + 1)
    nt_resv(x: String!) :- Bool!
        x.starts_with("Nn_") or x.starts_with("_Cxc_NT") or (x.starts_with("Nt") and (x.code_at(2) >= 48 and x.code_at(2) <= 57)) or (x.starts_with("Of") and (x.code_at(2) >= 48 and x.code_at(2) <= 57))
    nt_mty(y: String!) :- String!
        ||: y.starts_with("TR:") and not y.contains("(") : self.cut(y, 3) ||: y.starts_with("TN(TR:") and y.ends_with(")") and not self.cut(y, 6).contains("(") : "Nn_" + y.substring(6, (y.length() - 7).max(0)) ||: else : ""
    nt_ok(it: String!) :- Bool!
        it.contains(":") and self.nt_fnm(it) != "" and not self.nt_fnm(it).contains("_") and not self.nt_fnm(it).starts_with("Nn") and self.nt_mty(self.nt_fty(it)) != ""
    nt_tok(it: String!) :- Bool!
        self.nt_ok(it) and not self.nt_resv(self.cut(self.nt_mty(self.nt_fty(it)), ||: self.nt_mty(self.nt_fty(it)).starts_with("Nn_") : 3 ||: else : 0))
    nt_lt(t: String!, j: Int!, i: Int!) :- Int!
        ||: j < self.nt_n(t) and j != i and self.nt_fnm(self.nt_it(t, j)).compare_to(self.nt_fnm(self.nt_it(t, i))) < 0 : 1 ||: else : 0
    nt_rank(t: String!, i: Int!) :- Int!
        (self.nt_lt(t, 0, i) + self.nt_lt(t, 1, i)) + (self.nt_lt(t, 2, i) + self.nt_lt(t, 3, i))
    nt_at_rank(t: String!, r: Int!) :- String!
        ||: self.nt_rank(t, 0) == r : self.nt_it(t, 0) ||: self.nt_rank(t, 1) == r : self.nt_it(t, 1) ||: self.nt_rank(t, 2) == r : self.nt_it(t, 2) ||: else : self.nt_it(t, 3)
    nt_part(it: String!) :- String!
        (self.nt_fnm(it) + "_") + self.nt_mty(self.nt_fty(it))
    nt_all_ok(t: String!) :- Bool!
        (self.nt_n(t) < 1 or self.nt_tok(self.nt_it(t, 0))) and (self.nt_n(t) < 2 or self.nt_tok(self.nt_it(t, 1))) and (self.nt_n(t) < 3 or self.nt_tok(self.nt_it(t, 2))) and (self.nt_n(t) < 4 or self.nt_tok(self.nt_it(t, 3)))
    nt_parts(t: String!) :- String!
        ((self.nt_part(self.nt_at_rank(t, 0)) + (||: self.nt_n(t) > 1 : "_" + self.nt_part(self.nt_at_rank(t, 1)) ||: else : "")) + ((||: self.nt_n(t) > 2 : "_" + self.nt_part(self.nt_at_rank(t, 2)) ||: else : "") + (||: self.nt_n(t) > 3 : "_" + self.nt_part(self.nt_at_rank(t, 3)) ||: else : "")))
    nt_name(t: String!) :- String!
        ||: self.nt_n(t) == 0 or self.nt_more(t) or not self.nt_all_ok(t) : "!err:port: out of scope" ||: else : "_Cxc_NT_" + self.nt_parts(t)

    # base-type-name, unrolled to depth four. An error comes back as
    # `!err:<message>` anywhere in the result.
    nyi(s: String!) :- String!
        "!err:lowering not yet implemented: " + s
    to_outer(t: String!) :- String!
        t.substring(3, (t.index_of("(") - 3).max(0))
    to_inner(t: String!) :- String!
        t.substring((t.index_of("(") + 1).max(0), (t.length() - t.index_of("(") - 2).max(0))
    wr_inner(t: String!) :- String!
        t.substring(3, (t.length() - 4).max(0))
    is_wrap(t: String!) :- Bool!
        t.starts_with("TN(") or t.starts_with("TQ(")
    is_to(t: String!, o: String!) :- Bool!
        t.starts_with("TO:") and self.to_outer(t) == o
    known_outer(t: String!) :- Bool!
        self.is_to(t, "List") or self.is_to(t, "Set") or self.is_to(t, "Ptr") or self.is_to(t, "Map")
    map_ok(t: String!) :- Bool!
        self.to_inner(t).starts_with("TT(TR:") and self.to_inner(t).ends_with(")") and self.to_inner(t).index_of(",TR:") > 0 and not self.wr_inner(self.to_inner(t)).contains("(")
    map_k(t: String!) :- String!
        self.wr_inner(self.to_inner(t)).substring(3, (self.wr_inner(self.to_inner(t)).index_of(",") - 3).max(0))
    map_v(t: String!) :- String!
        self.cut(self.wr_inner(self.to_inner(t)), self.wr_inner(self.to_inner(t)).index_of(",") + 4)
    bt_err(t: String!) :- String!
        ||: t == "nil" : self.nyi("base-type-name: unknown type-node ") ||: t.starts_with("TT(") : self.nyi("base-type-name: unknown type-node :type-tuple") ||: t.starts_with("TF(") : self.nyi("base-type-name: unknown type-node :foreign-fn-type") ||: t.starts_with("TO:") and not self.known_outer(t) : self.nyi(("base-type-name: `" + self.to_outer(t)) + " of ...` — only `List of T`, `Map of (K, V)`, `Set of T`, and `Ptr of T` (FFI) supported") ||: t.starts_with("TNT(") : self.nt_name(t) ||: else : "!err:port: out of scope"
    bt0(t: String!) :- String!
        ||: t.starts_with("TR:") : t.substring(3, t.length() - 3) ||: else : self.bt_err(t)
    bt1(t: String!) :- String!
        ||: t.starts_with("TR:") : t.substring(3, t.length() - 3) ||: self.is_wrap(t) : self.bt0(self.wr_inner(t)) ||: self.is_to(t, "List") : "_Cxc_ListOf" + self.bt0(self.to_inner(t)) ||: self.is_to(t, "Set") : "_Cxc_SetOf" + self.bt0(self.to_inner(t)) ||: self.is_to(t, "Ptr") : "_Cxc_Ptr_" + self.bt0(self.to_inner(t)) ||: self.is_to(t, "Map") and self.map_ok(t) : ("_Cxc_MapOf" + self.map_k(t)) + self.map_v(t) ||: else : self.bt_err(t)
    bt2(t: String!) :- String!
        ||: t.starts_with("TR:") : t.substring(3, t.length() - 3) ||: self.is_wrap(t) : self.bt1(self.wr_inner(t)) ||: self.is_to(t, "List") : "_Cxc_ListOf" + self.bt1(self.to_inner(t)) ||: self.is_to(t, "Set") : "_Cxc_SetOf" + self.bt1(self.to_inner(t)) ||: self.is_to(t, "Ptr") : "_Cxc_Ptr_" + self.bt1(self.to_inner(t)) ||: self.is_to(t, "Map") and self.map_ok(t) : ("_Cxc_MapOf" + self.map_k(t)) + self.map_v(t) ||: else : self.bt_err(t)
    bt3(t: String!) :- String!
        ||: t.starts_with("TR:") : t.substring(3, t.length() - 3) ||: self.is_wrap(t) : self.bt2(self.wr_inner(t)) ||: self.is_to(t, "List") : "_Cxc_ListOf" + self.bt2(self.to_inner(t)) ||: self.is_to(t, "Set") : "_Cxc_SetOf" + self.bt2(self.to_inner(t)) ||: self.is_to(t, "Ptr") : "_Cxc_Ptr_" + self.bt2(self.to_inner(t)) ||: self.is_to(t, "Map") and self.map_ok(t) : ("_Cxc_MapOf" + self.map_k(t)) + self.map_v(t) ||: else : self.bt_err(t)
    bt_msg(r: String!) :- String!
        ||: r.contains("!err:") : self.cut(r, r.index_of("!err:") + 5) ||: else : ""
    # The protocol default's `:cxc-return-ty` from its signature's type.
    ret_ty(r: String!) :- String!
        ||: r == "nil" : "" ||: r.starts_with("TR:") : r.substring(3, r.length() - 3) ||: r.starts_with("TO:") : self.to_outer(r) ||: self.is_wrap(r) : self.bt3(self.wr_inner(r)) ||: else : ""

    # Protocol env.
    ihd :- self.sx_head(ii)
    twice(x: String!) :- Bool!
        self.cut(an_txt, an_txt.index_of(("\n" + x) + "\n") + 1).contains(("\n" + x) + "\n")
    q_self(q: Int!) :- Bool!
        self.sx_head(q) == "param"
    q_name(q: Int!) :- String!
        ||: self.q_self(q) : "self" ||: else : self.sx_text(q + 2)
    q_hasd(q: Int!) :- Bool!
        not self.q_self(q) and self.sx(q + 4).kind == 0
    needs_c(q: Int!) :- Bool!
        self.q_hasd(q) and nc_name == ""
    cty(t: String!) :- String!
        ||: t.starts_with("TR:") : t.substring(3, t.length() - 3) ||: t.starts_with("TN(TR:") and t.ends_with(")") : t.substring(6, (t.length() - 7).max(0)) ||: else : "nil"
    q_def(q: Int!) :- String!
        ||: self.q_hasd(q) : self.sx_text(q + 4) ||: else : "nil"
    q_bang(q: Int!) :- String!
        ||: self.sx_text(q + 3).starts_with("TN(") : " bang " ||: else : " plain "
    prow(q: Int!) :- String!
        ||: self.q_self(q) : ("(self " + pnm) + ")" ||: else : (("(p " + self.q_name(q)) + (" " + self.cty(self.sx_text(q + 3)))) + (self.q_bang(q) + (self.q_def(q) + ")"))
    lit_head(h: String!) :- Bool!
        h == "int" or h == "float" or h == "string" or h == "char" or h == "bool"
    form_head(h: String!) :- Bool!
        h == "nil" or h == "ident" or h == "neg" or h == "not" or h == "list"
    ok_head(h: String!) :- Bool!
        self.lit_head(h) or self.form_head(h)
    o_name   :- self.sx_text(ii + 2)
    o_ret    :- ||: self.look(rtab, o_name) == "" : "nil" ||: else : self.look(rtab, o_name)
    o_expr   :- self.sx_text(self.sx_next(self.sx_next(ii + 3)))
    o_site   :- ("observable `" + pnm) + (("." + o_name) + "`")
    o_retty  :- self.ret_ty(o_ret)
    m_after  :- ((("required param `" + ar_bad) + "` follows a defaulted ") + (("param on " + o_site) + " — spec §3.8.5 requires defaulted params to come last. ")) + ((("Reorder: put all required params (" + req_l) + ") FIRST, then defaulted params (") + (def_l + ")."))
    m_const  :- ((("default for `" + nc_name) + ("` on " + o_site)) + (" is not a compile-time constant (spec §3.8.5 " + "permits primitive literals, `nil`, unary `-`/`not` on those, a value-alias identifier, or a bare enum-case access `Enum.case`); ")) + (("got `" + nc_kw) + "` node")
    m_dup    :- (("protocol `" + pnm) + ("` declares signature `" + pdup)) + ("` more than once — each selector " + "appears at most once in a protocol's surface. See spec §3.4.5.")
    retty_out :- ||: o_retty == "" : "nil" ||: else : o_retty
    d_row    :- ((("(default " + o_name) + (" (params (self " + pnm)) + ((")" + prows) + (") " + self.retty_out))) + ((" " + o_ret) + ((" " + o_expr) + ")"))

    # Sync edges.
    e_emit :- epass == 2 and self.sx_head(ej) == "emit" and self.sx_text(ej + 2) == "sync" and self.sx_head(ej + 3) == "ident"
    e_x    :- self.sx_text(ej + 5)
    e_msg  :- self.sx_text(self.sx_next(ej + 3))
    e_ty   :- ||: self.has_key(ctab, e_x) : self.look(ctab, e_x) ||: self.has_key(dtab, e_x) : self.look(dtab, e_x) ||: self.has_key(utab, e_x) : self.look(utab, e_x) ||: else : ""
    e_bt   :- ||: e_ty == "" or e_ty.contains("TNT(") : "" ||: else : self.bt3(e_ty)
    e_err  :- self.bt_msg(e_bt)
    e_hit  :- e_bt != "" and e_err == "" and anm.contains(("\n" + e_bt) + "\n") and e_bt != tname
    e_par  :- self.sx(ej).parent
    e_h    :- self.sx_head(ej)

    # Enum env.
    c_raw  :- self.sx_next(ci + 3) < self.sx_end(ci)
    e_row  :- ((("(enum " + enm) + (" " + (||: tagged : "tagged" ||: else : "plain"))) + ((" (cases" + cases_t) + (") (case-index" + ci_txt))) + (((") (entries" + ents_t) + (") (payload-index" + pi_txt)) + ((") " + (||: ert == "nil" : "nil" ||: else : ("(raw-values" + raw_t) + ")")) + ((" " + ert) + ")")))

    # build-atom-env (chapter 34).
    #
    # Resolution. A type ref's `:resolves-to` is its refs row for the
    # current piece (slice 38 prefs rows for the prelude, slice 37 refs
    # rows per user file), else what lower's ensure-references-enriched
    # adds, the prelude module or `main` for a name declared under main.
    # decl-lookup hits when that module lists the name in the module map
    # and the env holds it.
    rrow(x: String!) :- String!
        self.look(reftab, (pc_cur.to_string() + ":") + x)
    res(x: String!) :- String!
        ||: self.rrow(x) != "" and self.rrow(x) != "nil" : self.rrow(x) ||: self.plook(x) != "" : self.plook(x) ||: dmain.contains(("\n" + x) + "\n") : "main" ||: else : ""
    home(x: String!) :- String!
        ||: self.plook(x) != "" : self.plook(x) ||: else : self.look(atab, x)
    hitm(x: String!) :- Bool!
        self.res(x) != "" and self.res(x) == self.home(x)
    in_set(st: String!, x: String!) :- Bool!
        st.contains(("\n" + x) + "\n")
    hit_atom(x: String!) :- Bool!
        self.in_set(atset, x) and self.hitm(x)
    hit_rec(x: String!) :- Bool!
        self.in_set(recset, x) and self.hitm(x)
    hit_enum(x: String!) :- Bool!
        self.has_key(etab, x) and self.hitm(x)
    mangle(m: String!, x: String!) :- String!
        ||: m.starts_with("std.") : "_Cxc_" + x ||: m == "main" : x ||: else : (m.replace(".", "_") + "_") + x
    csafe(x: String!) :- String!
        ||: self.has_key(atab, x) : self.mangle(self.look(atab, x), x) ||: else : x
    prim(x: String!) :- String!
        self.look(primtab, x)
    pre_atom(x: String!) :- Bool!
        "\nClock\nRandom\nTestKeyboardInput\nConsole\nSystemPanic\nPlugin\nOsPrimitive\nFileSystem\nSubprocess\nEnvVars\nEnvMut\nArgs\nJson\nHttp\nTime\nHash\n".contains(("\n" + x) + "\n")

    # cxc-type->c. An error is `!err:<message>`.
    tkw(t: String!) :- String!
        ||: t.starts_with("TR:") : ":type-ref" ||: t.starts_with("TNT(") : ":type-named-tuple" ||: t.starts_with("TN(") : ":type-nonnil" ||: t.starts_with("TQ(") : ":type-nullable" ||: t.starts_with("TO:") : ":type-of" ||: t.starts_with("TT(") : ":type-tuple" ||: t.starts_with("TF(") : ":foreign-fn-type" ||: else : ""
    ct_bang(x: String!) :- String!
        ||: self.hit_atom(x) : self.csafe(x) + " *" ||: x == "String" : "NSString *" ||: self.prim(x) != "" : self.prim(x) ||: else : self.csafe(x)
    ct_ref(x: String!) :- String!
        ||: self.prim(x) != "" : self.prim(x) ||: self.hit_rec(x) : self.csafe(x) ||: self.hit_atom(x) : self.csafe(x) + " *" ||: self.hit_enum(x) : self.csafe(x) ||: x == "SystemPanic" : self.csafe(x) + " *" ||: else : self.nyi("type " + x)
    q_nm(t: String!) :- String!
        ||: t.starts_with("TR:") : self.cut(t, 3) ||: t.starts_with("TO:") : self.to_outer(t) + " of ..." ||: t.starts_with("TT(") : "(...)" ||: t.starts_with("TNT(") : "(name: T, ...)" ||: else : ("<" + self.cut(self.tkw(t), 1)) + ">"
    m_qban(n: String!) :- String!
        "!err:" + ((("`" + n) + ("?` — the `?` suffix is banned universally " + "(spec §3.6.1 unified rule 2026-08-20). Fix: use bare `")) + ((n + "` for the nullable form (nil-allowed by default) or `") + (n + "!` for the non-nil contract.")))
    ct_tn(t: String!) :- String!
        ||: self.wr_inner(t).starts_with("TR:") : self.ct_bang(self.cut(self.wr_inner(t), 3)) ||: else : self.nyi("cxc-type->c: `!` on unknown inner " + self.tkw(self.wr_inner(t)))
    ct_coll(t: String!) :- String!
        ||: self.bt3(t).contains("!err:") : self.bt3(t) ||: else : self.bt3(t) + " *"
    is_coll(t: String!) :- Bool!
        self.is_to(t, "List") or self.is_to(t, "Map") or self.is_to(t, "Set")
    ct0(t: String!) :- String!
        ||: t.starts_with("TQ(") : self.m_qban(self.q_nm(self.wr_inner(t))) ||: t.starts_with("TN(") : self.ct_tn(t) ||: t.starts_with("TR:") : self.ct_ref(self.cut(t, 3)) ||: t.starts_with("TNT(") : self.nt_name(t) ||: self.is_to(t, "Ptr") : "!err:port: out of scope" ||: self.is_coll(t) : self.ct_coll(t) ||: t.starts_with("TO:") : self.nyi(("cxc-type->c: `" + self.to_outer(t)) + " of ...` unsupported") ||: else : self.nyi("cxc-type->c: unknown type-node " + self.tkw(t))
    ct_ptr(u: String!) :- String!
        ||: self.ct0(u).contains("!err:") : self.ct0(u) ||: else : self.ct0(u) + " *"
    ctype(t: String!) :- String!
        ||: self.is_to(t, "Ptr") : self.ct_ptr(self.to_inner(t)) ||: else : self.ct0(t)
    # base-type-name of a payload or param type, `T?:` and `nil` both nil.
    btn(t: String!) :- String!
        ||: t == "T?:" : self.bt3("nil") ||: else : self.bt3(t)
    err_of(r: String!) :- String!
        self.bt_msg(r)

    # Tab-separated rows. A regular transition is
    # `R i guarded handler reasons pprint psig synsrc params block`, a
    # synthesized swallow arm `S phase msg target rendering pprint psig`.
    rt1(r: String!) :- String!
        self.f_rest(r)
    rt2(r: String!) :- String!
        self.f_rest(self.rt1(r))
    rt3(r: String!) :- String!
        self.f_rest(self.rt2(r))
    rt4(r: String!) :- String!
        self.f_rest(self.rt3(r))
    rt5(r: String!) :- String!
        self.f_rest(self.rt4(r))
    rt6(r: String!) :- String!
        self.f_rest(self.rt5(r))
    rt7(r: String!) :- String!
        self.f_rest(self.rt6(r))
    rt8(r: String!) :- String!
        self.f_rest(self.rt7(r))
    rt9(r: String!) :- String!
        self.f_rest(self.rt8(r))
    rf1(r: String!) :- String!
        self.f_first(self.rt1(r))
    rf2(r: String!) :- String!
        self.f_first(self.rt2(r))
    rf3(r: String!) :- String!
        self.f_first(self.rt3(r))
    rf4(r: String!) :- String!
        self.f_first(self.rt4(r))
    rf5(r: String!) :- String!
        self.f_first(self.rt5(r))
    rf6(r: String!) :- String!
        self.f_first(self.rt6(r))
    rf7(r: String!) :- String!
        self.f_first(self.rt7(r))
    rf8(r: String!) :- String!
        self.f_first(self.rt8(r))
    rf9(r: String!) :- String!
        self.f_first(self.rt9(r))

    # Transition renderings. `(transition <line> <source> <recv> <target> <body>*)`.
    t_rcv(i: Int!) :- Int!
        self.sx_next(i + 3)
    t_tgt(i: Int!) :- Int!
        self.sx_next(self.t_rcv(i))
    t_body(i: Int!) :- Int!
        self.sx_next(self.t_tgt(i))
    t_srck(i: Int!) :- String!
        ||: self.sx(i + 3).kind == 0 : "phase" ||: self.sx_text(i + 3) == "*" : "wildcard" ||: else : self.sx_text(i + 3)
    t_phase(i: Int!) :- String!
        ||: self.sx(i + 3).kind == 0 : self.sx_text(i + 5) ||: else : ""
    t_glyph(i: Int!) :- String!
        ||: self.sx(self.t_rcv(i)).kind == 0 : self.sx_text(self.t_rcv(i) + 2) ||: else : ""
    t_m(i: Int!) :- Int!
        self.t_rcv(i) + 3
    m_kind(m: Int!) :- String!
        ||: self.sx(m).kind == 1 : "star" ||: self.sx_head(m) == "typed" : "typed" ||: self.sx_head(m + 2) == "ident" : "ident" ||: self.sx_head(m + 2) == "dot" : "dot" ||: else : "other"
    m_name(m: Int!) :- String!
        ||: self.m_kind(m) == "typed" : self.sx_text(m + 2) ||: self.m_kind(m) == "ident" : self.sx_text(m + 4) ||: else : ""
    t_kind(i: Int!) :- String!
        ||: self.t_glyph(i) == "" : "none" ||: else : self.m_kind(self.t_m(i))
    t_name(i: Int!) :- String!
        ||: self.t_glyph(i) == "" : "" ||: else : self.m_name(self.t_m(i))
    is_syn(r: String!) :- Bool!
        r.starts_with("S\t")
    r_i(r: String!) :- Int!
        ||: self.is_syn(r) : -1 ||: else : self.rf1(r).to_int_or(-1)
    r_srck(r: String!) :- String!
        ||: self.is_syn(r) : "phase" ||: else : self.t_srck(self.r_i(r))
    r_phase(r: String!) :- String!
        ||: self.is_syn(r) : self.rf1(r) ||: else : self.t_phase(self.r_i(r))
    r_glyph(r: String!) :- String!
        ||: self.is_syn(r) : "<:" ||: else : self.t_glyph(self.r_i(r))
    r_kind(r: String!) :- String!
        ||: self.is_syn(r) : "ident" ||: else : self.t_kind(self.r_i(r))
    r_name(r: String!) :- String!
        ||: self.is_syn(r) : self.rf2(r) ||: else : self.t_name(self.r_i(r))
    r_guard(r: String!) :- Bool!
        not self.is_syn(r) and self.rf2(r) == "1"
    r_hand(r: String!) :- Bool!
        not self.is_syn(r) and self.rf3(r) == "1"
    r_text(r: String!) :- String!
        ||: self.is_syn(r) : self.rf4(r) ||: else : self.sx_text(self.r_i(r))
    r_reasons(r: String!) :- String!
        ||: self.is_syn(r) : "" ||: else : self.rf4(r)
    r_ident(r: String!) :- Bool!
        self.r_kind(r) == "ident" or self.r_kind(r) == "typed"
    r_msgtx(r: String!) :- Bool!
        (self.r_glyph(r) == "<:" or self.r_glyph(r) == "<|") and self.r_ident(r)
    txl_at(i: Int!) :- String!
        txl.at(i) ?? ""
    tl_at(i: Int!) :- String!
        tl.at(i) ?? ""
    hl_at(i: Int!) :- String!
        hl.at(i) ?? ""
    mrf :- ||: k < tl.count() : self.tl_at(k) ||: else : self.hl_at(k - tl.count())
    m_ex :- self.look(mtab, self.r_name(mrf))
    m_bad :- ||: m_ex.starts_with("!err:") : self.cut(m_ex, 5) ||: self.rf6(mrf).starts_with("!err:") : self.cut(self.rf6(mrf), 5) ||: m_ex != self.rf6(mrf) : self.m_shape(self.r_name(mrf), m_ex, self.rf6(mrf)) ||: else : ""
    s_emit(j: Int!) :- Bool!
        self.sx_head(j) == "emit" and self.sx(j + 3).kind == 1 and self.sx_text(j + 3) == "nil"
    u_slot(ln: String!) :- Bool!
        self.rf4(ln) == "own" and self.rf3(ln) == "" and self.err_of(self.bt3(self.rf1(ln))) == "" and self.in_set(atset, self.bt3(self.rf1(ln)))

    # Body scan of one transition.
    has_as(p: Int!) :- Bool!
        self.sx_next(p + 2) < self.sx_end(p) and self.sx_head(self.sx_next(p + 2)) == "as"
    as_typed(p: Int!) :- Bool!
        self.has_as(p) and self.sx_text(self.sx_next(p + 2) + 2).starts_with("TR:")
    as_tok(p: Int!) :- String!
        (" (typed " + self.cut(self.sx_text(self.sx_next(p + 2) + 2), 3)) + ")"
    stmts_in(c: Int!) :- String!
        self.sx_text(self.sx_next(c + 2)).substring(6, (self.sx_text(self.sx_next(c + 2)).length() - 7).max(0))
    is_extra_a(h: String!) :- Bool!
        h != "data" and h != "uses" and h != "obs" and h != "transition"
    is_extra(h: String!) :- Bool!
        self.is_extra_a(h) and h != "prop" and h != "on-nil" and h != "class-fn" and h != "field"
    # A payload field. Typed params are `(field n T d ...)`, a src payload
    # field is `(field n T [bare])`.
    pf_t(q: Int!) :- String!
        self.sx_text(q + 3)
    tnil(t: String!) :- String!
        ||: t == "T?:" : "nil" ||: else : t
    pl_pr(q: Int!) :- String!
        ||: p_typed : (" (field " + self.sx_text(q + 2)) + ((" " + self.pf_t(q)) + " nil)") ||: else : ((" (field " + self.sx_text(q + 2)) + (" " + self.tnil(self.pf_t(q)))) + ((" nil" + (||: self.sx(q).size == 5 : " bare" ||: else : "")) + ")")
    syn_item(q: Int!) :- String!
        ||: p_typed : ((" (field " + self.sx_text(q + 2)) + " ") + ((||: self.pf_t(q) == "nil" : "T?:" ||: else : self.pf_t(q)) + ")") ||: else : " " + self.sx_text(q)
    sig_item(q: Int!) :- String!
        ((" [\"" + self.sx_text(q + 2)) + "\" \"") + (self.btn(self.pf_t(q)) + "\"]")
    t_handler(i: Int!) :- Bool!
        self.t_srck(i) == "wildcard" and self.sx_text(self.t_tgt(i)) == "self" and self.t_glyph(i) == "<:" and self.t_kind(i) == "typed" and not b_u
    t_ref :- (((("R\t" + ii.to_string()) + "\t") + ((||: b_g : "1" ||: else : "0") + "\t")) + (((||: self.t_handler(ii) : "1" ||: else : "0") + "\t") + ((b_rs + (||: b_bare : " violation" ||: else : "")) + "\t"))) + (((p_pr + "\t") + (p_sig + "\t")) + (((("(src (ident " + self.t_name(ii)) + ")") + (p_syn + ")\t")) + ((p_par + "\t") + b_blk)))
    t_idmsg :- self.t_glyph(ii) == "<:" and (self.t_kind(ii) == "ident" or self.t_kind(ii) == "typed")
    sw_at(k: Int!) :- Int!
        (swl.at(k) ?? "-1").to_int_or(-1)
    syn_ref(sw: Int!, m: String!) :- String!
        ((((("S\t" + self.t_phase(sw)) + "\t") + ((m + "\t") + (self.sx_text(self.t_tgt(sw)) + "\t"))) + (((("(transition " + self.sx_text(sw + 2)) + (" (phase " + self.t_phase(sw))) + (") (recv <: " + self.f_first(self.look(mptab, m)))) + ((") " + self.sx_text(self.t_tgt(sw))) + ")\t")))) + self.f_rest(self.look(mptab, m))

    # The include-main? scan over main's subtree.
    mj_par :- self.sx(mj).parent
    mj_fld(j: Int!) :- Bool!
        self.sx_head(j) == "field" and self.sx_head(self.sx(j).parent) == "data" and self.sx(self.sx(j).parent).parent == main_i
    mj_fty(t: String!) :- Bool!
        t.starts_with("TO:") or t == "TR:Block" or (t.starts_with("TR:") and (self.in_set(othset, self.cut(t, 3)) or self.pre_atom(self.cut(t, 3))))
    mj_txn :- self.sx_head(mj) == "transition" and (self.t_glyph(mj) == "<:" or self.t_glyph(mj) == "<|")
    mj_top :- mj_par == main_i and (self.sx_head(mj) == "uses" or mj_txn)
    mj_hit :- (self.mj_fld(mj) and self.mj_fty(self.sx_text(mj + 3))) or mj_top

    # Duplicate scans keep `s1` (seen), `s2` (seen twice), `s3` (a third
    # set), and `skeys`, the keys in first-seen order.
    sk_add(x: String!) :- String!
        ||: self.in_set(s1, x) : skeys ||: else : (skeys + x) + "\n"
    s2_add(x: String!) :- String!
        ||: self.in_set(s1, x) and not self.in_set(s2, x) : (s2 + x) + "\n" ||: else : s2
    vec_q(x: String!) :- String!
        ("\"" + x) + "\""

    # Merged ctor rows `name T default flag didx`, field rows
    # `name T default mod flag`.
    fd_mod(f: Int!) :- String!
        ||: self.sx_next(f + 4) < self.sx_end(f) and (self.sx_text(self.sx_next(f + 4)) == "weak" or self.sx_text(self.sx_next(f + 4)) == "unowned") : self.sx_text(self.sx_next(f + 4)) ||: else : ""
    fd_cont(t: String!) :- Bool!
        self.is_to(t, "List") or self.is_to(t, "Map") or self.is_to(t, "Set")
    ld_head(h: String!) :- Bool!
        h == "int" or h == "float" or h == "string" or h == "bool" or h == "nil"
    lit_dflt(f: Int!) :- Bool!
        self.sx(f + 4).kind == 0 and self.ld_head(self.sx_head(f + 4))
    f41_elig(f: Int!) :- Bool!
        not a_main and self.sx_text(f + 4) == "nil" and not self.fd_cont(self.sx_text(f + 3))
    f41_lit(f: Int!) :- Bool!
        not a_main and self.lit_dflt(f)
    fld_row(f: Int!, d: String!, fl2: String!) :- String!
        ((self.sx_text(f + 2) + "\t") + (self.sx_text(f + 3) + "\t")) + (((d + "\t") + (self.fd_mod(f) + "\t")) + (fl2 + "\n"))
    ctor_row(f: Int!, d: String!, fl2: String!, di: Int!) :- String!
        ((self.sx_text(f + 2) + "\t") + (self.sx_text(f + 3) + "\t")) + (((d + "\t") + (fl2 + "\t")) + (di.to_string() + "\n"))
    rawf_row(f: Int!) :- String!
        ((self.sx_text(f + 2) + "\t") + (self.sx_text(f + 3) + "\t")) + (self.id_of(f) + "\t\tf41\n")
    id_of(f: Int!) :- String!
        ("(ident " + self.sx_text(f + 2)) + ")"

    # The current merged line `fl`.
    l_n   :- self.f_first(fl)
    l_t   :- self.rf1(fl)
    l_d   :- self.rf2(fl)
    l_mod :- self.rf3(fl)
    l_flg :- self.rf4(fl)
    l_cflg :- self.rf3(fl)
    l_di  :- self.rf4(fl).to_int_or(-1)
    l_bt  :- self.bt3(l_t)
    l_ct  :- self.ctype(l_t)
    m_mod :- "lowering not yet implemented: F13 L1: `" + ((l_mod + " ") + (self.bt3(l_t) + ("` on field `" + l_n)))
    l_moderr :- ||: l_mod == "" : "" ||: self.err_of(l_bt) != "" : self.err_of(l_bt) ||: self.in_set(recset, l_bt) : (m_mod + "` — reference modifiers apply to reference ") + (("types (atoms, `String`); `" + l_bt) + "` is a record (value type, §3.2). Drop the modifier (spec §6.14).") ||: self.has_key(etab, l_bt) : (m_mod + "` — reference modifiers apply to reference ") + (("types (atoms, `String`); `" + l_bt) + "` is an enum (value type, §3.2). Drop the modifier (spec §6.14).") ||: not self.in_set(atset, l_bt) and l_bt != "String" and l_bt != "_Cxc_String" : (m_mod + "` — `") + ((l_bt + "` is not a known reference type ") + "(atom or `String`). Reference modifiers only apply to reference types (spec §6.14).") ||: else : ""
    l_ferr :- ||: l_moderr != "" : l_moderr ||: self.err_of(l_bt) != "" : self.err_of(l_bt) ||: else : self.err_of(l_ct)
    l_cerr :- ||: self.err_of(l_bt) != "" : self.err_of(l_bt) ||: else : self.err_of(l_ct)
    l_vt1 :- not l_ct.ends_with("*") and l_ct != "id" and not l_ct.contains("^")
    l_vt2 :- l_bt != "Block" and l_bt != "String" and l_bt != "Bytes" and l_bt != "Any"
    l_vt3 :- self.prim(l_bt) != "" or self.in_set(recset, l_bt) or self.has_key(etab, l_bt)
    l_bang :- l_t.starts_with("TN(")
    l_opt :- l_vt1 and l_vt2 and l_vt3 and not l_bang
    l_map :- ||: l_t.starts_with("TO:Map(TT(") : ((" (map " + self.map_k(l_t)) + " ") + (self.map_v(l_t) + ")") ||: else : ""
    # The invariant picker.
    l_lo :- self.f_first(self.look(bnd, l_n))
    l_hi :- self.f_rest(self.look(bnd, l_n))
    l_pick :- ||: l_bt != "Int" or l_lo == "" or l_hi == "" : "" ||: else : self.pick(l_lo.to_int_or(0), l_hi.to_int_or(0))
    pick(lo: Int!, hi: Int!) :- String!
        ||: lo > hi : "" ||: lo >= 0 and hi <= 255 : "UInt8" ||: lo >= -128 and hi <= 127 : "Int8" ||: lo >= 0 and hi <= 65535 : "UInt16" ||: lo >= -32768 and hi <= 32767 : "Int16" ||: lo >= 0 and hi <= 4294967295 : "UInt32" ||: lo >= -2147483648 and hi <= 2147483647 : "Int32" ||: else : ""
    l_cty  :- ||: l_pick == "" : l_bt ||: else : l_pick
    l_sc   :- ||: l_pick == "" : l_ct ||: else : self.prim(l_pick)
    l_ctyp :- ||: l_opt : "_Cxc_Optional_" + (||: l_cty == "Int" : "Int64" ||: else : l_cty) ||: else : l_sc
    l_pk   :- ||: l_pick == "" : "" ||: else : ((" (picked " + l_lo) + " ") + (l_hi + ")")
    l_frow :- ((("(f " + l_n) + (" " + l_cty)) + ((||: l_bang : " bang" ||: else : " plain") + (||: l_opt : " opt \"" ||: else : " raw \""))) + (((l_sc + "\" \"") + (l_ctyp + "\" ")) + ((l_d + " ") + (((l_t + l_map) + ((||: l_mod == "" : "" ||: else : " " + l_mod) + l_pk)) + ")")))
    l_crow :- ((("(c " + l_n) + (" " + l_bt)) + ((||: l_bang : " bang \"" ||: else : " plain \"") + (l_ct + "\" "))) + ((l_d + " ") + ((l_t + l_map) + ")"))
    # Bounds from one comparison binop `b`.
    b_ic(n: Int!) :- Bool!
        self.sx_head(n) == "int" or (self.sx_head(n) == "neg" and self.sx_head(n + 2) == "int")
    b_iv(n: Int!) :- Int!
        ||: self.sx_head(n) == "int" : self.sx_text(n + 2).to_int_or(0) ||: else : 0 - self.sx_text(n + 4).to_int_or(0)
    b_cmp(b: Int!) :- Bool!
        self.sx_head(b) == "binop" and (self.sx_text(b + 2) == "<=" or self.sx_text(b + 2) == "<" or self.sx_text(b + 2) == ">=" or self.sx_text(b + 2) == ">")
    b_r(b: Int!) :- Int!
        self.sx_next(b + 3)
    b_one(b: Int!) :- Bool!
        self.b_ic(b + 3) and self.sx_head(self.b_r(b)) == "ident"
    b_two(b: Int!) :- Bool!
        not self.b_one(b) and self.b_ic(self.b_r(b)) and self.sx_head(b + 3) == "ident"
    b_nm(b: Int!) :- String!
        ||: self.b_one(b) : self.sx_text(self.b_r(b) + 2) ||: else : self.sx_text(b + 5)
    b_v(b: Int!) :- Int!
        ||: self.b_one(b) : self.b_iv(b + 3) ||: else : self.b_iv(self.b_r(b))
    # Is the note a low bound, and its value.
    b_lo(b: Int!) :- Bool!
        ||: self.b_one(b) : self.sx_text(b + 2) == "<=" or self.sx_text(b + 2) == "<" ||: else : self.sx_text(b + 2) == ">=" or self.sx_text(b + 2) == ">"
    b_adj(b: Int!) :- Int!
        ||: self.sx_text(b + 2) == "<" and self.b_one(b) : self.b_v(b) + 1 ||: self.sx_text(b + 2) == ">" and self.b_one(b) : self.b_v(b) - 1 ||: self.sx_text(b + 2) == "<" : self.b_v(b) - 1 ||: self.sx_text(b + 2) == ">" : self.b_v(b) + 1 ||: else : self.b_v(b)
    b_new(b: Int!) :- String!
        ||: self.b_lo(b) : (self.b_maxs(self.f_first(self.look(bnd, self.b_nm(b))), self.b_adj(b)) + "\t") + self.f_rest(self.look(bnd, self.b_nm(b))) ||: else : (self.f_first(self.look(bnd, self.b_nm(b))) + "\t") + self.b_mins(self.f_rest(self.look(bnd, self.b_nm(b))), self.b_adj(b))
    b_maxs(c: String!, v: Int!) :- String!
        ||: c == "" : v.to_string() ||: c.to_int_or(0) >= v : c ||: else : v.to_string()
    b_mins(c: String!, v: Int!) :- String!
        ||: c == "" : v.to_string() ||: c.to_int_or(0) <= v : c ||: else : v.to_string()

    # Const shape. `kenv` adds the atom-ctor call and enum-case forms.
    ec_has(e: String!, c: String!) :- Bool!
        self.has_key(ectab, e) and self.look(ectab, e).contains(("," + c) + "=")
    ec_pay(e: String!, c: String!) :- Bool!
        self.look(ectab, e).contains(("," + c) + "=1,")
    k_head :- self.sx_head(kj)
    k_dotc(d: Int!) :- Bool!
        self.sx_head(d) == "dot" and self.sx_head(d + 2) == "ident"
    k_callok :- kenv and ((self.sx_head(kj + 2) == "ident" and self.in_set(atset, self.sx_text(kj + 4))) or (self.k_dotc(kj + 2) and self.ec_has(self.sx_text(kj + 6), self.sx_text(self.sx_next(kj + 4))) and self.ec_pay(self.sx_text(kj + 6), self.sx_text(self.sx_next(kj + 4)))))
    k_dotok :- kenv and self.k_dotc(kj) and self.ec_has(self.sx_text(kj + 4), self.sx_text(self.sx_next(kj + 2))) and not self.ec_pay(self.sx_text(kj + 4), self.sx_text(self.sx_next(kj + 2)))
    k_plain :- self.ok_head(k_head) or k_head == "pos" or k_head == "named"
    k_ok :- self.sx(kj).kind != 0 or k_plain or (k_head == "call" and k_callok) or (k_head == "dot" and k_dotok)
    # Where the scan goes after an accepted node.
    k_next :- ||: self.sx(kj).kind == 0 and k_head == "call" : self.sx_next(kj + 2) ||: self.sx(kj).kind == 0 and k_head == "dot" : self.sx_next(kj) ||: else : kj + 1
    m_kconst(site: String!) :- String!
        ((("default for `" + kfail) + ("` on " + site)) + (" is not a compile-time constant (spec §3.8.5 " + "permits primitive literals, `nil`, unary `-`/`not` on those, a value-alias identifier, or a bare enum-case access `Enum.case`); ")) + (("got `" + kfkw) + "` node")
    m_kafter(site: String!) :- String!
        ((("required param `" + a_arb) + "` follows a defaulted ") + (("param on " + site) + " — spec §3.8.5 requires defaulted params to come last. ")) + ((("Reorder: put all required params (" + a_req) + ") FIRST, then defaulted params (") + (a_def + ")."))
    a_site :- ("def-atom `" + an) + "` ctor-params"
    h_site(m: String!) :- String!
        (("handler `" + an) + ".-> ") + (m + "`")
    req_add(n: String!) :- String!
        ||: a_req == "" : ("`" + n) + "`" ||: else : ((a_req + ", `") + n) + "`"
    def_add(n: String!) :- String!
        ||: a_def == "" : ("`" + n) + "`" ||: else : ((a_def + ", `") + n) + "`"

    # Messages.
    m_wdup(m: String!) :- String!
        ((("atom `" + an) + "` declares two wildcard-source ") + (("arms `* <: " + m) + " ... -> ...` on the same ")) + ("message and at least one arm has no `|:` " + "guard, so the guarded arm can never fire. Add a guard to every wildcard arm on this message, or fold the unguarded arm's body into an `else` guard.")
    m_cdup(k: String!) :- String!
        ((("atom `" + an) + ("` declares " + self.look(sctab, k))) + ((" unguarded arms on `" + k.replace("|", " <: ")) + "`, so arms after the first are dead code. ")) + "Add a `|: <guard>` to all but at most one, or merge the bodies into one arm."
    m_cap(n: String!, t: String!) :- String!
        (("lowering not yet implemented: use: `" + n) + ("` requires an atom type; got `" + t)) + ("` (Layer 3.1 only " + "supports capability atom types in use: for now)")
    m_vec :- ("[" + self.cut(a_err, 1)) + "]"
    m_cdupn :- (("duplicate ctor-param names on def-atom `" + an) + "` (likely collision between use: and explicit ") + ("ctor-params): " + m_vec)
    m_fdupn :- (("duplicate field names on def-atom `" + an) + "` (collision between data:/use:): ") + m_vec
    is_res(x: String!) :- Bool!
        x == "phase" or x == "own_queue" or x == "parent" or x == "parent_slot_name" or x == "cxc_owned_resources"
    m_resv(x: String!) :- String!
        ((("field name `" + x) + ("` on def-atom `" + an)) + ("` collides with a reserved atom-runtime property. " + "Reserved names: cxc_owned_resources, own_queue, parent, parent_slot_name, phase. ")) + ((("Rename the field (e.g. `" + x) + "_v` or a domain-specific name like") + " `stage` for `phase`).")
    m_hdup(m: String!) :- String!
        (("atom `" + an) + ("` declares handler `-> " + m)) + ("(...):` more than once " + "(spec §1265: each handler name unique per atom).")
    m_f8(c: String!) :- String!
        (("lowering not yet implemented: F8 L3a: observable `" + c) + ("` on atom `" + an)) + ("` collides with a data field of the " + "same name. The field would win at `.` dispatch and the observable would be dead code. Rename one or move the derivation to `computed:` under a different name.")
    m_ondup(m: String!) :- String!
        (("atom `" + an) + ("` declares `on_nil:` entry " + "`")) + ((m + "` more than once — each ") + "method name appears at most once per section (spec §4.10.9).")
    m_onunk(m: String!) :- String!
        ((("atom `" + an) + ("` declares `on_nil:` entry for `" + m)) + ("` but the atom has no method " + "or observable by that name. Add the declaration, drop the entry, or fix a typo. ")) + (("(Protocol-inherited entries via `extend " + an) + "(P):` are validated by a follow-on pass; this L8 MVP checks only own-surface names.) See spec §4.10.9.")
    m_onc(m: String!) :- String!
        (("lowering not yet implemented: on_nil entry `" + m) + ("` on atom `" + an)) + (("` — value must be a compile-time constant (spec §3.8.5 permits primitive literals, `nil`, unary `-`/`not` on those); got `" + kfkw) + "` node.")
    m_shape(m: String!, a: String!, b: String!) :- String!
        ((("lowering not yet implemented: def-atom `" + an) + ("` has two transitions on message `" + m)) + (("` with different payload shapes: [" + self.cut(a, 1)) + ("] vs [" + self.cut(b, 1)))) + ("]; cxc source that reads " + "the same must map to the same ObjC selector")
    m_sync(m: String!) :- String!
        ("lowering not yet implemented: sync stream emit `|> " + m) + "` — Layer 4 streams are async-only (design §18 chose Option A: async fan-out)"
    m_spos(m: String!) :- String!
        (("lowering not yet implemented: positional arg on stream emit `:> " + m) + ("` — Layer 4 requires `:> " + m)) + "(key: value)` named form so payload shape matches subscriber receive pattern"
    m_sdup(m: String!, a: String!, b: String!) :- String!
        ((("lowering not yet implemented: def-atom `" + an) + ("` emits stream `" + m)) + (("` twice with different payload shapes: [" + self.cut(a, 1)) + ("] vs [" + self.cut(b, 1)))) + ("]; every emit of a stream must carry the same " + "keys so subscribers can bind a single receive shape")

    # The atom row.
    a_row :- (((("(atom " + an) + (" (fields" + ft_t)) + ((") (ctor-params" + ct_t) + (") (methods" + m_t))) + (((") (observables" + obs_t) + (") (invariants" + inv_t)) + ((") (transitions" + tx_t) + (") (message-index" + mi_t)))) + (((((") (companion-index" + ci_t) + (") (use-caps" + uc_t)) + ((") (stream-index" + si_t) + (") (stream-order" + so_t))) + (((") (subscriptions" + sb_t) + (") (slot-names" + sn_t)) + ((") (on-nil" + on_t) + (") (extras" + ex_t)))) + ((") (class-fns" + cf_t) + (") " + (self.sx_text(self.sx_next(ti + 3)) + ")"))))

    # The tree-shake. names-mentioned-in counts every `:name` that is a
    # prelude atom name. A name sits at the first child of a node whose
    # head is one of these, in a lambda's param list, or after `TR:`
    # inside a type atom.
    nm_h1(h: String!) :- Bool!
        h == "ident" or h == "field" or h == "obs" or h == "obs-sig" or h == "recv-sig"
    nm_h2(h: String!) :- Bool!
        h == "use" or h == "class-fn" or h == "named" or h == "name" or h == "typed"
    nm_h3(h: String!) :- Bool!
        h == "let" or h == "alias" or h == "bind" or h == "case" or h == "agent"
    nm_h4(h: String!) :- Bool!
        h == "record" or h == "enum" or h == "enum-case" or h == "protocol" or h == "module"
    nm_head(h: String!) :- Bool!
        self.nm_h1(h) or self.nm_h2(h) or self.nm_h3(h) or self.nm_h4(h) or h == "type-bound"
    j_par(j: Int!) :- Int!
        self.sx(j).parent
    nm_pos(j: Int!) :- Bool!
        j == self.j_par(j) + 2 and self.nm_head(self.sx_head(self.j_par(j))) and not (self.sx_head(self.j_par(j)) == "named" and self.sx_head(self.j_par(self.j_par(j))) == "as")
    nm_lam(j: Int!) :- Bool!
        self.sx_head(self.j_par(self.j_par(j))) == "lambda" and self.j_par(j) == self.j_par(self.j_par(j)) + 2
    ts_nm(j: Int!) :- String!
        ||: self.sx(j).kind != 1 : "" ||: self.nm_pos(j) or self.nm_lam(j) : self.sx_text(j) ||: else : ""
    ts_new(x: String!) :- Bool!
        x != "" and self.pre_atom(x) and not self.in_set(reached, x)
    ts_top :- tmode == 1 and self.sx(sj).parent == 0
    ts_excl(i: Int!) :- Bool!
        (self.sx_head(i) == "agent" and self.pre_atom(self.sx_text(i + 2))) or self.sx_head(i) == "plugin"
    tr_rest :- self.cut(tcur, tcur.index_of("TR:") + 3)
    tr_end(r: String!) :- Int!
        ||: r.index_of(")") < 0 and r.index_of(",") < 0 : r.length() ||: r.index_of(")") < 0 : r.index_of(",") ||: r.index_of(",") < 0 : r.index_of(")") ||: else : r.index_of(")").min(r.index_of(","))
    tr_nm :- tr_rest.substring(0, self.tr_end(tr_rest).max(0).min(tr_rest.length()))
    ts_keep(x: String!) :- Bool!
        not self.pre_atom(x) or self.in_set(reached, x)

    # Sorting.
    scan_cur :- rows.at(sort_i) ?? ""
    scan_cmp :- scan_cur.compare_to(scan_best)
    s_done   :- sort_i >= rows.count() and not scan_has

    -> reading
        then:
            mode => args.get_or(1, "")
            self :> start

    -> attr
        then: self :> at

    -> mmap
        then: self :> mm

    -> mgroup
        then: self :> mg

    -> shape
        then: self :> sh

    -> proto
        then: self :> pt

    -> edges
        then: self :> e1

    -> enumz
        then: self :> en

    -> aenv
        then: self :> ar

    -> tshake
        then: self :> t0

    -> sorting
        then: self :> scan

    -> done
        then: self :> fin

    -> end
        then: console.write(self.cut(out, 1))

    done <: fin -> end

    reading <: start -> reading
        then:
            let raw: String! = fs.read_text(args.get_or(2, ""))
            src => ||: raw.ends_with("\n") : raw.substring(0, (raw.length() - 1).max(0)) ||: else : raw
            pidx => "\n" + fs.read_text(args.get_or(3, ""))
            rsrc => fs.read_text(args.get_or(4, ""))
            self :> chk

    # An error rendering passes through.
    reading <: chk -> done
        |: src.starts_with("error|")
        then:
            out => "\n" + src

    reading <: chk -> reading
        |: not src.starts_with("error|")
        then: self :> rd

    reading <: rd -> attr
        |: rmode == 0 and r_end
        then:
            nodes => nodes.sort_by(n => n.pre)

    reading <: rd -> reading
        |: rmode == 0 and r_sp
        then:
            rp => rp + 1
            self :> rd

    reading <: rd -> reading
        |: rmode == 0 and r_open
        then:
            rstack => rstack.slice(0, sp).append(SNode(pre: ncount, kind: 0, start: rp, stop: 0, depth: sp, size: 0, parent: r_parent))
            ncount => ncount + 1
            sp => sp + 1
            rp => rp + 1
            self :> rd

    reading <: rd -> reading
        |: rmode == 0 and r_close
        then:
            nodes => nodes.append(SNode(pre: rtop.pre, kind: 0, start: rtop.start, stop: rp + 1, depth: rtop.depth, size: ncount - rtop.pre, parent: rtop.parent))
            sp => (sp - 1).max(0)
            rp => rp + 1
            self :> rd

    reading <: rd -> reading
        |: rmode == 0 and r_quote
        then:
            tstart => rp
            rmode => 2
            rp => rp + 1
            self :> rd

    reading <: rd -> reading
        |: rmode == 0 and r_plain and not r_quote
        then:
            tstart => rp
            rmode => 1
            rnest => 0
            rp => rp + 1
            self :> rd

    # Atom mode.
    reading <: rd -> reading
        |: rmode == 1 and a_stop
        then:
            nodes => nodes.append(SNode(pre: ncount, kind: 1, start: tstart, stop: rp, depth: sp, size: 1, parent: r_parent))
            ncount => ncount + 1
            rmode => 0
            self :> rd

    reading <: rd -> reading
        |: rmode == 1 and not a_stop and r_open
        then:
            rnest => rnest + 1
            rp => rp + 1
            self :> rd

    reading <: rd -> reading
        |: rmode == 1 and not a_stop and r_close
        then:
            rnest => rnest - 1
            rp => rp + 1
            self :> rd

    reading <: rd -> reading
        |: rmode == 1 and not a_stop and not r_open and not r_close
        then:
            rp => rp + 1
            self :> rd

    # String mode.
    reading <: rd -> reading
        |: rmode == 2 and (r_quote or r_end)
        then:
            nodes => nodes.append(SNode(pre: ncount, kind: 2, start: tstart, stop: (rp + 1).min(src.length()), depth: sp, size: 1, parent: r_parent))
            ncount => ncount + 1
            rmode => 0
            rp => rp + 1
            self :> rd

    reading <: rd -> reading
        |: rmode == 2 and not r_end and not r_quote and r_bs
        then:
            rmode => 3
            rp => rp + 1
            self :> rd

    reading <: rd -> reading
        |: rmode == 2 and not r_end and not r_quote and not r_bs
        then:
            rp => rp + 1
            self :> rd

    reading <: rd -> reading
        |: rmode == 3
        then:
            rmode => 2
            rp => (rp + 1).min(src.length())
            self :> rd

    # 1. Attribution. `(module <name>)` sets the module, a record, agent,
    # or enum takes its prelude module or the current one, last wins.
    attr <: at -> attr
        |: ti < nn and hd == "module"
        then:
            cur_mod => tname
            ti => self.sx_next(ti)
            self :> at

    attr <: at -> attr
        |: ti < nn and is_decl
        then:
            anames => ||: self.has_key(atab, tname) : anames ||: else : anames.append(tname)
            atab => self.put_last(atab, tname, self.pmod(tname))
            dmain => ||: cur_mod == "main" : dmain + (tname + "\n") ||: else : dmain
            ti => self.sx_next(ti)
            self :> at

    attr <: at -> attr
        |: ti < nn and hd != "module" and not is_decl
        then:
            ti => self.sx_next(ti)
            self :> at

    attr <: at -> attr
        |: ti >= nn
        then:
            k => 0
            self :> ar

    attr <: ar -> attr
        |: k < anames.count()
        then:
            rows => rows.append(("(decl " + self.nm_at(k)) + ((" " + self.look(atab, self.nm_at(k))) + ")"))
            k => k + 1
            self :> ar

    attr <: ar -> sorting
        |: k >= anames.count()
        then:
            sort_ret => "attr"

    # The module map, `<module> <name>` pairs from the attribution and the
    # prelude index, sorted and distinct, then grouped.
    mmap <: mm -> mmap
        |: k < anames.count()
        then:
            rows => rows.append((self.look(atab, self.nm_at(k)) + " ") + self.nm_at(k))
            k => k + 1
            self :> mm

    mmap <: mm -> mmap
        |: k >= anames.count() and gc < pidx.length()
        then:
            let ln: String! = self.line_at(pidx, gc)
            rows => ||: ln == "" : rows ||: else : rows.append((self.cut(ln, self.bar_at(ln) + 1) + " ") + ln.substring(0, self.bar_at(ln)))
            gc => gc + ln.length() + 1
            self :> mm

    mmap <: mm -> sorting
        |: k >= anames.count() and gc >= pidx.length()
        then:
            sort_ret => "mmap"

    mgroup <: mg -> mgroup
        |: gc < msorted.length()
        then:
            let ln: String! = self.line_at(msorted, gc)
            let m: String! = ln.substring(0, self.sp_at(ln))
            let n: String! = self.cut(ln, self.sp_at(ln) + 1)
            mtxt => ||: m == cm or cm == "" : mtxt ||: else : (mtxt + "\n") + (mrow + ")")
            nmod => ||: m == cm : nmod ||: else : nmod + 1
            mrow => ||: m == cm : (mrow + " ") + n ||: else : (("(module " + m) + " ") + n
            cm => m
            gc => gc + ln.length() + 1
            self :> mg

    mgroup <: mg -> shape
        |: gc >= msorted.length()
        then:
            out => (out + (("\n(module-map " + nmod.to_string()) + ")")) + (mtxt + (||: cm == "" : "" ||: else : ("\n" + mrow) + ")"))
            ti => 2

    # 2. The runtime_shape scan. Per plugin, the first `runtime_shape`
    # field whose default is `RuntimeShape.<case>` and the first `name`
    # field with a string default.
    shape <: sh -> shape
        |: ti < nn and hd == "plugin"
        then:
            fq => ti + 4
            fend => self.sx_end(ti + 2)
            p_shape => ""
            p_name => ""
            p_has_name => false
            self :> sf

    shape <: sh -> shape
        |: ti < nn and hd != "plugin"
        then:
            has_main => has_main or (hd == "agent" and tname == "main")
            ti => self.sx_next(ti)
            self :> sh

    shape <: sf -> shape
        |: fq < fend
        then:
            let fnm: String! = self.sx_text(fq + 2)
            let nm_hit: Bool! = not p_has_name and fnm == "name" and self.sx_head(fq + 4) == "string"
            p_shape => ||: p_shape == "" and fnm == "runtime_shape" and self.is_rs(fq + 4) : self.sx_text(fq + 9).replace("_", "-") ||: else : p_shape
            p_name => ||: nm_hit : self.sx_text(fq + 6) ||: else : p_name
            p_has_name => p_has_name or nm_hit
            fq => self.sx_next(fq)
            self :> sf

    shape <: sf -> shape
        |: fq >= fend
        then:
            sh_rows => ||: p_shape == "" : sh_rows ||: else : sh_rows + (("\n(plugin-shape " + p_nm_out) + ((" " + p_shape) + ")"))
            sh_n => ||: p_shape == "" : sh_n ||: else : sh_n + 1
            nd_items => ||: not p_nd : nd_items ||: nd_items == "" : nd_item ||: else : (nd_items + ", ") + nd_item
            nd_first => ||: nd_first == "" and p_nd : p_shape ||: else : nd_first
            nd_conf => nd_conf or (nd_first != "" and p_nd and p_shape != nd_first)
            ti => self.sx_next(ti)
            self :> sh

    shape <: sh -> done
        |: ti >= nn and nd_conf
        then:
            out => out + ("\nerror|" + m_conflict)

    shape <: sh -> done
        |: ti >= nn and not nd_conf and mode == "lower" and not has_main
        then:
            out => (out + shape_txt) + "\nerror|no `def main` entry point found at top level"

    shape <: sh -> proto
        |: ti >= nn and not nd_conf and (mode != "lower" or has_main)
        then:
            out => out + shape_txt
            ti => 2

    # 3. build-protocol-env. Accepts first, the duplicate check, then one
    # default per observable with its two validators.
    proto <: pt -> proto
        |: ti < nn and hd == "protocol"
        then:
            pnm => tname
            ii => ti + 3
            iend => self.sx_end(ti)
            acc_txt => ""
            an_txt => "\n"
            rtab => "\n"
            dflt_txt => ""
            dk => 1
            pdup => ""
            self :> pa

    proto <: pt -> proto
        |: ti < nn and hd != "protocol"
        then:
            ti => self.sx_next(ti)
            self :> pt

    proto <: pt -> proto
        |: ti >= nn
        then:
            k => 0
            self :> pr

    proto <: pr -> proto
        |: k < pnames.count()
        then:
            rows => rows.append(self.look(ptab, self.pn_at(k)))
            k => k + 1
            self :> pr

    proto <: pr -> sorting
        |: k >= pnames.count()
        then:
            sort_ret => "proto"

    proto <: pa -> proto
        |: ii < iend and (ihd == "obs-sig" or ihd == "recv-sig")
        then:
            let n: String! = self.sx_text(ii + 2)
            let r: String! = ||: ihd == "obs-sig" : self.sx_text(self.sx_next(ii + 3)) ||: else : "nil"
            acc_txt => acc_txt + ((" (accept " + n) + ((" " + self.sx_text(ii + 3)) + ((" " + r) + ")")))
            an_txt => an_txt + (n + "\n")
            rtab => self.put_last(rtab, n, r)
            ii => self.sx_next(ii)
            self :> pa

    proto <: pa -> proto
        |: ii < iend and ihd != "obs-sig" and ihd != "recv-sig"
        then:
            ii => self.sx_next(ii)
            self :> pa

    proto <: pa -> proto
        |: ii >= iend
        then: self :> pd

    proto <: pd -> proto
        |: dk < an_txt.length() and pdup == ""
        then:
            let ln: String! = self.line_at(an_txt, dk)
            pdup => ||: self.twice(ln) : ln ||: else : ""
            dk => dk + ln.length() + 1
            self :> pd

    proto <: pd -> done
        |: pdup != ""
        then:
            out => out + ("\nerror|" + m_dup)

    proto <: pd -> proto
        |: dk >= an_txt.length() and pdup == ""
        then:
            ii => ti + 3
            self :> po

    proto <: po -> proto
        |: ii < iend and ihd == "obs"
        then:
            qi => ii + 5
            qend => self.sx_end(ii + 3)
            q_seen => false
            ar_bad => ""
            req_l => ""
            def_l => ""
            nc_name => ""
            nc_kw => ""
            prows => ""
            self :> pq

    proto <: po -> proto
        |: ii < iend and ihd != "obs"
        then:
            ii => self.sx_next(ii)
            self :> po

    proto <: po -> proto
        |: ii >= iend
        then:
            let row: String! = ((("(protocol " + pnm) + " (accepts") + (acc_txt + ") (conforms) (defaults")) + (dflt_txt + "))")
            pnames => ||: self.has_key(ptab, pnm) : pnames ||: else : pnames.append(pnm)
            ptab => self.put_last(ptab, pnm, row)
            ti => self.sx_next(ti)
            self :> pt

    # One param. The bookkeeping, then the const check when it is due.
    proto <: pq -> proto
        |: qi < qend
        then:
            let qn: String! = self.q_name(qi)
            let hd2: Bool! = self.q_hasd(qi)
            ar_bad => ||: ar_bad == "" and q_seen and not hd2 : qn ||: else : ar_bad
            q_seen => q_seen or hd2
            req_l => ||: hd2 : req_l ||: req_l == "" : ("`" + qn) + "`" ||: else : ((req_l + ", `") + qn) + "`"
            def_l => ||: not hd2 : def_l ||: def_l == "" : ("`" + qn) + "`" ||: else : ((def_l + ", `") + qn) + "`"
            prows => prows + (" " + self.prow(qi))
            self :> pk

    proto <: pk -> proto
        |: self.needs_c(qi)
        then:
            cj => qi + 4
            cjend => self.sx_end(qi + 4)
            cbad => false
            self :> pc

    proto <: pk -> proto
        |: not self.needs_c(qi)
        then:
            qi => self.sx_next(qi)
            self :> pq

    proto <: pc -> proto
        |: cj < cjend and not cbad
        then:
            cbad => self.sx(cj).kind == 0 and not self.ok_head(self.sx_head(cj))
            cj => cj + 1
            self :> pc

    proto <: pc -> proto
        |: cj >= cjend or cbad
        then:
            nc_name => ||: cbad : self.q_name(qi) ||: else : ""
            nc_kw => ||: cbad : self.kw(qi + 4) ||: else : ""
            qi => self.sx_next(qi)
            self :> pq

    proto <: pq -> done
        |: qi >= qend and ar_bad != ""
        then:
            out => out + ("\nerror|" + m_after)

    proto <: pq -> done
        |: qi >= qend and ar_bad == "" and nc_name != ""
        then:
            out => out + ("\nerror|" + m_const)

    proto <: pq -> done
        |: qi >= qend and ar_bad == "" and nc_name == "" and self.bt_msg(o_retty) != ""
        then:
            out => out + ("\nerror|" + self.bt_msg(o_retty))

    proto <: pq -> proto
        |: qi >= qend and ar_bad == "" and nc_name == "" and self.bt_msg(o_retty) == ""
        then:
            dflt_txt => dflt_txt + (" " + d_row)
            ii => self.sx_next(ii)
            self :> po

    # sync-send-edges. The non-main atom names, then per atom one pass for
    # its ctor params, first data section, and first use section, and one
    # pass over its body for sync sends to an ident.
    edges <: e1 -> edges
        |: ti < nn
        then:
            anm => ||: is_atom : anm + (tname + "\n") ||: else : anm
            ti => self.sx_next(ti)
            self :> e1

    edges <: e1 -> edges
        |: ti >= nn
        then:
            ti => 2
            self :> e2

    edges <: e2 -> edges
        |: ti < nn and is_atom
        then:
            ej => ti + 1
            ejend => self.sx_end(ti)
            bstart => self.sx_next(self.sx_next(ti + 3))
            epass => 1
            fdata => -1
            fuses => -1
            ctab => "\n"
            dtab => "\n"
            utab => "\n"
            self :> ew

    edges <: e2 -> edges
        |: ti < nn and not is_atom
        then:
            ti => self.sx_next(ti)
            self :> e2

    edges <: e2 -> sorting
        |: ti >= nn
        then:
            sort_ret => "edges"

    edges <: ew -> edges
        |: ej < ejend and epass == 1
        then:
            let fld: Bool! = e_h == "field"
            fdata => ||: fdata < 0 and e_h == "data" and e_par == ti : ej ||: else : fdata
            fuses => ||: fuses < 0 and e_h == "uses" and e_par == ti : ej ||: else : fuses
            ctab => ||: fld and e_par == ti + 3 : self.put_first(ctab, self.sx_text(ej + 2), self.sx_text(ej + 3)) ||: else : ctab
            dtab => ||: fld and e_par == fdata and fdata >= 0 : self.put_first(dtab, self.sx_text(ej + 2), self.sx_text(ej + 3)) ||: else : dtab
            utab => ||: e_h == "use" and e_par == fuses and fuses >= 0 : self.put_first(utab, self.sx_text(ej + 2), self.sx_text(ej + 3)) ||: else : utab
            ej => ej + 1
            self :> ew

    edges <: ew -> edges
        |: ej >= ejend and epass == 1
        then:
            epass => 2
            ej => bstart
            self :> ew

    edges <: ew -> done
        |: ej < ejend and e_emit and e_err != ""
        then:
            out => out + ("\nerror|" + e_err)

    edges <: ew -> edges
        |: ej < ejend and epass == 2 and not (e_emit and e_err != "")
        then:
            rows => ||: e_emit and e_hit : rows.append(("(edge " + tname) + ((" " + e_bt) + ((" " + e_msg) + ")"))) ||: else : rows
            ej => ej + 1
            self :> ew

    edges <: ew -> edges
        |: ej >= ejend and epass == 2
        then:
            ti => self.sx_next(ti)
            self :> e2

    # build-enum-env. Per enum, the cases in order, then the two indices
    # sorted by case name, last wins.
    enumz <: en -> enumz
        |: e_pending
        then:
            gc => 1
            ci_txt => ""
            pi_txt => ""
            ec_v => ","
            self :> eg

    enumz <: en -> enumz
        |: not e_pending and ti < nn and hd == "enum"
        then:
            enm => tname
            ert => self.sx_text(ti + 3)
            ci => ti + 4
            cend => self.sx_end(ti)
            cidx => 0
            cases_t => ""
            ents_t => ""
            raw_t => ""
            tagged => false
            ctab2 => "\n"
            cnames => cnames.slice(0, 0)
            self :> ec

    enumz <: en -> enumz
        |: not e_pending and ti < nn and hd != "enum"
        then:
            ti => self.sx_next(ti)
            self :> en

    enumz <: en -> enumz
        |: not e_pending and ti >= nn
        then:
            k => 0
            self :> er

    enumz <: ec -> enumz
        |: ci < cend
        then:
            let cn: String! = self.sx_text(ci + 2)
            cases_t => cases_t + (" " + cn)
            ents_t => ents_t + (" " + self.sx_text(ci))
            raw_t => ||: c_raw : raw_t + (" " + self.sx_text(self.sx_next(ci + 3))) ||: else : raw_t
            tagged => tagged or self.sx(ci + 3).size > 2
            cnames => ||: self.has_key(ctab2, cn) : cnames ||: else : cnames.append(cn)
            ctab2 => self.put_last(ctab2, cn, (cidx.to_string() + "\t") + self.sx_text(ci + 3))
            cidx => cidx + 1
            ci => self.sx_next(ci)
            self :> ec

    enumz <: ec -> enumz
        |: ci >= cend
        then:
            k => 0
            self :> eb

    enumz <: eb -> enumz
        |: k < cnames.count()
        then:
            rows => rows.append((self.cn_at(k) + "\t") + self.look(ctab2, self.cn_at(k)))
            k => k + 1
            self :> eb

    enumz <: eb -> sorting
        |: k >= cnames.count()
        then:
            sort_ret => "case"
            e_pending => true

    enumz <: eg -> enumz
        |: gc < csorted.length()
        then:
            let ln: String! = self.line_at(csorted, gc)
            ci_txt => ci_txt + ((" (" + self.f_first(ln)) + ((" " + self.f_first(self.f_rest(ln))) + ")"))
            pi_txt => pi_txt + ((" (" + self.f_first(ln)) + ((" " + self.f_rest(self.f_rest(ln))) + ")"))
            ec_v => ec_v + ((self.f_first(ln) + "=") + ((||: self.f_rest(self.f_rest(ln)) == "(params)" : "0" ||: else : "1") + ","))
            gc => gc + ln.length() + 1
            self :> eg

    enumz <: eg -> enumz
        |: gc >= csorted.length()
        then:
            enames => ||: self.has_key(etab, enm) : enames ||: else : enames.append(enm)
            etab => self.put_last(etab, enm, e_row)
            ectab => self.put_last(ectab, enm, ec_v)
            e_pending => false
            ti => self.sx_next(ti)
            self :> en

    enumz <: er -> enumz
        |: k < enames.count()
        then:
            rows => rows.append(self.look(etab, self.en_at(k)))
            k => k + 1
            self :> er

    enumz <: er -> sorting
        |: k >= enames.count()
        then:
            sort_ret => "enum"

    # Selection sort over `rows` into `sorted`, distinct, then back to the
    # phase named by `sort_ret`.
    sorting <: scan -> sorting
        |: sort_i < rows.count() and not scan_has
        then:
            scan_best => scan_cur
            scan_has => true
            sort_i => sort_i + 1
            self :> scan

    sorting <: scan -> sorting
        |: sort_i < rows.count() and scan_has and scan_cmp < 0
        then:
            scan_best => scan_cur
            sort_i => sort_i + 1
            self :> scan

    sorting <: scan -> sorting
        |: sort_i < rows.count() and scan_has and scan_cmp >= 0
        then:
            sort_i => sort_i + 1
            self :> scan

    sorting <: scan -> sorting
        |: sort_i >= rows.count() and scan_has
        then:
            sorted => sorted + ("\n" + scan_best)
            nsorted => nsorted + 1
            rows => rows.filter(e => e != scan_best)
            sort_i => 0
            scan_has => false
            scan_best => ""
            self :> scan

    sorting <: scan -> mmap
        |: s_done and sort_ret == "attr"
        then:
            out => out + ((("\n(attribution " + nsorted.to_string()) + ")") + sorted)
            sorted => ""
            nsorted => 0
            k => 0
            gc => 1

    sorting <: scan -> mgroup
        |: s_done and sort_ret == "mmap"
        then:
            msorted => sorted
            sorted => ""
            nsorted => 0
            gc => 1

    sorting <: scan -> edges
        |: s_done and sort_ret == "proto"
        then:
            out => out + ((("\n(protocol-env " + nsorted.to_string()) + ")") + sorted)
            sorted => ""
            nsorted => 0
            ti => 2

    sorting <: scan -> enumz
        |: s_done and sort_ret == "edges"
        then:
            out => out + ((("\n(sync-edges " + nsorted.to_string()) + ")") + sorted)
            sorted => ""
            nsorted => 0
            ti => 2

    sorting <: scan -> enumz
        |: s_done and sort_ret == "case"
        then:
            csorted => sorted
            sorted => ""
            nsorted => 0

    sorting <: scan -> aenv
        |: s_done and sort_ret == "enum"
        then:
            out => out + ((("\n(enum-env " + nsorted.to_string()) + ")") + sorted)
            sorted => ""
            nsorted => 0

    sorting <: scan -> aenv
        |: s_done and sort_ret == "atag"
        then:
            asorted => sorted
            sorted => ""
            nsorted => 0
            a_resume => "atom"

    sorting <: scan -> tshake
        |: s_done and sort_ret == "atoms"
        then:
            out => out + ((("\n(atom-env " + nsorted.to_string()) + ")") + sorted)
            sorted => ""
            nsorted => 0

    sorting <: scan -> done
        |: s_done and sort_ret == "shake"
        then:
            out => out + ((("\n(tree-shake " + nsorted.to_string()) + ")") + sorted)

    # build-atom-env (chapter 34). The refs rows first, then the
    # include-main? scan, then one pass per atom in stream order.
    aenv <: ar -> aenv
        |: a_resume == "prep" and rgc < rsrc.length()
        then:
            let ln: String! = self.line_at(rsrc, rgc)
            let rest: String! = self.cut(ln, 10)
            rp_k => ||: ln.starts_with("(piece ") : ln.substring(7, (ln.length() - 8).max(0)) ||: else : rp_k
            reftab => ||: ln.starts_with("(ref type ") : self.put_last(reftab, (rp_k + ":") + rest.substring(0, self.sp_at(rest)), self.cut(rest, self.sp_at(rest) + 1).substring(0, (rest.length() - self.sp_at(rest) - 2).max(0))) ||: else : reftab
            rgc => rgc + ln.length() + 1
            self :> ar

    aenv <: ar -> aenv
        |: a_resume == "prep" and rgc >= rsrc.length()
        then:
            ti => 2
            self :> p0

    aenv <: ar -> aenv
        |: a_resume == "atom"
        then:
            gc => 1
            mi_t => ""
            ci_t => ""
            si_t => ""
            sb_t => ""
            on_t => ""
            self :> asm

    aenv <: p0 -> aenv
        |: ti < nn and hd == "agent"
        then:
            atset => atset + (tname + "\n")
            oth_any => oth_any or (tname != "main" and not self.pre_atom(tname))
            othset => ||: tname != "main" and not self.pre_atom(tname) : othset + (tname + "\n") ||: else : othset
            main_i => ||: main_i < 0 and tname == "main" : ti ||: else : main_i
            ti => self.sx_next(ti)
            self :> p0

    aenv <: p0 -> aenv
        |: ti < nn and hd != "agent"
        then:
            recset => ||: hd == "record" : recset + (tname + "\n") ||: else : recset
            ti => self.sx_next(ti)
            self :> p0

    aenv <: p0 -> aenv
        |: ti >= nn
        then:
            mj => ||: main_i < 0 : 0 ||: else : main_i + 1
            mjend => ||: main_i < 0 : 0 ||: else : self.sx_end(main_i)
            self :> p1

    aenv <: p1 -> aenv
        |: mj < mjend
        then:
            m_flag => m_flag or mj_hit
            mj => mj + 1
            self :> p1

    aenv <: p1 -> tshake
        |: mj >= mjend and not oth_any and not m_flag
        then:
            out => out + "\n(atom-env 0)"

    aenv <: p1 -> aenv
        |: mj >= mjend and (oth_any or m_flag)
        then:
            ti => 2
            pc_cur => 0
            self :> a0

    # One atom. Reset, then scan its items.
    aenv <: a0 -> aenv
        |: ti < nn and hd == "piece"
        then:
            pc_cur => pc_cur + 1
            ti => self.sx_next(ti)
            self :> a0

    aenv <: a0 -> aenv
        |: ti < nn and hd != "piece" and hd != "agent"
        then:
            ti => self.sx_next(ti)
            self :> a0

    aenv <: a0 -> aenv
        |: ti < nn and hd == "agent"
        then:
            an => tname
            a_main => tname == "main"
            ii => self.sx_next(self.sx_next(ti + 3))
            iend => self.sx_end(ti)
            dsec => -1
            usec => -1
            onil => -1
            obs_t => ""
            obs_set => "\n"
            inv_t => ""
            cf_t => ""
            ex_t => ""
            props => props.slice(0, 0)
            txl => txl.slice(0, 0)
            swl => swl.slice(0, 0)
            mpn => mpn.slice(0, 0)
            mptab => "\n"
            cov => "\n"
            self :> a1

    aenv <: a0 -> aenv
        |: ti >= nn
        then:
            k => 0
            self :> az

    aenv <: az -> aenv
        |: k < aenames.count()
        then:
            rows => rows.append(self.look(aetab, aenames.at(k) ?? ""))
            k => k + 1
            self :> az

    aenv <: az -> sorting
        |: k >= aenames.count()
        then:
            sort_ret => "atoms"

    aenv <: a1 -> aenv
        |: ii < iend and ihd == "transition"
        then:
            bi => self.t_body(ii)
            bend => self.sx_end(ii)
            b_g => false
            b_u => false
            b_bare => false
            b_rs => ""
            b_blk => ""
            self :> ab

    aenv <: a1 -> aenv
        |: ii < iend and ihd != "transition"
        then:
            dsec => ||: dsec < 0 and ihd == "data" : ii ||: else : dsec
            usec => ||: usec < 0 and ihd == "uses" : ii ||: else : usec
            onil => ||: onil < 0 and ihd == "on-nil" : ii ||: else : onil
            obs_t => ||: ihd == "obs" : obs_t + (" " + self.sx_text(ii + 2)) ||: else : obs_t
            obs_set => ||: ihd == "obs" : obs_set + (self.sx_text(ii + 2) + "\n") ||: else : obs_set
            inv_t => ||: ihd == "prop" : inv_t + (" " + self.sx_text(ii)) ||: else : inv_t
            props => ||: ihd == "prop" : props.append((ii + 2).to_string()) ||: else : props
            cf_t => ||: ihd == "class-fn" : cf_t + (" " + self.sx_text(ii)) ||: else : cf_t
            ex_t => ||: self.is_extra(ihd) : ex_t + (" " + self.sx_text(ii)) ||: else : ex_t
            ii => self.sx_next(ii)
            self :> a1

    aenv <: a1 -> aenv
        |: ii >= iend
        then:
            k => 0
            mk => 0
            self :> a2

    # The body items of transition `ii`.
    aenv <: ab -> aenv
        |: bi < bend
        then:
            let h: String! = self.sx_head(bi)
            b_g => b_g or h == "prop"
            b_u => b_u or (h == "then" and self.sx(bi + 2).size > 2)
            b_bare => b_bare or (h == "prop" and not self.has_as(bi))
            b_rs => ||: h == "prop" and self.as_typed(bi) and not b_rs.contains(self.as_tok(bi)) : b_rs + self.as_tok(bi) ||: else : b_rs
            b_blk => ||: h == "then" : b_blk + self.stmts_in(bi) ||: else : b_blk
            bi => self.sx_next(bi)
            self :> ab

    aenv <: ab -> aenv
        |: bi >= bend
        then:
            let m: Int! = self.t_m(ii)
            let kd: String! = self.t_kind(ii)
            p_typed => kd == "typed"
            pj => ||: kd == "typed" : m + 3 ||: kd == "ident" or kd == "dot" or kd == "other" : self.sx_next(m + 2) ||: else : 0
            pjend => ||: kd == "typed" or kd == "ident" or kd == "dot" or kd == "other" : self.sx_end(m) ||: else : 0
            p_pr => ""
            p_sig => ""
            p_syn => ""
            p_par => ""
            self :> ac

    # The payload fields of transition `ii`.
    aenv <: ac -> aenv
        |: pj < pjend
        then:
            p_pr => p_pr + self.pl_pr(pj)
            p_sig => ||: p_sig.starts_with("!err:") : p_sig ||: self.err_of(self.btn(self.pf_t(pj))) != "" : "!err:" + self.err_of(self.btn(self.pf_t(pj))) ||: else : p_sig + self.sig_item(pj)
            p_syn => p_syn + self.syn_item(pj)
            p_par => ||: p_typed : p_par + (" " + self.prow(pj)) ||: else : p_par
            pj => self.sx_next(pj)
            self :> ac

    aenv <: ac -> aenv
        |: pj >= pjend
        then:
            let swallow: Bool! = self.t_kind(ii) == "star"
            let idm: Bool! = t_idmsg and not self.has_key(mptab, self.t_name(ii))
            txl => ||: swallow : txl ||: else : txl.append(t_ref)
            swl => ||: swallow : swl.append(ii.to_string()) ||: else : swl
            mpn => ||: idm : mpn.append(self.t_name(ii)) ||: else : mpn
            mptab => ||: idm : self.put_last(mptab, self.t_name(ii), (self.rf7(t_ref) + "\t") + ((self.rf5(t_ref) + "\t") + self.rf6(t_ref))) ||: else : mptab
            cov => ||: t_idmsg and self.t_srck(ii) == "phase" : cov + ((self.t_phase(ii) + "|") + (self.t_name(ii) + "\n")) ||: else : cov
            ii => self.sx_next(ii)
            self :> a1

    # expand-phase-swallow-arms. One arm per swallow arm and message not
    # covered in that phase.
    aenv <: a2 -> aenv
        |: k < swl.count() and mk < mpn.count()
        then:
            let sw: Int! = self.sw_at(k)
            let m: String! = mpn.at(mk) ?? ""
            txl => ||: cov.contains((("\n" + self.t_phase(sw)) + "|") + (m + "\n")) : txl ||: else : txl.append(self.syn_ref(sw, m))
            mk => mk + 1
            self :> a2

    aenv <: a2 -> aenv
        |: k < swl.count() and mk >= mpn.count()
        then:
            k => k + 1
            mk => 0
            self :> a2

    aenv <: a2 -> aenv
        |: k >= swl.count()
        then:
            k => 0
            s1 => "\n"
            s2 => "\n"
            s3 => "\n"
            skeys => "\n"
            self :> a3

    # The wildcard-source duplicate check.
    aenv <: a3 -> aenv
        |: k < txl.count()
        then:
            let r: String! = self.txl_at(k)
            let on: Bool! = self.r_srck(r) == "wildcard" and self.r_name(r) != ""
            let x: String! = self.r_name(r)
            skeys => ||: on : self.sk_add(x) ||: else : skeys
            s2 => ||: on : self.s2_add(x) ||: else : s2
            s1 => ||: on and not self.in_set(s1, x) : (s1 + x) + "\n" ||: else : s1
            s3 => ||: on and not self.r_guard(r) and not self.in_set(s3, x) : (s3 + x) + "\n" ||: else : s3
            k => k + 1
            self :> a3

    aenv <: a3 -> aenv
        |: k >= txl.count()
        then:
            gc => 1
            a_err => ""
            self :> a3b

    aenv <: a3b -> aenv
        |: gc < skeys.length() and a_err == ""
        then:
            let x: String! = self.line_at(skeys, gc)
            a_err => ||: self.in_set(s2, x) and self.in_set(s3, x) : x ||: else : ""
            gc => gc + x.length() + 1
            self :> a3b

    aenv <: a3b -> done
        |: a_err != ""
        then:
            out => out + ("\nerror|" + self.m_wdup(a_err))

    aenv <: a3b -> aenv
        |: gc >= skeys.length() and a_err == ""
        then:
            k => 0
            skeys => "\n"
            sctab => "\n"
            self :> a4

    # The concrete-source duplicate check, unguarded arms per phase and
    # message.
    aenv <: a4 -> aenv
        |: k < txl.count()
        then:
            let r: String! = self.txl_at(k)
            let on: Bool! = self.r_srck(r) == "phase" and self.r_phase(r) != "" and self.r_name(r) != ""
            let x: String! = (self.r_phase(r) + "|") + self.r_name(r)
            skeys => ||: on and not self.has_key(sctab, x) : (skeys + x) + "\n" ||: else : skeys
            sctab => ||: on : self.put_last(sctab, x, (self.look(sctab, x).to_int_or(0) + (||: self.r_guard(r) : 0 ||: else : 1)).to_string()) ||: else : sctab
            k => k + 1
            self :> a4

    aenv <: a4 -> aenv
        |: k >= txl.count()
        then:
            gc => 1
            a_err => ""
            self :> a4b

    aenv <: a4b -> aenv
        |: gc < skeys.length() and a_err == ""
        then:
            let x: String! = self.line_at(skeys, gc)
            a_err => ||: self.look(sctab, x).to_int_or(0) > 1 : x ||: else : ""
            gc => gc + x.length() + 1
            self :> a4b

    aenv <: a4b -> done
        |: a_err != ""
        then:
            out => out + ("\nerror|" + self.m_cdup(a_err))

    aenv <: a4b -> aenv
        |: gc >= skeys.length() and a_err == ""
        then:
            k => 0
            cmn => "\n"
            s1 => "\n"
            s2 => "\n"
            s3 => "\n"
            self :> a5

    # The handler split. Concrete message names, then handler-shape names
    # seen twice with every arm guarded.
    aenv <: a5 -> aenv
        |: k < txl.count()
        then:
            let r: String! = self.txl_at(k)
            let x: String! = self.r_name(r)
            let hs: Bool! = self.r_hand(r)
            cmn => ||: self.r_glyph(r) == "<:" and self.r_srck(r) == "phase" and self.r_ident(r) : (cmn + x) + "\n" ||: else : cmn
            s2 => ||: hs and self.in_set(s1, x) : (s2 + x) + "\n" ||: else : s2
            s1 => ||: hs : (s1 + x) + "\n" ||: else : s1
            s3 => ||: hs and not self.r_guard(r) : (s3 + x) + "\n" ||: else : s3
            k => k + 1
            self :> a5

    aenv <: a5 -> aenv
        |: k >= txl.count()
        then:
            k => 0
            tl => tl.slice(0, 0)
            hl => hl.slice(0, 0)
            tx_t => ""
            self :> a5b

    aenv <: a5b -> aenv
        |: k < txl.count()
        then:
            let r: String! = self.txl_at(k)
            let x: String! = self.r_name(r)
            let ov: Bool! = self.in_set(cmn, x) or (self.in_set(s2, x) and not self.in_set(s3, x))
            tl => ||: self.r_hand(r) and not ov : tl ||: else : tl.append(r)
            hl => ||: self.r_hand(r) and not ov : hl.append(r) ||: else : hl
            tx_t => ||: self.r_hand(r) and not ov : tx_t ||: else : tx_t + (" " + self.r_text(r))
            k => k + 1
            self :> a5b

    aenv <: a5b -> aenv
        |: k >= txl.count()
        then:
            ej => ||: usec < 0 : 0 ||: else : usec + 2
            ejend => ||: usec < 0 : 0 ||: else : self.sx_end(usec)
            uc_t => ""
            self :> a6

    # The use: cap atom-type check.
    aenv <: a6 -> done
        |: ej < ejend and (self.err_of(self.bt3(self.sx_text(ej + 3))) != "" or not (self.in_set(atset, self.bt3(self.sx_text(ej + 3))) or self.bt3(self.sx_text(ej + 3)) == "SystemPanic"))
        then:
            out => out + ("\nerror|" + (||: self.err_of(self.bt3(self.sx_text(ej + 3))) != "" : self.err_of(self.bt3(self.sx_text(ej + 3))) ||: else : self.m_cap(self.sx_text(ej + 2), self.bt3(self.sx_text(ej + 3)))))

    aenv <: a6 -> aenv
        |: ej < ejend and self.err_of(self.bt3(self.sx_text(ej + 3))) == "" and (self.in_set(atset, self.bt3(self.sx_text(ej + 3))) or self.bt3(self.sx_text(ej + 3)) == "SystemPanic")
        then:
            uc_t => uc_t + ((" (" + self.sx_text(ej + 2)) + ((" " + self.bt3(self.sx_text(ej + 3))) + ")"))
            ej => self.sx_next(ej)
            self :> a6

    aenv <: a6 -> aenv
        |: ej >= ejend
        then:
            ej => ||: dsec < 0 : 0 ||: else : dsec + 2
            ejend => ||: dsec < 0 : 0 ||: else : self.sx_end(dsec)
            efn => "\n"
            mc_own => ""
            mc_f41 => ""
            mc_cap => ""
            mf_f41 => ""
            mf_raw => ""
            mf_cap => ""
            self :> a7

    # The F41 transform over the data section.
    aenv <: a7 -> aenv
        |: ej < ejend
        then:
            efn => efn + (self.sx_text(ej + 2) + "\n")
            mf_f41 => ||: self.f41_elig(ej) or self.f41_lit(ej) : mf_f41 + self.fld_row(ej, self.id_of(ej), "f41") ||: else : mf_f41 + self.fld_row(ej, self.sx_text(ej + 4), "own")
            mc_f41 => ||: self.f41_elig(ej) : mc_f41 + self.ctor_row(ej, "nil", "f41", -1) ||: self.f41_lit(ej) : mc_f41 + self.ctor_row(ej, self.sx_text(ej + 4), "f41", -1) ||: else : mc_f41
            ej => self.sx_next(ej)
            self :> a7

    aenv <: a7 -> aenv
        |: ej >= ejend
        then:
            ej => ti + 5
            ejend => self.sx_end(ti + 3)
            self :> a7b

    # The ctor params, mirrored to fields unless a field or an observable
    # has the name.
    aenv <: a7b -> aenv
        |: ej < ejend
        then:
            mc_own => mc_own + self.ctor_row(ej, self.sx_text(ej + 4), "own", ej + 4)
            mf_raw => ||: not a_main and not self.in_set(efn, self.sx_text(ej + 2)) and not self.in_set(obs_set, self.sx_text(ej + 2)) : mf_raw + self.rawf_row(ej) ||: else : mf_raw
            ej => self.sx_next(ej)
            self :> a7b

    aenv <: a7b -> aenv
        |: ej >= ejend
        then:
            ej => ||: usec < 0 : 0 ||: else : usec + 2
            ejend => ||: usec < 0 : 0 ||: else : self.sx_end(usec)
            self :> a7c

    aenv <: a7c -> aenv
        |: ej < ejend
        then:
            mc_cap => mc_cap + self.ctor_row(ej, "nil", "cap", -1)
            mf_cap => mf_cap + ((((self.sx_text(ej + 2) + "\t") + (self.sx_text(ej + 3) + "\t")) + (self.id_of(ej) + "\t\tcap\n")))
            ej => self.sx_next(ej)
            self :> a7c

    aenv <: a7c -> aenv
        |: ej >= ejend
        then:
            mc_t => (mc_own + mc_f41) + mc_cap
            mf_t => (mf_f41 + mf_raw) + mf_cap
            gc => 0
            s1 => "\n"
            s2 => "\n"
            skeys => "\n"
            self :> a8

    # Duplicate ctor-param names, then duplicate field names, then the
    # reserved runtime property names.
    aenv <: a8 -> aenv
        |: gc < mc_t.length()
        then:
            let x: String! = self.f_first(self.line_at(mc_t, gc))
            skeys => self.sk_add(x)
            s2 => self.s2_add(x)
            s1 => ||: self.in_set(s1, x) : s1 ||: else : (s1 + x) + "\n"
            gc => gc + self.line_at(mc_t, gc).length() + 1
            self :> a8

    aenv <: a8 -> aenv
        |: gc >= mc_t.length()
        then:
            gc => 1
            a_err => ""
            self :> a8b

    aenv <: a8b -> aenv
        |: gc < skeys.length()
        then:
            let x: String! = self.line_at(skeys, gc)
            a_err => ||: self.in_set(s2, x) : (a_err + " ") + self.vec_q(x) ||: else : a_err
            gc => gc + x.length() + 1
            self :> a8b

    aenv <: a8b -> done
        |: gc >= skeys.length() and a_err != ""
        then:
            out => out + ("\nerror|" + m_cdupn)

    aenv <: a8b -> aenv
        |: gc >= skeys.length() and a_err == ""
        then:
            gc => 0
            s1 => "\n"
            s2 => "\n"
            skeys => "\n"
            self :> a8c

    aenv <: a8c -> aenv
        |: gc < mf_t.length()
        then:
            let x: String! = self.f_first(self.line_at(mf_t, gc))
            skeys => self.sk_add(x)
            s2 => self.s2_add(x)
            s1 => ||: self.in_set(s1, x) : s1 ||: else : (s1 + x) + "\n"
            a_err => ||: a_err == "" and self.is_res(x) : x ||: else : a_err
            gc => gc + self.line_at(mf_t, gc).length() + 1
            self :> a8c

    aenv <: a8c -> aenv
        |: gc >= mf_t.length()
        then:
            gc => 1
            kname => a_err
            a_err => ""
            self :> a8d

    aenv <: a8d -> aenv
        |: gc < skeys.length()
        then:
            let x: String! = self.line_at(skeys, gc)
            a_err => ||: self.in_set(s2, x) : (a_err + " ") + self.vec_q(x) ||: else : a_err
            gc => gc + x.length() + 1
            self :> a8d

    aenv <: a8d -> done
        |: gc >= skeys.length() and a_err != ""
        then:
            out => out + ("\nerror|" + m_fdupn)

    aenv <: a8d -> done
        |: gc >= skeys.length() and a_err == "" and kname != ""
        then:
            out => out + ("\nerror|" + self.m_resv(kname))

    aenv <: a8d -> aenv
        |: gc >= skeys.length() and a_err == "" and kname == ""
        then:
            k => 0
            bnd => "\n"
            self :> a9

    # The invariant picker's bounds, one pass over each invariant's
    # predicate.
    aenv <: a9 -> aenv
        |: k < props.count()
        then:
            bk => (props.at(k) ?? "0").to_int_or(0)
            bend => self.sx_end((props.at(k) ?? "0").to_int_or(0))
            k => k + 1
            self :> a9b

    aenv <: a9 -> aenv
        |: k >= props.count()
        then:
            gc => 0
            ft_t => ""
            self :> a10

    aenv <: a9b -> aenv
        |: bk < bend
        then:
            bnd => ||: self.b_cmp(bk) and (self.b_one(bk) or self.b_two(bk)) : self.put_last(bnd, self.b_nm(bk), self.b_new(bk)) ||: else : bnd
            bk => bk + 1
            self :> a9b

    aenv <: a9b -> aenv
        |: bk >= bend
        then: self :> a9

    # fields-from-data-section and the picker, one merged field per step.
    aenv <: a10 -> aenv
        |: gc < mf_t.length()
        then:
            fl => self.line_at(mf_t, gc)
            gc => gc + self.line_at(mf_t, gc).length() + 1
            self :> a10b

    aenv <: a10b -> done
        |: l_ferr != ""
        then:
            out => out + ("\nerror|" + l_ferr)

    aenv <: a10b -> aenv
        |: l_ferr == ""
        then:
            ft_t => ft_t + (" " + l_frow)
            self :> a10

    aenv <: a10 -> aenv
        |: gc >= mf_t.length()
        then:
            gc => 0
            a_arb => ""
            a_req => ""
            a_def => ""
            a_seen => false
            kfail => ""
            self :> a11

    # validate-defaults-after-required! and validate-default-is-const!
    # over the merged ctor params.
    aenv <: a11 -> aenv
        |: gc < mc_t.length()
        then:
            fl => self.line_at(mc_t, gc)
            gc => gc + self.line_at(mc_t, gc).length() + 1
            self :> a11b

    aenv <: a11b -> aenv
        |: true
        then:
            let hd2: Bool! = l_d != "nil"
            a_arb => ||: a_arb == "" and a_seen and not hd2 : l_n ||: else : a_arb
            a_seen => a_seen or hd2
            a_req => ||: hd2 : a_req ||: else : self.req_add(l_n)
            a_def => ||: hd2 : self.def_add(l_n) ||: else : a_def
            kj => l_di
            kjend => self.sx_end(l_di)
            kbad => false
            kenv => true
            kret => "ctor"
            kname => l_n
            self :> kg

    aenv <: a11 -> done
        |: gc >= mc_t.length() and a_arb != ""
        then:
            out => out + ("\nerror|" + self.m_kafter(a_site))

    aenv <: a11 -> done
        |: gc >= mc_t.length() and a_arb == "" and kfail != ""
        then:
            out => out + ("\nerror|" + self.m_kconst(a_site))

    aenv <: a11 -> aenv
        |: gc >= mc_t.length() and a_arb == "" and kfail == ""
        then:
            gc => 0
            ct_t => ""
            self :> a12

    # The const-shape scan, entered through `kg` with kj on the default
    # (or -1 when there is nothing to check) and left through `kret`.
    aenv <: kg -> aenv
        |: kfail != "" or kj < 0 or l_cflg != "own"
        then: self :> kd

    aenv <: kg -> aenv
        |: kfail == "" and kj >= 0 and l_cflg == "own"
        then:
            kfkw => self.kw(kj)
            self :> ks

    aenv <: ks -> aenv
        |: kj < kjend and not kbad
        then:
            kbad => not k_ok
            kj => ||: k_ok : k_next ||: else : kj
            self :> ks

    aenv <: ks -> aenv
        |: kj >= kjend or kbad
        then:
            kfail => ||: kbad : kname ||: else : ""
            self :> kd

    aenv <: kd -> aenv
        |: kret == "ctor"
        then: self :> a11

    aenv <: kd -> aenv
        |: kret == "handler"
        then: self :> h2

    aenv <: kd -> aenv
        |: kret == "onnil"
        then: self :> o3

    # ctor-params-normalized.
    aenv <: a12 -> aenv
        |: gc < mc_t.length()
        then:
            fl => self.line_at(mc_t, gc)
            gc => gc + self.line_at(mc_t, gc).length() + 1
            self :> a12b

    aenv <: a12b -> done
        |: l_cerr != ""
        then:
            out => out + ("\nerror|" + l_cerr)

    aenv <: a12b -> aenv
        |: l_cerr == ""
        then:
            ct_t => ct_t + (" " + l_crow)
            self :> a12

    aenv <: a12 -> aenv
        |: gc >= mc_t.length()
        then:
            k => 0
            s1 => "\n"
            s2 => "\n"
            skeys => "\n"
            self :> h0

    # Handler declarations. The duplicate check, then per handler its
    # params through both validators, then the method entry.
    aenv <: h0 -> aenv
        |: k < hl.count()
        then:
            let x: String! = self.r_name(self.hl_at(k))
            skeys => self.sk_add(x)
            s2 => self.s2_add(x)
            s1 => ||: self.in_set(s1, x) : s1 ||: else : (s1 + x) + "\n"
            k => k + 1
            self :> h0

    aenv <: h0 -> aenv
        |: k >= hl.count()
        then:
            gc => 1
            a_err => ""
            self :> h0b

    aenv <: h0b -> aenv
        |: gc < skeys.length() and a_err == ""
        then:
            let x: String! = self.line_at(skeys, gc)
            a_err => ||: self.in_set(s2, x) : x ||: else : ""
            gc => gc + x.length() + 1
            self :> h0b

    aenv <: h0b -> done
        |: a_err != ""
        then:
            out => out + ("\nerror|" + self.m_hdup(a_err))

    aenv <: h0b -> aenv
        |: gc >= skeys.length() and a_err == ""
        then:
            hk => 0
            hnames => "\n"
            m_t => ""
            self :> h1

    aenv <: h1 -> aenv
        |: hk < hl.count()
        then:
            pj => self.t_m(self.r_i(self.hl_at(hk))) + 3
            pjend => self.sx_end(self.t_m(self.r_i(self.hl_at(hk))))
            a_arb => ""
            a_req => ""
            a_def => ""
            a_seen => false
            kfail => ""
            self :> h2

    aenv <: h2 -> aenv
        |: pj < pjend
        then:
            let hd2: Bool! = self.q_hasd(pj)
            let qn: String! = self.sx_text(pj + 2)
            a_arb => ||: a_arb == "" and a_seen and not hd2 : qn ||: else : a_arb
            a_seen => a_seen or hd2
            a_req => ||: hd2 : a_req ||: else : self.req_add(qn)
            a_def => ||: hd2 : self.def_add(qn) ||: else : a_def
            kj => ||: hd2 : pj + 4 ||: else : -1
            kjend => self.sx_end(pj + 4)
            kbad => false
            kenv => false
            kret => "handler"
            kname => qn
            fl => "x\tx\tx\town"
            pj => self.sx_next(pj)
            self :> kg

    aenv <: h2 -> done
        |: pj >= pjend and a_arb != ""
        then:
            out => out + ("\nerror|" + self.m_kafter(self.h_site(self.r_name(self.hl_at(hk)))))

    aenv <: h2 -> done
        |: pj >= pjend and a_arb == "" and kfail != ""
        then:
            out => out + ("\nerror|" + self.m_kconst(self.h_site(self.r_name(self.hl_at(hk)))))

    aenv <: h2 -> aenv
        |: pj >= pjend and a_arb == "" and kfail == ""
        then:
            let r: String! = self.hl_at(hk)
            hnames => hnames + (self.r_name(r) + "\n")
            m_t => m_t + ((((" (method " + self.r_name(r)) + " (params (self ") + ((an + ")") + self.rf8(r))) + ((") (block" + self.rf9(r)) + "))"))
            hk => hk + 1
            self :> h1

    aenv <: h1 -> aenv
        |: hk >= hl.count()
        then:
            gc => 0
            kname => ""
            self :> o0

    # The F8 L3a field and observable collision.
    aenv <: o0 -> aenv
        |: gc < mf_t.length()
        then:
            let x: String! = self.f_first(self.line_at(mf_t, gc))
            kname => ||: kname == "" and self.in_set(obs_set, x) : x ||: else : kname
            gc => gc + self.line_at(mf_t, gc).length() + 1
            self :> o0

    aenv <: o0 -> done
        |: gc >= mf_t.length() and kname != ""
        then:
            out => out + ("\nerror|" + self.m_f8(kname))

    aenv <: o0 -> aenv
        |: gc >= mf_t.length() and kname == ""
        then:
            ej => ||: onil < 0 : 0 ||: else : onil + 2
            ejend => ||: onil < 0 : 0 ||: else : self.sx_end(onil)
            s1 => "\n"
            s2 => "\n"
            skeys => "\n"
            self :> o1

    # on_nil. The duplicate check, then per entry the name and the value.
    aenv <: o1 -> aenv
        |: ej < ejend
        then:
            let x: String! = self.sx_text(ej + 1)
            skeys => self.sk_add(x)
            s2 => self.s2_add(x)
            s1 => ||: self.in_set(s1, x) : s1 ||: else : (s1 + x) + "\n"
            ej => self.sx_next(ej)
            self :> o1

    aenv <: o1 -> aenv
        |: ej >= ejend
        then:
            gc => 1
            a_err => ""
            self :> o1b

    aenv <: o1b -> aenv
        |: gc < skeys.length() and a_err == ""
        then:
            let x: String! = self.line_at(skeys, gc)
            a_err => ||: self.in_set(s2, x) : x ||: else : ""
            gc => gc + x.length() + 1
            self :> o1b

    aenv <: o1b -> done
        |: a_err != ""
        then:
            out => out + ("\nerror|" + self.m_ondup(a_err))

    aenv <: o1b -> aenv
        |: gc >= skeys.length() and a_err == ""
        then:
            ej => ||: onil < 0 : 0 ||: else : onil + 2
            rows => rows.slice(0, 0)
            self :> o2

    aenv <: o2 -> done
        |: ej < ejend and not self.in_set(hnames, self.sx_text(ej + 1)) and not self.in_set(obs_set, self.sx_text(ej + 1))
        then:
            out => out + ("\nerror|" + self.m_onunk(self.sx_text(ej + 1)))

    aenv <: o2 -> aenv
        |: ej < ejend and (self.in_set(hnames, self.sx_text(ej + 1)) or self.in_set(obs_set, self.sx_text(ej + 1)))
        then:
            kj => ej + 2
            kjend => self.sx_end(ej + 2)
            kbad => false
            kenv => false
            kfail => ""
            kret => "onnil"
            kname => self.sx_text(ej + 1)
            fl => "x\tx\tx\town"
            self :> kg

    aenv <: o3 -> done
        |: kfail != ""
        then:
            out => out + ("\nerror|" + self.m_onc(kfail))

    aenv <: o3 -> aenv
        |: kfail == ""
        then:
            rows => rows.append((("5\t(" + self.sx_text(ej + 1)) + " ") + (self.sx_text(ej + 2) + ")"))
            ej => self.sx_next(ej)
            self :> o2

    aenv <: o2 -> aenv
        |: ej >= ejend
        then:
            k => 0
            mtab => "\n"
            self :> m1

    # collect-message-shapes over the transitions, then the handler arms.
    aenv <: m1 -> aenv
        |: k < tl.count() + hl.count() and not self.r_msgtx(mrf)
        then:
            k => k + 1
            self :> m1

    aenv <: m1 -> aenv
        |: k < tl.count() + hl.count() and self.r_msgtx(mrf) and not self.has_key(mtab, self.r_name(mrf))
        then:
            mtab => self.put_last(mtab, self.r_name(mrf), self.rf6(mrf))
            rows => rows.append((("1\t(" + self.r_name(mrf)) + " (payload") + (self.rf5(mrf) + "))"))
            k => k + 1
            self :> m1

    aenv <: m1 -> done
        |: k < tl.count() + hl.count() and self.r_msgtx(mrf) and self.has_key(mtab, self.r_name(mrf)) and m_bad != ""
        then:
            out => out + ("\nerror|" + m_bad)

    aenv <: m1 -> aenv
        |: k < tl.count() + hl.count() and self.r_msgtx(mrf) and self.has_key(mtab, self.r_name(mrf)) and m_bad == ""
        then:
            k => k + 1
            self :> m1

    aenv <: m1 -> aenv
        |: k >= tl.count() + hl.count()
        then:
            k => 0
            ckeys => ckeys.slice(0, 0)
            ctab3 => "\n"
            self :> c1

    # collect-companion-shapes over the transitions, reasons merged in
    # first-seen order.
    aenv <: c1 -> aenv
        |: k < tl.count() and not self.r_msgtx(self.tl_at(k))
        then:
            k => k + 1
            self :> c1

    aenv <: c1 -> aenv
        |: k < tl.count() and self.r_msgtx(self.tl_at(k))
        then:
            let x: String! = self.r_name(self.tl_at(k)) + "_failed"
            c_key => x
            c_of => self.r_name(self.tl_at(k))
            c_rs => ||: self.has_key(ctab3, x) : self.f_rest(self.look(ctab3, x)) ||: else : ""
            c_tok => self.r_reasons(self.tl_at(k))
            ckeys => ||: self.has_key(ctab3, x) : ckeys ||: else : ckeys.append(x)
            self :> c2

    aenv <: c2 -> aenv
        |: c_tok != ""
        then:
            let t: String! = ||: c_tok.starts_with(" violation") : " violation" ||: else : c_tok.substring(0, (c_tok.index_of(")") + 1).max(0).min(c_tok.length()))
            c_rs => ||: c_rs.contains(t) : c_rs ||: else : c_rs + t
            c_tok => self.cut(c_tok, t.length())
            self :> c2

    aenv <: c2 -> aenv
        |: c_tok == ""
        then:
            ctab3 => self.put_last(ctab3, c_key, (c_of + "\t") + c_rs)
            k => k + 1
            self :> c1

    aenv <: c1 -> aenv
        |: k >= tl.count()
        then:
            k => 0
            self :> c3

    aenv <: c3 -> aenv
        |: k < ckeys.count()
        then:
            let x: String! = ckeys.at(k) ?? ""
            rows => rows.append((("2\t(" + x) + (" " + self.f_first(self.look(ctab3, x)))) + ((" (reasons" + self.f_rest(self.look(ctab3, x))) + "))"))
            k => k + 1
            self :> c3

    aenv <: c3 -> aenv
        |: k >= ckeys.count()
        then:
            k => 0
            expass => 1
            stab => "\n"
            so_t => ""
            self :> q0

    # collect-stream-shapes. Every untargeted emit inside a transition,
    # first the sync check over all of them, then the payload keys.
    aenv <: q0 -> aenv
        |: k < tl.count() and self.is_syn(self.tl_at(k))
        then:
            k => k + 1
            self :> q0

    aenv <: q0 -> aenv
        |: k < tl.count() and not self.is_syn(self.tl_at(k))
        then:
            ex => self.r_i(self.tl_at(k))
            exend => self.sx_end(self.r_i(self.tl_at(k)))
            k => k + 1
            self :> q1

    aenv <: q0 -> aenv
        |: k >= tl.count() and expass == 1
        then:
            k => 0
            expass => 2
            self :> q0

    aenv <: q0 -> aenv
        |: k >= tl.count() and expass == 2
        then:
            k => 0
            sbkeys => sbkeys.slice(0, 0)
            sbtab => "\n"
            self :> u1

    aenv <: q1 -> done
        |: ex < exend and self.s_emit(ex) and expass == 1 and self.sx_text(ex + 2) == "sync"
        then:
            out => out + ("\nerror|" + self.m_sync(self.sx_text(ex + 4)))

    aenv <: q1 -> aenv
        |: ex < exend and self.s_emit(ex) and expass == 2
        then:
            ea => ex + 5
            eaend => self.sx_end(ex)
            e_pos => false
            e_keys => ""
            self :> q2

    aenv <: q1 -> aenv
        |: ex < exend and not (self.s_emit(ex) and (expass == 2 or self.sx_text(ex + 2) == "sync"))
        then:
            ex => ex + 1
            self :> q1

    aenv <: q1 -> aenv
        |: ex >= exend
        then: self :> q0

    aenv <: q2 -> aenv
        |: ea < eaend
        then:
            e_pos => e_pos or self.sx_head(ea) == "pos"
            e_keys => ||: self.sx_head(ea) == "named" : e_keys + (" " + self.vec_q(self.sx_text(ea + 2))) ||: else : e_keys
            ea => self.sx_next(ea)
            self :> q2

    aenv <: q2 -> done
        |: ea >= eaend and e_pos
        then:
            out => out + ("\nerror|" + self.m_spos(self.sx_text(ex + 4)))

    aenv <: q2 -> done
        |: ea >= eaend and not e_pos and self.has_key(stab, self.sx_text(ex + 4)) and self.look(stab, self.sx_text(ex + 4)) != e_keys
        then:
            out => out + ("\nerror|" + self.m_sdup(self.sx_text(ex + 4), self.look(stab, self.sx_text(ex + 4)), e_keys))

    aenv <: q2 -> aenv
        |: ea >= eaend and not e_pos and not (self.has_key(stab, self.sx_text(ex + 4)) and self.look(stab, self.sx_text(ex + 4)) != e_keys)
        then:
            rows => ||: self.has_key(stab, self.sx_text(ex + 4)) : rows ||: else : rows.append((("3\t(" + self.sx_text(ex + 4)) + " (keys") + (e_keys.replace("\"", "") + "))"))
            so_t => ||: self.has_key(stab, self.sx_text(ex + 4)) : so_t ||: else : so_t + (" " + self.sx_text(ex + 4))
            stab => self.put_first(stab, self.sx_text(ex + 4), e_keys)
            ex => ex + 1
            self :> q1

    # The subscription map, then the owned slot names.
    aenv <: u1 -> aenv
        |: k < tl.count()
        then:
            let r: String! = self.tl_at(k)
            let on: Bool! = not self.is_syn(r) and self.r_glyph(r) == "<:" and self.r_kind(r) == "dot" and self.sx_head(self.t_m(self.r_i(r)) + 4) == "ident"
            let f: String! = self.sx_text(self.t_m(self.r_i(r)) + 6)
            let m: String! = self.sx_text(self.sx_next(self.t_m(self.r_i(r)) + 4))
            sbkeys => ||: on and not self.has_key(sbtab, f) : sbkeys.append(f) ||: else : sbkeys
            sbtab => ||: on and not (self.look(sbtab, f) + " ").contains((" " + m) + " ") : self.put_last(sbtab, f, (self.look(sbtab, f) + " ") + m) ||: else : sbtab
            k => k + 1
            self :> u1

    aenv <: u1 -> aenv
        |: k >= tl.count()
        then:
            k => 0
            self :> u1b

    aenv <: u1b -> aenv
        |: k < sbkeys.count()
        then:
            rows => rows.append(("4\t(" + (sbkeys.at(k) ?? "")) + (self.look(sbtab, sbkeys.at(k) ?? "") + ")"))
            k => k + 1
            self :> u1b

    aenv <: u1b -> aenv
        |: k >= sbkeys.count()
        then:
            gc => 0
            sn_t => ""
            self :> u2

    aenv <: u2 -> aenv
        |: gc < mf_t.length()
        then:
            fl => self.line_at(mf_t, gc)
            sn_t => ||: self.u_slot(self.line_at(mf_t, gc)) : sn_t + (" " + self.f_first(self.line_at(mf_t, gc))) ||: else : sn_t
            gc => gc + self.line_at(mf_t, gc).length() + 1
            self :> u2

    aenv <: u2 -> sorting
        |: gc >= mf_t.length()
        then:
            sort_ret => "atag"

    # Back from the tagged sort. Split the sections, then the row.
    aenv <: asm -> aenv
        |: gc < asorted.length()
        then:
            let ln: String! = self.line_at(asorted, gc)
            let v: String! = " " + self.cut(ln, 2)
            mi_t => ||: ln.starts_with("1") : mi_t + v ||: else : mi_t
            ci_t => ||: ln.starts_with("2") : ci_t + v ||: else : ci_t
            si_t => ||: ln.starts_with("3") : si_t + v ||: else : si_t
            sb_t => ||: ln.starts_with("4") : sb_t + v ||: else : sb_t
            on_t => ||: ln.starts_with("5") : on_t + v ||: else : on_t
            gc => gc + ln.length() + 1
            self :> asm

    aenv <: asm -> aenv
        |: gc >= asorted.length()
        then:
            aenames => ||: self.has_key(aetab, an) : aenames ||: else : aenames.append(an)
            aetab => self.put_last(aetab, an, a_row)
            ti => self.sx_next(ti)
            self :> a0

    # The CxcStream seed and reachable-prelude-atoms. One pass over the
    # stream outside the prelude atoms and plugins, then each reached
    # prelude atom's last declaration until nothing new is reached.
    tshake <: t0 -> tshake
        |: true
        then:
            sj => 2
            sjend => nn
            tmode => 1
            self :> ts

    tshake <: ts -> tshake
        |: sj < sjend and ts_top
        then:
            s_ex => self.ts_excl(sj)
            pltab => ||: self.sx_head(sj) == "agent" and self.pre_atom(self.sx_text(sj + 2)) : self.put_last(pltab, self.sx_text(sj + 2), sj.to_string()) ||: else : pltab
            sj => sj + 1
            self :> ts

    tshake <: ts -> tshake
        |: sj < sjend and not ts_top and tmode == 1 and s_ex
        then:
            sj => sj + 1
            self :> ts

    tshake <: ts -> tshake
        |: sj < sjend and not ts_top and not (tmode == 1 and s_ex)
        then:
            reached => ||: self.ts_new(self.ts_nm(sj)) : (reached + self.ts_nm(sj)) + "\n" ||: else : reached
            wq => ||: self.ts_new(self.ts_nm(sj)) : wq.append(self.ts_nm(sj)) ||: else : wq
            tcur => ||: self.sx(sj).kind == 1 and self.sx_text(sj).contains("TR:") : self.sx_text(sj) ||: else : ""
            sj => sj + 1
            self :> tt

    tshake <: tt -> tshake
        |: tcur.contains("TR:")
        then:
            reached => ||: self.ts_new(tr_nm) : (reached + tr_nm) + "\n" ||: else : reached
            wq => ||: self.ts_new(tr_nm) : wq.append(tr_nm) ||: else : wq
            tcur => self.cut(tr_rest, tr_nm.length())
            self :> tt

    tshake <: tt -> tshake
        |: not tcur.contains("TR:")
        then: self :> ts

    tshake <: ts -> tshake
        |: sj >= sjend
        then: self :> tw

    tshake <: tw -> tshake
        |: wk < wq.count() and self.look(pltab, wq.at(wk) ?? "") == ""
        then:
            wk => wk + 1
            self :> tw

    tshake <: tw -> tshake
        |: wk < wq.count() and self.look(pltab, wq.at(wk) ?? "") != ""
        then:
            sj => self.look(pltab, wq.at(wk) ?? "").to_int_or(0)
            sjend => self.sx_end(self.look(pltab, wq.at(wk) ?? "").to_int_or(0))
            tmode => 2
            wk => wk + 1
            self :> ts

    tshake <: tw -> tshake
        |: wk >= wq.count()
        then:
            k => 0
            self :> tf

    tshake <: tf -> tshake
        |: k < aenames.count()
        then:
            rows => ||: self.ts_keep(aenames.at(k) ?? "") : rows.append(("(keep " + (aenames.at(k) ?? "")) + ")") ||: else : rows
            k => k + 1
            self :> tf

    tshake <: tf -> sorting
        |: k >= aenames.count()
        then:
            rows => rows.append("(keep CxcStream runtime-provided)")
            sort_ret => "shake"
