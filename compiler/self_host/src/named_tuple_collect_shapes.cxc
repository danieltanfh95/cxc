# Port of cxc.named-tuple/collect-shapes — F15 L2.c.i walker that
# surfaces every distinct :type-named-tuple shape in an AST and
# returns `{mangled-name → shape-node}`.
#
# Clojure source. compiler/src/cxc/named_tuple.clj L210 to L231.
#
# Input per line: `<ser>[;<ser>…]` where each `<ser>` is one of
#   `<prim>`              — primitive type-ref, no shape to collect
#   `Nn_<ser>`            — non-nil wrapper, walks its inner
#   `Nt<count>_<body>`    — named-tuple; outer AND every nested shape
#                           in `<body>` collected via depth-N stack walk
#   `Of<arity>_<outer>_<ser1>_…` — parametric (F15 L2.b.ii / L2.b.iii),
#                           `<arity>` bare type manglings follow the
#                           outer name. Not itself a shape, but any
#                           named tuple inside an inner is collected,
#                           matching the postwalk in collect-shapes.
# where `<body>` is `<f1>_<ser1>_<f2>_<ser2>_…` with pre-sorted field
# names.
#
# Chapter 17 added depth-2 support via two phases
# (`scanning_nested` + `consuming_inner_pairs`). Chapter 18 lifts the
# depth-2 restriction with a slice-and-append stack:
#
# - `rem_stack`, `start_stack`, `saved_consumed`: `List of Int!`.
#   Every push rewrites via `.slice(0, depth).append(new)` so dead
#   values from popped-then-re-pushed sibling frames don't leak into
#   `at(depth - 1)` reads. Pop is implicit — `depth => depth - 1`
#   leaves the lists longer than `depth`, but the next push's slice
#   cleans up.
# - `depth: Int!` — logical stack size.
# - `top_consumed: Int!` — pairs consumed at the active (top) frame.
#
# Each walking step:
#   - If `depth == 0`: body is finished; return to parsing or sorting.
#   - If `top_complete` (consumed >= stack-top rem): emit canonical
#     for the popped frame body, restore `top_consumed` to the parent's
#     saved value plus one (the nested counted as one parent field),
#     decrement depth.
#   - Else parse one field-type pair:
#     - If type is `Nt<K>_...`: push a new frame.
#     - Else (primitive or `Nn_<prim>`): advance past the word; +1
#       to `top_consumed`.
#
# Chapter 24 adds `Of<N>_` frames. `kind_stack` tags each frame as a
# pair frame (1, an `Nt` body, items are `<fname>_<type>`) or a type
# frame (2, an `Of` inner list or the synthetic top-level frame, items
# are bare `<type>`). Only pair frames emit a canonical on pop. Each
# top-level entry is walked as a one-item type frame so `Of` and `Nn_`
# wrappers at the root reach nested shapes through the same arms.
#
# Output per line: comma-joined, alphabetically-sorted canonical
# names.

def main:
    use args:    Args
    use console: Console

    # Entry-splitting state.
    spec:          String! = ""
    cursor:        Int!    = 0
    entry_acc:     String! = ""
    canonicals:    List of String = []

    # Depth-N walker state.
    work:            String! = ""
    pos:             Int!    = 0
    end_of_spec:     Bool!   = false
    rem_stack:       List of Int = []
    start_stack:     List of Int = []
    saved_consumed:  List of Int = []
    kind_stack:      List of Int = []
    depth:           Int!    = 0
    top_consumed:    Int!    = 0

    # Sort / emit state.
    sort_i:        Int!    = 0
    scan_best:     String! = ""
    scan_has_best: Bool!   = false
    out:           String! = ""

    at_end  :- cursor >= spec.length()
    cur     :- ||: at_end : -1 ||: else : spec.code_at(cursor)
    is_semi :- cur == 59

    scan_cur :- canonicals.at(sort_i) ?? ""
    scan_cmp :- scan_cur.compare_to(scan_best)

    top_rem      :- rem_stack.at((depth - 1).max(0)) ?? 0
    top_kind     :- kind_stack.at((depth - 1).max(0)) ?? 0
    top_complete :- depth > 0 and top_consumed >= top_rem

    # Item-at-pos observations (used by the walking arms). A pair
    # frame item starts with `<fname>_`, a type frame item starts
    # directly with its type.
    fname_sub_at_pos    :- work.substring(pos, (work.length() - pos).max(0))
    fname_sep_at_pos    :- fname_sub_at_pos.index_of("_")
    after_fname_at_pos  :- ||: fname_sep_at_pos > 0 : pos + fname_sep_at_pos + 1 ||: else : work.length()
    type_start_at_pos   :- ||: top_kind == 2 : pos ||: else : after_fname_at_pos
    type_rest_at_pos    :- work.substring(type_start_at_pos, (work.length() - type_start_at_pos).max(0))
    is_nn_at_pos        :- type_rest_at_pos.starts_with("Nn_")
    type_body_start_at_pos :- ||: is_nn_at_pos : type_start_at_pos + 3 ||: else : type_start_at_pos
    type_body_at_pos    :- work.substring(type_body_start_at_pos, (work.length() - type_body_start_at_pos).max(0))
    type_is_nt          :- type_body_at_pos.length() >= 4 and type_body_at_pos.code_at(0) == 78 and type_body_at_pos.code_at(1) == 116 and type_body_at_pos.code_at(2) >= 48 and type_body_at_pos.code_at(2) <= 57
    type_is_of          :- type_body_at_pos.length() >= 4 and type_body_at_pos.code_at(0) == 79 and type_body_at_pos.code_at(1) == 102 and type_body_at_pos.code_at(2) >= 48 and type_body_at_pos.code_at(2) <= 57

    # Counted-prefix probes shared by the Nt and Of push arms.
    # `type_body_at_pos` is `Nt<K>_…` or `Of<K>_<outer>_…`.
    prefix_digits_sub   :- type_body_at_pos.substring(2, (type_body_at_pos.length() - 2).max(0))
    prefix_digits_sep   :- prefix_digits_sub.index_of("_")
    prefix_count        :- ||: prefix_digits_sep > 0 : prefix_digits_sub.substring(0, prefix_digits_sep).to_int_or(0) ||: else : 0
    after_count_rel     :- ||: prefix_digits_sep > 0 : 2 + prefix_digits_sep + 1 ||: else : type_body_at_pos.length()
    outer_sub           :- type_body_at_pos.substring(after_count_rel, (type_body_at_pos.length() - after_count_rel).max(0))
    outer_sep           :- outer_sub.index_of("_")

    -> parsing
        then:
            spec => args.get_or(1, "")
            self :> step

    -> walking
        then:
            self :> step

    -> sorting
        then:
            sort_i => 0
            scan_has_best => false
            scan_best => ""
            self :> scan

    -> end
        then: console.write(out)

    parsing <: step -> parsing
        |: not at_end and is_semi
        then:
            self :> commit

    parsing <: step -> parsing
        |: not at_end and not is_semi
        then:
            entry_acc => entry_acc + spec.substring(cursor, 1)
            cursor => cursor + 1
            self :> step

    # Each entry is walked as a synthetic one-item type frame.
    parsing <: step -> walking
        |: at_end and entry_acc.length() > 0
        then:
            work => entry_acc
            pos => 0
            end_of_spec => true
            rem_stack => rem_stack.slice(0, 0).append(1)
            start_stack => start_stack.slice(0, 0).append(0)
            saved_consumed => saved_consumed.slice(0, 0).append(0)
            kind_stack => kind_stack.slice(0, 0).append(2)
            top_consumed => 0
            depth => 1

    parsing <: step -> sorting
        |: at_end and entry_acc.length() == 0

    parsing <: commit -> walking
        then:
            work => entry_acc
            pos => 0
            end_of_spec => false
            rem_stack => rem_stack.slice(0, 0).append(1)
            start_stack => start_stack.slice(0, 0).append(0)
            saved_consumed => saved_consumed.slice(0, 0).append(0)
            kind_stack => kind_stack.slice(0, 0).append(2)
            top_consumed => 0
            depth => 1

    walking <: step -> parsing
        |: depth == 0 and not end_of_spec
        then:
            entry_acc => ""
            cursor => cursor + 1
            self :> step

    walking <: step -> sorting
        |: depth == 0 and end_of_spec

    # Pop. Pair frames emit their canonical, type frames only return.
    walking <: step -> walking
        |: top_complete
        then:
            let frame_start: Int! = start_stack.at((depth - 1).max(0)) ?? 0
            let frame_end:   Int! = ||: pos < work.length() : pos - 1 ||: else : pos
            let body:        String! = work.substring(frame_start, (frame_end - frame_start).max(0))
            let canonical:   String! = "_Cxc_NT_" + body
            canonicals => ||: top_kind == 1 and body.length() > 0 and not canonicals.contains(canonical) : canonicals.append(canonical) ||: else : canonicals
            depth => depth - 1
            top_consumed => (saved_consumed.at((depth - 1).max(0)) ?? 0) + 1
            self :> step

    walking <: step -> walking
        |: depth > 0 and not top_complete and type_is_nt
        then:
            # Push nested pair frame. `.slice(0, depth)` trims any dead
            # values left by a sibling frame that pushed-then-popped at
            # this depth earlier.
            let inner_start: Int! = type_body_start_at_pos + after_count_rel
            pos => inner_start
            rem_stack => rem_stack.slice(0, depth).append(prefix_count)
            start_stack => start_stack.slice(0, depth).append(inner_start)
            saved_consumed => saved_consumed.slice(0, depth).append(top_consumed)
            kind_stack => kind_stack.slice(0, depth).append(1)
            top_consumed => 0
            depth => depth + 1
            self :> step

    walking <: step -> walking
        |: depth > 0 and not top_complete and type_is_of
        then:
            # Push a type frame over the `<arity>` inner manglings that
            # follow `Of<arity>_<outer>_`.
            let inner_start: Int! = ||: outer_sep > 0 : type_body_start_at_pos + after_count_rel + outer_sep + 1 ||: else : work.length()
            pos => inner_start
            rem_stack => rem_stack.slice(0, depth).append(prefix_count)
            start_stack => start_stack.slice(0, depth).append(inner_start)
            saved_consumed => saved_consumed.slice(0, depth).append(top_consumed)
            kind_stack => kind_stack.slice(0, depth).append(2)
            top_consumed => 0
            depth => depth + 1
            self :> step

    walking <: step -> walking
        |: depth > 0 and not top_complete and not type_is_nt and not type_is_of
        then:
            # Consume one primitive (or Nn_primitive) item.
            # Scan the type word up to the next `_` or end of work.
            let rest_body: String! = type_body_at_pos
            let body_sep: Int! = rest_body.index_of("_")
            let next_pos: Int! = ||: body_sep > 0 : type_body_start_at_pos + body_sep + 1 ||: else : work.length()
            pos => next_pos
            top_consumed => top_consumed + 1
            self :> step

    sorting <: scan -> sorting
        |: sort_i < canonicals.count() and not scan_has_best
        then:
            scan_best => scan_cur
            scan_has_best => true
            sort_i => sort_i + 1
            self :> scan

    sorting <: scan -> sorting
        |: sort_i < canonicals.count() and scan_has_best and scan_cmp < 0
        then:
            scan_best => scan_cur
            sort_i => sort_i + 1
            self :> scan

    sorting <: scan -> sorting
        |: sort_i < canonicals.count() and scan_has_best and scan_cmp >= 0
        then:
            sort_i => sort_i + 1
            self :> scan

    sorting <: scan -> sorting
        |: sort_i >= canonicals.count() and scan_has_best
        then:
            let sep: String! = ||: out.length() == 0 : "" ||: else : ","
            out => out + sep + scan_best
            canonicals => canonicals.filter(c => c != scan_best)
            sort_i => 0
            scan_has_best => false
            scan_best => ""
            self :> scan

    sorting <: scan -> end
        |: sort_i >= canonicals.count() and not scan_has_best
