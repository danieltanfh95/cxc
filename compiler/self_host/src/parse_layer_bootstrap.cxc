# Self-host parse-layer bootstrap — terminal subset v1.
#
# Chapter-12 incremental landing. Per the chapter-11 design note
# (compiler/self_host/design/parse-layer-bootstrap.md) and the
# chapter-12 directive, build one shape at a time inside this
# single parser atom.
#
# Scope at chapter-12 initial landing. SHAPE 1 of 11 only:
#   from X import a[, b[, c]]
# Subsequent landings extend this file with more shapes under the
# same single-atom scaffolding. The build-one-shape-at-a-time
# discipline matches the directive guidance:
#   "produce one new :node shape in isolation, confirm oracle
#   equivalence, add the next shape."
#
# Lexing model. Single-line input only at this landing (multi-line
# layout markers deferred to the first def-record landing). Char-
# by-char dispatch mirrors the chapter-11 slice-31 tokenize-line
# pattern. Only the tokens that appear in `from X import a, b, c`
# are recognised: ident / kw / punct. All other bytes emit a
# parse error.
#
# Parsing model. Flat token stream in the `tokens` field, cursor
# in `pos`. Each shape adds its own transition arm; dispatch is
# on `cur_kind` + `cur_value`.
#
# Input. argv[1] = cxc source. For shape 1, a single-line
# `from X import ...` statement.
#
# Output. One serialized node per invocation, matching the chapter-
# 11 design note's wire format:
#   fromimport|<from>|<n1>[,<n2>...]
#   parseerror|<message>

def Token:
    kind:  String!
    value: String!
    line:  Int!

def main:
    use args:    Args
    use console: Console

    source:   String! = ""
    sc:       Int!    = 0
    word_acc: String! = ""
    line_num: Int!    = 1
    line_indent: Int! = 0
    indent_stack: List of Int = [0]
    at_line_start: Bool! = true
    tokens:   List of Token = []
    pos:      Int!    = 0
    out:      String! = ""
    error:    Bool!   = false
    error_msg: String! = ""
    # Chapter-23 lex-error flag. Clojure's cxc.lex throws its own
    # message (no `parse error:` wrapper, no got-token suffix), so the
    # end phase prints lex errors bare.
    lex_error: Bool!   = false
    # Chapter-23 escape scratch, mirrored from slice 33. `esc_mode` is
    # the return-mode sentinel for the shared escape phases ("str" or
    # "char"). `esc_hex` / `esc_val` accumulate the `\u{...}` body.
    # `char_esc` picks Clojure's close-quote error message.
    esc_mode:  String! = "str"
    esc_hex:   String! = ""
    esc_val:   Int!    = 0
    char_esc:  Bool!   = false
    # Chapter-26 bracket continuation, mirrored from slice 33.
    bracket_depth: Int!  = 0
    line_is_cont:  Bool! = false
    # Chapter 28. The `=> def:` layout escape (cxc.lex def-frame). A
    # line inside open brackets that ends with `=> def :` arms a frame
    # at its indent, `def_base`. Deeper lines then open with INDENT
    # (first) or NEWLINE (later) and leave the indent stack alone, and
    # the first line back at or under the base closes the frame with
    # NEWLINE DEDENT before it lexes normally. `line_in_def` marks a
    # line lexed inside the frame, which never ends with a NEWLINE.
    def_base:    Int!  = -1
    def_seen:    Bool! = false
    line_in_def: Bool! = false
    # Chapter 27 inconsistent dedent. Clojure pops the indent stack to a
    # level that must exist, and throws when the line's indent falls
    # between two open levels. It tokenizes the line content first, so
    # a content lex error on that line wins. `dedent_err` holds the
    # message until the line ends. `indent_str` is the stack printed
    # top first, `indent_snap` its value when the line's dedents began.
    dedenting:   Bool!   = false
    indent_str:  String! = "0"
    indent_snap: String! = "0"
    dedent_err:  String! = ""
    field_name_buf: String! = ""
    type_name_buf:  String! = ""
    type_ser_buf:   String! = ""
    inner_ser_buf:  String! = ""
    inner_k_buf:    String! = ""
    inner_v_buf:    String! = ""
    def_name_buf:   String! = ""
    def_prefix_set: Bool!   = false
    # Chapter-19 named-tuple scratch buffers. Used by the parse_nt_*
    # phases that fire when `(` opens a named-tuple type expression in
    # field position.
    nt_body_buf:    String! = ""
    nt_fname_buf:   String! = ""
    nt_tname_buf:   String! = ""
    # Chapter-20 depth-N stack (slice-and-append discipline, chapter 18).
    # On nested `(` inside parse_nt_type, the current nt_body_buf and
    # nt_fname_buf are saved; a fresh nested parse starts. On `)` with
    # nt_depth > 0, the saved outer is popped and the completed nested
    # is embedded as the outer pair's type.
    nt_body_buf_stack:  List of String = []
    nt_fname_buf_stack: List of String = []
    nt_depth:           Int!    = 0
    # Chapter-20 return-mode sentinel. The named-tuple parsing arms are
    # shared between parse_field_type and parse_ctor_param_type. The
    # terminal `)` arm (nt_depth == 0) picks the downstream emit phase
    # from this mode: "field" → emit_field_from_ser, "ctor" →
    # emit_ctor_param.
    nt_return_mode:     String! = "field"
    # Chapter-22 container-return-mode sentinel. Container (`T of X`)
    # parsing is shared between field position and named-tuple body
    # position. `finish_container` picks its downstream phase from this
    # mode. "field" → emit_field_from_ser via type_ser_buf. "nt_body"
    # → append the `fname:TO:Outer(inner)` pair into nt_body_buf and
    # return to after_nt_pair. The mode is reset to "field" at the end
    # of each nt_body commit so sibling fields in the same NT body
    # route correctly on their own container entries.
    container_return_mode: String! = "field"

    reserved: List of String = [
        "module", "from", "import", "as",
        "def", "use", "invariants",
        "accepts", "extend", "replace", "deprecated",
        "then", "do", "when", "let", "alias",
        "self", "nil", "true", "false",
        "and", "or", "not", "is", "in", "of",
        "if", "else", "return", "case",
        "function", "for",
        "weak", "unowned",
        "while", "loop", "break", "continue",
        "raise"
    ]

    at_src_end :- sc >= source.length()
    srccur     :- ||: at_src_end : -1 ||: else : source.code_at(sc)
    srcnext    :- ||: sc + 1 >= source.length() : -1 ||: else : source.code_at(sc + 1)
    is_sp      :- srccur == 32
    is_nl      :- srccur == 10
    is_id_start :- (srccur >= 65 and srccur <= 90) or (srccur >= 97 and srccur <= 122) or srccur == 95
    is_id_cont  :- is_id_start or (srccur >= 48 and srccur <= 57)
    is_comma   :- srccur == 44
    is_colon   :- srccur == 58
    is_lparen  :- srccur == 40
    is_rparen  :- srccur == 41
    is_bang    :- srccur == 33
    is_q       :- srccur == 63

    # Chapter-26 — the rest of Clojure's punctuation and glyph tables,
    # `#` line comments and the `@` retirement, mirrored from slice 33.
    srcnext2     :- ||: sc + 2 >= source.length() : -1 ||: else : source.code_at(sc + 2)
    is_lbracket  :- srccur == 91
    is_rbracket  :- srccur == 93
    is_semi      :- srccur == 59
    is_plus      :- srccur == 43
    is_star      :- srccur == 42
    is_slash     :- srccur == 47
    is_pct       :- srccur == 37
    is_amp       :- srccur == 38
    is_at        :- srccur == 64
    is_hash      :- srccur == 35
    is_lt_pipe   :- srccur == 60 and srcnext == 124
    is_pipe_gt   :- srccur == 124 and srcnext == 62
    is_dslash    :- srccur == 47 and srcnext == 47
    is_dstar     :- srccur == 42 and srcnext == 42
    is_dpipe_col :- srccur == 124 and srcnext == 124 and srcnext2 == 58

    is_arrow     :- srccur == 45 and srcnext == 62
    is_fat_arrow :- srccur == 61 and srcnext == 62
    is_pipe_col  :- srccur == 124 and srcnext == 58
    is_col_dash  :- srccur == 58 and srcnext == 45
    is_double_q  :- srccur == 63 and srcnext == 63
    is_lt_col    :- srccur == 60 and srcnext == 58
    is_col_gt    :- srccur == 58 and srcnext == 62
    is_eq_eq     :- srccur == 61 and srcnext == 61
    is_bang_eq   :- srccur == 33 and srcnext == 61
    is_gte       :- srccur == 62 and srcnext == 61
    is_lte       :- srccur == 60 and srcnext == 61

    is_any_multi :- is_arrow or is_fat_arrow or is_pipe_col or is_col_dash or is_double_q or is_lt_col or is_col_gt or is_eq_eq or is_bang_eq or is_gte or is_lte or is_lt_pipe or is_pipe_gt or is_dslash or is_dstar
    is_eq        :- srccur == 61
    is_dash      :- srccur == 45
    is_lt        :- srccur == 60
    is_gt        :- srccur == 62
    is_pipe      :- srccur == 124
    is_digit     :- srccur >= 48 and srccur <= 57
    is_dquote    :- srccur == 34
    is_squote    :- srccur == 39

    # Chapter-22 / 25 — numeric-literal lex predicates, mirrored from
    # slice 33. See the chapter-25 block below for the scan-number port.
    is_dot        :- srccur == 46
    srcnext_is_digit :- sc + 1 < source.length() and source.code_at(sc + 1) >= 48 and source.code_at(sc + 1) <= 57
    # Chapter-23 — string / char escape decoding, mirrored from slice
    # 33. Every escape Clojure's cxc.lex/append-escape! accepts decodes
    # to its code point, then `enc` (a port of Clojure's pr-str string
    # printer) re-encodes it. Token value holds the pr-str body without
    # quotes, which matches the oracle's `(pr-str value)` on both the
    # `=STR:` / `=CHR:` default column and the got-token error suffix.
    is_bslash     :- srccur == 92
    is_lbrace     :- srccur == 123
    is_rbrace     :- srccur == 125
    is_esc_x      :- srccur == 120
    is_esc_u      :- srccur == 117
    simple_esc_code :- ||: srccur == 110 : 10 ||: srccur == 116 : 9 ||: srccur == 114 : 13 ||: srccur == 92 : 92 ||: srccur == 34 : 34 ||: srccur == 39 : 39 ||: srccur == 48 : 0 ||: srccur == 97 : 7 ||: srccur == 98 : 8 ||: srccur == 102 : 12 ||: srccur == 118 : 11 ||: else : -1
    cur_hex       :- ||: srccur >= 48 and srccur <= 57 : srccur - 48 ||: srccur >= 97 and srccur <= 102 : srccur - 87 ||: srccur >= 65 and srccur <= 70 : srccur - 55 ||: else : -1
    next_hex      :- ||: srcnext >= 48 and srcnext <= 57 : srcnext - 48 ||: srcnext >= 97 and srcnext <= 102 : srcnext - 87 ||: srcnext >= 65 and srcnext <= 70 : srcnext - 55 ||: else : -1
    uni_len_ok    :- esc_hex.length() >= 1 and esc_hex.length() <= 6

    # pr-str string-body encoder. See slice 33 for the table rationale.
    enc(c: Int!) :- String!
        ||: c == 10 : "\\n" ||: c == 9 : "\\t" ||: c == 13 : "\\r" ||: c == 34 : "\\\"" ||: c == 92 : "\\\\" ||: c == 12 : "\\f" ||: c == 8 : "\\b" ||: c > 65535 : (55296 + (c - 65536) / 1024).to_char_string() + (56320 + (c - 65536) % 1024).to_char_string() ||: else : c.to_char_string()

    # Chapter-25 numeric scan state, a port of cxc.lex/scan-number.
    # `num_digs` / `num_last_digit` are one scan-digits run (separators
    # stripped). `num_mode` is the run's return-mode sentinel ("int",
    # "frac", "exp", "based", "hexfrac"). The `num_sig*` fields track
    # the significant digits and the position of the first one while the
    # int and frac runs scan, so the float value renders without a
    # second pass (see slice 34 `float_render_java.cxc`).
    num_digs:       String! = ""
    num_last_digit: Bool!   = false
    num_mode:       String! = "int"
    num_base:       Int!    = 10
    num_prefix:     String! = ""
    num_int:        String! = ""
    num_frac:       String! = ""
    num_exp:        String! = ""
    num_has_dot:    Bool!   = false
    num_has_exp:    Bool!   = false
    num_exp_sign:   String! = ""
    num_kind:       String! = "int"
    num_val:        Int!    = 0
    num_sig:        String! = ""
    num_sig_nz:     Int!    = 0
    num_int_sig:    Int!    = 0
    num_frac_lead:  Int!    = 0
    num_exp_val:    Int!    = 0
    sfx_acc:        String! = ""
    sfx_col:        Int!    = 0

    # Clojure's col is 1-based within the indent-stripped line content.
    line_content_sc: Int!   = 0
    cur_col       :- sc - line_content_sc + 1
    is_us         :- srccur == 95
    is_letter     :- (srccur >= 65 and srccur <= 90) or (srccur >= 97 and srccur <= 122)
    is_exp_marker :- srccur == 101 or srccur == 69
    is_p_marker   :- srccur == 112 or srccur == 80
    num_run_end   :- at_src_end or is_nl
    num_digit_val :- ||: num_base == 16 : cur_hex ||: srccur >= 48 and srccur < 48 + num_base : srccur - 48 ||: else : -1
    rest_src      :- source.substring(sc.min(source.length()), (source.length() - sc).max(0))
    rest_nl       :- rest_src.index_of("\n")
    line_rest     :- ||: rest_nl < 0 : rest_src.length() ||: else : rest_nl
    lz_snip       :- rest_src.substring(0, line_rest.min(5).max(0))
    num_str       :- ||: num_prefix.length() > 0 : num_prefix + num_digs ||: else : num_int + (||: num_has_dot : "." + num_frac ||: else : "") + (||: num_has_exp : "e" + num_exp_sign + num_exp ||: else : "")
    num_sig_trim  :- num_sig.substring(0, num_sig_nz.min(num_sig.length()))
    num_sci_exp   :- (||: num_int_sig > 0 : num_int_sig - 1 ||: else : 0 - num_frac_lead - 1) + (||: num_exp_sign == "-" : 0 - num_exp_val ||: else : num_exp_val)

    # Java `Double.toString` layout, mirrored from slice 34. Exact for
    # literals with at most 15 significant digits in the normal range.
    render_float(digs: String!, e: Int!) :- String!
        alias m        :- digs.length()
        alias pad17    :- (digs + "00000000000000000").substring(0, 17)
        alias is_inf   :- e >= 309 or (e == 308 and pad17.compare_to("17976931348623158") >= 0)
        alias int_len  :- (e + 1).max(0).min(m)
        alias int_txt  :- ||: m <= e + 1 : digs + "0".repeat((e + 1 - m).max(0)) ||: else : digs.substring(0, int_len)
        alias frac_txt :- ||: m <= e + 1 : "0" ||: else : digs.substring(int_len, (m - int_len).max(0))
        alias neg_txt  :- "0." + "0".repeat((0 - e - 1).max(0)) + digs
        alias sci_frac :- ||: m > 1 : digs.substring(m.min(1), (m - 1).max(0)) ||: else : "0"
        alias sci_txt  :- digs.substring(0, m.min(1)) + "." + sci_frac + "E" + e.to_string()
        ||: m == 0 : "0.0" ||: is_inf : "Infinity" ||: e <= -325 : "0.0" ||: e >= 0 and e < 7 : int_txt + "." + frac_txt ||: e < 0 and e >= -3 : neg_txt ||: else : sci_txt

    num_value_text :- ||: num_kind == "float" : self.render_float(num_sig_trim, num_sci_exp) ||: num_prefix.length() > 0 : num_val.to_string() ||: num_sig.length() == 0 : "0" ||: else : num_sig

    top_indent :- indent_stack.at((indent_stack.count() - 1).max(0)) ?? 0

    # Chapter 26, mirrored from slice 33. The last line owes its line
    # bump when it has content, and its NEWLINE only outside brackets.
    ends_open_line :- not at_line_start
    indent_popped  :- indent_str.substring((indent_str.index_of(" ") + 1).max(0).min(indent_str.length()), (indent_str.length() - indent_str.index_of(" ") - 1).max(0))
    eol_newline    :- bracket_depth == 0 and not line_is_cont

    # Chapter 28 def-frame probes. `def_trig` reads the last three
    # tokens the line left, `eol_def` arms the frame at the line end
    # when no NEWLINE closes the line.
    def_on     :- def_base >= 0
    def_in     :- def_on and line_indent > def_base
    def_out    :- def_on and line_indent <= def_base
    at_content :- not at_src_end and not is_sp and not is_nl and not is_hash
    tk_n       :- tokens.count()
    tk_a       :- tokens.at((tk_n - 3).max(0)) ?? Token(kind: "eof", value: "", line: line_num)
    tk_b       :- tokens.at((tk_n - 2).max(0)) ?? Token(kind: "eof", value: "", line: line_num)
    tk_c       :- tokens.at((tk_n - 1).max(0)) ?? Token(kind: "eof", value: "", line: line_num)
    def_trig_a :- tk_a.kind == "glyph" and tk_a.value == "=>"
    def_trig_b :- tk_b.kind == "kw" and tk_b.value == "def"
    def_trig_c :- tk_c.kind == "punct" and tk_c.value == ":"
    def_trig   :- tk_n >= 3 and def_trig_a and def_trig_b and def_trig_c
    eol_def    :- not line_in_def and not eol_newline and def_trig
    eol_nl_tok :- eol_newline and not line_in_def

    # Chapter 26. Every char class some step arm consumes, grouped so
    # the unexpected-char guard does not blow up the emit (each `and` /
    # `or` duplicates its left operand in the generated text).
    lex_known_a :- is_sp or is_nl or is_comma or is_colon or is_lparen
    lex_known_b :- is_rparen or is_bang or is_q or is_eq or is_dash
    lex_known_c :- is_lt or is_gt or is_pipe or is_id_start or is_digit
    lex_known_d :- is_dquote or is_squote or is_lbracket or is_rbracket or is_lbrace
    lex_known_e :- is_rbrace or is_dot or is_semi or is_plus or is_star
    lex_known_f :- is_slash or is_pct or is_amp or is_at or is_hash
    lex_known   :- lex_known_a or lex_known_b or lex_known_c or lex_known_d or lex_known_e or lex_known_f

    cur_tok   :- tokens.at(pos) ?? Token(kind: "eof", value: "", line: line_num)
    cur_kind  :- cur_tok.kind
    cur_value :- cur_tok.value
    cur_line  :- cur_tok.line

    -> lex_start
        then:
            source => args.get_or(1, "").replace("\\n", "\n").replace("\\N", "\\n")
            self :> step

    -> parsing
        then: self :> dispatch

    -> end
        then:
            let is_layout: Bool! = cur_kind == "newline" or cur_kind == "indent" or cur_kind == "dedent" or cur_kind == "eof"
            let value_pretty: String! = ||: is_layout : "nil" ||: else : "\"" + cur_value + "\""
            let err_out: String! = "parseerror|parse error: " + error_msg + " (got :" + cur_kind + " " + value_pretty + " at line " + cur_line.to_string() + ")"
            let lex_out: String! = "parseerror|" + error_msg
            let final: String! = ||: error and lex_error : lex_out ||: error : err_out ||: else : out
            console.write(final)

    lex_start <: step -> lex_start
        |: at_src_end and not error and ends_open_line and dedent_err != ""
        then:
            error => true
            lex_error => true
            error_msg => dedent_err
            self :> step

    lex_start <: step -> lex_start
        |: at_src_end and not error and ends_open_line and dedent_err == ""
        then:
            tokens => ||: eol_nl_tok : tokens.append(Token(kind: "newline", value: "", line: line_num)) ||: else : tokens
            def_base => ||: eol_def : line_indent ||: else : def_base
            def_seen => ||: eol_def : false ||: else : def_seen
            line_in_def => false
            line_num => line_num + 1
            at_line_start => true
            self :> step

    lex_start <: step -> lex_start
        |: at_src_end and not error and not ends_open_line
        then:
            self :> emit_trailing_dedents

    # At line start, consume indent and compare to top of stack.
    lex_start <: step -> lex_start
        |: not at_src_end and at_line_start
        then:
            self :> measure_indent

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_sp
        then:
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_nl and dedent_err != ""
        then:
            error => true
            lex_error => true
            error_msg => dedent_err
            sc => source.length()
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_nl and dedent_err == ""
        then:
            tokens => ||: eol_nl_tok : tokens.append(Token(kind: "newline", value: "", line: line_num)) ||: else : tokens
            def_base => ||: eol_def : line_indent ||: else : def_base
            def_seen => ||: eol_def : false ||: else : def_seen
            line_in_def => false
            line_is_cont => bracket_depth > 0
            line_num => line_num + 1
            sc => sc + 1
            at_line_start => true
            line_indent => 0
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_comma
        then:
            tokens => tokens.append(Token(kind: "punct", value: ",", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_colon and not is_col_dash and not is_col_gt
        then:
            tokens => tokens.append(Token(kind: "punct", value: ":", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_lparen
        then:
            tokens => tokens.append(Token(kind: "punct", value: "(", line: line_num))
            bracket_depth => bracket_depth + 1
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_rparen
        then:
            tokens => tokens.append(Token(kind: "punct", value: ")", line: line_num))
            bracket_depth => bracket_depth - 1
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_bang and not is_bang_eq
        then:
            tokens => tokens.append(Token(kind: "punct", value: "!", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_q and not is_double_q
        then:
            tokens => tokens.append(Token(kind: "punct", value: "?", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_any_multi
        then:
            let two: String! = source.substring(sc, 2)
            tokens => tokens.append(Token(kind: "glyph", value: two, line: line_num))
            sc => sc + 2
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_eq and not is_fat_arrow and not is_eq_eq
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "=", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_dash and not is_arrow
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "-", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_lt and not is_lt_col and not is_lte and not is_lt_pipe
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "<", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_gt and not is_gte
        then:
            tokens => tokens.append(Token(kind: "glyph", value: ">", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_pipe and not is_pipe_col and not is_pipe_gt and not is_dpipe_col
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "|", line: line_num))
            sc => sc + 1
            self :> step

    # Chapter-26 arms, mirrored from slice 33.
    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_dpipe_col
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "||:", line: line_num))
            sc => sc + 3
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_lbracket
        then:
            tokens => tokens.append(Token(kind: "punct", value: "[", line: line_num))
            bracket_depth => bracket_depth + 1
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_rbracket
        then:
            tokens => tokens.append(Token(kind: "punct", value: "]", line: line_num))
            bracket_depth => bracket_depth - 1
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_lbrace
        then:
            tokens => tokens.append(Token(kind: "punct", value: "{", line: line_num))
            bracket_depth => bracket_depth + 1
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_rbrace
        then:
            tokens => tokens.append(Token(kind: "punct", value: "}", line: line_num))
            bracket_depth => bracket_depth - 1
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_dot
        then:
            tokens => tokens.append(Token(kind: "punct", value: ".", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_semi
        then:
            tokens => tokens.append(Token(kind: "punct", value: ";", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_plus
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "+", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_star and not is_dstar
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "*", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_slash and not is_dslash
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "/", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_pct
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "%", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_amp
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "&", line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_hash
        then:
            sc => sc + line_rest
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_at
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "annotation grammar (`@name(...)`) is retired at v1.0 (annotation-grammar-retirement 2026-08-30). Plugin manifest → `def plugin:` block (spec §7.2). Metadata (kind) → body-shape inference (§3.3). Deprecation → comment / user convention."
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_id_start
        then:
            word_acc => ""
            self :> scan_word

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_digit
        then:
            num_digs => ""
            num_last_digit => false
            num_mode => "int"
            num_base => 10
            num_prefix => ""
            num_int => ""
            num_frac => ""
            num_exp => ""
            num_has_dot => false
            num_has_exp => false
            num_exp_sign => ""
            num_kind => "int"
            num_val => 0
            num_sig => ""
            num_sig_nz => 0
            num_int_sig => 0
            num_frac_lead => 0
            num_exp_val => 0
            self :> num_start

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_dquote
        then:
            word_acc => ""
            sc => sc + 1
            self :> scan_str

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_squote
        then:
            word_acc => ""
            sc => sc + 1
            self :> scan_char_body

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and not lex_known
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => ||: srccur > 32 and srccur < 127 : "unexpected character: \\" + source.substring(sc, 1) ||: else : "lex: unexpected char"
            self :> step

    lex_start <: step -> end
        |: error

    lex_start <: measure_indent -> lex_start
        |: not at_src_end and is_sp
        then:
            line_indent => line_indent + 1
            sc => sc + 1
            self :> measure_indent

    # Blank line — reset to start without emitting layout.
    lex_start <: measure_indent -> lex_start
        |: not at_src_end and is_nl
        then:
            line_num => line_num + 1
            sc => sc + 1
            line_indent => 0
            self :> measure_indent

    lex_start <: measure_indent -> lex_start
        |: at_src_end
        then: self :> emit_trailing_dedents

    # Non-space, non-newline content starts here. Compare indent.
    # Chapter 26, mirrored from slice 33. A comment-only line is blank,
    # a continuation line skips the indent comparison.
    lex_start <: measure_indent -> lex_start
        |: not at_src_end and is_hash
        then:
            sc => sc + line_rest
            self :> measure_indent

    # Chapter 28. Inside an armed def-frame a deeper line opens with
    # INDENT or NEWLINE, a line at or under the base closes the frame
    # and is measured again under the normal rules.
    lex_start <: measure_indent -> lex_start
        |: at_content and def_in
        then:
            tokens => tokens.append(||: def_seen : Token(kind: "newline", value: "", line: line_num) ||: else : Token(kind: "indent", value: "", line: line_num))
            def_seen => true
            line_in_def => true
            at_line_start => false
            line_content_sc => sc
            self :> step

    lex_start <: measure_indent -> lex_start
        |: at_content and def_out
        then:
            tokens => tokens.append(Token(kind: "newline", value: "", line: line_num)).append(Token(kind: "dedent", value: "", line: line_num))
            def_base => -1
            self :> measure_indent

    lex_start <: measure_indent -> lex_start
        |: at_content and not def_on and not line_is_cont
        then:
            at_line_start => false
            line_content_sc => sc
            dedenting => false
            indent_snap => indent_str
            self :> adjust_indent

    lex_start <: measure_indent -> lex_start
        |: at_content and not def_on and line_is_cont
        then:
            at_line_start => false
            line_content_sc => sc
            self :> step

    lex_start <: adjust_indent -> lex_start
        |: line_indent > top_indent and not dedenting
        then:
            tokens => tokens.append(Token(kind: "indent", value: "", line: line_num))
            indent_stack => indent_stack.append(line_indent)
            indent_str => line_indent.to_string() + " " + indent_str
            self :> step

    lex_start <: adjust_indent -> lex_start
        |: line_indent > top_indent and dedenting
        then:
            dedent_err => "inconsistent dedent at line " + line_num.to_string() + ": this line's indent (" + line_indent.to_string() + (||: line_indent == 1 : " column" ||: else : " columns") + ") does not match any enclosing block's indent level (open blocks are at [" + indent_snap + "]). Fix: align this line with one of those indents, or make the parent block consistent (typically means mixing tabs and spaces or a stray half-indent)."
            self :> step

    lex_start <: adjust_indent -> lex_start
        |: line_indent < top_indent
        then:
            tokens => tokens.append(Token(kind: "dedent", value: "", line: line_num))
            indent_stack => indent_stack.filter(x => x < top_indent)
            indent_str => indent_popped
            dedenting => true
            self :> adjust_indent

    lex_start <: adjust_indent -> lex_start
        |: line_indent == top_indent
        then: self :> step

    # Chapter 28. A frame still armed at end of source closes first.
    lex_start <: emit_trailing_dedents -> lex_start
        |: def_on
        then:
            tokens => tokens.append(Token(kind: "dedent", value: "", line: line_num))
            def_base => -1
            self :> emit_trailing_dedents

    lex_start <: emit_trailing_dedents -> parsing
        |: not def_on and indent_stack.count() <= 1
        then:
            tokens => tokens.append(Token(kind: "eof", value: "", line: line_num))

    lex_start <: emit_trailing_dedents -> lex_start
        |: not def_on and indent_stack.count() > 1
        then:
            tokens => tokens.append(Token(kind: "dedent", value: "", line: line_num))
            indent_stack => indent_stack.filter(x => x < top_indent)
            self :> emit_trailing_dedents

    lex_start <: scan_word -> lex_start
        |: not at_src_end and is_id_cont
        then:
            word_acc => word_acc + source.substring(sc, 1)
            sc => sc + 1
            self :> scan_word

    lex_start <: scan_word -> lex_start
        |: at_src_end or not is_id_cont
        then:
            let kind: String! = ||: reserved.contains(word_acc) : "kw" ||: else : "ident"
            tokens => tokens.append(Token(kind: kind, value: word_acc, line: line_num))
            self :> step

    # Chapter-25 — scan-number port. `num_start` picks the base the way
    # Clojure's scan-number does (prefix `0x` / `0b` / `0o`, C-octal
    # rejection, else decimal), `scan_digs` is scan-digits with its
    # three `_` errors, `digs_done` routes on `num_mode` to the next
    # part (frac, signed exponent, hex frac), and `num_suffix` /
    # `scan_sfx` port reject-unit-suffix!. Every error arm parks `sc` at
    # end of source (chapter-23 rule).
    lex_start <: num_start -> lex_start
        |: srccur == 48 and (srcnext == 120 or srcnext == 88)
        then:
            num_base => 16
            num_prefix => "0x"
            num_mode => "based"
            sc => sc + 2
            self :> scan_digs

    lex_start <: num_start -> lex_start
        |: srccur == 48 and (srcnext == 98 or srcnext == 66)
        then:
            num_base => 2
            num_prefix => "0b"
            num_mode => "based"
            sc => sc + 2
            self :> scan_digs

    lex_start <: num_start -> lex_start
        |: srccur == 48 and (srcnext == 111 or srcnext == 79)
        then:
            num_base => 8
            num_prefix => "0o"
            num_mode => "based"
            sc => sc + 2
            self :> scan_digs

    lex_start <: num_start -> lex_start
        |: srccur == 48 and srcnext >= 48 and srcnext <= 57
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "leading-zero integer `" + lz_snip + "…` — cxc rejects C's `017` octal form as ambiguous. Use `0o17` for octal or drop the leading zero for decimal. See spec §2.7.1."
            self :> step

    lex_start <: num_start -> lex_start
        |: not (srccur == 48 and (srcnext == 120 or srcnext == 88 or srcnext == 98 or srcnext == 66 or srcnext == 111 or srcnext == 79 or (srcnext >= 48 and srcnext <= 57)))
        then: self :> scan_digs

    lex_start <: scan_digs -> lex_start
        |: not num_run_end and num_digit_val >= 0
        then:
            let ch: String! = source.substring(sc, 1)
            let sig_mode: Bool! = num_mode == "int" or num_mode == "frac"
            let skip: Bool! = num_sig.length() == 0 and srccur == 48
            num_digs => num_digs + ch
            num_last_digit => true
            num_sig => ||: sig_mode and not skip : num_sig + ch ||: else : num_sig
            num_sig_nz => ||: sig_mode and srccur != 48 : num_sig.length() + 1 ||: else : num_sig_nz
            num_int_sig => ||: num_mode == "int" and not skip : num_int_sig + 1 ||: else : num_int_sig
            num_frac_lead => ||: num_mode == "frac" and skip : num_frac_lead + 1 ||: else : num_frac_lead
            num_exp_val => ||: num_mode == "exp" : (num_exp_val * 10 + srccur - 48).min(1000000) ||: else : num_exp_val
            num_val => ||: num_mode == "based" : num_val * num_base + num_digit_val ||: else : num_val
            sc => sc + 1
            self :> scan_digs

    lex_start <: scan_digs -> lex_start
        |: not num_run_end and num_digit_val < 0 and is_us and num_last_digit
        then:
            num_last_digit => false
            sc => sc + 1
            self :> scan_digs

    lex_start <: scan_digs -> lex_start
        |: not num_run_end and num_digit_val < 0 and is_us and not num_last_digit
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "`_` in numeric literal must follow a digit"
            self :> step

    lex_start <: scan_digs -> lex_start
        |: num_run_end and num_digs.length() > 0 and not num_last_digit
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "numeric literal ends with `_`"
            self :> step

    lex_start <: scan_digs -> lex_start
        |: not num_run_end and num_digit_val < 0 and not is_us and num_digs.length() > 0 and not num_last_digit
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "numeric literal has trailing `_`"
            self :> step

    lex_start <: scan_digs -> lex_start
        |: (num_run_end or (num_digit_val < 0 and not is_us)) and (num_digs.length() == 0 or num_last_digit)
        then: self :> digs_done

    # Int part done. `.` plus a digit opens the frac run, `e` / `E` the
    # exponent, anything else ends an int.
    lex_start <: digs_done -> lex_start
        |: num_mode == "int" and is_dot and srcnext_is_digit
        then:
            num_int => num_digs
            num_has_dot => true
            num_digs => ""
            num_last_digit => false
            num_mode => "frac"
            sc => sc + 1
            self :> scan_digs

    lex_start <: digs_done -> lex_start
        |: num_mode == "int" and not (is_dot and srcnext_is_digit) and is_exp_marker
        then:
            num_int => num_digs
            num_has_exp => true
            sc => sc + 1
            self :> scan_exp_sign

    lex_start <: digs_done -> lex_start
        |: num_mode == "int" and not (is_dot and srcnext_is_digit) and not is_exp_marker
        then:
            num_int => num_digs
            self :> num_suffix

    lex_start <: digs_done -> lex_start
        |: num_mode == "frac" and is_exp_marker
        then:
            num_frac => num_digs
            num_has_exp => true
            sc => sc + 1
            self :> scan_exp_sign

    lex_start <: digs_done -> lex_start
        |: num_mode == "frac" and not is_exp_marker
        then:
            num_frac => num_digs
            num_kind => "float"
            self :> num_suffix

    lex_start <: digs_done -> lex_start
        |: num_mode == "exp" and num_digs.length() == 0
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "exponent requires digits after `e`/`E`/`p`/`P`"
            self :> step

    lex_start <: digs_done -> lex_start
        |: num_mode == "exp" and num_digs.length() > 0
        then:
            num_exp => num_digs
            num_kind => "float"
            self :> num_suffix

    # Based ints. A hex `.` plus hex digit opens the hex-float frac run.
    # The C99 `p` exponent form itself is out of port scope (its value
    # is binary and needs exact rendering), so it raises a port-only
    # message the corpus never carries.
    lex_start <: digs_done -> lex_start
        |: num_mode == "based" and num_base == 16 and is_dot and next_hex >= 0
        then:
            num_digs => ""
            num_last_digit => false
            num_mode => "hexfrac"
            sc => sc + 1
            self :> scan_digs

    lex_start <: digs_done -> lex_start
        |: (num_mode == "hexfrac" or (num_mode == "based" and num_base == 16 and not (is_dot and next_hex >= 0))) and is_p_marker
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "lex: hex-float literal out of port scope"
            self :> step

    lex_start <: digs_done -> lex_start
        |: num_mode == "hexfrac" and not is_p_marker
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "hex-float literal requires the `p`/`P` binary exponent (C99 form; e.g. `0x1.8p+1`)"
            self :> step

    lex_start <: digs_done -> lex_start
        |: num_mode == "based" and not (num_base == 16 and ((is_dot and next_hex >= 0) or is_p_marker)) and num_digs.length() == 0
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "empty numeric literal after `" + num_prefix + "`/`" + num_prefix.uppercase() + "` prefix"
            self :> step

    lex_start <: digs_done -> lex_start
        |: num_mode == "based" and not (num_base == 16 and ((is_dot and next_hex >= 0) or is_p_marker)) and num_digs.length() > 0
        then: self :> num_suffix

    lex_start <: scan_exp_sign -> lex_start
        |: srccur == 43 or srccur == 45
        then:
            num_exp_sign => source.substring(sc, 1)
            num_digs => ""
            num_last_digit => false
            num_mode => "exp"
            sc => sc + 1
            self :> scan_digs

    lex_start <: scan_exp_sign -> lex_start
        |: not (srccur == 43 or srccur == 45)
        then:
            num_digs => ""
            num_last_digit => false
            num_mode => "exp"
            self :> scan_digs

    # reject-unit-suffix!. A letter or `_` right after the literal is a
    # retired F5 unit suffix. The message quotes the separator-stripped
    # literal plus the whole identifier-like run.
    lex_start <: num_suffix -> lex_start
        |: not num_run_end and (is_letter or is_us)
        then:
            sfx_acc => ""
            sfx_col => cur_col
            self :> scan_sfx

    lex_start <: num_suffix -> lex_start
        |: num_run_end or not (is_letter or is_us)
        then:
            tokens => tokens.append(Token(kind: num_kind, value: num_value_text, line: line_num))
            self :> step

    lex_start <: scan_sfx -> lex_start
        |: not num_run_end and is_id_cont
        then:
            sfx_acc => sfx_acc + source.substring(sc, 1)
            sc => sc + 1
            self :> scan_sfx

    lex_start <: scan_sfx -> lex_start
        |: num_run_end or not is_id_cont
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "numeric literal with unit suffix at line " + line_num.to_string() + ", col " + sfx_col.to_string() + ": `" + num_str + sfx_acc + "` — unit suffixes are not part of v1 (spec §2.7.1). Use the type constructor instead, e.g. `Duration(millis: " + num_str + ")`."
            self :> step

    lex_start <: scan_str -> lex_start
        |: not at_src_end and not is_dquote and not is_nl and not is_bslash
        then:
            word_acc => word_acc + self.enc(srccur)
            sc => sc + 1
            self :> scan_str

    # Chapter-23 — backslash in string body. Hand off to the shared
    # escape phases, which decode and re-encode through `enc`.
    lex_start <: scan_str -> lex_start
        |: not at_src_end and is_bslash
        then:
            esc_mode => "str"
            sc => sc + 1
            self :> scan_esc

    lex_start <: scan_str -> lex_start
        |: not at_src_end and is_dquote
        then:
            tokens => tokens.append(Token(kind: "string", value: word_acc, line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: scan_str -> lex_start
        |: at_src_end or is_nl
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "unterminated string literal"
            self :> step

    # Chapter-23 — shared escape phases. Every error arm jumps `sc` to
    # the end of source so no content arm on `step` fires again after
    # the error is raised.
    lex_start <: scan_esc -> lex_start
        |: at_src_end or is_nl
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => ||: esc_mode == "str" : "trailing backslash in string" ||: else : "trailing backslash in char literal"
            self :> step

    lex_start <: scan_esc -> lex_start
        |: not at_src_end and simple_esc_code >= 0
        then:
            word_acc => word_acc + self.enc(simple_esc_code)
            sc => sc + 1
            self :> esc_done

    lex_start <: scan_esc -> lex_start
        |: not at_src_end and is_esc_x
        then:
            sc => sc + 1
            self :> scan_hex_byte

    lex_start <: scan_esc -> lex_start
        |: not at_src_end and is_esc_u
        then:
            sc => sc + 1
            self :> scan_uni_open

    lex_start <: scan_esc -> lex_start
        |: not at_src_end and not is_nl and simple_esc_code < 0 and not is_esc_x and not is_esc_u
        then:
            error => true
            lex_error => true
            error_msg => "unknown escape sequence `\\" + source.substring(sc, 1) + "` — legal escapes: \\n \\t \\r \\\\ \\\" \\' \\0 \\a \\b \\f \\v \\xNN \\u{...} (spec §2.7.1)"
            sc => source.length()
            self :> step

    lex_start <: scan_hex_byte -> lex_start
        |: cur_hex >= 0 and next_hex >= 0
        then:
            word_acc => word_acc + self.enc(cur_hex * 16 + next_hex)
            sc => sc + 2
            self :> esc_done

    lex_start <: scan_hex_byte -> lex_start
        |: cur_hex < 0 or next_hex < 0
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "`\\xNN` escape requires exactly two hex digits"
            self :> step

    lex_start <: scan_uni_open -> lex_start
        |: not at_src_end and is_lbrace
        then:
            esc_hex => ""
            esc_val => 0
            sc => sc + 1
            self :> scan_uni_body

    lex_start <: scan_uni_open -> lex_start
        |: at_src_end or not is_lbrace
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "`\\u` escape requires `{...}` (e.g. `\\u{1F600}`)"
            self :> step

    lex_start <: scan_uni_body -> lex_start
        |: at_src_end or is_nl
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "unterminated `\\u{...}` escape"
            self :> step

    lex_start <: scan_uni_body -> lex_start
        |: not at_src_end and cur_hex >= 0
        then:
            esc_hex => esc_hex + source.substring(sc, 1)
            esc_val => ||: esc_hex.length() >= 7 : esc_val ||: else : esc_val * 16 + cur_hex
            sc => sc + 1
            self :> scan_uni_body

    lex_start <: scan_uni_body -> lex_start
        |: not at_src_end and not is_nl and cur_hex < 0 and not is_rbrace
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "`\\u{...}` escape body must be hex digits"
            self :> step

    lex_start <: scan_uni_body -> lex_start
        |: not at_src_end and is_rbrace and not uni_len_ok
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "`\\u{...}` escape requires 1-6 hex digits"
            self :> step

    lex_start <: scan_uni_body -> lex_start
        |: not at_src_end and is_rbrace and uni_len_ok and esc_val > 1114111
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "Unicode escape U+" + esc_hex + " exceeds U+10FFFF"
            self :> step

    lex_start <: scan_uni_body -> lex_start
        |: not at_src_end and is_rbrace and uni_len_ok and esc_val <= 1114111
        then:
            word_acc => word_acc + self.enc(esc_val)
            sc => sc + 1
            self :> esc_done

    lex_start <: esc_done -> lex_start
        |: esc_mode == "str"
        then: self :> scan_str

    lex_start <: esc_done -> lex_start
        |: esc_mode != "str"
        then: self :> scan_char_close

    lex_start <: scan_char_body -> lex_start
        |: not at_src_end and is_bslash
        then:
            esc_mode => "char"
            char_esc => true
            sc => sc + 1
            self :> scan_esc

    lex_start <: scan_char_body -> lex_start
        |: not at_src_end and is_squote
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "empty char literal `''` — need one character"
            self :> step

    lex_start <: scan_char_body -> lex_start
        |: not at_src_end and not is_squote and not is_nl and not is_bslash
        then:
            word_acc => word_acc + self.enc(srccur)
            char_esc => false
            sc => sc + 1
            self :> scan_char_close

    lex_start <: scan_char_body -> lex_start
        |: at_src_end or is_nl
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => "unterminated char literal"
            self :> step

    lex_start <: scan_char_close -> lex_start
        |: not at_src_end and is_squote
        then:
            tokens => tokens.append(Token(kind: "char", value: word_acc, line: line_num))
            sc => sc + 1
            self :> step

    lex_start <: scan_char_close -> lex_start
        |: at_src_end or not is_squote
        then:
            error => true
            lex_error => true
            sc => source.length()
            error_msg => ||: char_esc : "unterminated char literal — expected `'`" ||: else : "char literal must contain exactly one character"
            self :> step

    parsing <: dispatch -> end
        |: error

    parsing <: dispatch -> end
        |: not error and cur_kind == "eof"

    parsing <: dispatch -> parsing
        |: not error and cur_kind == "newline"
        then:
            pos => pos + 1
            self :> dispatch

    parsing <: dispatch -> parsing
        |: not error and cur_kind == "kw" and cur_value == "from"
        then:
            pos => pos + 1
            self :> read_from_module

    parsing <: dispatch -> parsing
        |: not error and cur_kind == "kw" and cur_value == "def"
        then:
            pos => pos + 1
            self :> read_def_name

    parsing <: dispatch -> parsing
        |: not error and not (cur_kind == "eof" or cur_kind == "newline" or (cur_kind == "kw" and (cur_value == "from" or cur_value == "def")))
        then:
            error => true
            error_msg => "expected top-level form"
            self :> dispatch

    # def NAME :  NEWLINE  INDENT  <fields>  DEDENT
    parsing <: read_def_name -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected :ident"
            self :> dispatch

    parsing <: read_def_name -> parsing
        then:
            out => ||: out.length() > 0 : out + "\n" ||: else : out
            def_name_buf => cur_value
            def_prefix_set => false
            pos => pos + 1
            self :> after_def_name

    parsing <: after_def_name -> parsing
        |: cur_kind == "punct" and cur_value == "("
        then:
            out => out + "defatom|" + def_name_buf + "|"
            def_prefix_set => true
            pos => pos + 1
            self :> parse_ctor_param

    parsing <: after_def_name -> parsing
        |: not (cur_kind == "punct" and cur_value == "(")
        then: self :> expect_def_colon

    parsing <: parse_ctor_param -> parsing
        |: cur_kind == "punct" and cur_value == ")"
        then:
            out => out + "|"
            pos => pos + 1
            self :> expect_def_colon

    parsing <: parse_ctor_param -> parsing
        |: cur_kind != "ident" and not (cur_kind == "punct" and cur_value == ")")
        then:
            error => true
            error_msg => "expected ctor-param name"
            self :> dispatch

    parsing <: parse_ctor_param -> parsing
        |: cur_kind == "ident"
        then:
            field_name_buf => cur_value
            pos => pos + 1
            self :> expect_ctor_param_colon

    parsing <: expect_ctor_param_colon -> parsing
        |: not (cur_kind == "punct" and cur_value == ":")
        then:
            error => true
            error_msg => "expected `:` after ctor-param name"
            self :> dispatch

    parsing <: expect_ctor_param_colon -> parsing
        then:
            pos => pos + 1
            self :> parse_ctor_param_type

    parsing <: parse_ctor_param_type -> parsing
        |: cur_kind == "punct" and cur_value == "("
        then:
            nt_body_buf => ""
            nt_depth => 0
            nt_return_mode => "ctor"
            pos => pos + 1
            self :> parse_nt_fname

    parsing <: parse_ctor_param_type -> parsing
        |: cur_kind != "ident" and not (cur_kind == "punct" and cur_value == "(")
        then:
            error => true
            error_msg => "expected ctor-param type name"
            self :> dispatch

    parsing <: parse_ctor_param_type -> parsing
        then:
            type_name_buf => cur_value
            pos => pos + 1
            self :> after_ctor_param_type_name

    parsing <: after_ctor_param_type_name -> parsing
        |: cur_kind == "punct" and cur_value == "!"
        then:
            type_ser_buf => "TN(TR:" + type_name_buf + ")"
            pos => pos + 1
            self :> emit_ctor_param

    parsing <: after_ctor_param_type_name -> parsing
        |: not (cur_kind == "punct" and cur_value == "!")
        then:
            type_ser_buf => "TR:" + type_name_buf
            self :> emit_ctor_param

    parsing <: emit_ctor_param -> parsing
        then:
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + field_name_buf + ":" + type_ser_buf
            self :> after_ctor_param

    parsing <: after_ctor_param -> parsing
        |: cur_kind == "punct" and cur_value == ","
        then:
            pos => pos + 1
            self :> parse_ctor_param

    parsing <: after_ctor_param -> parsing
        |: cur_kind == "punct" and cur_value == ")"
        then:
            out => out + "|"
            pos => pos + 1
            self :> expect_def_colon

    parsing <: after_ctor_param -> parsing
        |: not (cur_kind == "punct" and (cur_value == "," or cur_value == ")"))
        then:
            error => true
            error_msg => "expected `,` or `)` after ctor-param"
            self :> dispatch

    parsing <: expect_def_colon -> parsing
        |: not (cur_kind == "punct" and cur_value == ":")
        then:
            error => true
            error_msg => "expected :punct \":\""
            self :> dispatch

    parsing <: expect_def_colon -> parsing
        then:
            pos => pos + 1
            self :> expect_def_newline

    parsing <: expect_def_newline -> parsing
        |: cur_kind != "newline"
        then:
            error => true
            error_msg => "expected :newline"
            self :> dispatch

    parsing <: expect_def_newline -> parsing
        then:
            pos => pos + 1
            self :> expect_def_indent

    parsing <: expect_def_indent -> parsing
        |: cur_kind != "indent"
        then:
            error => true
            error_msg => "expected :indent"
            self :> dispatch

    parsing <: expect_def_indent -> parsing
        then:
            pos => pos + 1
            self :> parse_field

    parsing <: parse_field -> parsing
        |: cur_kind == "dedent"
        then:
            out => ||: def_prefix_set : out ||: else : out + "defrecord|" + def_name_buf + "|"
            def_prefix_set => true
            pos => pos + 1
            self :> dispatch

    parsing <: parse_field -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> parse_field

    parsing <: parse_field -> parsing
        |: cur_kind == "kw" and cur_value == "case"
        then:
            out => ||: def_prefix_set : out ||: else : out + "defenum|" + def_name_buf + "|"
            def_prefix_set => true
            self :> parse_enum_case

    parsing <: parse_field -> parsing
        |: cur_kind == "kw" and cur_value == "use"
        then:
            out => ||: def_prefix_set : out ||: else : out + "defatom|" + def_name_buf + "||"
            def_prefix_set => true
            pos => pos + 1
            self :> read_use_cap_name

    parsing <: read_use_cap_name -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected :ident"
            self :> dispatch

    parsing <: read_use_cap_name -> parsing
        then:
            pos => pos + 1
            self :> expect_use_colon

    parsing <: expect_use_colon -> parsing
        |: not (cur_kind == "punct" and cur_value == ":")
        then:
            error => true
            error_msg => "expected :punct \":\""
            self :> dispatch

    parsing <: expect_use_colon -> parsing
        then:
            pos => pos + 1
            self :> expect_use_type_name

    parsing <: expect_use_type_name -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected :ident"
            self :> dispatch

    parsing <: expect_use_type_name -> parsing
        then:
            pos => pos + 1
            self :> parse_field

    parsing <: parse_field -> parsing
        |: cur_kind != "ident" and cur_kind != "dedent" and cur_kind != "newline" and not (cur_kind == "kw" and cur_value == "case") and not (cur_kind == "kw" and cur_value == "use")
        then:
            error => true
            error_msg => "expected field name"
            self :> dispatch

    parsing <: parse_field -> parsing
        |: cur_kind == "ident"
        then:
            out => ||: def_prefix_set : out ||: else : out + "defrecord|" + def_name_buf + "|"
            def_prefix_set => true
            field_name_buf => cur_value
            pos => pos + 1
            self :> expect_field_colon

    parsing <: expect_field_colon -> parsing
        |: not (cur_kind == "punct" and cur_value == ":")
        then:
            error => true
            error_msg => "expected `:` after field name"
            self :> dispatch

    parsing <: expect_field_colon -> parsing
        then:
            pos => pos + 1
            self :> parse_field_type

    parsing <: parse_field_type -> parsing
        |: cur_kind == "punct" and cur_value == "("
        then:
            nt_body_buf => ""
            nt_depth => 0
            nt_return_mode => "field"
            pos => pos + 1
            self :> parse_nt_fname

    parsing <: parse_field_type -> parsing
        |: cur_kind != "ident" and not (cur_kind == "punct" and cur_value == "(")
        then:
            error => true
            error_msg => "expected type name"
            self :> dispatch

    parsing <: parse_field_type -> parsing
        then:
            type_name_buf => cur_value
            pos => pos + 1
            self :> after_type_name

    parsing <: parse_nt_fname -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected named-tuple field name"
            self :> dispatch

    parsing <: parse_nt_fname -> parsing
        then:
            nt_fname_buf => cur_value
            pos => pos + 1
            self :> expect_nt_colon

    parsing <: expect_nt_colon -> parsing
        |: not (cur_kind == "punct" and cur_value == ":")
        then:
            error => true
            error_msg => "expected `:` in named-tuple field"
            self :> dispatch

    parsing <: expect_nt_colon -> parsing
        then:
            pos => pos + 1
            self :> parse_nt_type

    parsing <: parse_nt_type -> parsing
        |: cur_kind == "punct" and cur_value == "("
        then:
            # Chapter-20 nested-TNT push. Save outer body and fname,
            # reset for fresh nested parse, bump depth. The `.slice(0,
            # nt_depth)` discipline (chapter-18 idiom) purges dead
            # values from a popped sibling nested at the same depth.
            nt_body_buf_stack => nt_body_buf_stack.slice(0, nt_depth).append(nt_body_buf)
            nt_fname_buf_stack => nt_fname_buf_stack.slice(0, nt_depth).append(nt_fname_buf)
            nt_body_buf => ""
            nt_depth => nt_depth + 1
            pos => pos + 1
            self :> parse_nt_fname

    parsing <: parse_nt_type -> parsing
        |: cur_kind != "ident" and not (cur_kind == "punct" and cur_value == "(")
        then:
            error => true
            error_msg => "expected named-tuple field type"
            self :> dispatch

    parsing <: parse_nt_type -> parsing
        then:
            nt_tname_buf => cur_value
            pos => pos + 1
            self :> after_nt_type

    parsing <: after_nt_type -> parsing
        |: cur_kind == "punct" and cur_value == "!"
        then:
            let sep: String! = ||: nt_body_buf.length() == 0 : "" ||: else : ","
            nt_body_buf => nt_body_buf + sep + nt_fname_buf + ":TN(TR:" + nt_tname_buf + ")"
            pos => pos + 1
            self :> after_nt_pair

    # Chapter-22 — container inner type inside a named-tuple pair.
    # Routes through the shared container-parse arms with the
    # container_return_mode sentinel set so finish_container appends
    # the TO form to nt_body_buf (not type_ser_buf) and returns to
    # after_nt_pair.
    parsing <: after_nt_type -> parsing
        |: cur_kind == "kw" and cur_value == "of"
        then:
            container_return_mode => "nt_body"
            pos => pos + 1
            self :> parse_of_inner

    parsing <: after_nt_type -> parsing
        |: not (cur_kind == "punct" and cur_value == "!") and not (cur_kind == "kw" and cur_value == "of")
        then:
            let sep: String! = ||: nt_body_buf.length() == 0 : "" ||: else : ","
            nt_body_buf => nt_body_buf + sep + nt_fname_buf + ":TR:" + nt_tname_buf
            self :> after_nt_pair

    parsing <: after_nt_pair -> parsing
        |: cur_kind == "punct" and cur_value == ","
        then:
            pos => pos + 1
            self :> parse_nt_fname

    parsing <: after_nt_pair -> parsing
        |: cur_kind == "punct" and cur_value == ")" and nt_depth > 0
        then:
            # Chapter-20 nested-TNT pop. The nested body (current
            # nt_body_buf) becomes the type-serialization of the outer
            # pair whose fname is at the top of nt_fname_buf_stack.
            let nested_body: String! = nt_body_buf
            let outer_body:  String! = nt_body_buf_stack.at((nt_depth - 1).max(0)) ?? ""
            let outer_fname: String! = nt_fname_buf_stack.at((nt_depth - 1).max(0)) ?? ""
            let sep: String!         = ||: outer_body.length() == 0 : "" ||: else : ","
            nt_body_buf => outer_body + sep + outer_fname + ":TNT(" + nested_body + ")"
            nt_fname_buf => outer_fname
            nt_depth => nt_depth - 1
            pos => pos + 1
            self :> after_nt_pair

    parsing <: after_nt_pair -> parsing
        |: cur_kind == "punct" and cur_value == ")" and nt_depth == 0 and nt_return_mode == "ctor"
        then:
            type_ser_buf => "TNT(" + nt_body_buf + ")"
            pos => pos + 1
            self :> emit_ctor_param

    parsing <: after_nt_pair -> parsing
        |: cur_kind == "punct" and cur_value == ")" and nt_depth == 0 and nt_return_mode == "field"
        then:
            type_ser_buf => "TNT(" + nt_body_buf + ")"
            pos => pos + 1
            self :> emit_field_from_ser

    parsing <: after_nt_pair -> parsing
        |: not (cur_kind == "punct" and (cur_value == "," or cur_value == ")"))
        then:
            error => true
            error_msg => "expected `,` or `)` in named-tuple"
            self :> dispatch

    parsing <: after_type_name -> parsing
        |: cur_kind == "kw" and cur_value == "of"
        then:
            pos => pos + 1
            self :> parse_of_inner

    parsing <: after_type_name -> parsing
        |: cur_kind == "punct" and cur_value == "!"
        then:
            type_ser_buf => "TN(TR:" + type_name_buf + ")"
            pos => pos + 1
            self :> emit_field_from_ser

    parsing <: after_type_name -> parsing
        |: not (cur_kind == "punct" and cur_value == "!") and not (cur_kind == "kw" and cur_value == "of")
        then:
            type_ser_buf => "TR:" + type_name_buf
            self :> emit_field_from_ser

    parsing <: parse_of_inner -> parsing
        |: cur_kind == "punct" and cur_value == "("
        then:
            pos => pos + 1
            self :> parse_tuple_k

    parsing <: parse_of_inner -> parsing
        |: cur_kind == "ident"
        then:
            inner_ser_buf => "TR:" + cur_value
            pos => pos + 1
            self :> after_container_inner

    parsing <: parse_of_inner -> parsing
        |: cur_kind != "ident" and not (cur_kind == "punct" and cur_value == "(")
        then:
            error => true
            error_msg => "expected inner type after `of`"
            self :> dispatch

    parsing <: after_container_inner -> parsing
        |: cur_kind == "punct" and cur_value == "!"
        then:
            inner_ser_buf => "TN(" + inner_ser_buf + ")"
            pos => pos + 1
            self :> finish_container

    parsing <: after_container_inner -> parsing
        |: not (cur_kind == "punct" and cur_value == "!")
        then: self :> finish_container

    parsing <: parse_tuple_k -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected key type in tuple"
            self :> dispatch

    parsing <: parse_tuple_k -> parsing
        then:
            inner_k_buf => "TR:" + cur_value
            pos => pos + 1
            self :> after_tuple_k_name

    parsing <: after_tuple_k_name -> parsing
        |: cur_kind == "punct" and cur_value == "!"
        then:
            inner_k_buf => "TN(" + inner_k_buf + ")"
            pos => pos + 1
            self :> expect_tuple_comma

    parsing <: after_tuple_k_name -> parsing
        |: not (cur_kind == "punct" and cur_value == "!")
        then: self :> expect_tuple_comma

    parsing <: expect_tuple_comma -> parsing
        |: not (cur_kind == "punct" and cur_value == ",")
        then:
            error => true
            error_msg => "expected `,` in tuple"
            self :> dispatch

    parsing <: expect_tuple_comma -> parsing
        then:
            pos => pos + 1
            self :> parse_tuple_v

    parsing <: parse_tuple_v -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected value type in tuple"
            self :> dispatch

    parsing <: parse_tuple_v -> parsing
        then:
            inner_v_buf => "TR:" + cur_value
            pos => pos + 1
            self :> after_tuple_v_name

    parsing <: after_tuple_v_name -> parsing
        |: cur_kind == "punct" and cur_value == "!"
        then:
            inner_v_buf => "TN(" + inner_v_buf + ")"
            pos => pos + 1
            self :> expect_tuple_rparen

    parsing <: after_tuple_v_name -> parsing
        |: not (cur_kind == "punct" and cur_value == "!")
        then: self :> expect_tuple_rparen

    parsing <: expect_tuple_rparen -> parsing
        |: not (cur_kind == "punct" and cur_value == ")")
        then:
            error => true
            error_msg => "expected `)` in tuple"
            self :> dispatch

    parsing <: expect_tuple_rparen -> parsing
        then:
            inner_ser_buf => "TT(" + inner_k_buf + "," + inner_v_buf + ")"
            pos => pos + 1
            self :> finish_container

    parsing <: finish_container -> parsing
        |: container_return_mode == "field"
        then:
            type_ser_buf => "TO:" + type_name_buf + "(" + inner_ser_buf + ")"
            self :> emit_field_from_ser

    # Chapter-22 — the container was reached from a named-tuple pair.
    # type_name_buf was set by parse_field_type at the TR path only,
    # so the NT path carries the outer name via nt_tname_buf which
    # parse_nt_type stamped before the shared after_nt_type dispatch.
    # Append the pair to nt_body_buf and return to after_nt_pair; the
    # mode resets to "field" so sibling fields in the same NT body
    # route correctly on their own container entries.
    parsing <: finish_container -> parsing
        |: container_return_mode == "nt_body"
        then:
            let sep: String! = ||: nt_body_buf.length() == 0 : "" ||: else : ","
            nt_body_buf => nt_body_buf + sep + nt_fname_buf + ":TO:" + nt_tname_buf + "(" + inner_ser_buf + ")"
            container_return_mode => "field"
            self :> after_nt_pair

    parsing <: emit_field_from_ser -> parsing
        |: cur_kind == "glyph" and cur_value == "="
        then:
            pos => pos + 1
            self :> read_field_default

    parsing <: emit_field_from_ser -> parsing
        |: not (cur_kind == "glyph" and cur_value == "=")
        then:
            let field_ser: String! = field_name_buf + ":" + type_ser_buf
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + field_ser
            self :> parse_field

    parsing <: read_field_default -> parsing
        |: cur_kind == "int"
        then:
            let field_ser: String! = field_name_buf + ":" + type_ser_buf + "=INT:" + cur_value
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + field_ser
            pos => pos + 1
            self :> parse_field

    # Chapter-22 — float default. The Token value carries the literal
    # text (e.g. "1.5"); the oracle serializes `(str (:value d))` which
    # for a parsed Double 1.5 is "1.5" too. Non-canonical shapes (`01.5`
    # — the leading-zero form is already rejected at lex, so the lex
    # never emits it) are out of corpus; exponent / unit-suffix shapes
    # are deferred.
    parsing <: read_field_default -> parsing
        |: cur_kind == "float"
        then:
            let field_ser: String! = field_name_buf + ":" + type_ser_buf + "=FLOAT:" + cur_value
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + field_ser
            pos => pos + 1
            self :> parse_field

    parsing <: read_field_default -> parsing
        |: cur_kind == "string"
        then:
            let field_ser: String! = field_name_buf + ":" + type_ser_buf + "=STR:\"" + cur_value + "\""
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + field_ser
            pos => pos + 1
            self :> parse_field

    parsing <: read_field_default -> parsing
        |: cur_kind == "char"
        then:
            let field_ser: String! = field_name_buf + ":" + type_ser_buf + "=CHR:\"" + cur_value + "\""
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + field_ser
            pos => pos + 1
            self :> parse_field

    parsing <: read_field_default -> parsing
        |: cur_kind == "kw" and (cur_value == "true" or cur_value == "false")
        then:
            let field_ser: String! = field_name_buf + ":" + type_ser_buf + "=BOOL:" + cur_value
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + field_ser
            pos => pos + 1
            self :> parse_field

    parsing <: read_field_default -> parsing
        |: cur_kind == "ident"
        then:
            let field_ser: String! = field_name_buf + ":" + type_ser_buf + "=IDENT:" + cur_value
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + field_ser
            pos => pos + 1
            self :> parse_field

    parsing <: read_field_default -> parsing
        |: cur_kind != "int" and cur_kind != "float" and cur_kind != "string" and cur_kind != "char" and cur_kind != "ident" and not (cur_kind == "kw" and (cur_value == "true" or cur_value == "false"))
        then:
            error => true
            error_msg => "expected default expression"
            self :> dispatch

    # enum body — reached via parse_field when first body token is `case`.
    # Prefix is emitted by parse_field; this flow consumes `case` cases
    # until DEDENT.
    parsing <: parse_enum_case -> parsing
        |: cur_kind == "dedent"
        then:
            pos => pos + 1
            self :> dispatch

    parsing <: parse_enum_case -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> parse_enum_case

    parsing <: parse_enum_case -> parsing
        |: not (cur_kind == "kw" and cur_value == "case") and cur_kind != "dedent" and cur_kind != "newline"
        then:
            error => true
            error_msg => "expected `case`"
            self :> dispatch

    parsing <: parse_enum_case -> parsing
        |: cur_kind == "kw" and cur_value == "case"
        then:
            pos => pos + 1
            self :> read_case_name

    parsing <: read_case_name -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected case name"
            self :> dispatch

    parsing <: read_case_name -> parsing
        then:
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + cur_value
            pos => pos + 1
            self :> after_case_name

    parsing <: after_case_name -> parsing
        |: cur_kind == "punct" and cur_value == "("
        then:
            out => out + "("
            pos => pos + 1
            self :> parse_payload_field

    parsing <: after_case_name -> parsing
        |: not (cur_kind == "punct" and cur_value == "(")
        then: self :> parse_enum_case

    parsing <: parse_payload_field -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected payload field name"
            self :> dispatch

    parsing <: parse_payload_field -> parsing
        then:
            field_name_buf => cur_value
            pos => pos + 1
            self :> expect_payload_field_colon

    parsing <: expect_payload_field_colon -> parsing
        |: not (cur_kind == "punct" and cur_value == ":")
        then:
            error => true
            error_msg => "expected `:` after payload field name"
            self :> dispatch

    parsing <: expect_payload_field_colon -> parsing
        then:
            pos => pos + 1
            self :> parse_payload_field_type

    parsing <: parse_payload_field_type -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected payload type name"
            self :> dispatch

    parsing <: parse_payload_field_type -> parsing
        then:
            type_name_buf => cur_value
            pos => pos + 1
            self :> after_payload_type_name

    parsing <: after_payload_type_name -> parsing
        |: cur_kind == "punct" and cur_value == "!"
        then:
            type_ser_buf => "TN(TR:" + type_name_buf + ")"
            pos => pos + 1
            self :> emit_payload_field

    parsing <: after_payload_type_name -> parsing
        |: not (cur_kind == "punct" and cur_value == "!")
        then:
            type_ser_buf => "TR:" + type_name_buf
            self :> emit_payload_field

    parsing <: emit_payload_field -> parsing
        then:
            let sep: String! = ||: out.ends_with("(") : "" ||: else : ";"
            out => out + sep + field_name_buf + ":" + type_ser_buf
            self :> after_payload_field

    parsing <: after_payload_field -> parsing
        |: cur_kind == "punct" and cur_value == ","
        then:
            pos => pos + 1
            self :> parse_payload_field

    parsing <: after_payload_field -> parsing
        |: cur_kind == "punct" and cur_value == ")"
        then:
            out => out + ")"
            pos => pos + 1
            self :> parse_enum_case

    parsing <: after_payload_field -> parsing
        |: not (cur_kind == "punct" and (cur_value == "," or cur_value == ")"))
        then:
            error => true
            error_msg => "expected `,` or `)` after payload field"
            self :> dispatch

    parsing <: read_from_module -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected :ident"
            self :> dispatch

    parsing <: read_from_module -> parsing
        then:
            let prefix: String! = ||: out.length() > 0 : out + "\nfromimport|" ||: else : "fromimport|"
            out => prefix + cur_value + "|"
            pos => pos + 1
            self :> expect_import

    parsing <: expect_import -> parsing
        |: not (cur_kind == "kw" and cur_value == "import")
        then:
            error => true
            error_msg => "expected :kw \"import\""
            self :> dispatch

    parsing <: expect_import -> parsing
        then:
            pos => pos + 1
            self :> read_name

    parsing <: read_name -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected :ident"
            self :> dispatch

    parsing <: read_name -> parsing
        then:
            out => out + cur_value
            pos => pos + 1
            self :> read_name_tail

    parsing <: read_name_tail -> parsing
        |: cur_kind == "punct" and cur_value == ","
        then:
            out => out + ","
            pos => pos + 1
            self :> read_name

    parsing <: read_name_tail -> parsing
        |: not (cur_kind == "punct" and cur_value == ",")
        then: self :> dispatch
