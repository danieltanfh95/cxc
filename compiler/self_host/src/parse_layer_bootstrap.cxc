# Self-host parse-layer bootstrap — terminal subset v1.
#
# Chapter-12 incremental landing. Per the chapter-11 design note
# (compiler/self_host/design/parse-layer-bootstrap.md) and the
# chapter-12 directive, build one shape at a time inside this
# single parser atom.
#
# Scope at chapter-12 initial landing. SHAPE 1 of 11 only:
#   from X import a[, b[, c]]
# Subsequent landings extend this file with more shapes under the
# same single-atom scaffolding. The build-one-shape-at-a-time
# discipline matches the directive guidance:
#   "produce one new :node shape in isolation, confirm oracle
#   equivalence, add the next shape."
#
# Lexing model. Single-line input only at this landing (multi-line
# layout markers deferred to the first def-record landing). Char-
# by-char dispatch mirrors the chapter-11 slice-31 tokenize-line
# pattern. Only the tokens that appear in `from X import a, b, c`
# are recognised: ident / kw / punct. All other bytes emit a
# parse error.
#
# Parsing model. Flat token stream in the `tokens` field, cursor
# in `pos`. Each shape adds its own transition arm; dispatch is
# on `cur_kind` + `cur_value`.
#
# Input. argv[1] = cxc source. For shape 1, a single-line
# `from X import ...` statement.
#
# Output. One serialized node per invocation, matching the chapter-
# 11 design note's wire format:
#   fromimport|<from>|<n1>[,<n2>...]
#   parseerror|<message>

def Token:
    kind:  String!
    value: String!

def main:
    use args:    Args
    use console: Console

    source:   String! = ""
    sc:       Int!    = 0
    word_acc: String! = ""
    line_indent: Int! = 0
    indent_stack: List of Int = [0]
    at_line_start: Bool! = true
    tokens:   List of Token = []
    pos:      Int!    = 0
    out:      String! = ""
    error:    Bool!   = false
    error_msg: String! = ""
    field_name_buf: String! = ""
    type_name_buf:  String! = ""
    type_ser_buf:   String! = ""
    inner_ser_buf:  String! = ""
    inner_k_buf:    String! = ""
    inner_v_buf:    String! = ""
    def_name_buf:   String! = ""

    reserved: List of String = [
        "module", "from", "import", "as",
        "def", "use", "invariants", "enum",
        "accepts", "extend", "replace", "deprecated",
        "then", "do", "when", "let", "alias",
        "self", "nil", "true", "false",
        "and", "or", "not", "is", "in", "of",
        "if", "else", "return", "case",
        "function", "for",
        "weak", "unowned",
        "while", "loop", "break", "continue",
        "raise"
    ]

    at_src_end :- sc >= source.length()
    srccur     :- ||: at_src_end : -1 ||: else : source.code_at(sc)
    is_sp      :- srccur == 32
    is_nl      :- srccur == 10
    is_id_start :- (srccur >= 65 and srccur <= 90) or (srccur >= 97 and srccur <= 122) or srccur == 95
    is_id_cont  :- is_id_start or (srccur >= 48 and srccur <= 57)
    is_comma   :- srccur == 44
    is_colon   :- srccur == 58
    is_lparen  :- srccur == 40
    is_rparen  :- srccur == 41
    is_bang    :- srccur == 33

    top_indent :- indent_stack.at((indent_stack.count() - 1).max(0)) ?? 0

    cur_tok   :- tokens.at(pos) ?? Token(kind: "EOF", value: "")
    cur_kind  :- cur_tok.kind
    cur_value :- cur_tok.value

    -> lex_start
        then:
            source => args.get_or(1, "").replace("\\n", "\n")
            self :> step

    -> parsing
        then: self :> dispatch

    -> end
        then:
            let final: String! = ||: error : "parseerror|" + error_msg + "|dbg|cnt=" + tokens.count().to_string() + "|pos=" + pos.to_string() ||: else : out
            console.write(final)

    lex_start <: step -> lex_start
        |: at_src_end and not error
        then:
            self :> emit_trailing_dedents

    # At line start, consume indent and compare to top of stack.
    lex_start <: step -> lex_start
        |: not at_src_end and at_line_start
        then:
            self :> measure_indent

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_sp
        then:
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_nl
        then:
            tokens => tokens.append(Token(kind: "NEWLINE", value: ""))
            sc => sc + 1
            at_line_start => true
            line_indent => 0
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_comma
        then:
            tokens => tokens.append(Token(kind: "punct", value: ","))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_colon
        then:
            tokens => tokens.append(Token(kind: "punct", value: ":"))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_lparen
        then:
            tokens => tokens.append(Token(kind: "punct", value: "("))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_rparen
        then:
            tokens => tokens.append(Token(kind: "punct", value: ")"))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_bang
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "!"))
            sc => sc + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_id_start
        then:
            word_acc => ""
            self :> scan_word

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and not is_sp and not is_nl and not is_comma and not is_colon and not is_lparen and not is_rparen and not is_bang and not is_id_start
        then:
            error => true
            error_msg => "lex: unexpected char"
            self :> step

    lex_start <: step -> end
        |: error

    lex_start <: measure_indent -> lex_start
        |: not at_src_end and is_sp
        then:
            line_indent => line_indent + 1
            sc => sc + 1
            self :> measure_indent

    # Blank line — reset to start without emitting layout.
    lex_start <: measure_indent -> lex_start
        |: not at_src_end and is_nl
        then:
            sc => sc + 1
            line_indent => 0
            self :> measure_indent

    lex_start <: measure_indent -> lex_start
        |: at_src_end
        then: self :> emit_trailing_dedents

    # Non-space, non-newline content starts here. Compare indent.
    lex_start <: measure_indent -> lex_start
        |: not at_src_end and not is_sp and not is_nl
        then:
            at_line_start => false
            self :> adjust_indent

    lex_start <: adjust_indent -> lex_start
        |: line_indent > top_indent
        then:
            tokens => tokens.append(Token(kind: "INDENT", value: ""))
            indent_stack => indent_stack.append(line_indent)
            self :> step

    lex_start <: adjust_indent -> lex_start
        |: line_indent < top_indent
        then:
            tokens => tokens.append(Token(kind: "DEDENT", value: ""))
            indent_stack => indent_stack.filter(x => x < top_indent)
            self :> adjust_indent

    lex_start <: adjust_indent -> lex_start
        |: line_indent == top_indent
        then: self :> step

    lex_start <: emit_trailing_dedents -> parsing
        |: indent_stack.count() <= 1
        then:
            tokens => tokens.append(Token(kind: "EOF", value: ""))

    lex_start <: emit_trailing_dedents -> lex_start
        |: indent_stack.count() > 1
        then:
            tokens => tokens.append(Token(kind: "DEDENT", value: ""))
            indent_stack => indent_stack.filter(x => x < top_indent)
            self :> emit_trailing_dedents

    lex_start <: scan_word -> lex_start
        |: not at_src_end and is_id_cont
        then:
            word_acc => word_acc + source.substring(sc, 1)
            sc => sc + 1
            self :> scan_word

    lex_start <: scan_word -> lex_start
        |: at_src_end or not is_id_cont
        then:
            let kind: String! = ||: reserved.contains(word_acc) : "kw" ||: else : "ident"
            tokens => tokens.append(Token(kind: kind, value: word_acc))
            self :> step

    parsing <: dispatch -> end
        |: error

    parsing <: dispatch -> end
        |: not error and cur_kind == "EOF"

    parsing <: dispatch -> parsing
        |: not error and cur_kind == "kw" and cur_value == "from"
        then:
            pos => pos + 1
            self :> read_from_module

    parsing <: dispatch -> parsing
        |: not error and cur_kind == "kw" and cur_value == "def"
        then:
            pos => pos + 1
            self :> read_def_name

    parsing <: dispatch -> parsing
        |: not error and not (cur_kind == "EOF" or (cur_kind == "kw" and (cur_value == "from" or cur_value == "def")))
        then:
            error => true
            error_msg => "chapter-12 scope: only `from X import` and `def X:` supported"
            self :> dispatch

    # def NAME :  NEWLINE  INDENT  <fields>  DEDENT
    parsing <: read_def_name -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected name after `def`"
            self :> dispatch

    parsing <: read_def_name -> parsing
        then:
            def_name_buf => cur_value
            pos => pos + 1
            self :> after_def_name

    parsing <: after_def_name -> parsing
        |: cur_kind == "punct" and cur_value == "("
        then:
            out => "defatom|" + def_name_buf + "|"
            pos => pos + 1
            self :> parse_ctor_param

    parsing <: after_def_name -> parsing
        |: not (cur_kind == "punct" and cur_value == "(")
        then: self :> expect_def_colon

    parsing <: parse_ctor_param -> parsing
        |: cur_kind == "punct" and cur_value == ")"
        then:
            out => out + "|"
            pos => pos + 1
            self :> expect_def_colon

    parsing <: parse_ctor_param -> parsing
        |: cur_kind != "ident" and not (cur_kind == "punct" and cur_value == ")")
        then:
            error => true
            error_msg => "expected ctor-param name"
            self :> dispatch

    parsing <: parse_ctor_param -> parsing
        |: cur_kind == "ident"
        then:
            field_name_buf => cur_value
            pos => pos + 1
            self :> expect_ctor_param_colon

    parsing <: expect_ctor_param_colon -> parsing
        |: not (cur_kind == "punct" and cur_value == ":")
        then:
            error => true
            error_msg => "expected `:` after ctor-param name"
            self :> dispatch

    parsing <: expect_ctor_param_colon -> parsing
        then:
            pos => pos + 1
            self :> parse_ctor_param_type

    parsing <: parse_ctor_param_type -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected ctor-param type name"
            self :> dispatch

    parsing <: parse_ctor_param_type -> parsing
        then:
            type_name_buf => cur_value
            pos => pos + 1
            self :> after_ctor_param_type_name

    parsing <: after_ctor_param_type_name -> parsing
        |: cur_kind == "glyph" and cur_value == "!"
        then:
            type_ser_buf => "TN(TR:" + type_name_buf + ")"
            pos => pos + 1
            self :> emit_ctor_param

    parsing <: after_ctor_param_type_name -> parsing
        |: not (cur_kind == "glyph" and cur_value == "!")
        then:
            type_ser_buf => "TR:" + type_name_buf
            self :> emit_ctor_param

    parsing <: emit_ctor_param -> parsing
        then:
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + field_name_buf + ":" + type_ser_buf
            self :> after_ctor_param

    parsing <: after_ctor_param -> parsing
        |: cur_kind == "punct" and cur_value == ","
        then:
            pos => pos + 1
            self :> parse_ctor_param

    parsing <: after_ctor_param -> parsing
        |: cur_kind == "punct" and cur_value == ")"
        then:
            out => out + "|"
            pos => pos + 1
            self :> expect_def_colon

    parsing <: after_ctor_param -> parsing
        |: not (cur_kind == "punct" and (cur_value == "," or cur_value == ")"))
        then:
            error => true
            error_msg => "expected `,` or `)` after ctor-param"
            self :> dispatch

    parsing <: expect_def_colon -> parsing
        |: not (cur_kind == "punct" and cur_value == ":")
        then:
            error => true
            error_msg => "expected `:` after def name"
            self :> dispatch

    parsing <: expect_def_colon -> parsing
        then:
            pos => pos + 1
            self :> expect_def_newline

    parsing <: expect_def_newline -> parsing
        |: cur_kind != "NEWLINE"
        then:
            error => true
            error_msg => "expected newline after `def X:`"
            self :> dispatch

    parsing <: expect_def_newline -> parsing
        then:
            pos => pos + 1
            self :> expect_def_indent

    parsing <: expect_def_indent -> parsing
        |: cur_kind != "INDENT"
        then:
            error => true
            error_msg => "expected indent after `def X:`"
            self :> dispatch

    parsing <: expect_def_indent -> parsing
        then:
            pos => pos + 1
            self :> parse_field

    parsing <: parse_field -> parsing
        |: cur_kind == "DEDENT"
        then:
            out => ||: out.length() > 0 : out ||: else : "defrecord|" + def_name_buf + "|"
            pos => pos + 1
            self :> dispatch

    parsing <: parse_field -> parsing
        |: cur_kind == "NEWLINE"
        then:
            pos => pos + 1
            self :> parse_field

    parsing <: parse_field -> parsing
        |: cur_kind == "kw" and cur_value == "case"
        then:
            out => ||: out.length() > 0 : out ||: else : "defenum|" + def_name_buf + "|"
            self :> parse_enum_case

    parsing <: parse_field -> parsing
        |: cur_kind != "ident" and cur_kind != "DEDENT" and cur_kind != "NEWLINE" and not (cur_kind == "kw" and cur_value == "case")
        then:
            error => true
            error_msg => "expected field name"
            self :> dispatch

    parsing <: parse_field -> parsing
        |: cur_kind == "ident"
        then:
            out => ||: out.length() > 0 : out ||: else : "defrecord|" + def_name_buf + "|"
            field_name_buf => cur_value
            pos => pos + 1
            self :> expect_field_colon

    parsing <: expect_field_colon -> parsing
        |: not (cur_kind == "punct" and cur_value == ":")
        then:
            error => true
            error_msg => "expected `:` after field name"
            self :> dispatch

    parsing <: expect_field_colon -> parsing
        then:
            pos => pos + 1
            self :> parse_field_type

    parsing <: parse_field_type -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected type name"
            self :> dispatch

    parsing <: parse_field_type -> parsing
        then:
            type_name_buf => cur_value
            pos => pos + 1
            self :> after_type_name

    parsing <: after_type_name -> parsing
        |: cur_kind == "kw" and cur_value == "of"
        then:
            pos => pos + 1
            self :> parse_of_inner

    parsing <: after_type_name -> parsing
        |: cur_kind == "glyph" and cur_value == "!"
        then:
            type_ser_buf => "TN(TR:" + type_name_buf + ")"
            pos => pos + 1
            self :> emit_field_from_ser

    parsing <: after_type_name -> parsing
        |: not (cur_kind == "glyph" and cur_value == "!") and not (cur_kind == "kw" and cur_value == "of")
        then:
            type_ser_buf => "TR:" + type_name_buf
            self :> emit_field_from_ser

    parsing <: parse_of_inner -> parsing
        |: cur_kind == "punct" and cur_value == "("
        then:
            pos => pos + 1
            self :> parse_tuple_k

    parsing <: parse_of_inner -> parsing
        |: cur_kind == "ident"
        then:
            inner_ser_buf => "TR:" + cur_value
            pos => pos + 1
            self :> after_container_inner

    parsing <: parse_of_inner -> parsing
        |: cur_kind != "ident" and not (cur_kind == "punct" and cur_value == "(")
        then:
            error => true
            error_msg => "expected inner type after `of`"
            self :> dispatch

    parsing <: after_container_inner -> parsing
        |: cur_kind == "glyph" and cur_value == "!"
        then:
            inner_ser_buf => "TN(" + inner_ser_buf + ")"
            pos => pos + 1
            self :> finish_container

    parsing <: after_container_inner -> parsing
        |: not (cur_kind == "glyph" and cur_value == "!")
        then: self :> finish_container

    parsing <: parse_tuple_k -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected key type in tuple"
            self :> dispatch

    parsing <: parse_tuple_k -> parsing
        then:
            inner_k_buf => "TR:" + cur_value
            pos => pos + 1
            self :> after_tuple_k_name

    parsing <: after_tuple_k_name -> parsing
        |: cur_kind == "glyph" and cur_value == "!"
        then:
            inner_k_buf => "TN(" + inner_k_buf + ")"
            pos => pos + 1
            self :> expect_tuple_comma

    parsing <: after_tuple_k_name -> parsing
        |: not (cur_kind == "glyph" and cur_value == "!")
        then: self :> expect_tuple_comma

    parsing <: expect_tuple_comma -> parsing
        |: not (cur_kind == "punct" and cur_value == ",")
        then:
            error => true
            error_msg => "expected `,` in tuple"
            self :> dispatch

    parsing <: expect_tuple_comma -> parsing
        then:
            pos => pos + 1
            self :> parse_tuple_v

    parsing <: parse_tuple_v -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected value type in tuple"
            self :> dispatch

    parsing <: parse_tuple_v -> parsing
        then:
            inner_v_buf => "TR:" + cur_value
            pos => pos + 1
            self :> after_tuple_v_name

    parsing <: after_tuple_v_name -> parsing
        |: cur_kind == "glyph" and cur_value == "!"
        then:
            inner_v_buf => "TN(" + inner_v_buf + ")"
            pos => pos + 1
            self :> expect_tuple_rparen

    parsing <: after_tuple_v_name -> parsing
        |: not (cur_kind == "glyph" and cur_value == "!")
        then: self :> expect_tuple_rparen

    parsing <: expect_tuple_rparen -> parsing
        |: not (cur_kind == "punct" and cur_value == ")")
        then:
            error => true
            error_msg => "expected `)` in tuple"
            self :> dispatch

    parsing <: expect_tuple_rparen -> parsing
        then:
            inner_ser_buf => "TT(" + inner_k_buf + "," + inner_v_buf + ")"
            pos => pos + 1
            self :> finish_container

    parsing <: finish_container -> parsing
        then:
            type_ser_buf => "TO:" + type_name_buf + "(" + inner_ser_buf + ")"
            self :> emit_field_from_ser

    parsing <: emit_field_from_ser -> parsing
        then:
            let field_ser: String! = field_name_buf + ":" + type_ser_buf
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + field_ser
            self :> parse_field

    # enum body — reached via parse_field when first body token is `case`.
    # Prefix is emitted by parse_field; this flow consumes `case` cases
    # until DEDENT.
    parsing <: parse_enum_case -> parsing
        |: cur_kind == "DEDENT"
        then:
            pos => pos + 1
            self :> dispatch

    parsing <: parse_enum_case -> parsing
        |: cur_kind == "NEWLINE"
        then:
            pos => pos + 1
            self :> parse_enum_case

    parsing <: parse_enum_case -> parsing
        |: not (cur_kind == "kw" and cur_value == "case") and cur_kind != "DEDENT" and cur_kind != "NEWLINE"
        then:
            error => true
            error_msg => "expected `case`"
            self :> dispatch

    parsing <: parse_enum_case -> parsing
        |: cur_kind == "kw" and cur_value == "case"
        then:
            pos => pos + 1
            self :> read_case_name

    parsing <: read_case_name -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected case name"
            self :> dispatch

    parsing <: read_case_name -> parsing
        then:
            let sep: String! = ||: out.ends_with("|") : "" ||: else : ";"
            out => out + sep + cur_value
            pos => pos + 1
            self :> after_case_name

    parsing <: after_case_name -> parsing
        |: cur_kind == "punct" and cur_value == "("
        then:
            out => out + "("
            pos => pos + 1
            self :> parse_payload_field

    parsing <: after_case_name -> parsing
        |: not (cur_kind == "punct" and cur_value == "(")
        then: self :> parse_enum_case

    parsing <: parse_payload_field -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected payload field name"
            self :> dispatch

    parsing <: parse_payload_field -> parsing
        then:
            field_name_buf => cur_value
            pos => pos + 1
            self :> expect_payload_field_colon

    parsing <: expect_payload_field_colon -> parsing
        |: not (cur_kind == "punct" and cur_value == ":")
        then:
            error => true
            error_msg => "expected `:` after payload field name"
            self :> dispatch

    parsing <: expect_payload_field_colon -> parsing
        then:
            pos => pos + 1
            self :> parse_payload_field_type

    parsing <: parse_payload_field_type -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected payload type name"
            self :> dispatch

    parsing <: parse_payload_field_type -> parsing
        then:
            type_name_buf => cur_value
            pos => pos + 1
            self :> after_payload_type_name

    parsing <: after_payload_type_name -> parsing
        |: cur_kind == "glyph" and cur_value == "!"
        then:
            type_ser_buf => "TN(TR:" + type_name_buf + ")"
            pos => pos + 1
            self :> emit_payload_field

    parsing <: after_payload_type_name -> parsing
        |: not (cur_kind == "glyph" and cur_value == "!")
        then:
            type_ser_buf => "TR:" + type_name_buf
            self :> emit_payload_field

    parsing <: emit_payload_field -> parsing
        then:
            let sep: String! = ||: out.ends_with("(") : "" ||: else : ";"
            out => out + sep + field_name_buf + ":" + type_ser_buf
            self :> after_payload_field

    parsing <: after_payload_field -> parsing
        |: cur_kind == "punct" and cur_value == ","
        then:
            pos => pos + 1
            self :> parse_payload_field

    parsing <: after_payload_field -> parsing
        |: cur_kind == "punct" and cur_value == ")"
        then:
            out => out + ")"
            pos => pos + 1
            self :> parse_enum_case

    parsing <: after_payload_field -> parsing
        |: not (cur_kind == "punct" and (cur_value == "," or cur_value == ")"))
        then:
            error => true
            error_msg => "expected `,` or `)` after payload field"
            self :> dispatch

    parsing <: read_from_module -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected module ident after `from`"
            self :> dispatch

    parsing <: read_from_module -> parsing
        then:
            out => "fromimport|" + cur_value + "|"
            pos => pos + 1
            self :> expect_import

    parsing <: expect_import -> parsing
        |: not (cur_kind == "kw" and cur_value == "import")
        then:
            error => true
            error_msg => "expected `import` after module name"
            self :> dispatch

    parsing <: expect_import -> parsing
        then:
            pos => pos + 1
            self :> read_name

    parsing <: read_name -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "expected name after `import`"
            self :> dispatch

    parsing <: read_name -> parsing
        then:
            out => out + cur_value
            pos => pos + 1
            self :> read_name_tail

    parsing <: read_name_tail -> parsing
        |: cur_kind == "punct" and cur_value == ","
        then:
            out => out + ","
            pos => pos + 1
            self :> read_name

    parsing <: read_name_tail -> end
        |: not (cur_kind == "punct" and cur_value == ",")
