# Port of cxc.named-tuple/canonical-named-tuple-name — primitive-only
# scope (type-ref and type-nonnil wrapping type-ref). Chapter-6
# upgrade: the sort step is now in-port using the chapter-6
# `.compare_to` landing, so callers can pass fields in any order.
#
# Input format: argv[1] = "<f1>|<m1>;<f2>|<m2>;..." where
#   fi: field name, non-empty, no `_`, must not start with `Nn`
#   mi: mangle string, either `<prim>` or `Nn_<prim>` where `<prim>`
#       is non-empty, contains no `_`, and is not a reserved-prefix
#       mangling (`Nn_`, `_Cxc_NT`, `Nt<digit>`, `Of<digit>`)
#
# Output per line:
#   Well-formed input: `_Cxc_NT_<f1>_<m1>_<f2>_<m2>_...` with the
#     fields alphabetically ordered by name
#   Any invalid pair OR empty input: `INVALID`
#
# Clojure source. compiler/src/cxc/named_tuple.clj L34 to L183.
#
# Phases. parsing → sorting → emitting → end. Parsing emits into a
# `pairs: List of String` field, one entry per field. Sorting is a
# selection sort: observations extract the current and current-best
# pair's name prefix, `.compare_to` gives strcmp-shape ordering, and
# the smallest-remaining pair migrates from `pairs` into
# `sorted_pairs` once per outer tick. Emitting walks `sorted_pairs`
# and builds the canonical name.
#
# Terminal phase MUST be named `end`. Error paths flag `invalid` and
# fall through; the terminal arm picks `INVALID` vs the canonical
# string in `end`'s entry then-body.

def main:
    use args:    Args
    use console: Console

    spec:          String! = ""
    cursor:        Int!    = 0
    in_mangle:     Bool!   = false
    name_acc:      String! = ""
    mangle_acc:    String! = ""
    pairs:         List of String = []
    sorted_pairs:  List of String = []
    scan_i:        Int!    = 0
    scan_best:     String! = ""
    scan_has_best: Bool!   = false
    emit_i:        Int!    = 0
    canonical_acc: String! = "_Cxc_NT"
    pair_count:    Int!    = 0
    invalid:       Bool!   = false

    at_end  :- cursor >= spec.length()
    cur     :- ||: at_end : -1 ||: else : spec.code_at(cursor)
    is_pipe :- cur == 124
    is_semi :- cur == 59

    scan_cur       :- pairs.at(scan_i) ?? ""
    scan_cur_pipe  :- scan_cur.index_of("|")
    scan_cur_name  :- scan_cur.substring(0, scan_cur_pipe.max(0))
    scan_best_pipe :- scan_best.index_of("|")
    scan_best_name :- scan_best.substring(0, scan_best_pipe.max(0))
    scan_cmp       :- scan_cur_name.compare_to(scan_best_name)

    -> parsing
        then:
            spec => args.get_or(1, "")
            self :> step

    -> sorting
        then:
            scan_i => 0
            scan_has_best => false
            scan_best => ""
            self :> scan

    -> emitting
        then:
            emit_i => 0
            self :> step

    -> end
        then:
            let out: String! = ||: invalid or pair_count == 0 : "INVALID" ||: else : canonical_acc
            console.write(out)

    parsing <: step -> parsing
        |: not at_end and is_pipe and not in_mangle
        then:
            in_mangle => true
            cursor => cursor + 1
            self :> step

    parsing <: step -> parsing
        |: not at_end and is_pipe and in_mangle
        then:
            invalid => true
            cursor => cursor + 1
            self :> step

    parsing <: step -> parsing
        |: not at_end and is_semi
        then:
            let name_bad: Bool!            = name_acc.length() == 0
            let name_underscore: Bool!     = name_acc.index_of("_") >= 0
            let name_nn: Bool!             = name_acc.starts_with("Nn")
            let mangle_empty: Bool!        = mangle_acc.length() == 0 or not in_mangle
            let m_has_nn: Bool!            = mangle_acc.starts_with("Nn_")
            let m_inner: String!           = ||: m_has_nn : mangle_acc.substring(3, mangle_acc.length() - 3) ||: else : mangle_acc
            let m_inner_empty: Bool!       = m_inner.length() == 0
            let m_inner_underscore: Bool!  = m_inner.index_of("_") >= 0
            let m_inner_cxc_nt: Bool!      = m_inner.starts_with("_Cxc_NT")
            let m_nt_tag: Bool!            = m_inner.starts_with("Nt") and m_inner.length() >= 3
            let m_of_tag: Bool!            = m_inner.starts_with("Of") and m_inner.length() >= 3
            let m_nt_digit: Bool!          = m_nt_tag and m_inner.code_at(2) >= 48 and m_inner.code_at(2) <= 57
            let m_of_digit: Bool!          = m_of_tag and m_inner.code_at(2) >= 48 and m_inner.code_at(2) <= 57
            let pair_bad: Bool!            = name_bad or name_underscore or name_nn or mangle_empty or m_inner_empty or m_inner_underscore or m_inner_cxc_nt or m_nt_digit or m_of_digit
            invalid => invalid or pair_bad
            pairs => pairs.append(name_acc + "|" + mangle_acc)
            pair_count => pair_count + 1
            name_acc => ""
            mangle_acc => ""
            in_mangle => false
            cursor => cursor + 1
            self :> step

    parsing <: step -> parsing
        |: not at_end and not is_pipe and not is_semi and in_mangle
        then:
            mangle_acc => mangle_acc + spec.substring(cursor, 1)
            cursor => cursor + 1
            self :> step

    parsing <: step -> parsing
        |: not at_end and not is_pipe and not is_semi and not in_mangle
        then:
            name_acc => name_acc + spec.substring(cursor, 1)
            cursor => cursor + 1
            self :> step

    parsing <: step -> sorting
        |: at_end and (name_acc.length() > 0 or mangle_acc.length() > 0 or in_mangle)
        then:
            let name_bad: Bool!            = name_acc.length() == 0
            let name_underscore: Bool!     = name_acc.index_of("_") >= 0
            let name_nn: Bool!             = name_acc.starts_with("Nn")
            let mangle_empty: Bool!        = mangle_acc.length() == 0 or not in_mangle
            let m_has_nn: Bool!            = mangle_acc.starts_with("Nn_")
            let m_inner: String!           = ||: m_has_nn : mangle_acc.substring(3, mangle_acc.length() - 3) ||: else : mangle_acc
            let m_inner_empty: Bool!       = m_inner.length() == 0
            let m_inner_underscore: Bool!  = m_inner.index_of("_") >= 0
            let m_inner_cxc_nt: Bool!      = m_inner.starts_with("_Cxc_NT")
            let m_nt_tag: Bool!            = m_inner.starts_with("Nt") and m_inner.length() >= 3
            let m_of_tag: Bool!            = m_inner.starts_with("Of") and m_inner.length() >= 3
            let m_nt_digit: Bool!          = m_nt_tag and m_inner.code_at(2) >= 48 and m_inner.code_at(2) <= 57
            let m_of_digit: Bool!          = m_of_tag and m_inner.code_at(2) >= 48 and m_inner.code_at(2) <= 57
            let pair_bad: Bool!            = name_bad or name_underscore or name_nn or mangle_empty or m_inner_empty or m_inner_underscore or m_inner_cxc_nt or m_nt_digit or m_of_digit
            invalid => invalid or pair_bad
            pairs => pairs.append(name_acc + "|" + mangle_acc)
            pair_count => pair_count + 1

    parsing <: step -> sorting
        |: at_end and name_acc.length() == 0 and mangle_acc.length() == 0 and not in_mangle

    sorting <: scan -> sorting
        |: scan_i < pairs.count() and not scan_has_best
        then:
            scan_best => scan_cur
            scan_has_best => true
            scan_i => scan_i + 1
            self :> scan

    sorting <: scan -> sorting
        |: scan_i < pairs.count() and scan_has_best and scan_cmp < 0
        then:
            scan_best => scan_cur
            scan_i => scan_i + 1
            self :> scan

    sorting <: scan -> sorting
        |: scan_i < pairs.count() and scan_has_best and scan_cmp >= 0
        then:
            scan_i => scan_i + 1
            self :> scan

    sorting <: scan -> sorting
        |: scan_i >= pairs.count() and scan_has_best
        then:
            sorted_pairs => sorted_pairs.append(scan_best)
            pairs => pairs.filter(p => p != scan_best)
            scan_i => 0
            scan_has_best => false
            scan_best => ""
            self :> scan

    sorting <: scan -> emitting
        |: scan_i >= pairs.count() and not scan_has_best

    emitting <: step -> emitting
        |: emit_i < sorted_pairs.count()
        then:
            let p: String!    = sorted_pairs.at(emit_i) ?? ""
            let pipe: Int!    = p.index_of("|")
            let nm: String!   = p.substring(0, pipe.max(0))
            let mg: String!   = p.substring((pipe + 1).max(0), (p.length() - pipe - 1).max(0))
            canonical_acc => canonical_acc + "_" + nm + "_" + mg
            emit_i => emit_i + 1
            self :> step

    emitting <: step -> end
        |: emit_i >= sorted_pairs.count()
