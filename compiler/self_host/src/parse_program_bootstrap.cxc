# Chapter-30 whole-program parse slice (slice 36).
#
# Ports `cxc.parse/parse`, the whole-program entry. It starts as a copy
# of slice 35 (`parse_expr_bootstrap.cxc`, chapters 26 to 29), which
# keeps its expression, statement, and item modes unchanged apart from
# the def name the item messages quote, and adds a prog mode on top.
# The split keeps slice 35's build where it was. Prog mode alone moved
# the generated `.m` from 25.7 MB to 45.7 MB.
#
# Prog mode. argv[2] = `prog` runs parse*'s loop and parse-top's
# dispatch (`from` and `import` lines with their foreign forms, the
# `module`, module-scope `let`, `extern`, and `record` / `enum` /
# `class` sugar rejections, and the fall-through message), the
# parse-def-atom header (name, ctor params, `queue:` configs through
# parse-queue-config and parse-def-atom-ctor-tail, the free-function
# fix-it, an optional NEWLINE before INDENT), the chapter-29 item loop
# under a real DEDENT, and the reshape at that DEDENT in Clojure's
# order (the foreign-outside-plugin check, then plugin, protocol, enum
# with its raw-value and self-reference checks, agent, record, and the
# `queue:` kind check), with every message. fold-direct-use-lines and
# fold-top-level-fields are applied as the body renders. Extend blocks
# run parse-extend-class with header and body conformances, `replace`
# prefixes, and every parse-extend-section rejection. Plugin `foreign`
# blocks run parse-foreign-block and parse-foreign-entry, and the `->`
# function type at field position runs parse-foreign-signature, so no
# `port: out of scope` message is left in this slice. The chained
# comparison desugar is applied as values are built, as in slice 35.
#
# Prog output. `(program <node>*)` or `error|<message>`, with
#   (from-import <dotted> (name <n> <alias>|nil)+)
#   (from-foreign-import <lang> "<header>" (name <n> <alias>|nil)+)
#   (import <dotted> <alias>|nil)   (foreign-import <lang> "<header>")
#   (agent <name> (params <p>*) <queue>|nil <item>*), with <queue> =
#   (queue unbounded) | (queue bounded <n>)
#   (record <name> <item>*)   (protocol <name> <item>*)
#   (enum <name> <raw-type>|nil <enum-case>*)
#   (plugin (fields <field>*) <foreign>*)
#   (extend <target> (conforms <type>*) <item>*), a `replace` item
#   printing as (replace <item>)
# and the folded body sections and the plugin forms
#   (data <field>*)   (uses (use <name> <type>)+)
#   (foreign "<lib>" <entry>*), <entry> = (symbol "<s>" <sig>)
#   | (selector "<c>" "<s>" <sig>) | (class_selector "<c>" "<s>" <sig>)
#   | (type "<objc>" <alias>)
#   TF(<args>,<ret>) a function type. Inside a foreign signature the
#   bare primitives `Int Int8 Int16 Int32 Int64 Float Double Bool` print
#   as `TN(TR:<name>)` (wrap-ffi-primitives-nonnil), through tuples and
#   named tuples but not through `of`, `!`, or `?`.
#
# The slice-35 header follows.
#
# Chapter-26 expression-parse slice (slice 35).
#
# Ports `cxc.parse/parse-expression` (lex, `parse-expr`, trailing-token
# check) together with the `desugar-chained-comparisons` postwalk that
# `cxc.parse/parse` runs over every top-level form. Covers the Clojure
# recursive descent in `parse-primary`, `parse-postfix`, `parse-unary`,
# and `parse-binop`.
#
# Lex. A copy of the shared lex from slice 33
# (`lex_tokenize_with_layout.cxc`), the third shared lex site next to
# slice 33 and the inline lex in `parse_layer_bootstrap.cxc`. Every lex
# arm is textually identical to slice 33. Only the hand-off after the
# eof token differs (`-> parsing` here, `-> emitting` there).
#
# Parse model. One atom has no call stack, so the Clojure recursion is
# simulated with a frame stack. `frames` is a `List of Frame` with a
# logical `depth` (chapter-18 slice-and-append discipline, every push is
# `frames.slice(0, depth).append(...)`). The value a returning "call"
# hands back lives in the `v_*` registers. Message names are the
# return-mode sentinels (chapter 20) that say which Clojure function is
# running.
#
#   expr_start   parse-expr, pushes a `binop` frame at min-prec 1
#   unary_start  parse-unary prefix ops, pushes `neg` / `not` frames
#   primary      parse-primary, pushes `paren` / `list` / `lambda` /
#                `multi` frames or yields a leaf
#   postfix      parse-postfix, `.field`, `(args)`, `[index]`, pushes
#                `call` / `sub` frames
#   unary_done   pops `neg` / `not`, then stores the lhs in the binop
#   binop_loop   the parse-binop loop. An operator at or above the
#                frame's min-prec records itself as the pending op and
#                pushes a fresh binop frame at prec + 1 (precedence
#                climbing, so the tree is Clojure's left-assoc tree)
#   ret          a frame finished. The frame below decides what the
#                value was for (rhs, group, arg, index, item, body)
#   finish       trailing newlines, then eof or the trailing-token error
#
# Chapter 27 return modes. `var_open` / `var_bind` (variant pattern
# bindings), `ms_entry` / `ms_after` (payload entries), and the
# parse-type set `ty_start`, `tnt_field`, `ty_suffix`, `ty_ret`,
# `ty_more`. A type's rendering travels in `v_ser` like a value.
#
# Chapter 28 return modes. `stmt_start` (parse-statement), `sret` (a
# statement returned, to the `seq` or `blk` frame), `bret` (a block
# returned, to the `st` or `darm` frame), `st_got` (a parse-expr inside
# a statement returned), plus `blk_loop`, `body_open`, `if_skip`,
# `il_bind`, `st_eq`, `or_loop`, `or_pat`, `or_colon`, `disp_loop`,
# `dpat`, `darm_got`, `dbody`, `darm_done`, and `blk_done`.
#
# Chained comparisons. Every value carries `v_kind` ("cmp" for a binop
# whose op is `< <= > >=`, "chain" for a chained-cmp, "other"), plus the
# op list and operand list of a cmp or chain. Combining a cmp op over a
# cmp or chain lhs extends the chain, which is exactly the bottom-up
# postwalk rewrite. Parentheses keep the kind, as the AST does.
#
# Input. argv[1] = expression source (`\n` physical newline, `\N`
# backslash-n inside a literal, chapter-23 sentinel). argv[2] = `stmt`
# selects statement mode (chapter 28).
#
# Output. One S-expression per input, or `error|<message>`.
#   (int <v>) (float <v>) (string "<pr>") (char "<pr>") (bool <v>)
#   (nil) (self) (ident <name>) (neg <e>) (not <e>)
#   (binop <op> <l> <r>) (chained-cmp (<op> ...) <e> <e> ...)
#   (dot <e> <field>) (call <callee> <arg>*) with (pos <e>) and
#   (named <name> <e>) args, (subscript <e> <i>), (list <e>*),
#   (lambda (<param>*) <body>), (multi-arm (arm <guard> <body>)+)
#
# Chapter 27 forms.
#   (raise <T> <arg>*)
#   (emit async <target> <msg> <arg>*)  `:>`, target `nil` when bare
#   (emit sync <target> <msg> <arg>*)   `|>`, target `nil` on f(args)
#   (msg-shape <target> (field <name> <type>)*), a bareword entry is
#   (field <name> TR:Any bare)
#   (variant <Enum> <case> <bind>*) or (variant . <case> <bind>*),
#   with (let <as>) and (let <field> <as>) bindings
# Types use the parse-layer rendering plus `TQ` for the banned `T?`.
#   TR:<name> TN(<t>) TQ(<t>) TO:<outer>(<t>) TT(<t>,...) TNT(<f>:<t>,...)
#
# Chapter 27 also ports multi-line `||:` chains (NEWLINE `||:` at the
# same indent, or one opened NEWLINE INDENT `||:` closed by its DEDENT)
# and Clojure's inconsistent-dedent lex error, in all three shared lex
# sites.
#
# Chapter 28. Statements and the last expression forms. `do:` blocks,
# `def:` lambda bodies, and the `<expr>:` NEWLINE INDENT `<:` dispatch
# block after a parse-expr, so no `port: out of scope` message is left.
# All three shared lex sites gained cxc.lex's `=> def:` layout escape.
#   (do <stmt>*)
#   (dispatch <scrutinee> (arm (<pat>+) <guard>|nil <body>)*), with
#   <pat> = * | (lit int <v>) | (lit bool <v>) | (case [.]<name> <bind>*)
#   and <body> = (block <stmt>*) for an indented body, else the expr
#
# Statement mode. argv[2] = `stmt` parses a statement sequence, the
# oracle's top-level loop over the private parse-statement (parse-block's
# loop with eof in place of DEDENT). Output `(stmts <stmt>*)` with
#   (return <e>) (alias <name> <e>) (expr-stmt <e>)
#   (let <name> <type>|nil <e> <or-arm>*)
#   (if <cond> <block> <block>|nil)
#   (if-let ((bind <name> <type>|nil <e>)+) <block> <block>|nil)
#   (while <cond> <block>) (break) (continue) (block <stmt>*)
#   (emit ...) and (dispatch ...) bare, a `|>` statement emit takes
#   <or-arm> = (or bare|(bind <name>)|(case <T> <bind>*) <block>)
# and every parse-statement rejection (`=>` staging, reserved `let`
# names, `for`, `switch`, `break <value>`) byte-matches its message.
#
# Item mode (chapter 29). argv[2] = `item` parses a sequence of
# atom-body items, the oracle's copy of parse-def-atom's body loop with
# eof in place of DEDENT and the fixed def name `Item` in the messages
# that quote it. Output `(items <item>*)` with
#   (field <name> <type>|nil <default>|nil [weak|unowned] [bare])
#   (prop <pred> [(as <T> (named <f> <e>)*)]), <pred> is an expression
#   or (type-bound <name> <type>)
#   (obs <name> (params <p>*) <rtype>|nil <expr> [(props <prop>*)])
#   (obs-sig <name> (params <p>*) <rtype>)   <p> = (param self) | field
#   (transition <line> <src> <recv>|nil <target> <clause>*), with
#   <src> = implicit | self | * | (phase <name>),
#   <recv> = (recv <: | <| <msg>), <msg> = * | (typed <name> <field>*)
#   | (src <expr> (field <name> <type> [bare])*), and <clause> a prop or
#   (then (ups (set <field> <e>)*) (stmts <stmt-or-prop>*))
#   (recv-sig <name> (params ...)) (use <name> <type>)
#   (enum-case <name> (params ...) [<raw>]) (on-nil (<method> <e>)*)
#   (class-fn <name> (params ...) <rtype>|nil (block <stmt>*))
# Plugin `foreign` blocks and the `->` function type at field position
# raised the port-only `port: out of scope` message in slice 35. Slice 36
# parses both (chapter 30).

def Token:
    kind:  String!
    value: String!
    line:  Int!
    col:   Int!

# One simulated call frame. `kind` names the waiting Clojure function.
# `binop` frames use `prec` (min-prec), `op` (pending operator, "" when
# none) and the lhs in `ser` / `ekind` / `ops` / `acc`. `call` keeps the
# callee in `ser`, the rendered args in `acc`, and the pending arg name
# in `aux`. `sub` keeps the target in `ser`. `list` keeps items in
# `acc`. `lambda` keeps the param list in `ser`. `multi` keeps rendered
# arms in `acc`, the pending guard in `aux`, its state in `op`
# ("guard" or "body"), and whether the chain opened an INDENT in `prec`.
#
# Chapter 27. A `call` frame also serves `raise T(...)` and the `:>`
# send args. `op` "" renders `(call <ser> ...)`, "raw" renders `ser` as
# the head and returns to parse-postfix, "rawend" renders `ser` and
# returns past parse-postfix (the `:>` postfix branch does not recur).
# `cal` / `ctg` / `cnm` record the callee shape (`dot` with target and
# name, `ident` with name, or `other`) so the `|>` expression can split
# the call it parsed. `sync` frames keep the `|>` line in `prec`. Type
# frames `tof` / `tofl` / `ttup` / `tnt` keep the outer name in `ser`,
# the item count in `prec`, the rendered items in `acc`, and the
# pending named-tuple field in `aux`. `mshape` keeps the payload target
# in `ser` and entries in `acc`. `variant` keeps the pattern head in
# `ser` and bindings in `acc`.
def Frame:
    kind:  String!
    prec:  Int!
    op:    String!
    ser:   String!
    ekind: String!
    ops:   String!
    acc:   String!
    aux:   String!
    cal:   String!
    ctg:   String!
    cnm:   String!

def main:
    use args:    Args
    use console: Console

    source:   String! = ""
    sc:       Int!    = 0
    line_num: Int!    = 1
    col_num:  Int!    = 1
    tok_start_col: Int! = 1
    word_acc: String! = ""
    line_indent: Int! = 0
    indent_stack: List of Int = [0]
    at_line_start: Bool! = true
    tokens:   List of Token = []
    error:    Bool!   = false
    error_msg: String! = ""
    # Chapter-23 escape scratch. `esc_mode` is the return-mode sentinel
    # for the shared escape phases ("str" or "char", chapter 20
    # `nt_return_mode` idiom). `esc_hex` / `esc_val` accumulate the
    # `\u{...}` body. `char_esc` remembers whether the char literal body
    # was an escape so the close-quote error picks Clojure's message.
    esc_mode:  String! = "str"
    esc_hex:   String! = ""
    esc_val:   Int!    = 0
    char_esc:  Bool!   = false
    # Chapter-26 bracket continuation. Clojure's tokenize counts open
    # brackets across lines. A line that starts inside an open bracket is
    # a continuation (no layout tokens at all), and a line only emits its
    # NEWLINE when the running depth is back to zero at its end.
    bracket_depth: Int!  = 0
    line_is_cont:  Bool! = false
    # Chapter 28. The `=> def:` layout escape (cxc.lex def-frame). A
    # line inside open brackets that ends with `=> def :` arms a frame
    # at its indent, `def_base`. Deeper lines then open with INDENT
    # (first) or NEWLINE (later) and leave the indent stack alone, and
    # the first line back at or under the base closes the frame with
    # NEWLINE DEDENT before it lexes normally. `line_in_def` marks a
    # line lexed inside the frame, which never ends with a NEWLINE.
    def_base:    Int!  = -1
    def_seen:    Bool! = false
    line_in_def: Bool! = false
    # Chapter 27 inconsistent dedent. Clojure pops the indent stack to a
    # level that must exist, and throws when the line's indent falls
    # between two open levels. It tokenizes the line content first, so
    # a content lex error on that line wins. `dedent_err` holds the
    # message until the line ends. `indent_str` is the stack printed
    # top first, `indent_snap` its value when the line's dedents began.
    dedenting:   Bool!   = false
    indent_str:  String! = "0"
    indent_snap: String! = "0"
    dedent_err:  String! = ""

    reserved: List of String = [
        "module", "from", "import", "as",
        "def", "use", "invariants",
        "accepts", "extend", "replace", "deprecated",
        "then", "do", "when", "let", "alias",
        "self", "nil", "true", "false",
        "and", "or", "not", "is", "in", "of",
        "if", "else", "return", "case",
        "function", "for",
        "weak", "unowned",
        "while", "loop", "break", "continue",
        "raise"
    ]

    at_src_end :- sc >= source.length()
    srccur     :- ||: at_src_end : -1 ||: else : source.code_at(sc)
    srcnext    :- ||: sc + 1 >= source.length() : -1 ||: else : source.code_at(sc + 1)
    is_sp      :- srccur == 32
    is_nl      :- srccur == 10
    is_id_start :- (srccur >= 65 and srccur <= 90) or (srccur >= 97 and srccur <= 122) or srccur == 95
    is_id_cont  :- is_id_start or (srccur >= 48 and srccur <= 57)
    is_comma   :- srccur == 44
    is_colon   :- srccur == 58
    is_lparen  :- srccur == 40
    is_rparen  :- srccur == 41
    is_bang    :- srccur == 33
    is_q       :- srccur == 63

    # Chapter-26 — the rest of Clojure's punctuation and glyph tables
    # (`[ ] { } . ;` punct, `+ * / % &` glyphs, `<| |> ||: // **`
    # multi-glyphs), plus `#` line comments and the `@` retirement.
    srcnext2     :- ||: sc + 2 >= source.length() : -1 ||: else : source.code_at(sc + 2)
    is_lbracket  :- srccur == 91
    is_rbracket  :- srccur == 93
    is_semi      :- srccur == 59
    is_plus      :- srccur == 43
    is_star      :- srccur == 42
    is_slash     :- srccur == 47
    is_pct       :- srccur == 37
    is_amp       :- srccur == 38
    is_at        :- srccur == 64
    is_hash      :- srccur == 35
    is_lt_pipe   :- srccur == 60 and srcnext == 124
    is_pipe_gt   :- srccur == 124 and srcnext == 62
    is_dslash    :- srccur == 47 and srcnext == 47
    is_dstar     :- srccur == 42 and srcnext == 42
    is_dpipe_col :- srccur == 124 and srcnext == 124 and srcnext2 == 58

    is_arrow     :- srccur == 45 and srcnext == 62
    is_fat_arrow :- srccur == 61 and srcnext == 62
    is_pipe_col  :- srccur == 124 and srcnext == 58
    is_col_dash  :- srccur == 58 and srcnext == 45
    is_double_q  :- srccur == 63 and srcnext == 63
    is_lt_col    :- srccur == 60 and srcnext == 58
    is_col_gt    :- srccur == 58 and srcnext == 62
    is_eq_eq     :- srccur == 61 and srcnext == 61
    is_bang_eq   :- srccur == 33 and srcnext == 61
    is_gte       :- srccur == 62 and srcnext == 61
    is_lte       :- srccur == 60 and srcnext == 61

    is_any_multi :- is_arrow or is_fat_arrow or is_pipe_col or is_col_dash or is_double_q or is_lt_col or is_col_gt or is_eq_eq or is_bang_eq or is_gte or is_lte or is_lt_pipe or is_pipe_gt or is_dslash or is_dstar
    is_eq        :- srccur == 61
    is_dash      :- srccur == 45
    is_lt        :- srccur == 60
    is_gt        :- srccur == 62
    is_pipe      :- srccur == 124
    is_digit     :- srccur >= 48 and srccur <= 57
    is_dquote    :- srccur == 34
    is_squote    :- srccur == 39

    # Chapter-22 / 25 — numeric-literal lex predicates. See the
    # chapter-25 block below for the full scan-number port.
    is_dot        :- srccur == 46
    srcnext_is_digit :- sc + 1 < source.length() and source.code_at(sc + 1) >= 48 and source.code_at(sc + 1) <= 57

    # Chapter-23 — string / char escape decoding. The port decodes every
    # escape Clojure's cxc.lex/append-escape! accepts (simple set
    # `\n \t \r \\ \" \' \0 \a \b \f \v`, hex byte `\xNN`, unicode
    # `\u{HEX+}`) to its code point, then re-encodes the code point
    # through `enc`, a port of Clojure's pr-str string printer. Token
    # value therefore holds the pr-str body (no surrounding quotes),
    # which is exactly what the oracle prints via `(pr-str value)`.
    # Chapter 22 preserved the two-char literal instead, which broke on
    # `\'` (pr-str prints a bare apostrophe) and could not express hex
    # or unicode escapes at all.
    is_bslash     :- srccur == 92
    is_lbrace     :- srccur == 123
    is_rbrace     :- srccur == 125
    is_esc_x      :- srccur == 120
    is_esc_u      :- srccur == 117
    simple_esc_code :- ||: srccur == 110 : 10 ||: srccur == 116 : 9 ||: srccur == 114 : 13 ||: srccur == 92 : 92 ||: srccur == 34 : 34 ||: srccur == 39 : 39 ||: srccur == 48 : 0 ||: srccur == 97 : 7 ||: srccur == 98 : 8 ||: srccur == 102 : 12 ||: srccur == 118 : 11 ||: else : -1
    cur_hex       :- ||: srccur >= 48 and srccur <= 57 : srccur - 48 ||: srccur >= 97 and srccur <= 102 : srccur - 87 ||: srccur >= 65 and srccur <= 70 : srccur - 55 ||: else : -1
    next_hex      :- ||: srcnext >= 48 and srcnext <= 57 : srcnext - 48 ||: srcnext >= 97 and srcnext <= 102 : srcnext - 87 ||: srcnext >= 65 and srcnext <= 70 : srcnext - 55 ||: else : -1
    uni_len_ok    :- esc_hex.length() >= 1 and esc_hex.length() <= 6

    # pr-str string-body encoder. Clojure's `char-escape-string` table
    # escapes newline, tab, return, double quote, backslash, formfeed,
    # and backspace. Every other code point prints raw. Code points
    # above U+FFFF are emitted as a UTF-16 surrogate pair because
    # `Int.to_char_string()` truncates to one unichar.
    enc(c: Int!) :- String!
        ||: c == 10 : "\\n" ||: c == 9 : "\\t" ||: c == 13 : "\\r" ||: c == 34 : "\\\"" ||: c == 92 : "\\\\" ||: c == 12 : "\\f" ||: c == 8 : "\\b" ||: c > 65535 : (55296 + (c - 65536) / 1024).to_char_string() + (56320 + (c - 65536) % 1024).to_char_string() ||: else : c.to_char_string()

    # Chapter-25 numeric scan state, a port of cxc.lex/scan-number.
    # `num_digs` / `num_last_digit` are one scan-digits run (separators
    # stripped). `num_mode` is the run's return-mode sentinel ("int",
    # "frac", "exp", "based", "hexfrac"). The `num_sig*` fields track
    # the significant digits and the position of the first one while the
    # int and frac runs scan, so the float value renders without a
    # second pass (see slice 34 `float_render_java.cxc`).
    num_digs:       String! = ""
    num_last_digit: Bool!   = false
    num_mode:       String! = "int"
    num_base:       Int!    = 10
    num_prefix:     String! = ""
    num_int:        String! = ""
    num_frac:       String! = ""
    num_exp:        String! = ""
    num_has_dot:    Bool!   = false
    num_has_exp:    Bool!   = false
    num_exp_sign:   String! = ""
    num_kind:       String! = "int"
    num_val:        Int!    = 0
    num_sig:        String! = ""
    num_sig_nz:     Int!    = 0
    num_int_sig:    Int!    = 0
    num_frac_lead:  Int!    = 0
    num_exp_val:    Int!    = 0
    sfx_acc:        String! = ""
    sfx_col:        Int!    = 0

    cur_col       :- col_num
    is_us         :- srccur == 95
    is_letter     :- (srccur >= 65 and srccur <= 90) or (srccur >= 97 and srccur <= 122)
    is_exp_marker :- srccur == 101 or srccur == 69
    is_p_marker   :- srccur == 112 or srccur == 80
    num_run_end   :- at_src_end or is_nl
    num_digit_val :- ||: num_base == 16 : cur_hex ||: srccur >= 48 and srccur < 48 + num_base : srccur - 48 ||: else : -1
    rest_src      :- source.substring(sc.min(source.length()), (source.length() - sc).max(0))
    rest_nl       :- rest_src.index_of("\n")
    line_rest     :- ||: rest_nl < 0 : rest_src.length() ||: else : rest_nl
    lz_snip       :- rest_src.substring(0, line_rest.min(5).max(0))
    num_str       :- ||: num_prefix.length() > 0 : num_prefix + num_digs ||: else : num_int + (||: num_has_dot : "." + num_frac ||: else : "") + (||: num_has_exp : "e" + num_exp_sign + num_exp ||: else : "")
    num_sig_trim  :- num_sig.substring(0, num_sig_nz.min(num_sig.length()))
    num_sci_exp   :- (||: num_int_sig > 0 : num_int_sig - 1 ||: else : 0 - num_frac_lead - 1) + (||: num_exp_sign == "-" : 0 - num_exp_val ||: else : num_exp_val)

    # Java `Double.toString` layout, mirrored from slice 34. Exact for
    # literals with at most 15 significant digits in the normal range.
    render_float(digs: String!, e: Int!) :- String!
        alias m        :- digs.length()
        alias pad17    :- (digs + "00000000000000000").substring(0, 17)
        alias is_inf   :- e >= 309 or (e == 308 and pad17.compare_to("17976931348623158") >= 0)
        alias int_len  :- (e + 1).max(0).min(m)
        alias int_txt  :- ||: m <= e + 1 : digs + "0".repeat((e + 1 - m).max(0)) ||: else : digs.substring(0, int_len)
        alias frac_txt :- ||: m <= e + 1 : "0" ||: else : digs.substring(int_len, (m - int_len).max(0))
        alias neg_txt  :- "0." + "0".repeat((0 - e - 1).max(0)) + digs
        alias sci_frac :- ||: m > 1 : digs.substring(m.min(1), (m - 1).max(0)) ||: else : "0"
        alias sci_txt  :- digs.substring(0, m.min(1)) + "." + sci_frac + "E" + e.to_string()
        ||: m == 0 : "0.0" ||: is_inf : "Infinity" ||: e <= -325 : "0.0" ||: e >= 0 and e < 7 : int_txt + "." + frac_txt ||: e < 0 and e >= -3 : neg_txt ||: else : sci_txt

    num_value_text :- ||: num_kind == "float" : self.render_float(num_sig_trim, num_sci_exp) ||: num_prefix.length() > 0 : num_val.to_string() ||: num_sig.length() == 0 : "0" ||: else : num_sig

    # Chapter 26. Every char class some step arm consumes. The emit
    # layer duplicates the left operand of each `and` / `or` it lowers,
    # so a flat chain of N terms costs 2^N text. Groups of five keep the
    # unexpected-char guard small.
    lex_known_a :- is_sp or is_nl or is_comma or is_colon or is_lparen
    lex_known_b :- is_rparen or is_bang or is_q or is_eq or is_dash
    lex_known_c :- is_lt or is_gt or is_pipe or is_id_start or is_digit
    lex_known_d :- is_dquote or is_squote or is_lbracket or is_rbracket or is_lbrace
    lex_known_e :- is_rbrace or is_dot or is_semi or is_plus or is_star
    lex_known_f :- is_slash or is_pct or is_amp or is_at or is_hash
    lex_known   :- lex_known_a or lex_known_b or lex_known_c or lex_known_d or lex_known_e or lex_known_f

    top_indent :- indent_stack.at((indent_stack.count() - 1).max(0)) ?? 0

    # Chapter 26 replaced the last-token test with `at_line_start`. A
    # source whose last line has content and no trailing newline still
    # owes that line its line bump, and its NEWLINE token only when the
    # line is not a bracket continuation and closes at depth zero.
    ends_open_line :- not at_line_start
    indent_popped  :- indent_str.substring((indent_str.index_of(" ") + 1).max(0).min(indent_str.length()), (indent_str.length() - indent_str.index_of(" ") - 1).max(0))
    eol_newline    :- bracket_depth == 0 and not line_is_cont

    # Chapter 28 def-frame probes. `def_trig` reads the last three
    # tokens the line left, `eol_def` arms the frame at the line end
    # when no NEWLINE closes the line.
    def_on     :- def_base >= 0
    def_in     :- def_on and line_indent > def_base
    def_out    :- def_on and line_indent <= def_base
    at_content :- not at_src_end and not is_sp and not is_nl and not is_hash
    tk_n       :- tokens.count()
    tk_a       :- tokens.at((tk_n - 3).max(0)) ?? Token(kind: "eof", value: "", line: line_num, col: 1)
    tk_b       :- tokens.at((tk_n - 2).max(0)) ?? Token(kind: "eof", value: "", line: line_num, col: 1)
    tk_c       :- tokens.at((tk_n - 1).max(0)) ?? Token(kind: "eof", value: "", line: line_num, col: 1)
    def_trig_a :- tk_a.kind == "glyph" and tk_a.value == "=>"
    def_trig_b :- tk_b.kind == "kw" and tk_b.value == "def"
    def_trig_c :- tk_c.kind == "punct" and tk_c.value == ":"
    def_trig   :- tk_n >= 3 and def_trig_a and def_trig_b and def_trig_c
    eol_def    :- not line_in_def and not eol_newline and def_trig
    eol_nl_tok :- eol_newline and not line_in_def


    # Chapter-26 parse state. `pos` is the token cursor, `frames` /
    # `depth` the simulated call stack, `v_*` the returned value.
    pos:    Int!    = 0
    depth:  Int!    = 0
    frames: List of Frame = []
    v_ser:  String! = ""
    v_kind: String! = "other"
    v_ops:  String! = ""
    v_args: String! = ""
    # Chapter 27. The last `.field` built (`ld_*`) and the last call
    # closed (`lc_*`). A value whose rendering equals `lc_ser` is that
    # call, since the rendering is a faithful encoding of the node, so
    # the `|>` expression reads its callee shape from these registers.
    ld_ser:  String! = ""
    ld_tgt:  String! = ""
    ld_nm:   String! = ""
    lc_ser:  String! = ""
    lc_cal:  String! = ""
    lc_tgt:  String! = ""
    lc_nm:   String! = ""
    lc_args: String! = ""
    # Chapter 28. `stmt_mode` is argv[2] == "stmt", which parses a
    # statement sequence instead of one expression. `b_op` carries the
    # opener of a block that just closed (`blk`, `do`, `lam`) past the
    # pop, so `blk_done` knows where the block value goes.
    stmt_mode: Bool! = false
    b_op:    String! = ""
    # Chapter 29. `item_mode` is argv[2] == "item", which parses a
    # sequence of atom-body items. `scan_*` run scan-past-parens for the
    # parametric observable probe. `lm_*` record the last message shape
    # built, so a receive pattern can split its target and payload the
    # way the chapter-27 `lc_*` registers split a call. `f_dflt`,
    # `pl_dflt`, and `pl_acc` carry a field's default name and a closed
    # param list past their pops.
    item_mode: Bool! = false
    scan_p:    Int!    = 0
    scan_d:    Int!    = 0
    scan_hit:  Bool!   = false
    lm_ser:    String! = ""
    lm_tgt:    String! = ""
    lm_fields: String! = ""
    f_dflt:    String! = ""
    pl_dflt:   String! = ""
    pl_acc:    String! = ""
    # Chapter 30. `prog_mode` is argv[2] == "prog", which parses a whole
    # program through parse* and parse-top. `p_out` holds the rendered
    # top-level nodes. The `d_*` registers describe the def being
    # parsed (defs never nest), `d_name` is also the name the body
    # messages quote (`Item` in item mode). The body renders into three
    # segments split at the first field and the first `use` line, where
    # the two folds put their merged sections. `e_*` and `ec_*` carry
    # the enum reshape checks, `f_*` and `pl_sref` the per-field probes.
    # `imp_*` hold an import line, `x_*` an extend block. `v_w` is the
    # FFI-wrapped rendering of the type in `v_ser`.
    prog_mode: Bool!   = false
    p_out:     String! = ""
    d_name:    String! = "Item"
    d_pos:     Int!    = 0
    d_ctor:    String! = "(params)"
    d_queue:   String! = "nil"
    d_seg0:    String! = ""
    d_seg1:    String! = ""
    d_seg2:    String! = ""
    d_nmark:   Int!    = 0
    d_m1:      String! = ""
    d_fields:  String! = ""
    d_uses:    String! = ""
    d_trans:   Bool!   = false
    d_use:     Bool!   = false
    d_sig:     Bool!   = false
    d_hascase: Bool!   = false
    d_frn:     Bool!   = false
    d_cdflt:   Bool!   = false
    d_pinv:    Bool!   = false
    d_noncase: Bool!   = false
    d_np:      String! = ""
    e_raw_nm:  String! = ""
    e_raw_val: String! = ""
    e_noraw:   String! = ""
    e_payany:  Bool!   = false
    e_max:     Int!    = 0
    e_sr_case: String! = ""
    e_sr_par:  String! = ""
    ec_nm:     String! = ""
    ec_raw:    String! = ""
    ec_sref:   String! = ""
    ec_pay:    Bool!   = false
    f_sref:    String! = ""
    f_cdf:     Bool!   = false
    pl_sref:   String! = ""
    imp_mode:  String! = ""
    imp_dot:   String! = ""
    imp_lang:  String! = ""
    imp_hdr:   String! = ""
    imp_names: String! = ""
    imp_as:    String! = "nil"
    in_ext:    Bool!   = false
    ext_repl:  Bool!   = false
    x_target:  String! = ""
    x_conf:    String! = ""
    x_body:    String! = ""
    v_w:       String! = ""

    cur_tok    :- tokens.at(pos) ?? Token(kind: "eof", value: "", line: line_num, col: 1)
    cur_kind   :- cur_tok.kind
    cur_value  :- cur_tok.value
    cur_line   :- cur_tok.line
    cur_tcol   :- cur_tok.col
    nxt_tok    :- tokens.at(pos + 1) ?? Token(kind: "eof", value: "", line: line_num, col: 1)
    nxt_kind   :- nxt_tok.kind
    nxt_value  :- nxt_tok.value
    nxt_line   :- nxt_tok.line
    nxt2_tok   :- tokens.at(pos + 2) ?? Token(kind: "eof", value: "", line: line_num, col: 1)
    nxt2_kind  :- nxt2_tok.kind
    nxt2_value :- nxt2_tok.value
    nxt2_line  :- nxt2_tok.line
    nxt3_tok   :- tokens.at(pos + 3) ?? Token(kind: "eof", value: "", line: line_num, col: 1)
    nxt3_kind  :- nxt3_tok.kind
    nxt3_value :- nxt3_tok.value
    nxt4_tok   :- tokens.at(pos + 4) ?? Token(kind: "eof", value: "", line: line_num, col: 1)
    nxt4_kind  :- nxt4_tok.kind
    nxt4_value :- nxt4_tok.value

    # pr-str of a token value, the way `fail!` prints the got-token.
    # Layout tokens carry nil, numbers print bare (an overflowed Double
    # prints `##Inf`), everything else is a quoted string whose body the
    # lex already holds in pr-str form.
    cur_layout :- cur_kind == "newline" or cur_kind == "indent" or cur_kind == "dedent" or cur_kind == "eof"
    cur_pr     :- ||: cur_layout : "nil" ||: cur_kind == "int" : cur_value ||: cur_kind == "float" and cur_value == "Infinity" : "##Inf" ||: cur_kind == "float" : cur_value ||: else : "\"" + cur_value + "\""
    cur_got    :- " (got :" + cur_kind + " " + cur_pr + " at line " + cur_line.to_string() + ")"
    nxt_layout :- nxt_kind == "newline" or nxt_kind == "indent" or nxt_kind == "dedent" or nxt_kind == "eof"
    nxt_pr     :- ||: nxt_layout : "nil" ||: nxt_kind == "int" : nxt_value ||: nxt_kind == "float" and nxt_value == "Infinity" : "##Inf" ||: nxt_kind == "float" : nxt_value ||: else : "\"" + nxt_value + "\""
    nxt_got    :- " (got :" + nxt_kind + " " + nxt_pr + " at line " + nxt_line.to_string() + ")"
    nxt2_layout :- nxt2_kind == "newline" or nxt2_kind == "indent" or nxt2_kind == "dedent" or nxt2_kind == "eof"
    nxt2_pr    :- ||: nxt2_layout : "nil" ||: nxt2_kind == "int" : nxt2_value ||: nxt2_kind == "float" and nxt2_value == "Infinity" : "##Inf" ||: nxt2_kind == "float" : nxt2_value ||: else : "\"" + nxt2_value + "\""
    nxt2_got   :- " (got :" + nxt2_kind + " " + nxt2_pr + " at line " + nxt2_line.to_string() + ")"

    cur_is_lparen   :- cur_kind == "punct" and cur_value == "("
    cur_is_rparen   :- cur_kind == "punct" and cur_value == ")"
    cur_is_lbracket :- cur_kind == "punct" and cur_value == "["
    cur_is_rbracket :- cur_kind == "punct" and cur_value == "]"
    cur_is_lbrace   :- cur_kind == "punct" and cur_value == "{"
    cur_is_dot      :- cur_kind == "punct" and cur_value == "."
    cur_is_comma    :- cur_kind == "punct" and cur_value == ","
    cur_is_colon    :- cur_kind == "punct" and cur_value == ":"
    cur_is_emit     :- cur_kind == "glyph" and cur_value == ":>"
    cur_is_sync     :- cur_kind == "glyph" and cur_value == "|>"
    cur_is_multi    :- cur_kind == "glyph" and cur_value == "||:"
    cur_is_neg      :- cur_kind == "glyph" and cur_value == "-"
    cur_is_plus     :- cur_kind == "glyph" and cur_value == "+"
    cur_is_not      :- cur_kind == "kw" and cur_value == "not"
    cur_is_else     :- cur_kind == "kw" and cur_value == "else"
    nxt_is_fat      :- nxt_kind == "glyph" and nxt_value == "=>"
    nxt_is_rparen   :- nxt_kind == "punct" and nxt_value == ")"
    nxt_is_rbracket :- nxt_kind == "punct" and nxt_value == "]"
    nxt_is_colon    :- nxt_kind == "punct" and nxt_value == ":"
    nxt_is_name     :- nxt_kind == "ident" or nxt_kind == "kw"
    nxt2_is_fat     :- nxt2_kind == "glyph" and nxt2_value == "=>"
    cur_is_raise    :- cur_kind == "kw" and cur_value == "raise"
    cur_is_q        :- cur_kind == "punct" and cur_value == "?"
    cur_is_bang     :- cur_kind == "punct" and cur_value == "!"
    nxt_is_multi    :- nxt_kind == "glyph" and nxt_value == "||:"
    nxt_is_comma    :- nxt_kind == "punct" and nxt_value == ","
    nxt_is_of       :- nxt_kind == "kw" and nxt_value == "of"
    nxt_is_suffix   :- nxt_kind == "punct" and (nxt_value == "?" or nxt_value == "!")
    nxt2_is_lparen  :- nxt2_kind == "punct" and nxt2_value == "("
    nxt2_is_colon   :- nxt2_kind == "punct" and nxt2_value == ":"
    nxt2_is_multi   :- nxt2_kind == "glyph" and nxt2_value == "||:"
    nxt2_is_close   :- nxt2_kind == "punct" and (nxt2_value == ")" or nxt2_value == ",")
    nxt3_is_rparen  :- nxt3_kind == "punct" and nxt3_value == ")"

    # glyph-precedence plus binary-glyph?. 0 means not a binary op.
    cur_is_opk :- cur_kind == "glyph" or cur_kind == "kw"
    cur_p1     :- cur_value == "or" or cur_value == "??"
    cur_p3a    :- cur_value == "==" or cur_value == "!=" or cur_value == "<=" or cur_value == ">="
    cur_p3b    :- cur_value == "<" or cur_value == ">" or cur_value == "is" or cur_value == "in"
    cur_p4     :- cur_value == "+" or cur_value == "-"
    cur_p5     :- cur_value == "*" or cur_value == "/" or cur_value == "%"
    op_prec    :- ||: not cur_is_opk : 0 ||: cur_p1 : 1 ||: cur_value == "and" : 2 ||: cur_p3a or cur_p3b : 3 ||: cur_p4 : 4 ||: cur_p5 : 5 ||: else : 0

    # parse-primary dispatch classes.
    cur_is_lit   :- cur_kind == "int" or cur_kind == "float" or cur_kind == "string" or cur_kind == "char"
    kw_atom      :- cur_kind == "kw" and (cur_value == "self" or cur_value == "nil" or cur_value == "true" or cur_value == "false")
    prim_atom    :- cur_is_lit or kw_atom or (cur_kind == "ident" and not nxt_is_fat)
    atom_ser     :- ||: cur_kind == "int" : "(int " + cur_value + ")" ||: cur_kind == "float" : "(float " + cur_value + ")" ||: cur_kind == "string" : "(string \"" + cur_value + "\")" ||: cur_kind == "char" : "(char \"" + cur_value + "\")" ||: cur_kind == "ident" : "(ident " + cur_value + ")" ||: cur_value == "self" : "(self)" ||: cur_value == "nil" : "(nil)" ||: else : "(bool " + cur_value + ")"
    prim_lambda1 :- cur_kind == "ident" and nxt_is_fat
    prim_lambda0 :- cur_is_lparen and nxt_is_rparen and nxt2_is_fat
    prim_paren   :- cur_is_lparen and not (nxt_is_rparen and nxt2_is_fat)
    prim_list0   :- cur_is_lbracket and nxt_is_rbracket
    prim_list    :- cur_is_lbracket and not nxt_is_rbracket
    prim_special :- prim_lambda1 or prim_lambda0 or prim_paren or prim_list0 or prim_list
    prim_send    :- cur_is_multi or cur_is_emit or cur_is_sync or cur_is_raise
    prim_do      :- cur_kind == "kw" and cur_value == "do"
    prim_err     :- not prim_atom and not prim_special and not prim_send and not prim_do
    prim_err_text :- ||: cur_kind == "kw" and cur_value == "if" and nxt_kind == "kw" and nxt_value == "let" : "expression-position `if let ...` is not supported. `if let` ships at statement position only (F39 L7). Rewrite as an outer `if let` statement." ||: cur_kind == "kw" and cur_value == "if" : "expression-position `if <cond>: <then> else: <else>` retired 2026-08-31 (R6). Rewrite as `||: <cond> : <then> ||: else : <else>` — multi-arm dispatch is the sole expression-position branching form at v1.0. For if/else chains use `||: c1 : b1 ||: c2 : b2 ||: else : b3`. See decisions-frozen-2026-08-31-glyphs.md §R6." ||: cur_kind == "kw" : "unexpected keyword " + cur_value + " in expression" ||: cur_kind == "punct" : "unexpected punctuation in expression" ||: cur_kind == "glyph" : "unexpected glyph `" + cur_value + "` in expression" ||: cur_kind == "newline" : "expected an expression, got a newline. Corvid does not continue expressions across newlines outside brackets. Common causes: (a) `let x: T =` followed by a newline before the RHS — keep the RHS on the same line as `=`, or hoist the value into an atom observation and read it here as `self.<obs>`; (b) a `||:` chain starting on its own line — hoist it into an observation body (`v :- Type = (||: g1 : b1 ||: else : b2)`) rather than embedding as a bare RHS." ||: else : "expected an expression"

    # looks-like-msg-payload-parens? at a `(`. The payload path itself
    # is out of port scope, the probe keeps a call from claiming it.
    mp_named    :- nxt_kind == "ident" and nxt2_kind == "punct" and nxt2_value == ":"
    mp_bare     :- nxt3_kind == "punct" and (nxt3_value == ")" or nxt3_value == ",")
    mp_upper    :- nxt3_kind == "ident" and nxt3_value.code_at(0) >= 65 and nxt3_value.code_at(0) <= 90
    mp_after_ok :- not (nxt4_kind == "punct" and (nxt4_value == "(" or nxt4_value == "."))
    msg_payload :- mp_named and (mp_bare or (mp_upper and mp_after_ok))
    pf_any      :- cur_is_dot or cur_is_lparen or cur_is_lbracket or cur_is_lbrace or cur_is_emit or cur_is_sync

    # variant-pattern-start? at the token after `is`.
    variant_start :- (nxt_kind == "punct" and nxt_value == "." and nxt2_kind == "ident") or (nxt_kind == "ident" and nxt2_kind == "punct" and nxt2_value == "." and nxt3_kind == "ident")

    # Frame stack. `top` is the frame at `depth - 1`.
    top      :- frames.at((depth - 1).max(0)) ?? Frame(kind: "none", prec: 0, op: "", ser: "", ekind: "other", ops: "", acc: "", aux: "", cal: "", ctg: "", cnm: "")
    top_kind :- ||: depth == 0 : "none" ||: else : top.kind
    fresh_binop :- Frame(kind: "binop", prec: 1, op: "", ser: "", ekind: "other", ops: "", acc: "", aux: "", cal: "", ctg: "", cnm: "")
    mk(k: String!, s: String!) :- Frame
        Frame(kind: k, prec: 0, op: "", ser: s, ekind: "other", ops: "", acc: "", aux: "", cal: "", ctg: "", cnm: "")
    mkop(k: String!, o: String!, s: String!, pr: Int!) :- Frame
        Frame(kind: k, prec: pr, op: o, ser: s, ekind: "other", ops: "", acc: "", aux: "", cal: "", ctg: "", cnm: "")
    mkcall(s: String!, c: String!, t: String!, n: String!) :- Frame
        Frame(kind: "call", prec: 0, op: "", ser: s, ekind: "other", ops: "", acc: "", aux: "", cal: c, ctg: t, cnm: n)
    retop(nop: String!, nser: String!, nek: String!, nops: String!, nacc: String!, naux: String!) :- Frame
        Frame(kind: top.kind, prec: top.prec, op: nop, ser: nser, ekind: nek, ops: nops, acc: nacc, aux: naux, cal: top.cal, ctg: top.ctg, cnm: top.cnm)

    # parse-binop loop test and the chained-cmp combine.
    bl_takes      :- op_prec > 0 and op_prec >= top.prec
    bl_variant    :- cur_value == "is" and variant_start
    top_op_cmp    :- top.op == "<" or top.op == "<=" or top.op == ">" or top.op == ">="
    lhs_chainable :- top.ekind == "cmp" or top.ekind == "chain"
    comb_kind     :- ||: top_op_cmp and lhs_chainable : "chain" ||: top_op_cmp : "cmp" ||: else : "other"
    comb_ops      :- ||: comb_kind == "chain" : top.ops + " " + top.op ||: else : top.op
    comb_args     :- ||: comb_kind == "chain" : top.acc + " " + v_ser ||: else : top.ser + " " + v_ser
    comb_ser      :- ||: comb_kind == "chain" : "(chained-cmp (" + comb_ops + ") " + comb_args + ")" ||: else : "(binop " + top.op + " " + top.ser + " " + v_ser + ")"
    arg_ser       :- ||: top.aux == "" : "(pos " + v_ser + ")" ||: else : "(named " + top.aux + " " + v_ser + ")"
    arm_ser       :- " (arm " + top.aux + " " + v_ser + ")"

    # Chapter 27. Callee shape of the value about to be called, the
    # head a closing call frame renders, and the `|>` split.
    v_is_ld      :- v_ser == ld_ser
    v_is_ident   :- v_ser.starts_with("(ident ")
    callee_cal   :- ||: v_is_ld : "dot" ||: v_is_ident : "ident" ||: else : "other"
    callee_tgt   :- ||: v_is_ld : ld_tgt ||: else : ""
    callee_nm    :- ||: v_is_ld : ld_nm ||: v_is_ident : v_ser.substring(7, (v_ser.length() - 8).max(0)) ||: else : ""
    call_head    :- ||: top.op == "" : "(call " + top.ser ||: else : top.ser
    call_args    :- top.acc + " " + arg_ser
    sync_ok      :- v_ser == lc_ser and (lc_cal == "dot" or lc_cal == "ident")
    sync_tgt     :- ||: lc_cal == "dot" : lc_tgt ||: else : "nil"

    # variant-pattern-start? already holds at the `is`, so the head is
    # either `. case` or `Enum . case`.
    var_head     :- ||: nxt_kind == "punct" : "(variant . " + nxt2_value ||: else : "(variant " + nxt_value + " " + nxt3_value
    var_skip     :- ||: nxt_kind == "punct" : 3 ||: else : 4
    bind_named   :- cur_kind == "ident" and nxt_is_colon and nxt2_kind == "kw" and nxt2_value == "let" and nxt3_kind == "ident"
    bind_pos     :- cur_kind == "kw" and cur_value == "let" and nxt_kind == "ident"
    bind_bad     :- not cur_is_rparen and not cur_is_comma and not bind_named and not bind_pos

    # parse-type. A new item for a `tofl` / `ttup` / `tnt` frame.
    named_tt     :- cur_is_lparen and nxt_kind == "ident" and nxt2_is_colon
    t_item       :- ||: top_kind == "tnt" : top.aux + ":" + v_ser ||: else : v_ser
    tacc         :- ||: top.prec == 0 : t_item ||: else : top.acc + "," + t_item
    # Chapter 30. The same list under wrap-ffi-primitives-nonnil, kept
    # in the type frame's `ops`.
    w_item       :- ||: top_kind == "tnt" : top.aux + ":" + v_w ||: else : v_w
    wacc         :- ||: top.prec == 0 : w_item ||: else : top.ops + "," + w_item
    ty_next      :- Frame(kind: top.kind, prec: top.prec + 1, op: "", ser: top.ser, ekind: "other", ops: wacc, acc: tacc, aux: "", cal: "", ctg: "", cnm: "")
    ty_frame     :- top_kind == "tof" or top_kind == "tofl" or top_kind == "ttup" or top_kind == "tnt"

    # Multi-line `||:`. `m_more` is another arm, inline, after a
    # NEWLINE, or after the one NEWLINE INDENT the chain may open. A
    # chain that opened its INDENT consumes the DEDENT that closes it.
    m_cont_nl    :- cur_kind == "newline" and nxt_is_multi
    m_cont_ind   :- cur_kind == "newline" and nxt_kind == "indent" and nxt2_is_multi and top.prec == 0
    m_more       :- cur_is_multi or m_cont_nl or m_cont_ind
    m_body       :- top_kind == "multi" and top.op == "body"
    m_q_dedent   :- ||: cur_kind == "newline" : nxt_kind == "dedent" ||: else : cur_kind == "dedent"
    m_q_skip     :- ||: cur_kind == "newline" : 2 ||: else : 1
    m_q_got      :- ||: cur_kind == "newline" : nxt_got ||: else : cur_got
    m_open       :- Frame(kind: "multi", prec: 1, op: "", ser: top.ser, ekind: "other", ops: "", acc: top.acc + arm_ser, aux: "", cal: "", ctg: "", cnm: "")

    # looks-like-dispatch-tail? after a parse-expr. Only `expr_start`
    # pushes a binop frame at min-prec 1, so `top.prec == 1` is
    # parse-expr returning. The `<:` dispatch block is out of port scope.
    disp_tail    :- top.prec == 1 and cur_is_colon and nxt_kind == "newline" and nxt2_kind == "indent" and nxt3_kind == "glyph" and nxt3_value == "<:"

    # Chapter 28. parse-statement dispatch classes, in Clojure's cond
    # order. Each guard is kept disjoint from the earlier branches, and
    # the joins stay at five terms (chapter-26 2^N rule).
    nxt_is_lparen :- nxt_kind == "punct" and nxt_value == "("
    nxt_is_let   :- nxt_kind == "kw" and nxt_value == "let"
    cur_is_let   :- cur_kind == "kw" and cur_value == "let"
    s_ret        :- cur_kind == "kw" and cur_value == "return"
    s_if         :- cur_kind == "kw" and cur_value == "if"
    s_stage      :- cur_kind == "ident" and nxt_is_fat
    s_let        :- cur_is_let and nxt_kind == "ident"
    s_letkw      :- cur_is_let and nxt_kind == "kw"
    s_alias      :- cur_kind == "kw" and cur_value == "alias"
    s_for        :- cur_kind == "kw" and cur_value == "for"
    s_switch     :- cur_kind == "ident" and cur_value == "switch" and not nxt_is_fat
    s_while      :- cur_kind == "kw" and cur_value == "while"
    s_break      :- cur_kind == "kw" and cur_value == "break"
    s_cont       :- cur_kind == "kw" and cur_value == "continue"
    s_sp_a       :- s_ret or s_if or s_stage or s_let or s_letkw
    s_sp_b       :- s_alias or cur_is_emit or cur_is_sync or s_for or s_switch
    s_sp_c       :- s_while or s_break or s_cont
    s_plain      :- not s_sp_a and not s_sp_b and not s_sp_c
    s_brk_ok     :- nxt_kind == "newline" or nxt_kind == "dedent"
    alias_ok     :- nxt_kind == "ident" and nxt2_kind == "glyph" and nxt2_value == ":-"
    cur_is_eq    :- cur_kind == "glyph" and cur_value == "="
    # if-let binding type. Only when `:` is not followed by NEWLINE or `=`.
    il_typed     :- nxt2_is_colon and nxt3_kind != "newline" and not (nxt3_kind == "glyph" and nxt3_value == "=")
    il_b         :- " (bind " + top.aux + " " + v_ser + ")"
    il_all       :- top.acc + il_b
    il_ser       :- "(if-let (" + il_all.substring(1, (il_all.length() - 1).max(0)) + ")"
    v_bare       :- v_ser.starts_with("(emit ") or v_ser.starts_with("(dispatch ")
    v_ident_nm   :- v_ser.substring(7, (v_ser.length() - 8).max(0))
    nl_indent    :- cur_kind == "newline" and nxt_kind == "indent"
    colon_block  :- nxt_kind == "newline" and nxt2_kind == "indent"
    do_block     :- nxt2_kind == "newline" and nxt3_kind == "indent"
    or_at_cur    :- cur_kind == "kw" and cur_value == "or"
    or_at_nxt    :- cur_kind == "newline" and nxt_kind == "kw" and nxt_value == "or"

    # parse-dispatch-pattern classes and the arm rendering.
    cur_is_recv  :- cur_kind == "glyph" and cur_value == "<:"
    d_wild       :- cur_kind == "glyph" and cur_value == "*"
    d_under      :- cur_kind == "ident" and cur_value == "_"
    d_bool       :- cur_kind == "kw" and (cur_value == "true" or cur_value == "false")
    d_dot        :- cur_is_dot and nxt_kind == "ident"
    d_case       :- cur_kind == "ident" and cur_value != "_"
    d_ok_a       :- d_wild or d_under or cur_kind == "int"
    d_ok_b       :- d_bool or d_dot or d_case
    d_when       :- cur_kind == "kw" and cur_value == "when" and nxt_is_colon
    d_pats       :- ||: top.acc == "" : v_ser ||: else : top.acc + " " + v_ser
    d_guard      :- ||: top.aux == "" : "nil" ||: else : top.aux
    d_arm        :- " (arm (" + top.acc + ") " + d_guard + " " + v_ser + ")"

    # Frame builders for statements, blocks, and dispatch arms.
    mkst(o: String!, a: String!, pr: Int!) :- Frame
        Frame(kind: "st", prec: pr, op: o, ser: "", ekind: "other", ops: "", acc: "", aux: a, cal: "", ctg: "", cnm: "")
    mkblk(o: String!, h: String!, pr: Int!) :- Frame
        Frame(kind: "blk", prec: pr, op: o, ser: h, ekind: "other", ops: "", acc: "", aux: "", cal: "", ctg: "", cnm: "")

    # ---------------------------------------------------------------
    # Chapter 29 probes. Atom-body items (parse-def-atom's body loop).
    # ---------------------------------------------------------------
    expr_mode :- not stmt_mode and not item_mode and not prog_mode

    # Any token by index. `fail!` prints no got-token suffix when the
    # position is past the last token.
    tkn(i: Int!) :- Token
        tokens.at(i.max(0)) ?? Token(kind: "eof", value: "", line: line_num, col: 1)
    tk_kind(i: Int!) :- String!
        self.tkn(i).kind
    tk_value(i: Int!) :- String!
        self.tkn(i).value
    tk_pr(i: Int!) :- String!
        ||: self.tk_kind(i) == "newline" or self.tk_kind(i) == "indent" or self.tk_kind(i) == "dedent" or self.tk_kind(i) == "eof" : "nil" ||: self.tk_kind(i) == "int" : self.tk_value(i) ||: self.tk_kind(i) == "float" and self.tk_value(i) == "Infinity" : "##Inf" ||: self.tk_kind(i) == "float" : self.tk_value(i) ||: else : "\"" + self.tk_value(i) + "\""
    tok_got(i: Int!) :- String!
        ||: i >= tokens.count() : "" ||: else : " (got :" + self.tk_kind(i) + " " + self.tk_pr(i) + " at line " + self.tkn(i).line.to_string() + ")"
    tok_line(i: Int!) :- Int!
        self.tkn(i).line
    prim_vt(n: String!) :- Bool!
        ",Int,Int8,Int16,Int32,Int64,UInt,UInt8,UInt16,UInt32,UInt64,Float,Double,Bool,Char,Byte,Bytes,Unit,Never,".contains("," + n + ",")

    # proposition-line-start?. Layout tokens mark a logical line start.
    prv_kind   :- self.tkn(pos - 1).kind
    line_start :- pos == 0 or prv_kind == "newline" or prv_kind == "indent" or prv_kind == "dedent"
    cur_is_pc  :- cur_kind == "glyph" and cur_value == "|:"
    cur_is_as  :- cur_kind == "kw" and cur_value == "as"
    nxt_is_cd  :- nxt_kind == "glyph" and nxt_value == ":-"
    pr_cont    :- cur_kind == "newline" and nxt_kind == "indent" and nxt2_kind == "kw" and nxt2_value == "as"
    pr_tb      :- nxt_kind == "ident" and nxt2_is_colon
    lay_end    :- cur_kind == "newline" or cur_kind == "dedent" or cur_kind == "eof"

    # The def-body dispatch, in parse-def-atom's cond order. `scan_hit`
    # is scan-past-parens for a `name(...)` head.
    obs_name   :- cur_kind == "ident" or (cur_kind == "kw" and (cur_value == "as" or cur_value == "from"))
    i_obs      :- obs_name and (nxt_is_cd or (nxt_is_lparen and scan_hit))
    i_handler  :- cur_kind == "glyph" and cur_value == "->" and nxt_kind == "ident" and nxt2_is_lparen
    i_field    :- cur_kind == "ident" and nxt_is_colon and nxt2_kind != "newline"
    i_trans    :- (cur_kind == "glyph" and (cur_value == "->" or cur_value == "*")) or (cur_kind == "kw" and cur_value == "self") or cur_kind == "ident"
    i_foreign  :- cur_kind == "ident" and cur_value == "foreign" and nxt_kind == "string" and nxt2_is_colon
    i_cfn      :- cur_kind == "ident" and cur_value == "class" and nxt_kind == "kw" and nxt_value == "function"
    i_defm     :- cur_kind == "kw" and cur_value == "def" and nxt_kind == "ident" and nxt2_is_lparen
    i_defn     :- cur_kind == "kw" and cur_value == "def" and nxt_kind == "ident" and nxt2_is_colon
    i_state    :- cur_kind == "ident" and cur_value == "state" and nxt_is_colon
    i_onnil    :- cur_kind == "ident" and cur_value == "on_nil" and nxt_is_colon
    i_kw       :- ||: cur_kind == "kw" : cur_value ||: else : ""
    i_class    :- ||: cur_is_pc : "prop" ||: i_kw == "invariants" : "inv" ||: cur_is_recv : "rsig" ||: i_foreign : "foreign" ||: i_kw == "use" : "use" ||: i_kw == "replace" : "replace" ||: i_cfn : "cfn" ||: i_kw == "function" : "func" ||: i_defm : "defm" ||: i_defn : "defn" ||: i_state : "state" ||: i_kw == "accepts" : "accepts" ||: i_kw == "case" : "case" ||: i_obs : "obs" ||: i_handler : "handler" ||: i_onnil : "onnil" ||: i_field : "field" ||: i_trans : "trans" ||: else : "err"
    sc_kind    :- self.tkn(scan_p).kind
    sc_value   :- self.tkn(scan_p).value
    sc_end     :- scan_p >= tokens.count()
    sc_lp      :- sc_kind == "punct" and sc_value == "("
    sc_rp      :- sc_kind == "punct" and sc_value == ")"
    sc_after   :- self.tkn(scan_p + 1).kind == "glyph" and self.tkn(scan_p + 1).value == ":-"
    use_rsv    :- ",hash,description,debugDescription,class,superclass,".contains("," + nxt_value + ",")
    def_ty_nm  :- ||: nxt3_kind == "ident" : nxt3_value ||: else : "TypeName"

    # parse-field. A field frame keeps the name in `cnm`, the modifier
    # in `aux`, its position in `prec`, the type in `acc`, the default
    # in `ops`.
    mkfld(nm: String!, md: String!, pr: Int!) :- Frame
        Frame(kind: "fld", prec: pr, op: "ty", ser: "", ekind: "other", ops: "nil", acc: "", aux: md, cal: "", ctg: "", cnm: nm)
    upd(npr: Int!, nop: String!, nser: String!, nops: String!, nacc: String!, naux: String!, ncal: String!, nctg: String!, ncnm: String!) :- Frame
        Frame(kind: top.kind, prec: npr, op: nop, ser: nser, ekind: top.ekind, ops: nops, acc: nacc, aux: naux, cal: ncal, ctg: nctg, cnm: ncnm)
    f_mod      :- cur_kind == "kw" and (cur_value == "weak" or cur_value == "unowned")
    nxt2_mod   :- nxt2_kind == "kw" and (nxt2_value == "weak" or nxt2_value == "unowned")
    fty_tn     :- v_ser.starts_with("TN(")
    fty_tn_nm  :- ||: v_ser.starts_with("TN(TR:") : v_ser.substring(6, (v_ser.length() - 7).max(0)) ||: else : "T"
    fty_prim   :- v_ser.starts_with("TR:") and self.prim_vt(v_ser.substring(3, (v_ser.length() - 3).max(0)))
    fty_of     :- v_ser.starts_with("TO:")
    fty_of_nm  :- v_ser.substring(3.min(v_ser.length()), (v_ser.index_of("(") - 3).max(0))
    fty_tup    :- v_ser.starts_with("TT(") or v_ser.starts_with("TNT(")
    fty_bad    :- fty_tn or fty_prim or fty_of or fty_tup
    fty_msg    :- ||: fty_tn : "F13 L1: `" + top.aux + " " + fty_tn_nm + "!` is invalid — `!` is the non-nil contract, but a `weak` reference is observably nil once its target deallocates. `unowned` names non-owning strong references (undefined behavior on dangle), which is orthogonal to the `!` contract. Drop the `!` (spec §6.14)." ||: fty_prim : "F13 L1: `" + top.aux + " " + v_ser.substring(3, (v_ser.length() - 3).max(0)) + "` is invalid — reference modifiers apply to reference types (atoms, `String`); `" + v_ser.substring(3, (v_ser.length() - 3).max(0)) + "` is a value/primitive type (spec §6.14). Drop the modifier." ||: fty_of : "F13 L1: `" + top.aux + " " + fty_of_nm + " of ...` is invalid — collections don't propagate reference modifiers to their elements. Purpose-built weak-element containers land as a follow-on (spec §6.14)." ||: else : "F13 L1: `" + top.aux + "` on a tuple type is invalid — reference modifiers apply only to single reference types (atoms, `String`), not to compound types (spec §6.14)."
    f_ser      :- "(field " + top.cnm + " " + top.acc + " " + top.ops + (||: top.aux == "" : "" ||: else : " " + top.aux) + ")"

    # Param lists. `plist` keeps the rendered params in `acc`, the first
    # defaulted field name in `cnm`, and `param` or `rparam` in `op`.
    mkpl(o: String!) :- Frame
        Frame(kind: "plist", prec: 0, op: o, ser: "", ekind: "other", ops: "", acc: "", aux: "", cal: "", ctg: "", cnm: "")
    pl_self    :- top.op == "param" and cur_kind == "kw" and cur_value == "self"
    pl_bare    :- top.op == "rparam" and cur_kind == "ident" and nxt_is_colon and nxt2_is_close

    # Then clauses, transition bodies, observables.
    th_up      :- cur_kind == "ident" and nxt_is_fat
    th_dup     :- top.aux.contains("," + cur_value + ",")
    bh_then    :- cur_kind == "kw" and cur_value == "then" and nxt_is_colon
    bh_do      :- cur_kind == "kw" and cur_value == "do" and nxt_is_colon
    bh_let     :- cur_kind == "kw" and cur_value == "let" and nxt_is_colon
    bh_any     :- bh_then or bh_do or bh_let
    mp_typed   :- cur_kind == "ident" and nxt_is_lparen and (nxt2_kind == "punct" and nxt2_value == ")" or (nxt2_kind == "ident" and nxt3_kind == "punct" and nxt3_value == ":"))
    mp_msg     :- ||: v_ser == lm_ser : "(src " + lm_tgt + lm_fields + ")" ||: else : "(src " + v_ser + ")"
    tr_ps      :- top.aux == "phase"
    tr_tgt_ok  :- top.ekind == "self" or top.ekind == top.cnm
    o_sig      :- top.ctg == "p" and ((cur_kind == "newline" and nxt_kind != "indent") or cur_kind == "dedent" or cur_kind == "eof")
    o_cls      :- ||: o_sig : "sig" ||: nl_indent and nxt2_kind == "glyph" and nxt2_value == "|:" : "pb" ||: cur_is_eq : "ex" ||: nl_indent : "bf" ||: else : "re"
    obs_props  :- ||: top.ops == "" : "" ||: else : " (props" + top.ops + ")"

    # ---------------------------------------------------------------
    # Chapter 30 probes. Whole programs (parse*, parse-top, the def
    # header and reshape in parse-def-atom, parse-extend-class, and the
    # plugin foreign blocks).
    # ---------------------------------------------------------------
    ffi_prim(n: String!) :- Bool!
        ",Int,Int8,Int16,Int32,Int64,Float,Double,Bool,".contains("," + n + ",")
    iseq_more  :- cur_kind != "newline" and not (cur_kind == "eof" and item_mode) and not (cur_kind == "dedent" and prog_mode)
    cur_is_star  :- cur_kind == "glyph" and cur_value == "*"
    cur_is_arrow :- cur_kind == "glyph" and cur_value == "->"
    nxt_is_as  :- nxt_kind == "kw" and nxt_value == "as"

    # Field probes for the reshapes, read at parse-field's end. `fb_self`
    # is a type whose base through `!` and `?` is the def itself (the
    # self-reference payload check), `f_cdf_now` a default that calls a
    # capitalized bare ident (the atom-ctor default agent signal).
    fb_in      :- ||: top.acc.starts_with("TN(") or top.acc.starts_with("TQ(") : top.acc.substring(3.min(top.acc.length()), (top.acc.length() - 4).max(0)) ||: else : top.acc
    fb_self    :- fb_in == "TR:" + d_name
    f_cdf_now  :- top.ops.starts_with("(call (ident ") and top.ops.code_at(13) >= 65 and top.ops.code_at(13) <= 90

    # parse-top's cond, in order. `protocol` is not a reserved word, so
    # the `sealed protocol` arm never fires, as in Clojure.
    t_sealed   :- cur_kind == "ident" and cur_value == "sealed" and nxt_kind == "kw" and nxt_value == "protocol"
    t_sugar    :- cur_kind == "ident" and (cur_value == "record" or cur_value == "enum" or cur_value == "class") and nxt_kind == "ident"
    t_extern   :- cur_kind == "ident" and cur_value == "extern"
    t_class    :- ||: i_kw == "module" : "module" ||: i_kw == "from" : "from" ||: i_kw == "import" : "import" ||: i_kw == "let" : "let" ||: i_kw == "def" : "def" ||: i_kw == "extend" : "extend" ||: t_sealed : "sealed" ||: t_extern : "extern" ||: t_sugar : "sugar" ||: else : "err"
    f_lang     :- nxt_kind == "ident" and (nxt_value == "objc" or nxt_value == "c") and nxt2_kind == "string"
    nxt3_is_imp :- nxt3_kind == "kw" and nxt3_value == "import"
    imp_node   :- ||: imp_mode == "ffrom" : ((" (from-foreign-import " + imp_lang) + (" \"" + imp_hdr)) + (("\"" + imp_names) + ")") ||: else : (" (from-import " + imp_dot) + (imp_names + ")")

    # parse-def-atom's header. `queue:` reads tokens up to `(` + 6.
    q_head     :- cur_is_lparen and nxt_kind == "ident" and nxt_value == "queue" and nxt2_is_colon
    q_unb      :- nxt3_kind == "ident" and nxt3_value == "unbounded"
    q_bnd      :- nxt3_kind == "ident" and nxt3_value == "bounded" and nxt4_kind == "punct" and nxt4_value == "("
    q5_int     :- self.tk_kind(pos + 5) == "int"
    q5_zero    :- self.tk_value(pos + 5) == "0"
    q6_rp      :- self.tk_kind(pos + 6) == "punct" and self.tk_value(pos + 6) == ")"
    dh_free    :- nxt_kind == "ident" and d_name.code_at(0) >= 97 and d_name.code_at(0) <= 122

    # Body items as they reach the def's loop, by rendering head.
    it_field   :- v_ser.starts_with("(field ")
    it_use     :- v_ser.starts_with("(use ")
    it_case    :- v_ser.starts_with("(enum-case ")
    it_frn     :- v_ser.starts_with("(foreign ")
    it_trans   :- v_ser.starts_with("(transition ")
    it_osig    :- v_ser.starts_with("(obs-sig ")
    it_rsig    :- v_ser.starts_with("(recv-sig ")
    it_obs     :- v_ser.starts_with("(obs ")
    it_node    :- ||: it_trans : ":transition" ||: it_osig : ":observation-signature" ||: it_obs : ":observable" ||: it_rsig : ":receive-signature" ||: v_ser.starts_with("(prop ") : ":proposition" ||: it_case : ":enum-case" ||: v_ser.starts_with("(on-nil") : ":on-nil-section" ||: v_ser.starts_with("(class-fn ") : ":class-function" ||: it_use : ":use-section" ||: it_frn : ":foreign-block" ||: else : ":field"
    it_fold    :- it_field or it_use
    it_mark    :- (it_field and d_fields == "") or (it_use and d_uses == "")

    # The reshape. fold-direct-use-lines and fold-top-level-fields put
    # their merged sections at the first use line and the first field,
    # the segment marks, so the folded body is the segments joined with
    # the two sections in mark order.
    d_mk(m: String!) :- String!
        ||: m == "F" : " (data" + d_fields + ")" ||: else : " (uses" + d_uses + ")"
    d_m2       :- ||: d_m1 == "F" : "U" ||: else : "F"
    d_body     :- (d_seg0 + (||: d_nmark >= 1 : self.d_mk(d_m1) ||: else : "")) + (d_seg1 + ((||: d_nmark >= 2 : self.d_mk(d_m2) ||: else : "") + d_seg2))
    d_plugin   :- d_name == "plugin"
    d_hasctor  :- d_ctor != "(params)"
    d_hasq     :- d_queue != "nil"
    d_agent_a  :- d_trans or d_use or d_cdflt or d_hasctor or d_hasq
    e_mixed    :- e_raw_nm != "" and e_noraw != ""
    e_rtype    :- ||: e_raw_nm == "" : "nil" ||: e_max <= 255 : "UInt8" ||: e_max <= 65535 : "UInt16" ||: e_max <= 4294967295 : "UInt32" ||: else : "UInt64"
    rs_pl      :- ||: d_hasctor : "pl_ctor" ||: d_hasq : "pl_q" ||: d_np != "" : "pl_np" ||: else : "plugin"
    rs_pr      :- ||: d_hasctor : "pr_ctor" ||: d_pinv : "pr_inv" ||: d_hasq : "q" ||: else : "protocol"
    rs_en      :- ||: d_hasctor : "en_ctor" ||: d_noncase : "en_mix" ||: e_mixed : "en_raw" ||: e_raw_nm != "" and e_payany : "en_rawpay" ||: e_sr_case != "" : "en_self" ||: d_hasq : "q" ||: else : "enum"
    rs_class   :- ||: not d_plugin and d_frn : "frn" ||: d_plugin : rs_pl ||: d_sig : rs_pr ||: d_hascase : rs_en ||: d_agent_a : "agent" ||: else : "record"
    rs_ikind   :- ||: d_sig : ":protocol" ||: else : ":tagged-variant"

    # parse-extend-section's cond, after the outer loop's nested-extend
    # check. `ext_repl` is set once a `replace` prefix is consumed.
    x_conf_ln  :- cur_kind == "ident" and cur_value == "conforms" and nxt_is_colon
    x_class    :- ||: ext_repl and i_obs : "robs" ||: ext_repl and cur_is_star : "rtrans" ||: ext_repl : "rerr" ||: i_kw == "extend" : "nest" ||: i_kw == "replace" : "repl" ||: cur_is_pc : "prop" ||: i_kw == "invariants" : "inv" ||: x_conf_ln : "conf" ||: i_obs : "obs" ||: cur_is_star : "trans" ||: i_field : "fielderr" ||: i_kw == "use" : "use" ||: i_kw == "deprecated" : "dep" ||: i_state : "state" ||: else : "err"
    x_item     :- ||: ext_repl : " (replace " + v_ser + ")" ||: else : " " + v_ser

    # parse-foreign-entry.
    fe_kind_ok :- cur_value == "symbol" or cur_value == "selector" or cur_value == "class_selector" or cur_value == "type"
    fe_sel     :- cur_kind == "ident" and (cur_value == "selector" or cur_value == "class_selector")
    fe_sym     :- cur_kind == "ident" and cur_value == "symbol"
    fe_type    :- cur_kind == "ident" and cur_value == "type"
    nxt2_is_arrow :- nxt2_kind == "glyph" and nxt2_value == "->"
    nxt3_is_arrow :- nxt3_kind == "glyph" and nxt3_value == "->"

    -> lex_start
        then:
            source => args.get_or(1, "").replace("\\n", "\n").replace("\\N", "\\n")
            stmt_mode => args.get_or(2, "") == "stmt"
            item_mode => args.get_or(2, "") == "item"
            prog_mode => args.get_or(2, "") == "prog"
            self :> step

    -> parsing
        then: self :> begin

    -> end
        then:
            let final: String! = ||: error : "error|" + error_msg ||: else : v_ser
            console.write(final)


    lex_start <: step -> lex_start
        |: at_src_end and not error and ends_open_line and dedent_err != ""
        then:
            error => true
            error_msg => dedent_err
            self :> step

    lex_start <: step -> lex_start
        |: at_src_end and not error and ends_open_line and dedent_err == ""
        then:
            tokens => ||: eol_nl_tok : tokens.append(Token(kind: "newline", value: "", line: line_num, col: 1)) ||: else : tokens
            def_base => ||: eol_def : line_indent ||: else : def_base
            def_seen => ||: eol_def : false ||: else : def_seen
            line_in_def => false
            line_num => line_num + 1
            col_num => 1
            at_line_start => true
            self :> step

    lex_start <: step -> lex_start
        |: at_src_end and not error and not ends_open_line
        then:
            self :> emit_trailing_dedents

    lex_start <: step -> lex_start
        |: not at_src_end and at_line_start
        then:
            self :> measure_indent

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_sp
        then:
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_nl and dedent_err != ""
        then:
            error => true
            error_msg => dedent_err
            sc => source.length()
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_nl and dedent_err == ""
        then:
            tokens => ||: eol_nl_tok : tokens.append(Token(kind: "newline", value: "", line: line_num, col: 1)) ||: else : tokens
            def_base => ||: eol_def : line_indent ||: else : def_base
            def_seen => ||: eol_def : false ||: else : def_seen
            line_in_def => false
            line_is_cont => bracket_depth > 0
            line_num => line_num + 1
            col_num => 1
            sc => sc + 1
            at_line_start => true
            line_indent => 0
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_comma
        then:
            tokens => tokens.append(Token(kind: "punct", value: ",", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_colon and not is_col_dash and not is_col_gt
        then:
            tokens => tokens.append(Token(kind: "punct", value: ":", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_lparen
        then:
            tokens => tokens.append(Token(kind: "punct", value: "(", line: line_num, col: col_num))
            bracket_depth => bracket_depth + 1
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_rparen
        then:
            tokens => tokens.append(Token(kind: "punct", value: ")", line: line_num, col: col_num))
            bracket_depth => bracket_depth - 1
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_bang and not is_bang_eq
        then:
            tokens => tokens.append(Token(kind: "punct", value: "!", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_q and not is_double_q
        then:
            tokens => tokens.append(Token(kind: "punct", value: "?", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_any_multi
        then:
            let two: String! = source.substring(sc, 2)
            tokens => tokens.append(Token(kind: "glyph", value: two, line: line_num, col: col_num))
            sc => sc + 2
            col_num => col_num + 2
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_eq and not is_fat_arrow and not is_eq_eq
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "=", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_dash and not is_arrow
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "-", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_lt and not is_lt_col and not is_lte and not is_lt_pipe
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "<", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_gt and not is_gte
        then:
            tokens => tokens.append(Token(kind: "glyph", value: ">", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_pipe and not is_pipe_col and not is_pipe_gt and not is_dpipe_col
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "|", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    # Chapter-26 arms. Brackets move `bracket_depth`, the rest are
    # plain one-char tokens. `||:` is the one three-char glyph.
    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_dpipe_col
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "||:", line: line_num, col: col_num))
            sc => sc + 3
            col_num => col_num + 3
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_lbracket
        then:
            tokens => tokens.append(Token(kind: "punct", value: "[", line: line_num, col: col_num))
            bracket_depth => bracket_depth + 1
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_rbracket
        then:
            tokens => tokens.append(Token(kind: "punct", value: "]", line: line_num, col: col_num))
            bracket_depth => bracket_depth - 1
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_lbrace
        then:
            tokens => tokens.append(Token(kind: "punct", value: "{", line: line_num, col: col_num))
            bracket_depth => bracket_depth + 1
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_rbrace
        then:
            tokens => tokens.append(Token(kind: "punct", value: "}", line: line_num, col: col_num))
            bracket_depth => bracket_depth - 1
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_dot
        then:
            tokens => tokens.append(Token(kind: "punct", value: ".", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_semi
        then:
            tokens => tokens.append(Token(kind: "punct", value: ";", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_plus
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "+", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_star and not is_dstar
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "*", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_slash and not is_dslash
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "/", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_pct
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "%", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_amp
        then:
            tokens => tokens.append(Token(kind: "glyph", value: "&", line: line_num, col: col_num))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    # `#` ends the line's tokens. The newline itself stays for the
    # newline arm.
    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_hash
        then:
            sc => sc + line_rest
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_at
        then:
            error => true
            sc => source.length()
            error_msg => "annotation grammar (`@name(...)`) is retired at v1.0 (annotation-grammar-retirement 2026-08-30). Plugin manifest → `def plugin:` block (spec §7.2). Metadata (kind) → body-shape inference (§3.3). Deprecation → comment / user convention."
            self :> step

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_id_start
        then:
            word_acc => ""
            tok_start_col => col_num
            self :> scan_word

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_digit
        then:
            tok_start_col => col_num
            num_digs => ""
            num_last_digit => false
            num_mode => "int"
            num_base => 10
            num_prefix => ""
            num_int => ""
            num_frac => ""
            num_exp => ""
            num_has_dot => false
            num_has_exp => false
            num_exp_sign => ""
            num_kind => "int"
            num_val => 0
            num_sig => ""
            num_sig_nz => 0
            num_int_sig => 0
            num_frac_lead => 0
            num_exp_val => 0
            self :> num_start

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_dquote
        then:
            word_acc => ""
            tok_start_col => col_num
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_str

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and is_squote
        then:
            word_acc => ""
            tok_start_col => col_num
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_char_body

    lex_start <: step -> lex_start
        |: not at_src_end and not at_line_start and not lex_known
        then:
            error => true
            sc => source.length()
            error_msg => ||: srccur > 32 and srccur < 127 : "unexpected character: \\" + source.substring(sc, 1) ||: else : "lex: unexpected char"
            self :> step

    lex_start <: step -> end
        |: error

    lex_start <: measure_indent -> lex_start
        |: not at_src_end and is_sp
        then:
            line_indent => line_indent + 1
            sc => sc + 1
            col_num => col_num + 1
            self :> measure_indent

    lex_start <: measure_indent -> lex_start
        |: not at_src_end and is_nl
        then:
            line_num => line_num + 1
            col_num => 1
            sc => sc + 1
            line_indent => 0
            self :> measure_indent

    lex_start <: measure_indent -> lex_start
        |: at_src_end
        then: self :> step

    # Chapter 26. A comment-only line is blank. A continuation line
    # skips the indent comparison entirely.
    lex_start <: measure_indent -> lex_start
        |: not at_src_end and is_hash
        then:
            sc => sc + line_rest
            self :> measure_indent

    # Chapter 28. Inside an armed def-frame a deeper line opens with
    # INDENT or NEWLINE, a line at or under the base closes the frame
    # and is measured again under the normal rules.
    lex_start <: measure_indent -> lex_start
        |: at_content and def_in
        then:
            tokens => tokens.append(||: def_seen : Token(kind: "newline", value: "", line: line_num, col: 1) ||: else : Token(kind: "indent", value: "", line: line_num, col: 1))
            def_seen => true
            line_in_def => true
            at_line_start => false
            col_num => 1
            self :> step

    lex_start <: measure_indent -> lex_start
        |: at_content and def_out
        then:
            tokens => tokens.append(Token(kind: "newline", value: "", line: line_num, col: 1)).append(Token(kind: "dedent", value: "", line: line_num, col: 1))
            def_base => -1
            self :> measure_indent

    lex_start <: measure_indent -> lex_start
        |: at_content and not def_on and not line_is_cont
        then:
            at_line_start => false
            col_num => 1
            dedenting => false
            indent_snap => indent_str
            self :> adjust_indent

    lex_start <: measure_indent -> lex_start
        |: at_content and not def_on and line_is_cont
        then:
            at_line_start => false
            col_num => 1
            self :> step

    lex_start <: adjust_indent -> lex_start
        |: line_indent > top_indent and not dedenting
        then:
            tokens => tokens.append(Token(kind: "indent", value: "", line: line_num, col: 1))
            indent_stack => indent_stack.append(line_indent)
            indent_str => line_indent.to_string() + " " + indent_str
            self :> step

    lex_start <: adjust_indent -> lex_start
        |: line_indent > top_indent and dedenting
        then:
            dedent_err => "inconsistent dedent at line " + line_num.to_string() + ": this line's indent (" + line_indent.to_string() + (||: line_indent == 1 : " column" ||: else : " columns") + ") does not match any enclosing block's indent level (open blocks are at [" + indent_snap + "]). Fix: align this line with one of those indents, or make the parent block consistent (typically means mixing tabs and spaces or a stray half-indent)."
            self :> step

    lex_start <: adjust_indent -> lex_start
        |: line_indent < top_indent
        then:
            tokens => tokens.append(Token(kind: "dedent", value: "", line: line_num, col: 1))
            indent_stack => indent_stack.filter(x => x < top_indent)
            indent_str => indent_popped
            dedenting => true
            self :> adjust_indent

    lex_start <: adjust_indent -> lex_start
        |: line_indent == top_indent
        then: self :> step

    # Chapter 28. A frame still armed at end of source closes first.
    lex_start <: emit_trailing_dedents -> lex_start
        |: def_on
        then:
            tokens => tokens.append(Token(kind: "dedent", value: "", line: line_num, col: 1))
            def_base => -1
            self :> emit_trailing_dedents

    lex_start <: emit_trailing_dedents -> parsing
        |: not def_on and indent_stack.count() <= 1
        then:
            tokens => tokens.append(Token(kind: "eof", value: "", line: line_num, col: 1))

    lex_start <: emit_trailing_dedents -> lex_start
        |: not def_on and indent_stack.count() > 1
        then:
            tokens => tokens.append(Token(kind: "dedent", value: "", line: line_num, col: 1))
            indent_stack => indent_stack.filter(x => x < top_indent)
            self :> emit_trailing_dedents

    lex_start <: scan_word -> lex_start
        |: not at_src_end and is_id_cont
        then:
            word_acc => word_acc + source.substring(sc, 1)
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_word

    lex_start <: scan_word -> lex_start
        |: at_src_end or not is_id_cont
        then:
            let kind: String! = ||: reserved.contains(word_acc) : "kw" ||: else : "ident"
            tokens => tokens.append(Token(kind: kind, value: word_acc, line: line_num, col: tok_start_col))
            self :> step

    # Chapter-25 — scan-number port. `num_start` picks the base the way
    # Clojure's scan-number does (prefix `0x` / `0b` / `0o`, C-octal
    # rejection, else decimal), `scan_digs` is scan-digits with its
    # three `_` errors, `digs_done` routes on `num_mode` to the next
    # part (frac, signed exponent, hex frac), and `num_suffix` /
    # `scan_sfx` port reject-unit-suffix!. Every error arm parks `sc` at
    # end of source (chapter-23 rule).
    lex_start <: num_start -> lex_start
        |: srccur == 48 and (srcnext == 120 or srcnext == 88)
        then:
            num_base => 16
            num_prefix => "0x"
            num_mode => "based"
            sc => sc + 2
            col_num => col_num + 2
            self :> scan_digs

    lex_start <: num_start -> lex_start
        |: srccur == 48 and (srcnext == 98 or srcnext == 66)
        then:
            num_base => 2
            num_prefix => "0b"
            num_mode => "based"
            sc => sc + 2
            col_num => col_num + 2
            self :> scan_digs

    lex_start <: num_start -> lex_start
        |: srccur == 48 and (srcnext == 111 or srcnext == 79)
        then:
            num_base => 8
            num_prefix => "0o"
            num_mode => "based"
            sc => sc + 2
            col_num => col_num + 2
            self :> scan_digs

    lex_start <: num_start -> lex_start
        |: srccur == 48 and srcnext >= 48 and srcnext <= 57
        then:
            error => true
            sc => source.length()
            error_msg => "leading-zero integer `" + lz_snip + "…` — cxc rejects C's `017` octal form as ambiguous. Use `0o17` for octal or drop the leading zero for decimal. See spec §2.7.1."
            self :> step

    lex_start <: num_start -> lex_start
        |: not (srccur == 48 and (srcnext == 120 or srcnext == 88 or srcnext == 98 or srcnext == 66 or srcnext == 111 or srcnext == 79 or (srcnext >= 48 and srcnext <= 57)))
        then: self :> scan_digs

    lex_start <: scan_digs -> lex_start
        |: not num_run_end and num_digit_val >= 0
        then:
            let ch: String! = source.substring(sc, 1)
            let sig_mode: Bool! = num_mode == "int" or num_mode == "frac"
            let skip: Bool! = num_sig.length() == 0 and srccur == 48
            num_digs => num_digs + ch
            num_last_digit => true
            num_sig => ||: sig_mode and not skip : num_sig + ch ||: else : num_sig
            num_sig_nz => ||: sig_mode and srccur != 48 : num_sig.length() + 1 ||: else : num_sig_nz
            num_int_sig => ||: num_mode == "int" and not skip : num_int_sig + 1 ||: else : num_int_sig
            num_frac_lead => ||: num_mode == "frac" and skip : num_frac_lead + 1 ||: else : num_frac_lead
            num_exp_val => ||: num_mode == "exp" : (num_exp_val * 10 + srccur - 48).min(1000000) ||: else : num_exp_val
            num_val => ||: num_mode == "based" : num_val * num_base + num_digit_val ||: else : num_val
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_digs

    lex_start <: scan_digs -> lex_start
        |: not num_run_end and num_digit_val < 0 and is_us and num_last_digit
        then:
            num_last_digit => false
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_digs

    lex_start <: scan_digs -> lex_start
        |: not num_run_end and num_digit_val < 0 and is_us and not num_last_digit
        then:
            error => true
            sc => source.length()
            error_msg => "`_` in numeric literal must follow a digit"
            self :> step

    lex_start <: scan_digs -> lex_start
        |: num_run_end and num_digs.length() > 0 and not num_last_digit
        then:
            error => true
            sc => source.length()
            error_msg => "numeric literal ends with `_`"
            self :> step

    lex_start <: scan_digs -> lex_start
        |: not num_run_end and num_digit_val < 0 and not is_us and num_digs.length() > 0 and not num_last_digit
        then:
            error => true
            sc => source.length()
            error_msg => "numeric literal has trailing `_`"
            self :> step

    lex_start <: scan_digs -> lex_start
        |: (num_run_end or (num_digit_val < 0 and not is_us)) and (num_digs.length() == 0 or num_last_digit)
        then: self :> digs_done

    # Int part done. `.` plus a digit opens the frac run, `e` / `E` the
    # exponent, anything else ends an int.
    lex_start <: digs_done -> lex_start
        |: num_mode == "int" and is_dot and srcnext_is_digit
        then:
            num_int => num_digs
            num_has_dot => true
            num_digs => ""
            num_last_digit => false
            num_mode => "frac"
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_digs

    lex_start <: digs_done -> lex_start
        |: num_mode == "int" and not (is_dot and srcnext_is_digit) and is_exp_marker
        then:
            num_int => num_digs
            num_has_exp => true
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_exp_sign

    lex_start <: digs_done -> lex_start
        |: num_mode == "int" and not (is_dot and srcnext_is_digit) and not is_exp_marker
        then:
            num_int => num_digs
            self :> num_suffix

    lex_start <: digs_done -> lex_start
        |: num_mode == "frac" and is_exp_marker
        then:
            num_frac => num_digs
            num_has_exp => true
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_exp_sign

    lex_start <: digs_done -> lex_start
        |: num_mode == "frac" and not is_exp_marker
        then:
            num_frac => num_digs
            num_kind => "float"
            self :> num_suffix

    lex_start <: digs_done -> lex_start
        |: num_mode == "exp" and num_digs.length() == 0
        then:
            error => true
            sc => source.length()
            error_msg => "exponent requires digits after `e`/`E`/`p`/`P`"
            self :> step

    lex_start <: digs_done -> lex_start
        |: num_mode == "exp" and num_digs.length() > 0
        then:
            num_exp => num_digs
            num_kind => "float"
            self :> num_suffix

    # Based ints. A hex `.` plus hex digit opens the hex-float frac run.
    # The C99 `p` exponent form itself is out of port scope (its value
    # is binary and needs exact rendering), so it raises a port-only
    # message the corpus never carries.
    lex_start <: digs_done -> lex_start
        |: num_mode == "based" and num_base == 16 and is_dot and next_hex >= 0
        then:
            num_digs => ""
            num_last_digit => false
            num_mode => "hexfrac"
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_digs

    lex_start <: digs_done -> lex_start
        |: (num_mode == "hexfrac" or (num_mode == "based" and num_base == 16 and not (is_dot and next_hex >= 0))) and is_p_marker
        then:
            error => true
            sc => source.length()
            error_msg => "lex: hex-float literal out of port scope"
            self :> step

    lex_start <: digs_done -> lex_start
        |: num_mode == "hexfrac" and not is_p_marker
        then:
            error => true
            sc => source.length()
            error_msg => "hex-float literal requires the `p`/`P` binary exponent (C99 form; e.g. `0x1.8p+1`)"
            self :> step

    lex_start <: digs_done -> lex_start
        |: num_mode == "based" and not (num_base == 16 and ((is_dot and next_hex >= 0) or is_p_marker)) and num_digs.length() == 0
        then:
            error => true
            sc => source.length()
            error_msg => "empty numeric literal after `" + num_prefix + "`/`" + num_prefix.uppercase() + "` prefix"
            self :> step

    lex_start <: digs_done -> lex_start
        |: num_mode == "based" and not (num_base == 16 and ((is_dot and next_hex >= 0) or is_p_marker)) and num_digs.length() > 0
        then: self :> num_suffix

    lex_start <: scan_exp_sign -> lex_start
        |: srccur == 43 or srccur == 45
        then:
            num_exp_sign => source.substring(sc, 1)
            num_digs => ""
            num_last_digit => false
            num_mode => "exp"
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_digs

    lex_start <: scan_exp_sign -> lex_start
        |: not (srccur == 43 or srccur == 45)
        then:
            num_digs => ""
            num_last_digit => false
            num_mode => "exp"
            self :> scan_digs

    # reject-unit-suffix!. A letter or `_` right after the literal is a
    # retired F5 unit suffix. The message quotes the separator-stripped
    # literal plus the whole identifier-like run.
    lex_start <: num_suffix -> lex_start
        |: not num_run_end and (is_letter or is_us)
        then:
            sfx_acc => ""
            sfx_col => cur_col
            self :> scan_sfx

    lex_start <: num_suffix -> lex_start
        |: num_run_end or not (is_letter or is_us)
        then:
            tokens => tokens.append(Token(kind: num_kind, value: num_value_text, line: line_num, col: tok_start_col))
            self :> step

    lex_start <: scan_sfx -> lex_start
        |: not num_run_end and is_id_cont
        then:
            sfx_acc => sfx_acc + source.substring(sc, 1)
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_sfx

    lex_start <: scan_sfx -> lex_start
        |: num_run_end or not is_id_cont
        then:
            error => true
            sc => source.length()
            error_msg => "numeric literal with unit suffix at line " + line_num.to_string() + ", col " + sfx_col.to_string() + ": `" + num_str + sfx_acc + "` — unit suffixes are not part of v1 (spec §2.7.1). Use the type constructor instead, e.g. `Duration(millis: " + num_str + ")`."
            self :> step

    # Chapter-23 — string body. Plain chars go through `enc` so a raw
    # tab or other pr-str-escaped char prints the way the oracle does.
    lex_start <: scan_str -> lex_start
        |: not at_src_end and not is_dquote and not is_nl and not is_bslash
        then:
            word_acc => word_acc + self.enc(srccur)
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_str

    lex_start <: scan_str -> lex_start
        |: not at_src_end and is_bslash
        then:
            esc_mode => "str"
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_esc

    lex_start <: scan_str -> lex_start
        |: not at_src_end and is_dquote
        then:
            tokens => tokens.append(Token(kind: "string", value: word_acc, line: line_num, col: tok_start_col))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: scan_str -> lex_start
        |: at_src_end or is_nl
        then:
            error => true
            sc => source.length()
            error_msg => "unterminated string literal"
            self :> step

    # Chapter-23 — shared escape phases. Entered with `sc` one past the
    # backslash. Clojure scans one physical line at a time, so a
    # physical newline counts as end of input for every escape arm.
    lex_start <: scan_esc -> lex_start
        |: at_src_end or is_nl
        then:
            error => true
            sc => source.length()
            error_msg => ||: esc_mode == "str" : "trailing backslash in string" ||: else : "trailing backslash in char literal"
            self :> step

    lex_start <: scan_esc -> lex_start
        |: not at_src_end and simple_esc_code >= 0
        then:
            word_acc => word_acc + self.enc(simple_esc_code)
            sc => sc + 1
            col_num => col_num + 1
            self :> esc_done

    lex_start <: scan_esc -> lex_start
        |: not at_src_end and is_esc_x
        then:
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_hex_byte

    lex_start <: scan_esc -> lex_start
        |: not at_src_end and is_esc_u
        then:
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_uni_open

    lex_start <: scan_esc -> lex_start
        |: not at_src_end and not is_nl and simple_esc_code < 0 and not is_esc_x and not is_esc_u
        then:
            error => true
            sc => source.length()
            error_msg => "unknown escape sequence `\\" + source.substring(sc, 1) + "` — legal escapes: \\n \\t \\r \\\\ \\\" \\' \\0 \\a \\b \\f \\v \\xNN \\u{...} (spec §2.7.1)"
            self :> step

    # `\xNN`. Exactly two hex digits, both read through the `cur_hex`
    # / `next_hex` lookahead so the arm consumes them in one tick.
    lex_start <: scan_hex_byte -> lex_start
        |: cur_hex >= 0 and next_hex >= 0
        then:
            word_acc => word_acc + self.enc(cur_hex * 16 + next_hex)
            sc => sc + 2
            col_num => col_num + 2
            self :> esc_done

    lex_start <: scan_hex_byte -> lex_start
        |: cur_hex < 0 or next_hex < 0
        then:
            error => true
            sc => source.length()
            error_msg => "`\\xNN` escape requires exactly two hex digits"
            self :> step

    # `\u{HEX+}`. Clojure reads every hex digit up to `}` first, then
    # checks the 1 to 6 digit count, then the U+10FFFF ceiling. The arm
    # order below mirrors that error precedence.
    lex_start <: scan_uni_open -> lex_start
        |: not at_src_end and is_lbrace
        then:
            esc_hex => ""
            esc_val => 0
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_uni_body

    lex_start <: scan_uni_open -> lex_start
        |: at_src_end or not is_lbrace
        then:
            error => true
            sc => source.length()
            error_msg => "`\\u` escape requires `{...}` (e.g. `\\u{1F600}`)"
            self :> step

    lex_start <: scan_uni_body -> lex_start
        |: at_src_end or is_nl
        then:
            error => true
            sc => source.length()
            error_msg => "unterminated `\\u{...}` escape"
            self :> step

    lex_start <: scan_uni_body -> lex_start
        |: not at_src_end and cur_hex >= 0
        then:
            esc_hex => esc_hex + source.substring(sc, 1)
            esc_val => ||: esc_hex.length() >= 7 : esc_val ||: else : esc_val * 16 + cur_hex
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_uni_body

    lex_start <: scan_uni_body -> lex_start
        |: not at_src_end and not is_nl and cur_hex < 0 and not is_rbrace
        then:
            error => true
            sc => source.length()
            error_msg => "`\\u{...}` escape body must be hex digits"
            self :> step

    lex_start <: scan_uni_body -> lex_start
        |: not at_src_end and is_rbrace and not uni_len_ok
        then:
            error => true
            sc => source.length()
            error_msg => "`\\u{...}` escape requires 1-6 hex digits"
            self :> step

    lex_start <: scan_uni_body -> lex_start
        |: not at_src_end and is_rbrace and uni_len_ok and esc_val > 1114111
        then:
            error => true
            sc => source.length()
            error_msg => "Unicode escape U+" + esc_hex + " exceeds U+10FFFF"
            self :> step

    lex_start <: scan_uni_body -> lex_start
        |: not at_src_end and is_rbrace and uni_len_ok and esc_val <= 1114111
        then:
            word_acc => word_acc + self.enc(esc_val)
            sc => sc + 1
            col_num => col_num + 1
            self :> esc_done

    # Return-mode split back to the literal that opened the escape.
    lex_start <: esc_done -> lex_start
        |: esc_mode == "str"
        then: self :> scan_str

    lex_start <: esc_done -> lex_start
        |: esc_mode != "str"
        then: self :> scan_char_close

    # Chapter-23 — char body. Escape bodies share the string escape
    # phases via `esc_mode => "char"`.
    lex_start <: scan_char_body -> lex_start
        |: not at_src_end and is_bslash
        then:
            esc_mode => "char"
            char_esc => true
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_esc

    lex_start <: scan_char_body -> lex_start
        |: not at_src_end and is_squote
        then:
            error => true
            sc => source.length()
            error_msg => "empty char literal `''` — need one character"
            self :> step

    lex_start <: scan_char_body -> lex_start
        |: not at_src_end and not is_squote and not is_nl and not is_bslash
        then:
            word_acc => word_acc + self.enc(srccur)
            char_esc => false
            sc => sc + 1
            col_num => col_num + 1
            self :> scan_char_close

    lex_start <: scan_char_body -> lex_start
        |: at_src_end or is_nl
        then:
            error => true
            sc => source.length()
            error_msg => "unterminated char literal"
            self :> step

    lex_start <: scan_char_close -> lex_start
        |: not at_src_end and is_squote
        then:
            tokens => tokens.append(Token(kind: "char", value: word_acc, line: line_num, col: tok_start_col))
            sc => sc + 1
            col_num => col_num + 1
            self :> step

    lex_start <: scan_char_close -> lex_start
        |: at_src_end or not is_squote
        then:
            error => true
            sc => source.length()
            error_msg => ||: char_esc : "unterminated char literal — expected `'`" ||: else : "char literal must contain exactly one character"
            self :> step

    # ---------------------------------------------------------------
    # Chapter-26 parser. Every error arm sets `error`, the full message,
    # and sends `halt`, whose guard-only arm exits to `end`.
    # ---------------------------------------------------------------

    parsing <: halt -> end
        |: error

    # parse-expression prologue. skip-newlines, then the empty check.
    parsing <: begin -> parsing
        |: expr_mode and cur_kind == "newline"
        then:
            pos => pos + 1
            self :> begin

    parsing <: begin -> parsing
        |: expr_mode and cur_kind == "eof"
        then:
            error => true
            error_msg => "parse-expression: source is empty"
            self :> halt

    parsing <: begin -> parsing
        |: expr_mode and cur_kind != "newline" and cur_kind != "eof"
        then: self :> expr_start

    # Chapter 28 statement mode. A `seq` frame is the oracle's top-level
    # loop, parse-block's loop with eof in place of DEDENT.
    parsing <: begin -> parsing
        |: stmt_mode
        then:
            frames => frames.slice(0, depth).append(self.mk("seq", ""))
            depth => depth + 1
            self :> seq_loop

    # parse-expr. A fresh parse-binop call at min-prec 1.
    parsing <: expr_start -> parsing
        |: not error
        then:
            frames => frames.slice(0, depth).append(fresh_binop)
            depth => depth + 1
            self :> unary_start

    # parse-unary. `-` and `not` wrap, unary `+` is dropped.
    parsing <: unary_start -> parsing
        |: cur_is_neg
        then:
            frames => frames.slice(0, depth).append(self.mk("neg", ""))
            depth => depth + 1
            pos => pos + 1
            self :> unary_start

    parsing <: unary_start -> parsing
        |: cur_is_not
        then:
            frames => frames.slice(0, depth).append(self.mk("not", ""))
            depth => depth + 1
            pos => pos + 1
            self :> unary_start

    parsing <: unary_start -> parsing
        |: cur_is_plus
        then:
            pos => pos + 1
            self :> unary_start

    parsing <: unary_start -> parsing
        |: not cur_is_neg and not cur_is_not and not cur_is_plus
        then: self :> primary

    # parse-primary.
    parsing <: primary -> parsing
        |: prim_atom
        then:
            v_ser => atom_ser
            v_kind => "other"
            pos => pos + 1
            self :> postfix

    parsing <: primary -> parsing
        |: prim_lambda1
        then:
            frames => frames.slice(0, depth).append(self.mk("lambda", "(" + cur_value + ")"))
            depth => depth + 1
            pos => pos + 2
            self :> lambda_body

    parsing <: primary -> parsing
        |: prim_lambda0
        then:
            frames => frames.slice(0, depth).append(self.mk("lambda", "()"))
            depth => depth + 1
            pos => pos + 3
            self :> lambda_body

    parsing <: primary -> parsing
        |: prim_paren
        then:
            frames => frames.slice(0, depth).append(self.mk("paren", ""))
            depth => depth + 1
            pos => pos + 1
            self :> expr_start

    parsing <: primary -> parsing
        |: prim_list0
        then:
            v_ser => "(list)"
            v_kind => "other"
            pos => pos + 2
            self :> postfix

    parsing <: primary -> parsing
        |: prim_list
        then:
            frames => frames.slice(0, depth).append(self.mk("list", ""))
            depth => depth + 1
            pos => pos + 1
            self :> expr_start

    parsing <: primary -> parsing
        |: cur_is_multi
        then:
            frames => frames.slice(0, depth).append(self.mk("multi", ""))
            depth => depth + 1
            pos => pos + 1
            self :> arm_head

    # Chapter 27. `raise T(args)`. The args are parse-args-parens, so a
    # `raw` call frame renders `(raise T arg*)` and returns to postfix.
    parsing <: primary -> parsing
        |: cur_is_raise and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: raise: expected a record TypeName after `raise`" + nxt_got
            self :> halt

    parsing <: primary -> parsing
        |: cur_is_raise and nxt_kind == "ident" and not nxt2_is_lparen
        then:
            error => true
            error_msg => "parse error: raise: expected `(` after TypeName — raise requires a ctor-call form (`raise T(field: value, ...)`)" + nxt2_got
            self :> halt

    parsing <: primary -> parsing
        |: cur_is_raise and nxt_kind == "ident" and nxt2_is_lparen and nxt3_is_rparen
        then:
            v_ser => "(raise " + nxt_value + ")"
            v_kind => "other"
            pos => pos + 4
            self :> postfix

    parsing <: primary -> parsing
        |: cur_is_raise and nxt_kind == "ident" and nxt2_is_lparen and not nxt3_is_rparen
        then:
            frames => frames.slice(0, depth).append(self.mkop("call", "raw", "(raise " + nxt_value, 0))
            depth => depth + 1
            pos => pos + 3
            self :> arg_start

    # Bare `:> msg[(args)]`, a self-broadcast emit with a nil target.
    # parse-postfix runs on the emit node afterwards.
    parsing <: primary -> parsing
        |: cur_is_emit and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: primary -> parsing
        |: cur_is_emit and nxt_kind == "ident" and not nxt2_is_lparen
        then:
            v_ser => "(emit async nil " + nxt_value + ")"
            v_kind => "other"
            pos => pos + 2
            self :> postfix

    parsing <: primary -> parsing
        |: cur_is_emit and nxt_kind == "ident" and nxt2_is_lparen and nxt3_is_rparen
        then:
            v_ser => "(emit async nil " + nxt_value + ")"
            v_kind => "other"
            pos => pos + 4
            self :> postfix

    parsing <: primary -> parsing
        |: cur_is_emit and nxt_kind == "ident" and nxt2_is_lparen and not nxt3_is_rparen
        then:
            frames => frames.slice(0, depth).append(self.mkop("call", "raw", "(emit async nil " + nxt_value, 0))
            depth => depth + 1
            pos => pos + 3
            self :> arg_start

    # `|> <expr>`. The `sync` frame keeps the glyph's line for the
    # error, `ret` checks the parsed value is a call on a dot or ident.
    parsing <: primary -> parsing
        |: cur_is_sync
        then:
            frames => frames.slice(0, depth).append(self.mkop("sync", "", "", cur_line))
            depth => depth + 1
            pos => pos + 1
            self :> expr_start

    # Chapter 28. parse-do-block-expr. A `blk` frame with opener `do`
    # renders `(do <stmt>*)` and returns to parse-postfix. Prec 1 is the
    # inline one-statement form.
    parsing <: primary -> parsing
        |: prim_do and not nxt_is_colon
        then:
            error => true
            error_msg => "parse error: expected :punct \":\"" + nxt_got
            self :> halt

    parsing <: primary -> parsing
        |: prim_do and nxt_is_colon and do_block
        then:
            frames => frames.slice(0, depth).append(self.mkblk("do", "(do", 0))
            depth => depth + 1
            pos => pos + 4
            self :> blk_loop

    parsing <: primary -> parsing
        |: prim_do and nxt_is_colon and not do_block
        then:
            frames => frames.slice(0, depth).append(self.mkblk("do", "(do", 1))
            depth => depth + 1
            pos => pos + 2
            self :> stmt_start

    parsing <: primary -> parsing
        |: prim_err
        then:
            error => true
            error_msg => "parse error: " + prim_err_text + cur_got
            self :> halt

    # parse-lambda-body. Chapter 28. A `def:` body wants INDENT right
    # after the colon (the lex escape opens it inside brackets), and its
    # `blk` frame with opener `lam` hands `(do <stmt>*)` back to `ret`.
    parsing <: lambda_body -> parsing
        |: cur_kind == "kw" and cur_value == "def" and nxt_is_colon and nxt2_kind == "indent"
        then:
            frames => frames.slice(0, depth).append(self.mkblk("lam", "(do", 0))
            depth => depth + 1
            pos => pos + 3
            self :> blk_loop

    parsing <: lambda_body -> parsing
        |: cur_kind == "kw" and cur_value == "def" and nxt_is_colon and nxt2_kind != "indent"
        then:
            error => true
            error_msg => "parse error: expected :indent" + nxt2_got
            self :> halt

    parsing <: lambda_body -> parsing
        |: not (cur_kind == "kw" and cur_value == "def" and nxt_is_colon)
        then: self :> expr_start

    # parse-postfix.
    parsing <: postfix -> parsing
        |: cur_is_dot and nxt_is_name
        then:
            v_ser => "(dot " + v_ser + " " + nxt_value + ")"
            v_kind => "other"
            ld_ser => "(dot " + v_ser + " " + nxt_value + ")"
            ld_tgt => v_ser
            ld_nm => nxt_value
            pos => pos + 2
            self :> postfix

    parsing <: postfix -> parsing
        |: cur_is_dot and not nxt_is_name
        then:
            error => true
            error_msg => "parse error: expected an identifier or method name after `.`" + nxt_got
            self :> halt

    # Chapter 27. parse-msg-args-parens. The `mshape` frame keeps the
    # target, `ms_entry` reads `name:` and either a bareword or a type.
    parsing <: postfix -> parsing
        |: cur_is_lparen and msg_payload
        then:
            frames => frames.slice(0, depth).append(self.mk("mshape", v_ser))
            depth => depth + 1
            pos => pos + 1
            self :> ms_entry

    parsing <: postfix -> parsing
        |: cur_is_lparen and not msg_payload and nxt_is_rparen
        then:
            v_ser => "(call " + v_ser + ")"
            v_kind => "other"
            lc_ser => "(call " + v_ser + ")"
            lc_cal => callee_cal
            lc_tgt => callee_tgt
            lc_nm => callee_nm
            lc_args => ""
            pos => pos + 2
            self :> postfix

    parsing <: postfix -> parsing
        |: cur_is_lparen and not msg_payload and not nxt_is_rparen
        then:
            frames => frames.slice(0, depth).append(self.mkcall(v_ser, callee_cal, callee_tgt, callee_nm))
            depth => depth + 1
            pos => pos + 1
            self :> arg_start

    parsing <: postfix -> parsing
        |: cur_is_lbracket
        then:
            frames => frames.slice(0, depth).append(self.mk("sub", v_ser))
            depth => depth + 1
            pos => pos + 1
            self :> expr_start

    parsing <: postfix -> parsing
        |: cur_is_lbrace
        then:
            error => true
            error_msg => "parse error: message-payload braces `{name: Type, ...}` are retired (F70 I5, 2026-08-19). Use parens `(name: Type, ...)` instead — the parser distinguishes payload-parens (contents start with `name: Type`) from call-parens (contents start with a value expression) by content, so there is no ambiguity at the receive site." + cur_got
            self :> halt

    # Chapter 27. `<expr> :> msg[(args)]`. Clojure returns the emit node
    # without recurring, so the value goes straight to `unary_done`.
    parsing <: postfix -> parsing
        |: cur_is_emit and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: postfix -> parsing
        |: cur_is_emit and nxt_kind == "ident" and not nxt2_is_lparen
        then:
            v_ser => "(emit async " + v_ser + " " + nxt_value + ")"
            v_kind => "other"
            pos => pos + 2
            self :> unary_done

    parsing <: postfix -> parsing
        |: cur_is_emit and nxt_kind == "ident" and nxt2_is_lparen and nxt3_is_rparen
        then:
            v_ser => "(emit async " + v_ser + " " + nxt_value + ")"
            v_kind => "other"
            pos => pos + 4
            self :> unary_done

    parsing <: postfix -> parsing
        |: cur_is_emit and nxt_kind == "ident" and nxt2_is_lparen and not nxt3_is_rparen
        then:
            frames => frames.slice(0, depth).append(self.mkop("call", "rawend", "(emit async " + v_ser + " " + nxt_value, 0))
            depth => depth + 1
            pos => pos + 3
            self :> arg_start

    parsing <: postfix -> parsing
        |: cur_is_sync
        then:
            error => true
            error_msg => "parse error: binary postfix `receiver |> msg(args)` is retired (F70 I6, 2026-08-19). Use prefix form `|> receiver.msg(args)` as a statement — the receiver dots into the message, matching call notation. Prefix normalizes send-site scans and removes the source/receiver-order ambiguity." + cur_got
            self :> halt

    parsing <: postfix -> parsing
        |: not pf_any
        then: self :> unary_done

    # parse-args-parens, one arg. A named arg parks its name in `aux`.
    parsing <: arg_start -> parsing
        |: top.op != "prop" and cur_kind == "ident" and nxt_is_colon
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc, cur_value))
            pos => pos + 2
            self :> expr_start

    parsing <: arg_start -> parsing
        |: top.op != "prop" and not (cur_kind == "ident" and nxt_is_colon)
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc, ""))
            self :> expr_start

    # End of parse-unary. Pop prefix frames, then hand the operand to
    # the binop frame as its lhs.
    parsing <: unary_done -> parsing
        |: top_kind == "neg"
        then:
            v_ser => "(neg " + v_ser + ")"
            v_kind => "other"
            depth => depth - 1
            self :> unary_done

    parsing <: unary_done -> parsing
        |: top_kind == "not"
        then:
            v_ser => "(not " + v_ser + ")"
            v_kind => "other"
            depth => depth - 1
            self :> unary_done

    parsing <: unary_done -> parsing
        |: top_kind == "binop"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", v_ser, v_kind, v_ops, v_args, ""))
            self :> binop_loop

    # parse-binop loop over the top binop frame.
    parsing <: binop_loop -> parsing
        |: bl_takes and nxt_kind == "newline"
        then:
            error => true
            error_msg => "parse error: binary operator `" + cur_value + "` at end of line without a right-hand operand. Corvid does NOT continue expressions across newlines outside brackets. Wrap the whole expression in parens to continue on the next line: `(a\n    + b\n    + c)`." + cur_got
            self :> halt

    # Chapter 27. parse-variant-pattern-rhs. The binop frame records
    # `is` as its pending op and a `variant` frame collects bindings,
    # whose pop hands the pattern to `ret` as the rhs.
    parsing <: binop_loop -> parsing
        |: bl_takes and nxt_kind != "newline" and bl_variant
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(cur_value, top.ser, top.ekind, top.ops, top.acc, "")).append(self.mk("variant", var_head))
            depth => depth + 1
            pos => pos + var_skip
            self :> var_open

    parsing <: binop_loop -> parsing
        |: bl_takes and nxt_kind != "newline" and not bl_variant
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(cur_value, top.ser, top.ekind, top.ops, top.acc, "")).append(self.mkop("binop", "", "", op_prec + 1))
            depth => depth + 1
            pos => pos + 1
            self :> unary_start

    # Chapter 28. parse-dispatch-block. The returning parse-expr frame
    # becomes a `disp` frame holding `(dispatch <scrutinee>` and the
    # rendered arms, past the `:` NEWLINE INDENT.
    parsing <: binop_loop -> parsing
        |: not bl_takes and disp_tail
        then:
            frames => frames.slice(0, depth - 1).append(self.mk("disp", "(dispatch " + top.ser))
            pos => pos + 3
            self :> disp_loop

    parsing <: binop_loop -> parsing
        |: not bl_takes and not disp_tail
        then:
            v_ser => top.ser
            v_kind => top.ekind
            v_ops => top.ops
            v_args => top.acc
            depth => depth - 1
            self :> ret

    # A simulated call returned `v_*`. The frame below decides.
    parsing <: ret -> parsing
        |: top_kind == "binop"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", comb_ser, comb_kind, comb_ops, comb_args, ""))
            self :> binop_loop

    parsing <: ret -> parsing
        |: top_kind == "paren" and cur_is_rparen
        then:
            depth => depth - 1
            pos => pos + 1
            self :> postfix

    parsing <: ret -> parsing
        |: top_kind == "paren" and not cur_is_rparen
        then:
            error => true
            error_msg => "parse error: expected :punct \")\"" + cur_got
            self :> halt

    parsing <: ret -> parsing
        |: top_kind == "call" and cur_is_comma
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + " " + arg_ser, ""))
            pos => pos + 1
            self :> arg_start

    parsing <: ret -> parsing
        |: top_kind == "call" and cur_is_rparen and (top.op == "" or top.op == "raw")
        then:
            v_ser => call_head + call_args + ")"
            v_kind => "other"
            lc_ser => call_head + call_args + ")"
            lc_cal => top.cal
            lc_tgt => top.ctg
            lc_nm => top.cnm
            lc_args => call_args
            depth => depth - 1
            pos => pos + 1
            self :> postfix

    parsing <: ret -> parsing
        |: top_kind == "call" and cur_is_rparen and top.op == "rawend"
        then:
            v_ser => call_head + call_args + ")"
            v_kind => "other"
            depth => depth - 1
            pos => pos + 1
            self :> unary_done

    # Chapter 27. The `|>` operand returned. It must be a call on a dot
    # or an ident, which becomes a sync emit.
    parsing <: ret -> parsing
        |: top_kind == "sync" and sync_ok
        then:
            v_ser => "(emit sync " + sync_tgt + " " + lc_nm + lc_args + ")"
            v_kind => "other"
            depth => depth - 1
            self :> postfix

    parsing <: ret -> parsing
        |: top_kind == "sync" and not sync_ok
        then:
            error => true
            error_msg => "parse error: expression-position `|>` expected `|> receiver.method(args)` (got :glyph \"|>\" at line " + top.prec.to_string() + ")"
            self :> halt

    parsing <: ret -> parsing
        |: top_kind == "call" and not cur_is_comma and not cur_is_rparen
        then:
            error => true
            error_msg => "parse error: expected `,` or `)` in arg list" + cur_got
            self :> halt

    parsing <: ret -> parsing
        |: top_kind == "sub" and cur_is_rbracket
        then:
            v_ser => "(subscript " + top.ser + " " + v_ser + ")"
            v_kind => "other"
            depth => depth - 1
            pos => pos + 1
            self :> postfix

    parsing <: ret -> parsing
        |: top_kind == "sub" and not cur_is_rbracket
        then:
            error => true
            error_msg => "parse error: expected :punct \"]\"" + cur_got
            self :> halt

    parsing <: ret -> parsing
        |: top_kind == "list" and cur_is_comma
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + " " + v_ser, ""))
            pos => pos + 1
            self :> expr_start

    parsing <: ret -> parsing
        |: top_kind == "list" and cur_is_rbracket
        then:
            v_ser => "(list" + top.acc + " " + v_ser + ")"
            v_kind => "other"
            depth => depth - 1
            pos => pos + 1
            self :> postfix

    parsing <: ret -> parsing
        |: top_kind == "list" and not cur_is_comma and not cur_is_rbracket
        then:
            error => true
            error_msg => "parse error: expected `,` or `]` in list literal" + cur_got
            self :> halt

    parsing <: ret -> parsing
        |: top_kind == "lambda"
        then:
            v_ser => "(lambda " + top.ser + " " + v_ser + ")"
            v_kind => "other"
            depth => depth - 1
            self :> postfix

    parsing <: ret -> parsing
        |: top_kind == "multi" and top.op == "guard"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("guard", top.ser, top.ekind, top.ops, top.acc, v_ser))
            self :> arm_colon

    parsing <: ret -> parsing
        |: m_body and cur_is_multi
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser, top.ekind, top.ops, top.acc + arm_ser, ""))
            pos => pos + 1
            self :> arm_head

    # Chapter 27. Block chain. A NEWLINE then `||:` continues at the same
    # indent, a NEWLINE INDENT `||:` opens the chain's one INDENT.
    parsing <: ret -> parsing
        |: m_body and m_cont_nl
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser, top.ekind, top.ops, top.acc + arm_ser, ""))
            pos => pos + 2
            self :> arm_head

    parsing <: ret -> parsing
        |: m_body and m_cont_ind
        then:
            frames => frames.slice(0, depth - 1).append(m_open)
            pos => pos + 3
            self :> arm_head

    parsing <: ret -> parsing
        |: m_body and not m_more and top.prec == 0
        then:
            v_ser => "(multi-arm" + top.acc + arm_ser + ")"
            v_kind => "other"
            depth => depth - 1
            self :> postfix

    parsing <: ret -> parsing
        |: m_body and not m_more and top.prec == 1 and m_q_dedent
        then:
            v_ser => "(multi-arm" + top.acc + arm_ser + ")"
            v_kind => "other"
            depth => depth - 1
            pos => pos + m_q_skip
            self :> postfix

    parsing <: ret -> parsing
        |: m_body and not m_more and top.prec == 1 and not m_q_dedent
        then:
            error => true
            error_msg => "parse error: expected DEDENT after multi-arm `||:` chain" + m_q_got
            self :> halt

    # Chapter 28. A `rawstmt` call is the statement `:> msg(args)`,
    # which is a whole statement and skips parse-postfix.
    parsing <: ret -> parsing
        |: top_kind == "call" and cur_is_rparen and top.op == "rawstmt"
        then:
            v_ser => call_head + call_args + ")"
            v_kind => "other"
            depth => depth - 1
            pos => pos + 1
            self :> sret

    parsing <: ret -> parsing
        |: top_kind == "st"
        then: self :> st_got

    parsing <: ret -> parsing
        |: top_kind == "darm"
        then: self :> darm_got

    parsing <: ret -> parsing
        |: top_kind == "none"
        then: self :> finish

    # parse-multi-arm-arm. `else` is a guard marker, not an expression.
    parsing <: arm_head -> parsing
        |: cur_is_else
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("guard", top.ser, top.ekind, top.ops, top.acc, "else"))
            pos => pos + 1
            self :> arm_colon

    parsing <: arm_head -> parsing
        |: not cur_is_else
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("guard", top.ser, top.ekind, top.ops, top.acc, ""))
            self :> expr_start

    parsing <: arm_colon -> parsing
        |: cur_is_colon
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("body", top.ser, top.ekind, top.ops, top.acc, top.aux))
            pos => pos + 1
            self :> expr_start

    parsing <: arm_colon -> parsing
        |: not cur_is_colon
        then:
            error => true
            error_msg => "parse error: expected :punct \":\"" + cur_got
            self :> halt

    # ---------------------------------------------------------------
    # Chapter 27. `is` variant patterns, `(name: Type)` payloads, and
    # parse-type.
    # ---------------------------------------------------------------

    # parse-variant-pattern-rhs bindings. Commas are skipped wherever
    # they sit, as Clojure's loop does.
    parsing <: var_open -> parsing
        |: cur_is_lparen
        then:
            pos => pos + 1
            self :> var_bind

    parsing <: var_open -> parsing
        |: not cur_is_lparen
        then:
            v_ser => top.ser + ")"
            v_kind => "other"
            depth => depth - 1
            self :> ret

    parsing <: var_bind -> parsing
        |: cur_is_rparen
        then:
            v_ser => top.ser + top.acc + ")"
            v_kind => "other"
            depth => depth - 1
            pos => pos + 1
            self :> ret

    parsing <: var_bind -> parsing
        |: cur_is_comma
        then:
            pos => pos + 1
            self :> var_bind

    parsing <: var_bind -> parsing
        |: bind_named
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser, top.ekind, top.ops, top.acc + " (let " + cur_value + " " + nxt3_value + ")", ""))
            pos => pos + 4
            self :> var_bind

    parsing <: var_bind -> parsing
        |: bind_pos
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser, top.ekind, top.ops, top.acc + " (let " + nxt_value + ")", ""))
            pos => pos + 2
            self :> var_bind

    parsing <: var_bind -> parsing
        |: bind_bad
        then:
            error => true
            error_msg => "parse error: F69 L4: expected `let <name>` or `<field>: let <name>` inside a `<:` case pattern payload. Positional bindings without `let` are not supported — spec §3.7.1 requires discrimination-with-name-binding to be explicit." + cur_got
            self :> halt

    # parse-msg-args-parens, one entry.
    parsing <: ms_entry -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + cur_got
            self :> halt

    parsing <: ms_entry -> parsing
        |: cur_kind == "ident" and not nxt_is_colon
        then:
            error => true
            error_msg => "parse error: expected :punct \":\"" + nxt_got
            self :> halt

    parsing <: ms_entry -> parsing
        |: cur_kind == "ident" and nxt_is_colon and nxt2_is_close
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser, top.ekind, top.ops, top.acc + " (field " + cur_value + " TR:Any bare)", ""))
            pos => pos + 2
            self :> ms_after

    parsing <: ms_entry -> parsing
        |: cur_kind == "ident" and nxt_is_colon and not nxt2_is_close
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser, top.ekind, top.ops, top.acc, cur_value))
            pos => pos + 2
            self :> ty_start

    parsing <: ms_after -> parsing
        |: cur_is_comma
        then:
            pos => pos + 1
            self :> ms_entry

    parsing <: ms_after -> parsing
        |: cur_is_rparen
        then:
            v_ser => "(msg-shape " + top.ser + top.acc + ")"
            lm_ser => "(msg-shape " + top.ser + top.acc + ")"
            lm_tgt => top.ser
            lm_fields => top.acc
            v_kind => "other"
            depth => depth - 1
            pos => pos + 1
            self :> postfix

    parsing <: ms_after -> parsing
        |: not cur_is_comma and not cur_is_rparen
        then:
            error => true
            error_msg => "parse error: expected `,` or `)` in message shape" + cur_got
            self :> halt

    # parse-type. The result is the parse-layer type rendering in
    # `v_ser` (`TR:` `TN(...)` `TQ(...)` `TO:<outer>(...)` `TT(...)`
    # `TNT(f:T,...)`), and `ty_ret` hands it to the frame below.
    parsing <: ty_start -> parsing
        |: named_tt
        then:
            frames => frames.slice(0, depth).append(self.mk("tnt", ""))
            depth => depth + 1
            pos => pos + 1
            self :> tnt_field

    parsing <: ty_start -> parsing
        |: cur_is_lparen and not named_tt
        then:
            frames => frames.slice(0, depth).append(self.mk("ttup", ""))
            depth => depth + 1
            pos => pos + 1
            self :> ty_start

    parsing <: ty_start -> parsing
        |: cur_kind == "ident" and nxt_is_of and nxt2_is_lparen
        then:
            frames => frames.slice(0, depth).append(self.mk("tofl", cur_value))
            depth => depth + 1
            pos => pos + 3
            self :> ty_start

    parsing <: ty_start -> parsing
        |: cur_kind == "ident" and nxt_is_of and not nxt2_is_lparen
        then:
            frames => frames.slice(0, depth).append(self.mk("tof", cur_value))
            depth => depth + 1
            pos => pos + 2
            self :> ty_start

    parsing <: ty_start -> parsing
        |: cur_kind == "ident" and not nxt_is_of
        then:
            v_ser => "TR:" + cur_value
            v_w => ||: self.ffi_prim(cur_value) : "TN(TR:" + cur_value + ")" ||: else : "TR:" + cur_value
            pos => pos + 1
            self :> ty_suffix

    parsing <: ty_start -> parsing
        |: cur_kind != "ident" and not cur_is_lparen
        then:
            error => true
            error_msg => "parse error: expected :ident" + cur_got
            self :> halt

    parsing <: tnt_field -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + cur_got
            self :> halt

    parsing <: tnt_field -> parsing
        |: cur_kind == "ident" and not nxt_is_colon
        then:
            error => true
            error_msg => "parse error: expected `:` in named-tuple field decl" + nxt_got
            self :> halt

    parsing <: tnt_field -> parsing
        |: cur_kind == "ident" and nxt_is_colon
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser, top.ekind, top.ops, top.acc, cur_value))
            pos => pos + 2
            self :> ty_start

    # Nullability suffix. `?` and `!` cannot stack.
    parsing <: ty_suffix -> parsing
        |: (cur_is_q or cur_is_bang) and nxt_is_suffix
        then:
            error => true
            error_msg => "parse error: cannot stack `?`/`!` on the same type (spec §3.6.1)" + nxt_got
            self :> halt

    parsing <: ty_suffix -> parsing
        |: cur_is_q and not nxt_is_suffix
        then:
            v_ser => "TQ(" + v_ser + ")"
            v_w => "TQ(" + v_ser + ")"
            pos => pos + 1
            self :> ty_ret

    parsing <: ty_suffix -> parsing
        |: cur_is_bang and not nxt_is_suffix
        then:
            v_ser => "TN(" + v_ser + ")"
            v_w => "TN(" + v_ser + ")"
            pos => pos + 1
            self :> ty_ret

    parsing <: ty_suffix -> parsing
        |: not cur_is_q and not cur_is_bang
        then: self :> ty_ret

    parsing <: ty_ret -> parsing
        |: top_kind == "tof"
        then:
            v_ser => "TO:" + top.ser + "(" + v_ser + ")"
            v_w => "TO:" + top.ser + "(" + v_ser + ")"
            depth => depth - 1
            self :> ty_suffix

    parsing <: ty_ret -> parsing
        |: ty_frame and top_kind != "tof" and cur_is_comma
        then:
            frames => frames.slice(0, depth - 1).append(ty_next)
            pos => pos + 1
            self :> ty_more

    parsing <: ty_ret -> parsing
        |: top_kind == "tofl" and cur_is_rparen
        then:
            v_ser => "TO:" + top.ser + "(TT(" + tacc + "))"
            v_w => "TO:" + top.ser + "(TT(" + tacc + "))"
            depth => depth - 1
            pos => pos + 1
            self :> ty_suffix

    parsing <: ty_ret -> parsing
        |: top_kind == "ttup" and cur_is_rparen
        then:
            v_ser => ||: top.prec == 0 : v_ser ||: else : "TT(" + tacc + ")"
            v_w => ||: top.prec == 0 : v_w ||: else : "TT(" + wacc + ")"
            depth => depth - 1
            pos => pos + 1
            self :> ty_suffix

    parsing <: ty_ret -> parsing
        |: top_kind == "tnt" and cur_is_rparen
        then:
            v_ser => "TNT(" + tacc + ")"
            v_w => "TNT(" + wacc + ")"
            depth => depth - 1
            pos => pos + 1
            self :> ty_suffix

    parsing <: ty_ret -> parsing
        |: ty_frame and top_kind != "tof" and not cur_is_comma and not cur_is_rparen
        then:
            error => true
            error_msg => ||: top_kind == "tofl" : "parse error: expected `,` or `)` in type-parameter list" + cur_got ||: top_kind == "ttup" : "parse error: expected `,` or `)` in tuple type" + cur_got ||: else : "parse error: expected `,` or `)` in named-tuple type" + cur_got
            self :> halt

    parsing <: ty_ret -> parsing
        |: top_kind == "mshape"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser, top.ekind, top.ops, top.acc + " (field " + top.aux + " " + v_ser + ")", ""))
            self :> ms_after

    # Chapter 28. A `let` or `if let` binding type.
    parsing <: ty_ret -> parsing
        |: top_kind == "st"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc, top.aux + " " + v_ser))
            self :> st_eq

    # After a `,` in a type list. A named tuple reads its next field,
    # the other lists their next type.
    parsing <: ty_more -> parsing
        |: top_kind == "tnt"
        then: self :> tnt_field

    parsing <: ty_more -> parsing
        |: top_kind != "tnt"
        then: self :> ty_start

    # ---------------------------------------------------------------
    # Chapter 28. Statements (parse-statement), blocks (parse-block and
    # the inline loops of `if`, `while`, `if let`, `do:`, `def:`),
    # `or` recovery arms (parse-or-arms), and `<:` dispatch blocks.
    #
    # Return modes. `sret` is parse-statement returning, it dispatches
    # on the `seq` or `blk` frame below. `bret` is a block returning, it
    # dispatches on the `st` or `darm` frame below. A `st` frame's `op`
    # names the statement and its state (`return`, `alias`, `expr`,
    # `if`, `ift`, `ifk`, `ife`, `while`, `whb`, `ilb`, `let`, `sync`,
    # `orl`). `ser` holds the rendering so far, `acc` the bindings or
    # arms, `aux` the binding name and type or the pending arm pattern.
    # ---------------------------------------------------------------

    # Top-level statement loop.
    parsing <: seq_loop -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> seq_loop

    parsing <: seq_loop -> parsing
        |: cur_kind == "eof"
        then:
            v_ser => "(stmts" + top.acc + ")"
            self :> done

    parsing <: seq_loop -> parsing
        |: cur_kind != "newline" and cur_kind != "eof"
        then: self :> stmt_start

    parsing <: done -> end
        |: not error

    # parse-statement.
    parsing <: stmt_start -> parsing
        |: s_ret
        then:
            frames => frames.slice(0, depth).append(self.mkst("return", "", 0))
            depth => depth + 1
            pos => pos + 1
            self :> expr_start

    parsing <: stmt_start -> parsing
        |: s_if and nxt_is_let
        then:
            frames => frames.slice(0, depth).append(self.mkst("ilb", "", 0))
            depth => depth + 1
            pos => pos + 1
            self :> il_bind

    parsing <: stmt_start -> parsing
        |: s_if and not nxt_is_let
        then:
            frames => frames.slice(0, depth).append(self.mkst("if", "", 0))
            depth => depth + 1
            pos => pos + 1
            self :> expr_start

    parsing <: stmt_start -> parsing
        |: s_stage
        then:
            error => true
            error_msg => "parse error: `" + cur_value + " => <expr>` is a staged field update, legal only directly inside a `then:` block (or an inline transition arm). Inside `if`, `else`, loop bodies, or any nested block, use an async self-send: `self :> set_" + cur_value + "(v)` with a handler on the atom. For expression-position selection, use `||: cond : X ||: else : Y`." + cur_got
            self :> halt

    parsing <: stmt_start -> parsing
        |: s_let and nxt2_is_colon
        then:
            frames => frames.slice(0, depth).append(self.mkst("let", nxt_value, 0))
            depth => depth + 1
            pos => pos + 3
            self :> ty_start

    parsing <: stmt_start -> parsing
        |: s_let and not nxt2_is_colon
        then:
            frames => frames.slice(0, depth).append(self.mkst("let", nxt_value + " nil", 0))
            depth => depth + 1
            pos => pos + 2
            self :> st_eq

    parsing <: stmt_start -> parsing
        |: s_letkw
        then:
            error => true
            error_msg => "parse error: `let " + nxt_value + " ...` — `" + nxt_value + "` is a reserved keyword in Corvid and cannot be used as a binding name. Rename the binding (e.g. `" + nxt_value + "_val`, `" + nxt_value + "_card`, `low_" + nxt_value + "`) or pick a different identifier. See docs/writing-corvid/02-language-tour.md for the reserved-word list." + nxt_got
            self :> halt

    parsing <: stmt_start -> parsing
        |: s_alias and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: stmt_start -> parsing
        |: s_alias and nxt_kind == "ident" and not alias_ok
        then:
            error => true
            error_msg => "parse error: expected :glyph \":-\"" + nxt2_got
            self :> halt

    parsing <: stmt_start -> parsing
        |: s_alias and alias_ok
        then:
            frames => frames.slice(0, depth).append(self.mkst("alias", nxt_value, 0))
            depth => depth + 1
            pos => pos + 3
            self :> expr_start

    # Statement `:> msg[(args)]`. No parse-postfix, the emit is the
    # whole statement.
    parsing <: stmt_start -> parsing
        |: cur_is_emit and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: stmt_start -> parsing
        |: cur_is_emit and nxt_kind == "ident" and not nxt2_is_lparen
        then:
            v_ser => "(emit async nil " + nxt_value + ")"
            v_kind => "other"
            pos => pos + 2
            self :> sret

    parsing <: stmt_start -> parsing
        |: cur_is_emit and nxt_kind == "ident" and nxt2_is_lparen and nxt3_is_rparen
        then:
            v_ser => "(emit async nil " + nxt_value + ")"
            v_kind => "other"
            pos => pos + 4
            self :> sret

    parsing <: stmt_start -> parsing
        |: cur_is_emit and nxt_kind == "ident" and nxt2_is_lparen and not nxt3_is_rparen
        then:
            frames => frames.slice(0, depth).append(self.mkop("call", "rawstmt", "(emit async nil " + nxt_value, 0))
            depth => depth + 1
            pos => pos + 3
            self :> arg_start

    # Statement `|> <expr>`. The frame keeps the glyph's line.
    parsing <: stmt_start -> parsing
        |: cur_is_sync
        then:
            frames => frames.slice(0, depth).append(self.mkst("sync", "", cur_line))
            depth => depth + 1
            pos => pos + 1
            self :> expr_start

    parsing <: stmt_start -> parsing
        |: s_for
        then:
            error => true
            error_msg => "parse error: F20 REJECTED: `for e in xs: body` is not supported — iteration is method dispatch, not language sugar (spec §3.7.1 rationale 3). Write `xs.for_each(e => body)` instead. For fold / map / filter / sorted, use the corresponding method with an inline lambda. See plans/archive/f20-for-as-alias.md." + cur_got
            self :> halt

    parsing <: stmt_start -> parsing
        |: s_switch
        then:
            error => true
            error_msg => "parse error: F69 L5: `switch <expr>: <case ...>` is retired at v1.0. Pattern-matched dispatch is expression-position `<:` receive-glyph blocks (spec §3.7 rewrite). Write:\n\n    <expr>:\n        <: pattern: <body>\n        <: *: <body>\n\nSee plans/archive/f69-atom-unification.md." + cur_got
            self :> halt

    parsing <: stmt_start -> parsing
        |: s_while
        then:
            frames => frames.slice(0, depth).append(self.mkst("while", "", 0))
            depth => depth + 1
            pos => pos + 1
            self :> expr_start

    parsing <: stmt_start -> parsing
        |: s_break and s_brk_ok
        then:
            v_ser => "(break)"
            pos => pos + 1
            self :> sret

    parsing <: stmt_start -> parsing
        |: s_break and not s_brk_ok
        then:
            error => true
            error_msg => "parse error: F17 L1: `break <value>` is not supported — value-yielding loops (`loop:` + `break <value>`) were rejected 2026-08-18 as redundant with actor state transitions. Model the accumulate-until-done pattern as a self-transition on an atom with an own-line `|:` proposition: the loop body becomes `then: field => ...`, the exit condition becomes `|: <cond>` at the arm head on a transition to the done phase, and the final value is read via an observable. See plans/archive/f17-loop-primitives.md §\"Why not `loop:`\"." + nxt_got
            self :> halt

    parsing <: stmt_start -> parsing
        |: s_cont
        then:
            v_ser => "(continue)"
            pos => pos + 1
            self :> sret

    parsing <: stmt_start -> parsing
        |: s_plain
        then:
            frames => frames.slice(0, depth).append(self.mkst("expr", "", 0))
            depth => depth + 1
            self :> expr_start

    # parse-one-binding of `if let`.
    parsing <: il_bind -> parsing
        |: not cur_is_let
        then:
            error => true
            error_msg => "parse error: expected :kw \"let\"" + cur_got
            self :> halt

    parsing <: il_bind -> parsing
        |: cur_is_let and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: il_bind -> parsing
        |: cur_is_let and nxt_kind == "ident" and il_typed
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc, nxt_value))
            pos => pos + 3
            self :> ty_start

    parsing <: il_bind -> parsing
        |: cur_is_let and nxt_kind == "ident" and not il_typed
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc, nxt_value + " nil"))
            pos => pos + 2
            self :> st_eq

    # The `=` of a `let` or `if let` binding, then its RHS.
    parsing <: st_eq -> parsing
        |: cur_is_eq
        then:
            pos => pos + 1
            self :> expr_start

    parsing <: st_eq -> parsing
        |: not cur_is_eq
        then:
            error => true
            error_msg => "parse error: expected :glyph \"=\"" + cur_got
            self :> halt

    # A parse-expr inside a statement returned.
    parsing <: st_got -> parsing
        |: top.op == "return"
        then:
            v_ser => "(return " + v_ser + ")"
            depth => depth - 1
            self :> sret

    parsing <: st_got -> parsing
        |: top.op == "alias"
        then:
            v_ser => "(alias " + top.aux + " " + v_ser + ")"
            depth => depth - 1
            self :> sret

    parsing <: st_got -> parsing
        |: top.op == "expr" and v_bare
        then:
            depth => depth - 1
            self :> sret

    parsing <: st_got -> parsing
        |: top.op == "expr" and not v_bare
        then:
            v_ser => "(expr-stmt " + v_ser + ")"
            depth => depth - 1
            self :> sret

    parsing <: st_got -> parsing
        |: (top.op == "if" or top.op == "while") and cur_is_colon
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(||: top.op == "if" : "ift" ||: else : "whb", "(" + top.op + " " + v_ser, top.ekind, top.ops, "", ""))
            pos => pos + 1
            self :> body_open

    parsing <: st_got -> parsing
        |: (top.op == "if" or top.op == "while" or top.op == "ilb") and not cur_is_colon and not (top.op == "ilb" and cur_is_comma)
        then:
            error => true
            error_msg => "parse error: expected :punct \":\"" + cur_got
            self :> halt

    parsing <: st_got -> parsing
        |: top.op == "ilb" and cur_is_comma
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("ilb", top.ser, top.ekind, top.ops, il_all, ""))
            pos => pos + 1
            self :> il_bind

    parsing <: st_got -> parsing
        |: top.op == "ilb" and cur_is_colon
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("ift", il_ser, top.ekind, top.ops, "", ""))
            pos => pos + 1
            self :> body_open

    parsing <: st_got -> parsing
        |: top.op == "let"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("orl", "(let " + top.aux + " " + v_ser, top.ekind, top.ops, "", ""))
            self :> or_loop

    parsing <: st_got -> parsing
        |: top.op == "sync" and sync_ok
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("orl", "(emit sync " + sync_tgt + " " + lc_nm + lc_args, top.ekind, top.ops, "", ""))
            self :> or_loop

    parsing <: st_got -> parsing
        |: top.op == "sync" and not sync_ok and v_is_ident
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("orl", "(emit sync nil " + v_ident_nm, top.ekind, top.ops, "", ""))
            self :> or_loop

    parsing <: st_got -> parsing
        |: top.op == "sync" and not sync_ok and not v_is_ident
        then:
            error => true
            error_msg => "parse error: prefix `|>` expected a call expression on the right-hand side (F70 I6: `|> receiver.method(args)`), or legacy bare form (`|> msg(args)` — retired in Stage 3) (got :glyph \"|>\" at line " + top.prec.to_string() + ")"
            self :> halt

    # A typed `or T(...)` pattern returned from its bindings.
    parsing <: st_got -> parsing
        |: top.op == "orl"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("orl", top.ser, top.ekind, top.ops, top.acc, v_ser))
            self :> or_colon

    # The body of `if`, `while`, `if let`, or `else`. NEWLINE INDENT
    # opens a block, anything else is one inline statement.
    parsing <: body_open -> parsing
        |: nl_indent
        then:
            frames => frames.slice(0, depth).append(self.mkblk("blk", "(block", 0))
            depth => depth + 1
            pos => pos + 2
            self :> blk_loop

    parsing <: body_open -> parsing
        |: cur_kind == "newline" and nxt_kind != "indent"
        then:
            error => true
            error_msg => "parse error: expected :indent" + nxt_got
            self :> halt

    parsing <: body_open -> parsing
        |: cur_kind != "newline"
        then:
            frames => frames.slice(0, depth).append(self.mkblk("blk", "(block", 1))
            depth => depth + 1
            self :> stmt_start

    # parse-block's loop.
    parsing <: blk_loop -> parsing
        |: cur_kind == "dedent"
        then:
            v_ser => top.ser + top.acc + ")"
            v_kind => "other"
            b_op => top.op
            depth => depth - 1
            pos => pos + 1
            self :> blk_done

    parsing <: blk_loop -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> blk_loop

    parsing <: blk_loop -> parsing
        |: cur_kind != "dedent" and cur_kind != "newline"
        then: self :> stmt_start

    # parse-statement returned.
    parsing <: sret -> parsing
        |: top_kind == "seq"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser, top.ekind, top.ops, top.acc + " " + v_ser, ""))
            self :> seq_loop

    parsing <: sret -> parsing
        |: top_kind == "blk" and top.prec == 0
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + " " + v_ser, ""))
            self :> blk_loop

    parsing <: sret -> parsing
        |: top_kind == "blk" and top.prec == 1
        then:
            v_ser => top.ser + " " + v_ser + ")"
            v_kind => "other"
            b_op => top.op
            depth => depth - 1
            self :> blk_done

    # A block closed. `do:` returns to parse-postfix, a `def:` body to
    # the lambda frame, a statement block to its statement.
    parsing <: blk_done -> parsing
        |: b_op == "blk"
        then: self :> bret

    parsing <: blk_done -> parsing
        |: b_op == "do"
        then: self :> postfix

    parsing <: blk_done -> parsing
        |: b_op == "lam"
        then: self :> ret

    parsing <: bret -> parsing
        |: top_kind == "st" and top.op == "ift"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("ifk", top.ser + " " + v_ser, top.ekind, top.ops, "", ""))
            self :> if_skip

    parsing <: bret -> parsing
        |: top_kind == "st" and (top.op == "ife" or top.op == "whb")
        then:
            v_ser => top.ser + " " + v_ser + ")"
            depth => depth - 1
            self :> sret

    parsing <: bret -> parsing
        |: top_kind == "st" and top.op == "orl"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("orl", top.ser, top.ekind, top.ops, top.acc + " (or " + top.aux + " " + v_ser + ")", ""))
            self :> or_loop

    parsing <: bret -> parsing
        |: top_kind == "darm"
        then:
            v_ser => d_arm
            depth => depth - 1
            self :> darm_done

    # skip-newlines after the then-block, then an optional `else:`.
    parsing <: if_skip -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> if_skip

    parsing <: if_skip -> parsing
        |: cur_is_else and nxt_is_colon
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("ife", top.ser, top.ekind, top.ops, "", ""))
            pos => pos + 2
            self :> body_open

    parsing <: if_skip -> parsing
        |: cur_kind != "newline" and not (cur_is_else and nxt_is_colon)
        then:
            v_ser => top.ser + " nil)"
            depth => depth - 1
            self :> sret

    # parse-or-arms. An arm is NEWLINE `or` (or `or` straight after the
    # previous arm's DEDENT), a pattern, `:`, and an indented block.
    parsing <: or_loop -> parsing
        |: or_at_cur
        then:
            pos => pos + 1
            self :> or_pat

    parsing <: or_loop -> parsing
        |: or_at_nxt
        then:
            pos => pos + 2
            self :> or_pat

    parsing <: or_loop -> parsing
        |: not or_at_cur and not or_at_nxt
        then:
            v_ser => top.ser + top.acc + ")"
            depth => depth - 1
            self :> sret

    parsing <: or_pat -> parsing
        |: cur_is_colon
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("orl", top.ser, top.ekind, top.ops, top.acc, "bare"))
            self :> or_colon

    parsing <: or_pat -> parsing
        |: cur_kind == "ident" and nxt_is_lparen
        then:
            frames => frames.slice(0, depth).append(self.mk("variant", "(case " + cur_value))
            depth => depth + 1
            pos => pos + 2
            self :> var_bind

    parsing <: or_pat -> parsing
        |: cur_kind == "ident" and not nxt_is_lparen
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("orl", top.ser, top.ekind, top.ops, top.acc, "(bind " + cur_value + ")"))
            pos => pos + 1
            self :> or_colon

    parsing <: or_pat -> parsing
        |: not cur_is_colon and cur_kind != "ident"
        then:
            error => true
            error_msg => "parse error: Track B/1: expected `or:` (bare), `or <ident>:` (bind), or `or T(<bindings>):` (typed match) after the `or` keyword in a sync-send recovery arm." + cur_got
            self :> halt

    parsing <: or_colon -> parsing
        |: not cur_is_colon
        then:
            error => true
            error_msg => "parse error: expected :punct \":\"" + cur_got
            self :> halt

    parsing <: or_colon -> parsing
        |: cur_is_colon and colon_block
        then:
            frames => frames.slice(0, depth).append(self.mkblk("blk", "(block", 0))
            depth => depth + 1
            pos => pos + 3
            self :> blk_loop

    parsing <: or_colon -> parsing
        |: cur_is_colon and not colon_block
        then:
            error => true
            error_msg => "parse error: Track B/1: `or` arm requires an indented block body — inline single-expression bodies are not supported for recovery arms." + nxt_got
            self :> halt

    # parse-dispatch-block's loop.
    parsing <: disp_loop -> parsing
        |: cur_kind == "dedent"
        then:
            v_ser => top.ser + top.acc + ")"
            v_kind => "other"
            depth => depth - 1
            pos => pos + 1
            self :> ret

    parsing <: disp_loop -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> disp_loop

    parsing <: disp_loop -> parsing
        |: cur_is_recv
        then:
            frames => frames.slice(0, depth).append(self.mkop("darm", "pat", "", 0))
            depth => depth + 1
            pos => pos + 1
            self :> dpat

    parsing <: disp_loop -> parsing
        |: cur_kind != "dedent" and cur_kind != "newline" and not cur_is_recv
        then:
            error => true
            error_msg => "parse error: F69 L4: expected `<: <pattern>: <body>` arm or dedent inside a dispatch block." + cur_got
            self :> halt

    parsing <: darm_done -> parsing
        |: top_kind == "disp"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + v_ser, ""))
            self :> disp_loop

    # parse-dispatch-pattern. A pattern returns through `ret` to the
    # `darm` frame, bindings reuse the variant `var_bind` arms.
    parsing <: dpat -> parsing
        |: d_wild
        then:
            v_ser => "*"
            pos => pos + 1
            self :> ret

    parsing <: dpat -> parsing
        |: d_under
        then:
            error => true
            error_msg => "parse error: wildcard case-pattern is now `*` (was `_` pre-2026-08-26). Rewrite `<: _:` as `<: *:` and constructor `Foo(field: _)` as `Foo(field: *)`. `_` retired in pattern position." + cur_got
            self :> halt

    parsing <: dpat -> parsing
        |: cur_kind == "int"
        then:
            v_ser => "(lit int " + cur_value + ")"
            pos => pos + 1
            self :> ret

    parsing <: dpat -> parsing
        |: d_bool
        then:
            v_ser => "(lit bool " + cur_value + ")"
            pos => pos + 1
            self :> ret

    parsing <: dpat -> parsing
        |: d_dot and nxt2_is_lparen
        then:
            frames => frames.slice(0, depth).append(self.mk("variant", "(case ." + nxt_value))
            depth => depth + 1
            pos => pos + 3
            self :> var_bind

    parsing <: dpat -> parsing
        |: d_dot and not nxt2_is_lparen
        then:
            v_ser => "(case ." + nxt_value + ")"
            pos => pos + 2
            self :> ret

    parsing <: dpat -> parsing
        |: d_case and nxt_is_lparen
        then:
            frames => frames.slice(0, depth).append(self.mk("variant", "(case " + cur_value))
            depth => depth + 1
            pos => pos + 2
            self :> var_bind

    parsing <: dpat -> parsing
        |: d_case and not nxt_is_lparen
        then:
            v_ser => "(case " + cur_value + ")"
            pos => pos + 1
            self :> ret

    parsing <: dpat -> parsing
        |: not d_ok_a and not d_ok_b
        then:
            error => true
            error_msg => "parse error: F69 L4: expected a case pattern (name or `name(...)`), literal (int / bool), or wildcard `_` at start of `<:` dispatch arm." + cur_got
            self :> halt

    # A pattern, the guard, or an inline body returned to the arm.
    parsing <: darm_got -> parsing
        |: top.op == "pat" and cur_is_comma
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("pat", top.ser, top.ekind, top.ops, d_pats, top.aux))
            pos => pos + 1
            self :> dpat

    parsing <: darm_got -> parsing
        |: top.op == "pat" and not cur_is_comma and d_when
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("guard", top.ser, top.ekind, top.ops, d_pats, top.aux))
            pos => pos + 2
            self :> expr_start

    parsing <: darm_got -> parsing
        |: top.op == "pat" and not cur_is_comma and not d_when
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("body", top.ser, top.ekind, top.ops, d_pats, top.aux))
            self :> dbody

    parsing <: darm_got -> parsing
        |: top.op == "guard"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("body", top.ser, top.ekind, top.ops, top.acc, v_ser))
            self :> dbody

    parsing <: darm_got -> parsing
        |: top.op == "inl"
        then:
            v_ser => d_arm
            depth => depth - 1
            self :> darm_done

    # parse-dispatch-arm-body. NEWLINE INDENT is a block, else one
    # inline parse-expr.
    parsing <: dbody -> parsing
        |: not cur_is_colon
        then:
            error => true
            error_msg => "parse error: expected :punct \":\"" + cur_got
            self :> halt

    parsing <: dbody -> parsing
        |: cur_is_colon and colon_block
        then:
            frames => frames.slice(0, depth).append(self.mkblk("blk", "(block", 0))
            depth => depth + 1
            pos => pos + 3
            self :> blk_loop

    parsing <: dbody -> parsing
        |: cur_is_colon and not colon_block
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("inl", top.ser, top.ekind, top.ops, top.acc, top.aux))
            pos => pos + 1
            self :> expr_start

    # parse-expression epilogue. skip-newlines, then eof or trailing.
    parsing <: finish -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> finish

    parsing <: finish -> end
        |: cur_kind == "eof"

    parsing <: finish -> parsing
        |: cur_kind != "newline" and cur_kind != "eof"
        then:
            error => true
            error_msg => "parse-expression: expected single expression followed by end-of-file; extra tokens starting at [:" + cur_kind + " " + cur_pr + " " + cur_line.to_string() + " " + cur_tcol.to_string() + "]"
            self :> halt

    # ---------------------------------------------------------------
    # Chapter 29. Atom-body items. Item mode (argv[2] `item`) runs
    # parse-def-atom's body loop with eof in place of DEDENT and the
    # fixed def name `Item` in the messages that quote it. Return modes
    # `iret` (an item, to the `iseq` loop), `pret` (parse-proposition),
    # `thret` (a then clause), `fret` (parse-field), and `pl_done`
    # (a param list). Frames `iseq`, `prop`, `thb`, `tr`, `obs`, `fld`,
    # `plist`, `use`, `rsig`, `case`, `cfn`, and `onil`.
    # ---------------------------------------------------------------

    parsing <: begin -> parsing
        |: item_mode
        then:
            frames => frames.slice(0, depth).append(self.mk("iseq", ""))
            depth => depth + 1
            self :> iseq_loop

    parsing <: iseq_loop -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> iseq_loop

    parsing <: iseq_loop -> parsing
        |: cur_kind == "eof" and item_mode
        then:
            v_ser => "(items" + top.acc + ")"
            self :> done

    # Chapter 30. In prog mode the loop is parse-def-atom's or
    # parse-extend-class's, and a DEDENT ends it.
    parsing <: iseq_loop -> parsing
        |: cur_kind == "dedent" and prog_mode and not in_ext
        then: self :> rs

    parsing <: iseq_loop -> parsing
        |: cur_kind == "dedent" and prog_mode and in_ext
        then: self :> x_done

    parsing <: iseq_loop -> parsing
        |: iseq_more and not in_ext
        then: self :> item_start

    parsing <: iseq_loop -> parsing
        |: iseq_more and in_ext
        then: self :> ext_start

    parsing <: iret -> parsing
        |: top_kind == "iseq" and not prog_mode
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser, top.ekind, top.ops, top.acc + " " + v_ser, ""))
            self :> iseq_loop

    # looks-like-observable? needs scan-past-parens on a `name(` head.
    parsing <: item_start -> parsing
        |: obs_name and nxt_is_lparen
        then:
            scan_p => pos + 2
            scan_d => 1
            self :> obs_scan

    parsing <: item_start -> parsing
        |: not (obs_name and nxt_is_lparen)
        then:
            scan_hit => false
            self :> item_disp

    parsing <: obs_scan -> parsing
        |: sc_end
        then:
            scan_hit => false
            self :> scan_done

    parsing <: obs_scan -> parsing
        |: not sc_end and sc_lp
        then:
            scan_d => scan_d + 1
            scan_p => scan_p + 1
            self :> obs_scan

    parsing <: obs_scan -> parsing
        |: not sc_end and sc_rp and scan_d == 1
        then:
            scan_hit => sc_after
            self :> scan_done

    parsing <: obs_scan -> parsing
        |: not sc_end and sc_rp and scan_d > 1
        then:
            scan_d => scan_d - 1
            scan_p => scan_p + 1
            self :> obs_scan

    parsing <: obs_scan -> parsing
        |: not sc_end and not sc_lp and not sc_rp
        then:
            scan_p => scan_p + 1
            self :> obs_scan

    parsing <: scan_done -> parsing
        |: not in_ext
        then: self :> item_disp

    parsing <: scan_done -> parsing
        |: in_ext
        then: self :> ext_disp

    # The body dispatch.
    parsing <: item_disp -> parsing
        |: i_class == "prop"
        then: self :> prop_start

    parsing <: item_disp -> parsing
        |: i_class == "inv"
        then:
            error => true
            error_msg => ("parse error: `invariants:` section header is retired at v1.0 (four-position `|:` unification, ratified 2026-08-25). Migrate each invariant to a def-body `|:` proposition on its own line at def-body top level:\n\n  def " + d_name) + (":\n      <field decls>\n      |: <proposition>          ← was `invariants:` entry\n      |: <another proposition>\n\nSee spec §1.11 retirement mapping table and §3.4.2." + cur_got)
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "rsig" and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "rsig" and nxt_kind == "ident"
        then:
            frames => frames.slice(0, depth).append(self.mk("rsig", nxt_value)).append(self.mkpl("param"))
            depth => depth + 2
            pos => pos + 2
            self :> pl_open

    parsing <: item_disp -> parsing
        |: i_class == "foreign" and nxt3_kind != "newline"
        then:
            error => true
            error_msg => "parse error: expected :newline" + self.tok_got(pos + 3)
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "foreign" and nxt3_kind == "newline" and nxt4_kind != "indent"
        then:
            error => true
            error_msg => "parse error: expected :indent" + self.tok_got(pos + 4)
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "foreign" and nxt3_kind == "newline" and nxt4_kind == "indent"
        then:
            frames => frames.slice(0, depth).append(self.mk("fb", "(foreign \"" + nxt_value + "\""))
            depth => depth + 1
            pos => pos + 5
            self :> fb_loop

    # parse-use-line, reached through the section registry.
    parsing <: item_disp -> parsing
        |: i_class == "use" and nxt_is_colon
        then:
            error => true
            error_msg => "parse error: `use:` section header is retired at v1.0. Declare each capability directly at def-body position: `use <name>: <Type>`." + nxt_got
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "use" and not nxt_is_colon and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "use" and nxt_kind == "ident" and use_rsv
        then:
            error => true
            error_msg => (("parse error: `use " + (nxt_value + ": ...` — `")) + (nxt_value + ("` collides with an NSObject-synthesized ivar / method (backing storage `_" + nxt_value))) + (("` overlaps NSObject's own). Choose a different local name (e.g. `" + (nxt_value + "er`, `")) + (nxt_value + ("_cap`)." + nxt_got)))
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "use" and nxt_kind == "ident" and not use_rsv and not nxt2_is_colon
        then:
            error => true
            error_msg => "parse error: expected :punct \":\"" + nxt2_got
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "use" and nxt_kind == "ident" and not use_rsv and nxt2_is_colon
        then:
            frames => frames.slice(0, depth).append(self.mk("use", nxt_value))
            depth => depth + 1
            pos => pos + 3
            self :> ty_start

    parsing <: ty_ret -> parsing
        |: top_kind == "use"
        then:
            v_ser => ("(use " + top.ser) + (" " + (v_ser + ")"))
            depth => depth - 1
            self :> iret

    parsing <: item_disp -> parsing
        |: i_class == "replace"
        then:
            error => true
            error_msg => ("parse error: `replace` modifier inside `def " + d_name) + ("` body is only meaningful in an `extend` context — a class's own declarations can't shadow themselves (§3.3.2 rule 4). Drop the `replace` prefix, or move the declaration into an `extend` block if the intent was to shadow another declaration." + cur_got)
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "cfn" and nxt2_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt2_got
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "cfn" and nxt2_kind == "ident"
        then:
            frames => frames.slice(0, depth).append(self.mk("cfn", nxt2_value)).append(self.mkpl("param"))
            depth => depth + 2
            pos => pos + 3
            self :> pl_open

    parsing <: item_disp -> parsing
        |: i_class == "func"
        then:
            error => true
            error_msg => ("parse error: F67 L4: `function` keyword inside `def " + d_name) + ("` body is retired (Proposal G class-body collapse). Migrate the method by category:\n\n  - reader → observable: `name(args) :- <expr>`\n  - void   → transition: `* <: name(args) -> * then: <body>`\n  - writer → transition: `* <: name(args) -> * then: <update>`\n\nUtility functions unrelated to `self` belong at module scope (`def name(args) -> T: body`). See spec §1.11." + cur_got)
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "defm"
        then:
            error => true
            error_msg => (("parse error: F67 L4: `def " + nxt_value) + (("(args)` method form inside `def " + d_name) + ("` body is retired (Proposal G class-body collapse). Migrate the method by category:\n\n  - reader → observable: `" + (nxt_value + "(args) :- <expr>`\n  - void   → transition: `* <: ")))) + ((nxt_value + "(args) -> * then: <body>`\n  - writer → transition: `* <: ") + (nxt_value + ("(args) -> * then: <update>`\n\nUtility functions unrelated to `self` belong at module scope. See spec §1.11." + cur_got)))
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "defn"
        then:
            error => true
            error_msg => ((("parse error: F34 L3: `def " + nxt_value) + (": " + ((def_ty_nm + "` nested-atom slot form inside `def ") + (d_name + "` body is retired. Migrate to the spec-canonical `data:` field shape (§1.11):\n\n  ")))) + ((nxt_value + (": " + def_ty_nm)) + (" = " + (def_ty_nm + "()\n\nIf the original carried ctor args (`def ")))) + (((nxt_value + ": ") + (def_ty_nm + ("(args...)`), preserve them on the RHS ctor call:\n\n  " + nxt_value))) + ((": " + (def_ty_nm + " = ")) + (def_ty_nm + ("(args...)" + cur_got))))
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "state"
        then:
            error => true
            error_msg => ("parse error: `state:` section header is retired at v1.0 (class-body-collapse F67 L5). Migrate each field to def-body top level with no wrapping header:\n\n  def " + d_name) + (":\n      <field>: <Type> [= <default>]     ← was inside `state:`\n      <another field>: <Type>\n\nMutation still happens only through transitions. See spec §1.11." + cur_got)
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "accepts"
        then:
            error => true
            error_msg => ("parse error: `accepts:` and `accepts name(...)` are retired at v1.0. Declare protocol members directly in `def " + d_name) + ("` using `<: name(args)` for async receives or `name(args) :- ReturnType` for sync observations." + cur_got)
            self :> halt

    # Enum cases. The `case` frame keeps the name in `ser`, the payload
    # in `acc`, the first defaulted payload field in `ctg`, and the
    # position after the name in `prec`.
    parsing <: item_disp -> parsing
        |: i_class == "case" and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "case" and nxt_kind == "ident" and nxt2_is_lparen
        then:
            frames => frames.slice(0, depth).append(self.mkop("case", "", nxt_value, pos + 2)).append(self.mkpl("param"))
            depth => depth + 2
            pos => pos + 2
            self :> pl_open

    parsing <: item_disp -> parsing
        |: i_class == "case" and nxt_kind == "ident" and not nxt2_is_lparen
        then:
            frames => frames.slice(0, depth).append(Frame(kind: "case", prec: pos + 2, op: "", ser: nxt_value, ekind: "other", ops: "", acc: "(params)", aux: "", cal: "", ctg: "", cnm: ""))
            depth => depth + 1
            pos => pos + 2
            self :> case_raw

    parsing <: case_raw -> parsing
        |: top.ctg != ""
        then:
            error => true
            error_msg => ("parse error: F16 L1: default on enum payload field `" + (top.ctg + "` in case `")) + (top.ser + ("` — payload fields don't carry defaults (the case *value* is the payload; a default would confuse construction semantics). Drop the `= <default>`." + self.tok_got(top.prec)))
            self :> halt

    parsing <: case_raw -> parsing
        |: top.ctg == "" and cur_is_eq and top.acc != "(params)"
        then:
            error => true
            error_msg => "parse error: F16 L2: case `" + (top.ser + ("` has both a payload `(...)` and a raw value `= ...` — these are mutually exclusive shapes per §3.3. Payload enums carry associated values; raw-value enums attach fixed integer values to bare cases. Pick one." + nxt_got))
            self :> halt

    parsing <: case_raw -> parsing
        |: top.ctg == "" and cur_is_eq and top.acc == "(params)" and nxt_kind != "int"
        then:
            error => true
            error_msg => "parse error: F16 L2: raw value on case `" + (top.ser + ("` must be an integer literal (v1.0 scope — string/float raw values are deferred to a follow-on landing)." + nxt_got))
            self :> halt

    parsing <: case_raw -> parsing
        |: top.ctg == "" and cur_is_eq and top.acc == "(params)" and nxt_kind == "int"
        then:
            v_ser => ("(enum-case " + (top.ser + " ")) + ((top.acc + " ") + (nxt_value + ")"))
            ec_nm => top.ser
            ec_raw => nxt_value
            ec_pay => top.acc != "(params)"
            ec_sref => ||: top.acc == "(params)" : "" ||: else : pl_sref
            depth => depth - 1
            pos => pos + 2
            self :> iret

    parsing <: case_raw -> parsing
        |: top.ctg == "" and not cur_is_eq
        then:
            v_ser => ("(enum-case " + top.ser) + (" " + (top.acc + ")"))
            ec_nm => top.ser
            ec_raw => ""
            ec_pay => top.acc != "(params)"
            ec_sref => ||: top.acc == "(params)" : "" ||: else : pl_sref
            depth => depth - 1
            self :> iret

    parsing <: item_disp -> parsing
        |: i_class == "obs"
        then: self :> obs_start

    parsing <: item_disp -> parsing
        |: i_class == "handler"
        then:
            error => true
            error_msg => ("parse error: F67 L3: `-> " + (nxt_value + "(args):` handler-decl sugar is retired (Proposal G class-body collapse). Migrate to the explicit handler-shape transition:\n\n    * <: ")) + (nxt_value + ("(args) -> *\n        then: <body>\n\nSemantics unchanged (spec §1265) — same method-table entry, same external invocation surface. The collapse removes the parallel opener glyph so the class body has one shape per kind of declaration." + cur_got))
            self :> halt

    # parse-on-nil-section.
    parsing <: item_disp -> parsing
        |: i_class == "onnil" and nxt2_kind != "newline"
        then:
            error => true
            error_msg => "parse error: expected :newline" + nxt2_got
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "onnil" and nxt2_kind == "newline" and nxt3_kind != "indent"
        then:
            error => true
            error_msg => "parse error: expected :indent" + self.tok_got(pos + 3)
            self :> halt

    parsing <: item_disp -> parsing
        |: i_class == "onnil" and nxt2_kind == "newline" and nxt3_kind == "indent"
        then:
            frames => frames.slice(0, depth).append(self.mk("onil", ""))
            depth => depth + 1
            pos => pos + 4
            self :> on_loop

    parsing <: on_loop -> parsing
        |: cur_kind == "dedent"
        then:
            v_ser => "(on-nil" + top.acc + ")"
            depth => depth - 1
            pos => pos + 1
            self :> iret

    parsing <: on_loop -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> on_loop

    parsing <: on_loop -> parsing
        |: cur_kind == "ident" and nxt_is_colon
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc, cur_value))
            pos => pos + 2
            self :> expr_start

    parsing <: on_loop -> parsing
        |: cur_kind != "dedent" and cur_kind != "newline" and not (cur_kind == "ident" and nxt_is_colon)
        then:
            error => true
            error_msg => "parse error: expected `<method_name>: <const-expr>` inside `on_nil:` section, or dedent to close the section" + cur_got
            self :> halt

    parsing <: ret -> parsing
        |: top_kind == "onil"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + " (" + top.aux + " " + v_ser + ")", ""))
            self :> on_loop

    parsing <: item_disp -> parsing
        |: i_class == "field"
        then: self :> fld_start

    parsing <: item_disp -> parsing
        |: i_class == "trans"
        then: self :> tr_start

    parsing <: item_disp -> parsing
        |: i_class == "err"
        then:
            error => true
            error_msg => "parse error: expected direct use (`use name: Type`), field decl (`name: Type [= default]`), own-line `|:` proposition, on_nil:, observable/signature (`name[(args)] :- expr-or-type`), async signature (`<: name(args)`), or transition inside def-atom body" + cur_got
            self :> halt

    # ---------------------------------------------------------------
    # parse-proposition. The `prop` frame holds the rendering so far in
    # `ser`, the `as` type in `aux`, and 1 in `prec` for a continuation
    # `as` on its own indented line.
    # ---------------------------------------------------------------
    parsing <: prop_start -> parsing
        |: not line_start
        then:
            error => true
            error_msg => "parse error: `|:` proposition must occupy its own line; it cannot be crammed onto a signature or statement" + cur_got
            self :> halt

    parsing <: prop_start -> parsing
        |: line_start and pr_tb
        then:
            frames => frames.slice(0, depth).append(self.mkop("prop", "tb", "(prop (type-bound " + nxt_value, 0))
            depth => depth + 1
            pos => pos + 3
            self :> ty_start

    parsing <: prop_start -> parsing
        |: line_start and not pr_tb
        then:
            frames => frames.slice(0, depth).append(self.mkop("prop", "pred", "(prop", 0))
            depth => depth + 1
            pos => pos + 1
            self :> expr_start

    parsing <: ty_ret -> parsing
        |: top_kind == "prop" and top.op == "tb"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser + " " + v_ser + ")", top.ekind, top.ops, top.acc, top.aux))
            self :> pr_after

    parsing <: ret -> parsing
        |: top_kind == "prop"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser + " " + v_ser, top.ekind, top.ops, top.acc, top.aux))
            self :> pr_after

    parsing <: pr_after -> parsing
        |: pr_cont
        then:
            frames => frames.slice(0, depth - 1).append(self.upd(1, "astype", top.ser, top.ops, top.acc, top.aux, top.cal, top.ctg, top.cnm))
            pos => pos + 3
            self :> ty_start

    parsing <: pr_after -> parsing
        |: not pr_cont and cur_is_as
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("astype", top.ser, top.ekind, top.ops, top.acc, top.aux))
            pos => pos + 1
            self :> ty_start

    parsing <: pr_after -> parsing
        |: not pr_cont and not cur_is_as
        then: self :> pr_fin

    parsing <: ty_ret -> parsing
        |: top_kind == "prop" and top.op == "astype"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("args", top.ser, top.ekind, top.ops, top.acc, v_ser))
            self :> pr_aargs

    # parse-args-parens for the `as` constructor. The call frame keeps
    # the `(` position in `prec`, the names seen in `cnm`, and the first
    # validation message in `ctg`. Clojure validates after the whole list
    # parsed, in arg order, at the `(`.
    parsing <: pr_aargs -> parsing
        |: not cur_is_lparen
        then:
            error => true
            error_msg => "parse error: expected :punct \"(\"" + cur_got
            self :> halt

    parsing <: pr_aargs -> parsing
        |: cur_is_lparen and nxt_is_rparen
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser + " (as " + top.aux + ")", top.ekind, top.ops, top.acc, top.aux))
            pos => pos + 2
            self :> pr_close

    parsing <: pr_aargs -> parsing
        |: cur_is_lparen and not nxt_is_rparen
        then:
            frames => frames.slice(0, depth).append(Frame(kind: "call", prec: pos, op: "prop", ser: "", ekind: "other", ops: "", acc: "", aux: "", cal: "", ctg: "", cnm: ","))
            depth => depth + 1
            pos => pos + 1
            self :> arg_start

    parsing <: arg_start -> parsing
        |: top.op == "prop" and cur_kind == "ident" and nxt_is_colon
        then:
            frames => frames.slice(0, depth - 1).append(self.upd(top.prec, top.op, top.ser, top.ops, top.acc, cur_value, top.cal, (||: top.ctg == "" and top.cnm.contains("," + cur_value + ",") : "duplicate proposition error argument `" + cur_value + "`" ||: else : top.ctg), top.cnm + cur_value + ","))
            pos => pos + 2
            self :> expr_start

    parsing <: arg_start -> parsing
        |: top.op == "prop" and not (cur_kind == "ident" and nxt_is_colon)
        then:
            frames => frames.slice(0, depth - 1).append(self.upd(top.prec, top.op, top.ser, top.ops, top.acc, "", top.cal, (||: top.ctg == "" : "proposition error arguments must use `field: value` named form" ||: else : top.ctg), top.cnm))
            self :> expr_start

    parsing <: ret -> parsing
        |: top_kind == "call" and cur_is_rparen and top.op == "prop" and top.ctg != ""
        then:
            error => true
            error_msg => "parse error: " + top.ctg + self.tok_got(top.prec)
            self :> halt

    parsing <: ret -> parsing
        |: top_kind == "call" and cur_is_rparen and top.op == "prop" and top.ctg == ""
        then:
            v_ser => call_args
            depth => depth - 1
            pos => pos + 1
            self :> pr_args

    parsing <: pr_args -> parsing
        |: top_kind == "prop"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser + " (as " + top.aux + v_ser + ")", top.ekind, top.ops, top.acc, top.aux))
            self :> pr_close

    # A continuation `as` closes its INDENT, with or without a NEWLINE.
    parsing <: pr_close -> parsing
        |: top.prec == 0
        then: self :> pr_fin

    parsing <: pr_close -> parsing
        |: top.prec == 1 and cur_kind == "newline" and nxt_kind == "dedent"
        then:
            pos => pos + 2
            self :> pr_fin

    parsing <: pr_close -> parsing
        |: top.prec == 1 and cur_kind == "newline" and nxt_kind != "dedent"
        then:
            error => true
            error_msg => "parse error: expected :dedent" + nxt_got
            self :> halt

    parsing <: pr_close -> parsing
        |: top.prec == 1 and cur_kind == "dedent"
        then:
            pos => pos + 1
            self :> pr_fin

    parsing <: pr_close -> parsing
        |: top.prec == 1 and cur_kind != "newline" and cur_kind != "dedent"
        then:
            error => true
            error_msg => "parse error: expected :dedent" + cur_got
            self :> halt

    parsing <: pr_fin -> parsing
        |: top.prec == 1 or lay_end
        then:
            v_ser => top.ser + ")"
            depth => depth - 1
            self :> pret

    parsing <: pr_fin -> parsing
        |: top.prec == 0 and not lay_end
        then:
            error => true
            error_msg => "parse error: `|:` proposition must occupy its own line; unexpected trailing content" + cur_got
            self :> halt

    parsing <: pret -> parsing
        |: top_kind == "iseq"
        then: self :> iret

    parsing <: pret -> parsing
        |: top_kind == "thb"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + " " + v_ser, top.aux))
            self :> th_next

    parsing <: pret -> parsing
        |: top_kind == "tr"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + " " + v_ser, top.aux))
            self :> tb_loop

    parsing <: pret -> parsing
        |: top_kind == "obs"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops + " " + v_ser, top.acc, top.aux))
            self :> obs_ploop

    # ---------------------------------------------------------------
    # parse-field and the param lists.
    # ---------------------------------------------------------------
    parsing <: fld_start -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + cur_got
            self :> halt

    parsing <: fld_start -> parsing
        |: cur_kind == "ident" and not nxt_is_colon
        then:
            error => true
            error_msg => "parse error: expected :punct \":\"" + nxt_got
            self :> halt

    parsing <: fld_start -> parsing
        |: cur_kind == "ident" and nxt_is_colon and nxt2_mod
        then:
            frames => frames.slice(0, depth).append(self.mkfld(cur_value, nxt2_value, pos + 2))
            depth => depth + 1
            pos => pos + 3
            self :> ty_start

    parsing <: fld_start -> parsing
        |: cur_kind == "ident" and nxt_is_colon and not nxt2_mod
        then:
            frames => frames.slice(0, depth).append(self.mkfld(cur_value, "", pos + 1))
            depth => depth + 1
            pos => pos + 2
            self :> ty_start

    # Chapter 30. The `->` function type runs parse-foreign-signature
    # with the field type as its left side. The `fsig` frame below
    # waits for the right side, the one above parses it. The modifier
    # checks follow Clojure's cond order and never reject a `TF(...)`.
    parsing <: ty_ret -> parsing
        |: top_kind == "fld" and cur_kind == "glyph" and cur_value == "->"
        then:
            frames => frames.slice(0, depth).append(Frame(kind: "fsig", prec: 0, op: "", ser: "", ekind: "other", ops: "", acc: v_ser, aux: "", cal: "", ctg: "", cnm: "")).append(self.mkop("fsig", "", "", 0))
            depth => depth + 2
            pos => pos + 1
            self :> fs_start

    parsing <: ty_ret -> parsing
        |: top_kind == "fld" and not (cur_kind == "glyph" and cur_value == "->") and top.aux != "" and fty_bad
        then:
            error => true
            error_msg => "parse error: " + fty_msg + self.tok_got(top.prec)
            self :> halt

    parsing <: ty_ret -> parsing
        |: top_kind == "fld" and not (cur_kind == "glyph" and cur_value == "->") and (top.aux == "" or not fty_bad) and cur_is_eq
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("dflt", top.ser, top.ekind, top.ops, v_ser, top.aux))
            pos => pos + 1
            self :> expr_start

    parsing <: ty_ret -> parsing
        |: top_kind == "fld" and not (cur_kind == "glyph" and cur_value == "->") and (top.aux == "" or not fty_bad) and not cur_is_eq
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("tail", top.ser, top.ekind, top.ops, v_ser, top.aux))
            self :> fld_tail

    parsing <: ret -> parsing
        |: top_kind == "fld"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("tail", top.ser, top.ekind, v_ser, top.acc, top.aux))
            self :> fld_tail

    parsing <: fld_tail -> parsing
        |: cur_kind == "glyph" and cur_value == ":-"
        then:
            error => true
            error_msg => (("parse error: `" + top.cnm) + (": <Type> :- <body>` is not a valid observation shape at v1.0. The `:Type` annotation belongs AFTER `:-`, not before it. Rewrite as one of:\n\n    " + (top.cnm + " :- <body>              # inferred return type\n    "))) + ((top.cnm + " :- <Type> = <body>     # explicit return type on one line\n    ") + (top.cnm + ("(args) :- <Type>        # parametric obs, return type after :-\n        <body>                       # body on the next indented line\n\nSee docs/writing-corvid/04-common-mistakes.md." + cur_got)))
            self :> halt

    parsing <: fld_tail -> parsing
        |: not (cur_kind == "glyph" and cur_value == ":-")
        then:
            v_ser => f_ser
            f_dflt => ||: top.ops == "nil" : "" ||: else : top.cnm
            f_sref => ||: fb_self : top.cnm ||: else : ""
            f_cdf => f_cdf_now
            depth => depth - 1
            self :> fret

    parsing <: fret -> parsing
        |: top_kind == "iseq"
        then: self :> iret

    parsing <: fret -> parsing
        |: top_kind == "plist"
        then:
            frames => frames.slice(0, depth - 1).append(self.upd(top.prec, top.op, top.ser, top.ops, top.acc + " " + v_ser, top.aux, top.cal, (||: top.ctg == "" : f_sref ||: else : top.ctg), (||: top.cnm == "" : f_dflt ||: else : top.cnm)))
            self :> pl_after

    # parse-param-list-parens and parse-receive-payload-param-list.
    parsing <: pl_open -> parsing
        |: not cur_is_lparen
        then:
            error => true
            error_msg => "parse error: expected :punct \"(\"" + cur_got
            self :> halt

    parsing <: pl_open -> parsing
        |: cur_is_lparen and nxt_is_rparen
        then:
            v_ser => "(params)"
            pl_acc => ""
            pl_dflt => ""
            pl_sref => ""
            depth => depth - 1
            pos => pos + 2
            self :> pl_done

    parsing <: pl_open -> parsing
        |: cur_is_lparen and not nxt_is_rparen
        then:
            pos => pos + 1
            self :> pl_param

    parsing <: pl_param -> parsing
        |: pl_self
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + " (param self)", top.aux))
            pos => pos + 1
            self :> pl_after

    parsing <: pl_param -> parsing
        |: pl_bare
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + " (field " + cur_value + " TR:Any nil bare)", top.aux))
            pos => pos + 2
            self :> pl_after

    parsing <: pl_param -> parsing
        |: not pl_self and not pl_bare
        then: self :> fld_start

    parsing <: pl_after -> parsing
        |: cur_is_comma
        then:
            pos => pos + 1
            self :> pl_param

    parsing <: pl_after -> parsing
        |: cur_is_rparen
        then:
            v_ser => "(params" + top.acc + ")"
            pl_acc => top.acc
            pl_dflt => top.cnm
            pl_sref => top.ctg
            depth => depth - 1
            pos => pos + 1
            self :> pl_done

    parsing <: pl_after -> parsing
        |: not cur_is_comma and not cur_is_rparen
        then:
            error => true
            error_msg => ||: top.op == "param" : "parse error: expected `,` or `)` in param list" + cur_got ||: else : "parse error: expected `,` or `)` in receive-payload param list" + cur_got
            self :> halt

    parsing <: pl_done -> parsing
        |: top_kind == "obs"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, v_ser, top.aux))
            self :> obs_cd

    parsing <: pl_done -> parsing
        |: top_kind == "rsig" and lay_end
        then:
            v_ser => ("(recv-sig " + top.ser) + (" " + (v_ser + ")"))
            depth => depth - 1
            self :> iret

    parsing <: pl_done -> parsing
        |: top_kind == "rsig" and not lay_end
        then:
            error => true
            error_msg => "parse error: signature-only async receive `<: " + (top.ser + ("(...)` must end after its parameter list; omit the source phase and `->` target" + cur_got))
            self :> halt

    parsing <: pl_done -> parsing
        |: top_kind == "case"
        then:
            frames => frames.slice(0, depth - 1).append(self.upd(top.prec, top.op, top.ser, top.ops, v_ser, top.aux, top.cal, pl_dflt, top.cnm))
            self :> case_raw

    parsing <: pl_done -> parsing
        |: top_kind == "cfn"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, v_ser, "nil"))
            self :> cfn_ret

    parsing <: pl_done -> parsing
        |: top_kind == "tr"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser + " (recv " + top.ctg + " (typed " + top.ops + pl_acc + "))", top.ekind, "", top.acc, top.aux))
            self :> tr_arrow

    # parse-class-function-decl. `aux` holds the return type.
    parsing <: cfn_ret -> parsing
        |: cur_kind == "glyph" and cur_value == "->"
        then:
            pos => pos + 1
            self :> ty_start

    parsing <: cfn_ret -> parsing
        |: not (cur_kind == "glyph" and cur_value == "->")
        then: self :> cfn_colon

    parsing <: ty_ret -> parsing
        |: top_kind == "cfn"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc, v_ser))
            self :> cfn_colon

    parsing <: cfn_colon -> parsing
        |: not cur_is_colon
        then:
            error => true
            error_msg => "parse error: expected :punct \":\"" + cur_got
            self :> halt

    parsing <: cfn_colon -> parsing
        |: cur_is_colon and nxt_kind != "newline"
        then:
            error => true
            error_msg => "parse error: expected :newline" + nxt_got
            self :> halt

    parsing <: cfn_colon -> parsing
        |: cur_is_colon and nxt_kind == "newline" and nxt2_kind != "indent"
        then:
            error => true
            error_msg => "parse error: expected :indent" + nxt2_got
            self :> halt

    parsing <: cfn_colon -> parsing
        |: cur_is_colon and nxt_kind == "newline" and nxt2_kind == "indent"
        then:
            frames => frames.slice(0, depth).append(self.mkblk("blk", "(block", 0))
            depth => depth + 1
            pos => pos + 3
            self :> blk_loop

    parsing <: bret -> parsing
        |: top_kind == "cfn"
        then:
            v_ser => (("(class-fn " + top.ser) + (" " + top.acc)) + ((" " + top.aux) + (" " + (v_ser + ")")))
            depth => depth - 1
            self :> iret

    # ---------------------------------------------------------------
    # parse-observable. The `obs` frame keeps the name in `ser`, the
    # params in `acc`, the return type in `aux` ("nil" when none), the
    # propositions in `ops`, "p" in `ctg` when a param list was written,
    # and the position after `:-` in `prec` for the parse-expr restart.
    # ---------------------------------------------------------------
    parsing <: obs_start -> parsing
        |: nxt_is_lparen
        then:
            frames => frames.slice(0, depth).append(Frame(kind: "obs", prec: 0, op: "params", ser: cur_value, ekind: "other", ops: "", acc: "(params)", aux: "nil", cal: "", ctg: "p", cnm: "")).append(self.mkpl("param"))
            depth => depth + 2
            pos => pos + 1
            self :> pl_open

    parsing <: obs_start -> parsing
        |: not nxt_is_lparen
        then:
            frames => frames.slice(0, depth).append(Frame(kind: "obs", prec: 0, op: "params", ser: cur_value, ekind: "other", ops: "", acc: "(params)", aux: "nil", cal: "", ctg: "", cnm: ""))
            depth => depth + 1
            pos => pos + 1
            self :> obs_cd

    parsing <: obs_cd -> parsing
        |: not (cur_kind == "glyph" and cur_value == ":-")
        then:
            error => true
            error_msg => "parse error: expected :glyph \":-\"" + cur_got
            self :> halt

    parsing <: obs_cd -> parsing
        |: cur_kind == "glyph" and cur_value == ":-" and nxt_kind == "ident" and nxt_value.code_at(0) >= 65 and nxt_value.code_at(0) <= 90
        then:
            frames => frames.slice(0, depth - 1).append(self.upd(pos + 1, "cand", top.ser, top.ops, top.acc, top.aux, top.cal, top.ctg, top.cnm))
            pos => pos + 1
            self :> ty_start

    parsing <: obs_cd -> parsing
        |: cur_kind == "glyph" and cur_value == ":-" and not (nxt_kind == "ident" and nxt_value.code_at(0) >= 65 and nxt_value.code_at(0) <= 90) and nxt_kind == "newline" and nxt2_kind == "indent"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("body", top.ser, top.ekind, top.ops, top.acc, top.aux)).append(self.mkblk("blk", "(do", 0))
            depth => depth + 1
            pos => pos + 3
            self :> blk_loop

    parsing <: obs_cd -> parsing
        |: cur_kind == "glyph" and cur_value == ":-" and not (nxt_kind == "ident" and nxt_value.code_at(0) >= 65 and nxt_value.code_at(0) <= 90) and not (nxt_kind == "newline" and nxt2_kind == "indent")
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("expr", top.ser, top.ekind, top.ops, top.acc, top.aux))
            pos => pos + 1
            self :> expr_start

    # The candidate return type parsed. Pick the form at the type end.
    parsing <: ty_ret -> parsing
        |: top_kind == "obs"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("typed", top.ser, top.ekind, top.ops, top.acc, v_ser))
            self :> obs_type

    parsing <: obs_type -> parsing
        |: o_cls == "sig"
        then:
            v_ser => ("(obs-sig " + (top.ser + " ")) + ((top.acc + " ") + (top.aux + ")"))
            depth => depth - 1
            self :> iret

    parsing <: obs_type -> parsing
        |: o_cls == "pb"
        then:
            pos => pos + 2
            self :> obs_ploop

    parsing <: obs_type -> parsing
        |: o_cls == "ex"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("expr", top.ser, top.ekind, top.ops, top.acc, top.aux))
            pos => pos + 1
            self :> expr_start

    parsing <: obs_type -> parsing
        |: o_cls == "bf"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("body", top.ser, top.ekind, top.ops, top.acc, top.aux)).append(self.mkblk("blk", "(do", 0))
            depth => depth + 1
            pos => pos + 2
            self :> blk_loop

    parsing <: obs_type -> parsing
        |: o_cls == "re"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("expr", top.ser, top.ekind, top.ops, top.acc, "nil"))
            pos => top.prec
            self :> expr_start

    # The proposition body, then `= expr`.
    parsing <: obs_ploop -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> obs_ploop

    parsing <: obs_ploop -> parsing
        |: cur_kind == "dedent" and nxt_kind == "glyph" and nxt_value == "="
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("expr", top.ser, top.ekind, top.ops, top.acc, top.aux))
            pos => pos + 2
            self :> expr_start

    parsing <: obs_ploop -> parsing
        |: cur_kind == "dedent" and not (nxt_kind == "glyph" and nxt_value == "=")
        then:
            error => true
            error_msg => "parse error: expected :glyph \"=\"" + nxt_got
            self :> halt

    parsing <: obs_ploop -> parsing
        |: cur_is_pc
        then: self :> prop_start

    parsing <: obs_ploop -> parsing
        |: cur_kind != "newline" and cur_kind != "dedent" and not cur_is_pc
        then:
            error => true
            error_msg => "parse error: expected an own-line `|:` proposition inside observation body" + cur_got
            self :> halt

    parsing <: ret -> parsing
        |: top_kind == "obs"
        then: self :> obs_fin

    parsing <: bret -> parsing
        |: top_kind == "obs"
        then: self :> obs_fin

    parsing <: obs_fin -> parsing
        |: top_kind == "obs"
        then:
            v_ser => (("(obs " + top.ser) + (" " + (top.acc + " "))) + ((top.aux + " ") + (v_ser + (obs_props + ")")))
            depth => depth - 1
            self :> iret

    # ---------------------------------------------------------------
    # parse-transition. The `tr` frame keeps the rendering in `ser`, the
    # clauses in `acc`, the start position in `prec`, the source kind
    # in `aux` and phase name in `cnm`, the target in `ekind`, the
    # receive glyph in `ctg`, "w" in `cal` for `<: *`, "then" in `ops`
    # once a then clause is in, and the state in `op`.
    # ---------------------------------------------------------------
    parsing <: tr_start -> parsing
        |: cur_kind == "glyph" and cur_value == "->"
        then:
            frames => frames.slice(0, depth).append(Frame(kind: "tr", prec: pos, op: "head", ser: "(transition " + cur_line.to_string() + " implicit nil", ekind: "", ops: "", acc: "", aux: "implicit", cal: "", ctg: "", cnm: ""))
            depth => depth + 1
            self :> tr_arrow

    parsing <: tr_start -> parsing
        |: not (cur_kind == "glyph" and cur_value == "->")
        then:
            frames => frames.slice(0, depth).append(Frame(kind: "tr", prec: pos, op: "head", ser: "(transition " + cur_line.to_string() + " " + (||: cur_kind == "ident" : "(phase " + cur_value + ")" ||: else : cur_value), ekind: "", ops: "", acc: "", aux: (||: cur_kind == "ident" : "phase" ||: cur_kind == "kw" : "self" ||: else : "wildcard"), cal: "", ctg: "", cnm: (||: cur_kind == "ident" : cur_value ||: else : "")))
            depth => depth + 1
            pos => pos + 1
            self :> tr_skip1

    # Allow newlines between the source and the receive glyph.
    parsing <: tr_skip1 -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> tr_skip1

    parsing <: tr_skip1 -> parsing
        |: cur_kind == "glyph" and (cur_value == "<:" or cur_value == "<|")
        then:
            frames => frames.slice(0, depth - 1).append(self.upd(top.prec, "mp", top.ser, top.ops, top.acc, top.aux, top.cal, cur_value, top.cnm))
            pos => pos + 1
            self :> mp_start

    parsing <: tr_skip1 -> parsing
        |: cur_kind != "newline" and not (cur_kind == "glyph" and (cur_value == "<:" or cur_value == "<|"))
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser + " nil", top.ekind, top.ops, top.acc, top.aux))
            self :> tr_arrow

    # parse-msg-pattern.
    parsing <: mp_start -> parsing
        |: cur_kind == "glyph" and cur_value == "*"
        then:
            frames => frames.slice(0, depth - 1).append(self.upd(top.prec, top.op, top.ser + " (recv " + top.ctg + " *)", top.ops, top.acc, top.aux, "w", top.ctg, top.cnm))
            pos => pos + 1
            self :> tr_arrow

    parsing <: mp_start -> parsing
        |: not (cur_kind == "glyph" and cur_value == "*") and mp_typed
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("typed", top.ser, top.ekind, cur_value, top.acc, top.aux)).append(self.mkpl("rparam"))
            depth => depth + 1
            pos => pos + 1
            self :> pl_open

    parsing <: mp_start -> parsing
        |: not (cur_kind == "glyph" and cur_value == "*") and not mp_typed
        then: self :> expr_start

    parsing <: ret -> parsing
        |: top_kind == "tr"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser + " (recv " + top.ctg + " " + mp_msg + ")", top.ekind, "", top.acc, top.aux))
            self :> tr_arrow

    # skip-newlines, `->`, then the target.
    parsing <: tr_arrow -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> tr_arrow

    parsing <: tr_arrow -> parsing
        |: cur_kind != "newline" and not (cur_kind == "glyph" and cur_value == "->")
        then:
            error => true
            error_msg => "parse error: expected :glyph \"->\"" + cur_got
            self :> halt

    parsing <: tr_arrow -> parsing
        |: cur_kind == "glyph" and cur_value == "->" and nxt_kind == "glyph" and nxt_value == "*"
        then:
            error => true
            error_msg => "parse error: transition target `*` is retired 2026-08-26 (target-`*` meant self-reference, not wildcard — unifying `*` as wildcard-only). Rewrite `-> *` as `-> self`." + nxt_got
            self :> halt

    parsing <: tr_arrow -> parsing
        |: cur_kind == "glyph" and cur_value == "->" and (nxt_kind == "ident" or (nxt_kind == "kw" and nxt_value == "self"))
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("body", top.ser + " " + nxt_value, nxt_value, top.ops, top.acc, top.aux))
            pos => pos + 2
            self :> tb_start

    parsing <: tr_arrow -> parsing
        |: cur_kind == "glyph" and cur_value == "->" and not (nxt_kind == "glyph" and nxt_value == "*") and not (nxt_kind == "ident" or (nxt_kind == "kw" and nxt_value == "self"))
        then:
            error => true
            error_msg => "parse error: expected target phase or `self` after `->`" + nxt_got
            self :> halt

    # parse-transition-body. An inline clause, an indented clause block,
    # or nothing.
    parsing <: tb_start -> parsing
        |: bh_then
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("tbi", top.ser, top.ekind, top.ops, top.acc, top.aux))
            self :> th_start

    parsing <: tb_start -> parsing
        |: bh_do
        then: self :> tb_do

    parsing <: tb_start -> parsing
        |: bh_let
        then: self :> tb_let

    parsing <: tb_start -> parsing
        |: not bh_any and nl_indent
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("tb", top.ser, top.ekind, top.ops, top.acc, top.aux))
            pos => pos + 2
            self :> tb_loop

    parsing <: tb_start -> parsing
        |: not bh_any and not nl_indent
        then: self :> tr_fin

    parsing <: tb_do -> parsing
        |: not error
        then:
            error => true
            error_msg => "parse error: `do:` transition sub-block is retired (F70 I3, 2026-08-19). Rename the clause header from `do:` to `then:` — the unified `then:` clause accepts both field updates (`field => expr`) and side-effect statements (`:>`, prefix `|> receiver.msg(args)`, calls, prints) in source order. Multiple `then:` blocks per transition body are legal (F22 exemption for `then:`). See spec §1.11 and plans/archive/f70-surface-facelift.md." + cur_got
            self :> halt

    parsing <: tb_let -> parsing
        |: not error
        then:
            error => true
            error_msg => "parse error: `let:` transition sub-block is retired (F18 L1' Landing 2, 2026-08-24). Use statement-form `let <name> = <expr>` inside the `then:` clause instead — the unified `then:` clause accepts field updates, side-effect statements, and `let` bindings in source order. Migration: rewrite `let: k: 5\\n        then: n => n + k` as `then:\\n            let k = 5\\n            n => n + k`. See spec §2.5 and plans/g2-expression-flow/f18-block-as-expression.md." + cur_got
            self :> halt

    parsing <: tb_loop -> parsing
        |: cur_kind == "dedent"
        then:
            pos => pos + 1
            self :> tr_fin

    parsing <: tb_loop -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> tb_loop

    parsing <: tb_loop -> parsing
        |: cur_is_pc and top.ops == "then"
        then:
            error => true
            error_msg => "parse error: arm-head `|:` proposition must appear before `then:` in a transition body" + cur_got
            self :> halt

    parsing <: tb_loop -> parsing
        |: cur_is_pc and top.ops != "then"
        then: self :> prop_start

    parsing <: tb_loop -> parsing
        |: bh_then
        then: self :> th_start

    parsing <: tb_loop -> parsing
        |: bh_do
        then: self :> tb_do

    parsing <: tb_loop -> parsing
        |: bh_let
        then: self :> tb_let

    parsing <: tb_loop -> parsing
        |: cur_kind != "dedent" and cur_kind != "newline" and not cur_is_pc and not bh_any
        then: self :> tr_fin

    parsing <: thret -> parsing
        |: top_kind == "tr" and top.op == "tbi"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + " " + v_ser, top.aux))
            self :> tr_fin

    parsing <: thret -> parsing
        |: top_kind == "tr" and top.op == "tb"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, "then", top.acc + " " + v_ser, top.aux))
            self :> tb_loop

    # Phase-swallow `<: *` validation, at the transition start.
    parsing <: tr_fin -> parsing
        |: top.cal == "w" and not tr_ps
        then:
            error => true
            error_msg => "parse error: phase-swallow shorthand `<phase> <: * -> <phase>` requires a specific source phase; got source `:" + (top.aux + ("`" + self.tok_got(top.prec)))
            self :> halt

    parsing <: tr_fin -> parsing
        |: top.cal == "w" and tr_ps and not tr_tgt_ok
        then:
            error => true
            error_msg => (("parse error: phase-swallow shorthand `" + top.cnm) + (" <: * -> " + top.cnm)) + (("` must have the target phase equal to the source (or `self`); got `-> " + top.ekind) + ("`" + self.tok_got(top.prec)))
            self :> halt

    parsing <: tr_fin -> parsing
        |: top.cal == "w" and tr_ps and tr_tgt_ok and top.acc != ""
        then:
            error => true
            error_msg => (("parse error: phase-swallow shorthand `" + top.cnm) + (" <: * -> " + top.ekind)) + (("` must have an empty body — the whole point is 'silently drop any message', so `then:` / `|:` / etc. are rejected. Use a concrete `" + top.cnm) + (" <: <msg> -> ...` arm instead if you need per-message logic." + self.tok_got(top.prec)))
            self :> halt

    parsing <: tr_fin -> parsing
        |: top.cal != "w" or (tr_ps and tr_tgt_ok and top.acc == "")
        then:
            v_ser => top.ser + top.acc + ")"
            depth => depth - 1
            self :> iret

    # ---------------------------------------------------------------
    # parse-then-clause. The `thb` frame keeps the updates in `ser`, the
    # statements in `acc`, the fields staged so far in `aux`, the field
    # being staged in `ops`, and 1 in `prec` for the inline form.
    # ---------------------------------------------------------------
    parsing <: th_start -> parsing
        |: nxt2_kind == "newline" and nxt3_kind != "indent"
        then:
            error => true
            error_msg => "parse error: expected :indent" + self.tok_got(pos + 3)
            self :> halt

    parsing <: th_start -> parsing
        |: nxt2_kind == "newline" and nxt3_kind == "indent"
        then:
            frames => frames.slice(0, depth).append(Frame(kind: "thb", prec: 0, op: "", ser: "", ekind: "other", ops: "", acc: "", aux: ",", cal: "", ctg: "", cnm: ""))
            depth => depth + 1
            pos => pos + 4
            self :> th_loop

    parsing <: th_start -> parsing
        |: nxt2_kind != "newline"
        then:
            frames => frames.slice(0, depth).append(Frame(kind: "thb", prec: 1, op: "", ser: "", ekind: "other", ops: "", acc: "", aux: ",", cal: "", ctg: "", cnm: ""))
            depth => depth + 1
            pos => pos + 2
            self :> th_entry

    parsing <: th_loop -> parsing
        |: cur_kind == "dedent"
        then:
            pos => pos + 1
            self :> th_close

    parsing <: th_loop -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> th_loop

    parsing <: th_loop -> parsing
        |: cur_kind != "dedent" and cur_kind != "newline"
        then: self :> th_entry

    parsing <: th_entry -> parsing
        |: cur_is_pc
        then: self :> prop_start

    parsing <: th_entry -> parsing
        |: th_up and th_dup
        then:
            error => true
            error_msg => "parse error: duplicate `" + (cur_value + (" =>` in this then: block. `=>` is a one-shot transformation — one commit per field per transition. Compose the whole chain in one `=>`, or split intermediate values into `let` bindings." + cur_got))
            self :> halt

    parsing <: th_entry -> parsing
        |: th_up and not th_dup
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("up", top.ser, top.ekind, cur_value, top.acc, top.aux + cur_value + ","))
            pos => pos + 2
            self :> expr_start

    parsing <: th_entry -> parsing
        |: not cur_is_pc and not th_up
        then: self :> stmt_start

    parsing <: ret -> parsing
        |: top_kind == "thb"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop("", top.ser + " (set " + top.ops + " " + v_ser + ")", top.ekind, "", top.acc, top.aux))
            self :> th_next

    parsing <: sret -> parsing
        |: top_kind == "thb"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + " " + v_ser, top.aux))
            self :> th_next

    parsing <: th_next -> parsing
        |: top.prec == 1
        then: self :> th_close

    parsing <: th_next -> parsing
        |: top.prec == 0
        then: self :> th_loop

    parsing <: th_close -> parsing
        |: top_kind == "thb"
        then:
            v_ser => ("(then (ups" + top.ser) + (") (stmts" + (top.acc + "))"))
            depth => depth - 1
            self :> thret

    # ===============================================================
    # Chapter 30. Whole programs. Prog mode (argv[2] `prog`) runs
    # parse*'s loop and parse-top's dispatch, parses `from` and `import`
    # lines, the def header (name, ctor params, `queue:`, the
    # free-function rejection, NEWLINE INDENT), runs the chapter-29
    # item loop under a real DEDENT, and reshapes the def. Extend blocks
    # run the same item parsers under parse-extend-section's dispatch.
    # Return modes `rs` (the reshape), `x_done`, `fs_done` (a foreign
    # signature), and `fe_add` (a foreign entry). Frames `dh` (a ctor
    # param list), `xhc` / `xcl` (conformances), `fb`, `fent`, `fsig`.
    # ===============================================================

    parsing <: begin -> parsing
        |: prog_mode
        then: self :> p_loop

    parsing <: p_loop -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> p_loop

    parsing <: p_loop -> parsing
        |: cur_kind == "eof"
        then:
            v_ser => "(program" + p_out + ")"
            self :> done

    parsing <: p_loop -> parsing
        |: cur_kind != "newline" and cur_kind != "eof"
        then: self :> p_disp

    # The retired top-level forms.
    parsing <: p_disp -> parsing
        |: t_class == "module"
        then:
            error => true
            error_msg => "parse error: `module <name>` declaration is retired (2026-08-20). Module identity is the file path relative to the source root — the compiler walks the tree; no explicit declaration is needed. Delete this line. If you were using the declared name for imports elsewhere, rely on the file path instead (e.g. `from com.example.foo import X` where `com/example/foo.cxc` is the file)." + cur_got
            self :> halt

    parsing <: p_disp -> parsing
        |: t_class == "let"
        then:
            error => true
            error_msg => "parse error: module-scope `let` retired 2026-08-31 (R3, decisions-frozen-2026-08-31.md §R3). Module-scope constants live in a `def` record with compile-time-constant field defaults, e.g. `def Constants:\\n    PROTOCOL_VERSION: UInt16! = 13` — consumers reference as `Constants.PROTOCOL_VERSION`. For A7 `project.cxc` manifests, drop the `let project = ` prefix and leave the bare `Project(...)` expression." + cur_got
            self :> halt

    parsing <: p_disp -> parsing
        |: t_class == "sealed"
        then:
            error => true
            error_msg => "parse error: `sealed protocol` is retired at v1.0 (spec §3.4.1). For closed sum types use `enum` with associated values; for open protocols (any type may conform), drop `sealed`." + cur_got
            self :> halt

    parsing <: p_disp -> parsing
        |: t_class == "extern"
        then:
            error => true
            error_msg => "parse error: `extern` as a top-level section keyword is retired at v1.0. FFI is a `Plugin` capability atom (R11 2026-09-01) provisioned to shims inside `def plugin:` modules; foreign symbols nest inside the plugin body (`foreign \"libname\":` sections). See spec §1.12, §1.14, §7.2.1." + cur_got
            self :> halt

    parsing <: p_disp -> parsing
        |: t_class == "sugar"
        then:
            error => true
            error_msg => (("parse error: F69 L3: `" + cur_value) + (" " + (nxt_value + ":` sugar retired at v1.0. Write `def "))) + ((nxt_value + ":` — the body-shape (fields / cases / transitions) tells the compiler what kind of def it is (spec §3.3, F69 atom unification 2026-08-18). See plans/archive/f69-atom-unification.md.") + cur_got)
            self :> halt

    parsing <: p_disp -> parsing
        |: t_class == "err"
        then:
            error => true
            error_msg => "parse error: expected top-level form" + cur_got
            self :> halt

    # parse-from-import. The foreign form reads `<lang> "<header>"`.
    parsing <: p_disp -> parsing
        |: t_class == "from" and f_lang and not nxt3_is_imp
        then:
            error => true
            error_msg => "parse error: expected :kw \"import\"" + self.tok_got(pos + 3)
            self :> halt

    parsing <: p_disp -> parsing
        |: t_class == "from" and f_lang and nxt3_is_imp
        then:
            imp_mode => "ffrom"
            imp_lang => nxt_value
            imp_hdr => nxt2_value
            imp_names => ""
            pos => pos + 4
            self :> in_name

    parsing <: p_disp -> parsing
        |: t_class == "from" and not f_lang and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: p_disp -> parsing
        |: t_class == "from" and not f_lang and nxt_kind == "ident"
        then:
            imp_mode => "from"
            imp_dot => nxt_value
            imp_names => ""
            pos => pos + 2
            self :> in_dot

    # parse-import.
    parsing <: p_disp -> parsing
        |: t_class == "import" and f_lang and nxt3_kind != "newline"
        then:
            error => true
            error_msg => "parse error: expected :newline" + self.tok_got(pos + 3)
            self :> halt

    parsing <: p_disp -> parsing
        |: t_class == "import" and f_lang and nxt3_kind == "newline"
        then:
            p_out => p_out + ((" (foreign-import " + nxt_value) + ((" \"" + nxt2_value) + "\")"))
            pos => pos + 4
            self :> p_loop

    parsing <: p_disp -> parsing
        |: t_class == "import" and not f_lang and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: p_disp -> parsing
        |: t_class == "import" and not f_lang and nxt_kind == "ident"
        then:
            imp_mode => "import"
            imp_dot => nxt_value
            pos => pos + 2
            self :> in_dot

    # parse-dotted, then the rest of the line.
    parsing <: in_dot -> parsing
        |: cur_is_dot and nxt_kind == "ident"
        then:
            imp_dot => imp_dot + "." + nxt_value
            pos => pos + 2
            self :> in_dot

    parsing <: in_dot -> parsing
        |: not (cur_is_dot and nxt_kind == "ident") and imp_mode == "from" and i_kw == "import"
        then:
            pos => pos + 1
            self :> in_name

    parsing <: in_dot -> parsing
        |: not (cur_is_dot and nxt_kind == "ident") and imp_mode == "from" and i_kw != "import"
        then:
            error => true
            error_msg => "parse error: expected :kw \"import\"" + cur_got
            self :> halt

    parsing <: in_dot -> parsing
        |: not (cur_is_dot and nxt_kind == "ident") and imp_mode == "import" and cur_is_as and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: in_dot -> parsing
        |: not (cur_is_dot and nxt_kind == "ident") and imp_mode == "import" and cur_is_as and nxt_kind == "ident"
        then:
            imp_as => nxt_value
            pos => pos + 2
            self :> imp_nl

    parsing <: in_dot -> parsing
        |: not (cur_is_dot and nxt_kind == "ident") and imp_mode == "import" and not cur_is_as
        then:
            imp_as => "nil"
            self :> imp_nl

    parsing <: imp_nl -> parsing
        |: cur_kind == "newline"
        then:
            p_out => p_out + ((" (import " + imp_dot) + ((" " + imp_as) + ")"))
            pos => pos + 1
            self :> p_loop

    parsing <: imp_nl -> parsing
        |: cur_kind != "newline"
        then:
            error => true
            error_msg => "parse error: expected :newline" + cur_got
            self :> halt

    # The from-import name list, `name [as alias]` separated by `,`.
    parsing <: in_name -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + cur_got
            self :> halt

    parsing <: in_name -> parsing
        |: cur_kind == "ident" and nxt_is_as and nxt2_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt2_got
            self :> halt

    parsing <: in_name -> parsing
        |: cur_kind == "ident" and nxt_is_as and nxt2_kind == "ident"
        then:
            imp_names => imp_names + ((" (name " + cur_value) + ((" " + nxt2_value) + ")"))
            pos => pos + 3
            self :> in_sep

    parsing <: in_name -> parsing
        |: cur_kind == "ident" and not nxt_is_as
        then:
            imp_names => imp_names + ((" (name " + cur_value) + " nil)")
            pos => pos + 1
            self :> in_sep

    parsing <: in_sep -> parsing
        |: cur_is_comma
        then:
            pos => pos + 1
            self :> in_name

    parsing <: in_sep -> parsing
        |: cur_kind == "newline"
        then:
            p_out => p_out + imp_node
            pos => pos + 1
            self :> p_loop

    parsing <: in_sep -> parsing
        |: not cur_is_comma and cur_kind != "newline"
        then:
            error => true
            error_msg => "parse error: expected `,` or newline in from-import" + cur_got
            self :> halt

    # ---------------------------------------------------------------
    # parse-def-atom's header.
    # ---------------------------------------------------------------
    parsing <: p_disp -> parsing
        |: t_class == "def" and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: p_disp -> parsing
        |: t_class == "def" and nxt_kind == "ident"
        then:
            d_name => nxt_value
            d_pos => pos
            d_ctor => "(params)"
            d_queue => "nil"
            d_seg0 => ""
            d_seg1 => ""
            d_seg2 => ""
            d_nmark => 0
            d_m1 => ""
            d_fields => ""
            d_uses => ""
            d_trans => false
            d_use => false
            d_sig => false
            d_hascase => false
            d_frn => false
            d_cdflt => false
            d_pinv => false
            d_noncase => false
            d_np => ""
            e_raw_nm => ""
            e_raw_val => ""
            e_noraw => ""
            e_payany => false
            e_max => 0
            e_sr_case => ""
            e_sr_par => ""
            pos => pos + 2
            self :> dh_open

    # parse-queue-config, then parse-def-atom-ctor-tail.
    parsing <: dh_open -> parsing
        |: q_head and q_unb
        then:
            d_queue => "(queue unbounded)"
            pos => pos + 4
            self :> q_tail

    parsing <: dh_open -> parsing
        |: q_head and q_bnd and not q5_int
        then:
            error => true
            error_msg => "parse error: Track C/2: `queue: bounded(...)` requires an integer literal capacity, e.g. `bounded(100)`." + self.tok_got(pos + 5)
            self :> halt

    parsing <: dh_open -> parsing
        |: q_head and q_bnd and q5_int and q5_zero
        then:
            error => true
            error_msg => ("parse error: Track C/2: `queue: bounded(" + self.tk_value(pos + 5)) + (")` requires a positive capacity." + self.tok_got(pos + 5))
            self :> halt

    parsing <: dh_open -> parsing
        |: q_head and q_bnd and q5_int and not q5_zero and not q6_rp
        then:
            error => true
            error_msg => "parse error: expected :punct \")\"" + self.tok_got(pos + 6)
            self :> halt

    parsing <: dh_open -> parsing
        |: q_head and q_bnd and q5_int and not q5_zero and q6_rp
        then:
            d_queue => ("(queue bounded " + self.tk_value(pos + 5)) + ")"
            pos => pos + 7
            self :> q_tail

    parsing <: dh_open -> parsing
        |: q_head and not q_unb and not q_bnd
        then:
            error => true
            error_msg => ("parse error: Track C/2: `queue:` expects `bounded(N)` or `unbounded` (positional discipline expression), got " + self.tk_pr(pos + 3)) + self.tok_got(pos + 3)
            self :> halt

    parsing <: dh_open -> parsing
        |: cur_is_lparen and not q_head
        then:
            frames => frames.slice(0, depth).append(self.mk("dh", "")).append(self.mkpl("param"))
            depth => depth + 2
            self :> pl_open

    parsing <: dh_open -> parsing
        |: not cur_is_lparen
        then: self :> dh_colon

    parsing <: q_tail -> parsing
        |: cur_is_rparen
        then:
            pos => pos + 1
            self :> dh_colon

    parsing <: q_tail -> parsing
        |: cur_is_comma
        then:
            frames => frames.slice(0, depth).append(self.mk("dh", "")).append(self.mkpl("param"))
            depth => depth + 2
            pos => pos + 1
            self :> pl_param

    parsing <: q_tail -> parsing
        |: not cur_is_rparen and not cur_is_comma
        then:
            error => true
            error_msg => "parse error: Track C/2: after `queue: <discipline>` expected `,` (followed by more ctor params) or `)` (queue is the only entry)." + cur_got
            self :> halt

    parsing <: pl_done -> parsing
        |: top_kind == "dh"
        then:
            d_ctor => v_ser
            depth => depth - 1
            self :> dh_colon

    # `:`, the free-function fix-it, an optional NEWLINE, then INDENT.
    parsing <: dh_colon -> parsing
        |: not cur_is_colon
        then:
            error => true
            error_msg => "parse error: expected :punct \":\"" + cur_got
            self :> halt

    parsing <: dh_colon -> parsing
        |: cur_is_colon and dh_free
        then:
            error => true
            error_msg => (("parse error: top-level free function `def " + d_name) + ("(...): T :- body` does not exist at v1.0. Only `def <AtomName>:`, `def <RecordName>:`, `def <EnumName>:`, `def main:`, and `def plugin:` are legal at module scope. Hoist this helper into the atom that uses it as an observation:\n\n    def main:\n        -> running\n            then: print(" + d_name)) + (("(3, 7))\n        " + d_name) + ("(x: Int, y: Int) :- Int\n            ||: x < y : x\n            ||: else : y\n\nNote: the return type goes AFTER `:-`, not before it." + self.tok_got(d_pos)))
            self :> halt

    parsing <: dh_colon -> parsing
        |: cur_is_colon and not dh_free and nxt_kind == "newline" and nxt2_kind == "indent"
        then:
            pos => pos + 3
            self :> dh_body

    parsing <: dh_colon -> parsing
        |: cur_is_colon and not dh_free and nxt_kind == "newline" and nxt2_kind != "indent"
        then:
            error => true
            error_msg => "parse error: expected :indent" + nxt2_got
            self :> halt

    parsing <: dh_colon -> parsing
        |: cur_is_colon and not dh_free and nxt_kind == "indent"
        then:
            pos => pos + 2
            self :> dh_body

    parsing <: dh_colon -> parsing
        |: cur_is_colon and not dh_free and nxt_kind != "newline" and nxt_kind != "indent"
        then:
            error => true
            error_msg => "parse error: expected :indent" + nxt_got
            self :> halt

    parsing <: dh_body -> parsing
        |: not error
        then:
            frames => frames.slice(0, depth).append(self.mk("iseq", ""))
            depth => depth + 1
            self :> iseq_loop

    # One body item, into the segments and the reshape registers.
    parsing <: iret -> parsing
        |: top_kind == "iseq" and prog_mode and not in_ext
        then:
            d_seg0 => ||: d_nmark == 0 and not it_fold : d_seg0 + " " + v_ser ||: else : d_seg0
            d_seg1 => ||: d_nmark == 1 and not it_fold : d_seg1 + " " + v_ser ||: else : d_seg1
            d_seg2 => ||: d_nmark == 2 and not it_fold : d_seg2 + " " + v_ser ||: else : d_seg2
            d_nmark => ||: it_mark : d_nmark + 1 ||: else : d_nmark
            d_m1 => ||: it_mark and d_nmark == 0 and it_field : "F" ||: it_mark and d_nmark == 0 : "U" ||: else : d_m1
            d_fields => ||: it_field : d_fields + " " + v_ser ||: else : d_fields
            d_uses => ||: it_use : d_uses + " " + v_ser ||: else : d_uses
            d_trans => d_trans or it_trans
            d_use => d_use or it_use
            d_sig => d_sig or it_osig or it_rsig
            d_hascase => d_hascase or it_case
            d_frn => d_frn or it_frn
            d_cdflt => d_cdflt or (it_field and f_cdf)
            d_pinv => d_pinv or not (it_osig or it_rsig or it_obs)
            d_noncase => d_noncase or not it_case
            d_np => ||: d_np == "" and not it_field and not it_frn : it_node ||: else : d_np
            e_raw_nm => ||: it_case and ec_raw != "" and e_raw_nm == "" : ec_nm ||: else : e_raw_nm
            e_raw_val => ||: it_case and ec_raw != "" and e_raw_nm == "" : ec_raw ||: else : e_raw_val
            e_noraw => ||: it_case and ec_raw == "" and e_noraw == "" : ec_nm ||: else : e_noraw
            e_payany => e_payany or (it_case and ec_pay)
            e_max => ||: it_case and ec_raw != "" and ec_raw.to_int_or(0) > e_max : ec_raw.to_int_or(0) ||: else : e_max
            e_sr_case => ||: it_case and ec_sref != "" and e_sr_case == "" : ec_nm ||: else : e_sr_case
            e_sr_par => ||: it_case and ec_sref != "" and e_sr_case == "" : ec_sref ||: else : e_sr_par
            self :> iseq_loop

    # ---------------------------------------------------------------
    # The reshape at the def's DEDENT, in parse-def-atom's order. Every
    # message quotes the `def` token.
    # ---------------------------------------------------------------
    parsing <: rs -> parsing
        |: rs_class == "frn"
        then:
            error => true
            error_msg => "parse error: R7: `foreign \"...\"` blocks are only legal inside a `def plugin:` module manifest. Add a `def plugin:` marker at module top-level (spec §7.2.1, R7 + R11 plugin-only wave 2026-09-01) or move the block into an actual plugin module." + self.tok_got(d_pos)
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "pl_ctor"
        then:
            error => true
            error_msg => "parse error: R7: `def plugin:` manifest cannot take ctor params — manifest is data, not a constructor. Delete the `(...)` after `plugin`." + self.tok_got(d_pos)
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "pl_q"
        then:
            error => true
            error_msg => "parse error: R7: `def plugin:` manifest cannot declare a `queue:` — no mailbox on a manifest record." + self.tok_got(d_pos)
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "pl_np"
        then:
            error => true
            error_msg => ("parse error: R7: `def plugin:` body admits only fields (name/version/compat/requires + defaults) and nested `foreign \"libname\":` sections. Got node kind `" + d_np) + ("`." + self.tok_got(d_pos))
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "plugin"
        then:
            p_out => p_out + ((" (plugin (fields" + d_fields) + (")" + ((d_seg0 + d_seg1) + (d_seg2 + ")"))))
            depth => depth - 1
            pos => pos + 1
            self :> p_loop

    parsing <: rs -> parsing
        |: rs_class == "pr_ctor"
        then:
            error => true
            error_msg => ("parse error: F68 L1: `def " + d_name) + ("(...)` with ctor params contains signature-only members — protocols declare signatures only and carry no state, so ctor params are not permitted. Drop the ctor params to keep as a protocol, or remove the signature-only members to promote to a concrete def." + self.tok_got(d_pos))
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "pr_inv"
        then:
            error => true
            error_msg => ("parse error: signature-only protocol `" + d_name) + ("` mixes protocol declarations with state, transitions, or other concrete body items. A protocol body may contain only `<: name(args)`, `name(args) :- ReturnType`, and bodyful observable defaults." + self.tok_got(d_pos))
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "protocol"
        then:
            p_out => p_out + ((" (protocol " + d_name) + (d_body + ")"))
            depth => depth - 1
            pos => pos + 1
            self :> p_loop

    parsing <: rs -> parsing
        |: rs_class == "en_ctor"
        then:
            error => true
            error_msg => ("parse error: F68 L2: `def " + d_name) + ("(...)` with ctor params contains `case` markers — enums declare a closed set of cases and carry no ctor state. Drop the ctor params to keep as an enum, or remove the `case` markers to promote to a class/atom." + self.tok_got(d_pos))
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "en_mix"
        then:
            error => true
            error_msg => ("parse error: F68 L2: `def " + d_name) + (":` mixes `case` markers with other body items (fields, observables, transitions, direct `use`, protocol signatures). Enums are a closed set of cases with no per-instance state. Move the non-case items to a separate declaration, or drop the `case` markers if this was intended as a class." + self.tok_got(d_pos))
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "en_raw"
        then:
            error => true
            error_msg => ((("parse error: F16 L2: enum `" + d_name) + ("` mixes cases with explicit raw values (`case " + e_raw_nm)) + ((" = " + e_raw_val) + ("`) and cases without (`case " + e_noraw))) + ("`). Either assign raw values to every case or drop them from all cases (spec §3.3 raw-value enums are all-or-none)." + self.tok_got(d_pos))
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "en_rawpay"
        then:
            error => true
            error_msg => ("parse error: F16 L2: enum `" + d_name) + ("` combines raw-value cases with payload cases. These shapes are distinct per §3.3 — raw-value enums attach fixed integer values; payload enums carry associated values. Pick one shape." + self.tok_got(d_pos))
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "en_self"
        then:
            error => true
            error_msg => (((("parse error: self-reference enum payload `" + d_name) + ("` on case `" + e_sr_case)) + (("` payload `" + e_sr_par) + (": " + d_name))) + (("` — v1.0 rejects direct self-reference. Enums are value types (spec §3.2); embedding `" + d_name) + ("` as a value field inside its own payload has no value-shaped lowering. Workarounds: (1) carry an indirect reference by name (e.g. `inner_name: String!` plus a resolve pass), (2) wrap in a boxed record held through a container like `List of " + d_name))) + ("` (sub-case 2 — legal), (3) use the flat tagged-record encoding (see compiler/self_host/design/ast-shape-records.md). Future landings that promote records/enums to reference types will retire this check." + self.tok_got(d_pos))
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "enum"
        then:
            p_out => p_out + ((" (enum " + d_name) + ((" " + e_rtype) + (d_body + ")")))
            depth => depth - 1
            pos => pos + 1
            self :> p_loop

    parsing <: rs -> parsing
        |: rs_class == "q"
        then:
            error => true
            error_msg => (("parse error: Track C/2: `queue: <discipline>` is meaningful only on agent atoms (those with transitions, direct `use:`, or ctor params). `def " + d_name) + ("` has no mailbox — its inferred kind is " + rs_ikind)) + (". Remove the `queue:` declaration or promote to an agent shape." + self.tok_got(d_pos))
            self :> halt

    parsing <: rs -> parsing
        |: rs_class == "agent"
        then:
            p_out => p_out + (((" (agent " + d_name) + (" " + d_ctor)) + ((" " + d_queue) + (d_body + ")")))
            depth => depth - 1
            pos => pos + 1
            self :> p_loop

    parsing <: rs -> parsing
        |: rs_class == "record"
        then:
            p_out => p_out + ((" (record " + d_name) + (d_body + ")"))
            depth => depth - 1
            pos => pos + 1
            self :> p_loop

    # ---------------------------------------------------------------
    # parse-extend-class. Header conformances `(P, ...)`, then the body
    # loop over parse-extend-section. `xhc` and `xcl` frames take the
    # conformance types back from parse-type.
    # ---------------------------------------------------------------
    parsing <: p_disp -> parsing
        |: t_class == "extend" and nxt_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + nxt_got
            self :> halt

    parsing <: p_disp -> parsing
        |: t_class == "extend" and nxt_kind == "ident"
        then:
            x_target => nxt_value
            x_conf => ""
            x_body => ""
            ext_repl => false
            pos => pos + 2
            self :> x_head

    parsing <: x_head -> parsing
        |: cur_is_lparen and nxt_is_rparen
        then:
            error => true
            error_msg => "parse error: empty conformance list `()` — omit the parens if no protocols." + nxt_got
            self :> halt

    parsing <: x_head -> parsing
        |: cur_is_lparen and not nxt_is_rparen
        then:
            frames => frames.slice(0, depth).append(self.mk("xhc", ""))
            depth => depth + 1
            pos => pos + 1
            self :> ty_start

    parsing <: x_head -> parsing
        |: not cur_is_lparen
        then: self :> x_colon

    parsing <: ty_ret -> parsing
        |: top_kind == "xhc" and cur_is_comma
        then:
            x_conf => x_conf + " " + v_ser
            pos => pos + 1
            self :> ty_start

    parsing <: ty_ret -> parsing
        |: top_kind == "xhc" and cur_is_rparen
        then:
            x_conf => x_conf + " " + v_ser
            depth => depth - 1
            pos => pos + 1
            self :> x_colon

    parsing <: ty_ret -> parsing
        |: top_kind == "xhc" and not cur_is_comma and not cur_is_rparen
        then:
            error => true
            error_msg => "parse error: expected `,` or `)` in conformance list" + cur_got
            self :> halt

    parsing <: x_colon -> parsing
        |: not cur_is_colon
        then:
            error => true
            error_msg => "parse error: expected :punct \":\"" + cur_got
            self :> halt

    parsing <: x_colon -> parsing
        |: cur_is_colon and nxt_kind != "newline"
        then:
            error => true
            error_msg => "parse error: expected :newline" + nxt_got
            self :> halt

    parsing <: x_colon -> parsing
        |: cur_is_colon and nxt_kind == "newline" and nxt2_kind != "indent"
        then:
            error => true
            error_msg => "parse error: expected :indent" + nxt2_got
            self :> halt

    parsing <: x_colon -> parsing
        |: cur_is_colon and nxt_kind == "newline" and nxt2_kind == "indent"
        then:
            frames => frames.slice(0, depth).append(self.mk("iseq", ""))
            depth => depth + 1
            in_ext => true
            pos => pos + 3
            self :> iseq_loop

    parsing <: x_done -> parsing
        |: not error
        then:
            p_out => p_out + (((" (extend " + x_target) + (" (conforms" + x_conf)) + (")" + (x_body + ")")))
            in_ext => false
            depth => depth - 1
            pos => pos + 1
            self :> p_loop

    parsing <: iret -> parsing
        |: top_kind == "iseq" and prog_mode and in_ext
        then:
            x_body => x_body + x_item
            ext_repl => false
            self :> iseq_loop

    # looks-like-observable? needs scan-past-parens here too.
    parsing <: ext_start -> parsing
        |: obs_name and nxt_is_lparen
        then:
            scan_p => pos + 2
            scan_d => 1
            self :> obs_scan

    parsing <: ext_start -> parsing
        |: not (obs_name and nxt_is_lparen)
        then:
            scan_hit => false
            self :> ext_disp

    parsing <: ext_disp -> parsing
        |: x_class == "robs" or x_class == "obs"
        then: self :> obs_start

    parsing <: ext_disp -> parsing
        |: x_class == "rtrans" or x_class == "trans"
        then: self :> tr_start

    parsing <: ext_disp -> parsing
        |: x_class == "prop"
        then: self :> prop_start

    parsing <: ext_disp -> parsing
        |: x_class == "repl"
        then:
            ext_repl => true
            pos => pos + 1
            self :> ext_start

    parsing <: ext_disp -> parsing
        |: x_class == "conf"
        then:
            frames => frames.slice(0, depth).append(self.mk("xcl", ""))
            depth => depth + 1
            pos => pos + 2
            self :> ty_start

    parsing <: ty_ret -> parsing
        |: top_kind == "xcl" and cur_kind == "newline"
        then:
            x_conf => x_conf + " " + v_ser
            depth => depth - 1
            pos => pos + 1
            self :> iseq_loop

    parsing <: ty_ret -> parsing
        |: top_kind == "xcl" and cur_kind != "newline"
        then:
            error => true
            error_msg => "parse error: expected :newline" + cur_got
            self :> halt

    parsing <: ext_disp -> parsing
        |: x_class == "rerr"
        then:
            error => true
            error_msg => ("parse error: `replace` inside `extend " + x_target) + ("` must prefix an observable (`replace name[(args)] :- expr`) or a wildcard self-transition (`replace * <: msg(args) -> * then: <body>`). See §3.3.2 rule 4." + cur_got)
            self :> halt

    parsing <: ext_disp -> parsing
        |: x_class == "nest"
        then:
            error => true
            error_msg => "parse error: nested `extend` blocks are not permitted — extension is a top-level form only. See F9 plan Q3.3." + cur_got
            self :> halt

    parsing <: ext_disp -> parsing
        |: x_class == "inv"
        then:
            error => true
            error_msg => ("parse error: `invariants:` section header is retired at v1.0 (four-position `|:` unification, ratified 2026-08-25). Migrate each invariant to a `|:` proposition on its own line at extend-body top level:\n\n  extend " + x_target) + (":\n      |: <proposition>          ← was `invariants:` entry\n\nExtension propositions compose additively with the def's existing propositions. See spec §1.11 and §3.4.2." + cur_got)
            self :> halt

    parsing <: ext_disp -> parsing
        |: x_class == "fielderr"
        then:
            error => true
            error_msg => (("parse error: field declaration `" + cur_value) + (": …` is not permitted inside `extend " + x_target)) + ("` — extensions cannot add state (§3.3.2). Add fields at the original class definition." + cur_got)
            self :> halt

    parsing <: ext_disp -> parsing
        |: x_class == "use"
        then:
            error => true
            error_msg => ("parse error: `use <name>: <Type>` is not permitted inside `extend " + x_target) + ("` — extensions cannot add capabilities (§3.3.2). Declare the direct `use` line at the original class definition." + cur_got)
            self :> halt

    parsing <: ext_disp -> parsing
        |: x_class == "dep"
        then:
            error => true
            error_msg => ("parse error: `deprecated:` is not permitted inside `extend " + x_target) + ("` — deprecation belongs on the original definition." + cur_got)
            self :> halt

    parsing <: ext_disp -> parsing
        |: x_class == "state"
        then:
            error => true
            error_msg => "parse error: `state:` section is retired at v1.0 — and extensions cannot add fields anyway (§3.3.2, §1.11)." + cur_got
            self :> halt

    parsing <: ext_disp -> parsing
        |: x_class == "err"
        then:
            error => true
            error_msg => ("parse error: expected observable (`name[(args)] :- expr`), transition (`* <: msg(args) -> * …`), own-line `|:`, conforms:, or dedent in `extend " + x_target) + ("` body" + cur_got)
            self :> halt

    # ---------------------------------------------------------------
    # parse-foreign-block and parse-foreign-entry. The `fb` frame keeps
    # the head in `ser` and the entries in `acc`, `fent` its entry head.
    # ---------------------------------------------------------------
    parsing <: fb_loop -> parsing
        |: cur_kind == "dedent"
        then:
            v_ser => top.ser + top.acc + ")"
            depth => depth - 1
            pos => pos + 1
            self :> iret

    parsing <: fb_loop -> parsing
        |: cur_kind == "newline"
        then:
            pos => pos + 1
            self :> fb_loop

    parsing <: fb_loop -> parsing
        |: cur_kind != "dedent" and cur_kind != "newline"
        then: self :> fe_start

    parsing <: fe_start -> parsing
        |: cur_kind != "ident"
        then:
            error => true
            error_msg => ("parse error: R7 foreign entry expects a kind keyword (`symbol` / `selector` / `class_selector` / `type`), got " + cur_pr) + cur_got
            self :> halt

    parsing <: fe_start -> parsing
        |: cur_kind == "ident" and not fe_kind_ok
        then:
            error => true
            error_msg => ("parse error: R7 foreign entry kind must be one of `symbol` / `selector` / `class_selector` / `type`, got `" + cur_value) + ("`." + cur_got)
            self :> halt

    parsing <: fe_start -> parsing
        |: (fe_sym or fe_sel or fe_type) and nxt_kind != "string"
        then:
            error => true
            error_msg => "parse error: expected :string" + nxt_got
            self :> halt

    parsing <: fe_start -> parsing
        |: fe_sym and nxt_kind == "string" and not nxt2_is_arrow
        then:
            error => true
            error_msg => "parse error: expected :glyph \"->\"" + nxt2_got
            self :> halt

    parsing <: fe_start -> parsing
        |: fe_sym and nxt_kind == "string" and nxt2_is_arrow
        then:
            frames => frames.slice(0, depth).append(self.mk("fent", "(symbol \"" + nxt_value + "\"")).append(self.mkop("fsig", "w", "", 0))
            depth => depth + 2
            pos => pos + 3
            self :> fs_start

    parsing <: fe_start -> parsing
        |: fe_sel and nxt_kind == "string" and nxt2_kind != "string"
        then:
            error => true
            error_msg => "parse error: expected :string" + nxt2_got
            self :> halt

    parsing <: fe_start -> parsing
        |: fe_sel and nxt_kind == "string" and nxt2_kind == "string" and not nxt3_is_arrow
        then:
            error => true
            error_msg => "parse error: expected :glyph \"->\"" + self.tok_got(pos + 3)
            self :> halt

    parsing <: fe_start -> parsing
        |: fe_sel and nxt_kind == "string" and nxt2_kind == "string" and nxt3_is_arrow
        then:
            frames => frames.slice(0, depth).append(self.mk("fent", (("(" + cur_value) + (" \"" + nxt_value)) + (("\" \"" + nxt2_value) + "\""))).append(self.mkop("fsig", "w", "", 0))
            depth => depth + 2
            pos => pos + 4
            self :> fs_start

    parsing <: fe_start -> parsing
        |: fe_type and nxt_kind == "string" and nxt2_kind == "kw" and nxt2_value == "as" and nxt3_kind != "ident"
        then:
            error => true
            error_msg => "parse error: expected :ident" + self.tok_got(pos + 3)
            self :> halt

    parsing <: fe_start -> parsing
        |: fe_type and nxt_kind == "string" and nxt2_kind == "kw" and nxt2_value == "as" and nxt3_kind == "ident"
        then:
            v_ser => (("(type \"" + nxt_value) + ("\" " + nxt3_value)) + ")"
            pos => pos + 4
            self :> fe_add

    parsing <: fe_start -> parsing
        |: fe_type and nxt_kind == "string" and not (nxt2_kind == "kw" and nxt2_value == "as")
        then:
            v_ser => (("(type \"" + nxt_value) + ("\" " + nxt_value)) + ")"
            pos => pos + 2
            self :> fe_add

    parsing <: fe_add -> parsing
        |: top_kind == "fb"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, top.acc + " " + v_ser, top.aux))
            self :> fb_loop

    # parse-foreign-signature, right-associative over `->`. A `fsig`
    # frame holds its left side in `acc`, and "w" in `op` wraps
    # primitives non-nil (wrap-ffi-primitives-nonnil, via `v_w`).
    parsing <: fs_start -> parsing
        |: cur_is_lparen and nxt_is_rparen
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, "TT()", top.aux))
            pos => pos + 2
            self :> fs_after

    parsing <: fs_start -> parsing
        |: not (cur_is_lparen and nxt_is_rparen)
        then: self :> ty_start

    parsing <: ty_ret -> parsing
        |: top_kind == "fsig"
        then:
            frames => frames.slice(0, depth - 1).append(self.retop(top.op, top.ser, top.ekind, top.ops, (||: top.op == "w" : v_w ||: else : v_ser), top.aux))
            self :> fs_after

    parsing <: fs_after -> parsing
        |: cur_is_arrow
        then:
            frames => frames.slice(0, depth).append(self.mkop("fsig", top.op, "", 0))
            depth => depth + 1
            pos => pos + 1
            self :> fs_start

    parsing <: fs_after -> parsing
        |: not cur_is_arrow
        then:
            v_ser => top.acc
            depth => depth - 1
            self :> fs_done

    parsing <: fs_done -> parsing
        |: top_kind == "fsig"
        then:
            v_ser => (("TF(" + top.acc) + ("," + v_ser)) + ")"
            depth => depth - 1
            self :> fs_done

    parsing <: fs_done -> parsing
        |: top_kind == "fent"
        then:
            v_ser => (top.ser + " ") + (v_ser + ")")
            depth => depth - 1
            self :> fe_add

    parsing <: fs_done -> parsing
        |: top_kind == "fld"
        then: self :> ty_ret
