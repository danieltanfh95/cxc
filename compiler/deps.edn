{:paths ["src" "resources"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.0"}
         instaparse/instaparse {:mvn/version "1.5.0"}
         org.clojure/data.json {:mvn/version "2.5.1"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]}
  :nrepl {:extra-deps  {nrepl/nrepl {:mvn/version "1.3.0"}}
          :extra-paths ["test"]}
  ;; clj -M:kondo   →  lint src + test with clj-kondo (pinned version).
  ;; Currently zero warnings; keep it that way.
  :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
          :main-opts  ["-m" "clj-kondo.main" "--lint" "src" "test"]}}}
