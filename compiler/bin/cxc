#!/usr/bin/env bash
# cxc — unified entry point for the cxc toolchain.
#
#   cxc compile <input.cxc-or-dir> <out-dir> [--target=<name>] [--trace]
#   cxc trace   <file.jsonl> [--top=N] [--silent-clock]
#   cxc view    [<trace.jsonl>] [--port=N]
#   cxc help    [<subcommand>]
#
# Runs `clj -M -m cxc.core "$@"` from the compiler directory so that
# resources/prelude, deps.edn, etc. resolve regardless of where you
# invoke `cxc` from. Absolute-path any positional args pointing at
# files so they still resolve after we cd.

set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
COMPILER_DIR="$(cd "$HERE/.." && pwd)"

# Rewrite positional args to absolute paths, so `cxc` works from any cwd.
# Existing files are absolute-ized against their directory; not-yet-existing
# positional PATHS (e.g. the output directory for `cxc compile <in> <out-dir>`)
# are absolute-ized against the invoking cwd so `cxc compile in.cxc out`
# lands `out/` under the caller's cwd, not under $COMPILER_DIR.
# Flags (--target=..., --trace, etc.) pass through unchanged.
# The first arg (subcommand: compile/trace/view/help) always passes through.
INVOKING_CWD="$(pwd)"
rewritten=()
argi=0
for arg in "$@"; do
  if [[ "$argi" -eq 0 ]] || [[ "$arg" == --* ]] || [[ "$arg" == -* ]]; then
    rewritten+=("$arg")
  elif [ -e "$arg" ]; then
    rewritten+=("$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")")
  elif [[ "$arg" == /* ]]; then
    rewritten+=("$arg")
  else
    rewritten+=("$INVOKING_CWD/$arg")
  fi
  argi=$((argi+1))
done

cd "$COMPILER_DIR"

# Try the persistent compile daemon for `cxc compile ...` when the socket is
# live. Falls back to a cold `clj` on any error so correctness never depends
# on the daemon being up. Opt out with CXC_NO_DAEMON=1.
SOCK="${CXC_DAEMON_SOCK:-/tmp/cxc-daemon.sock}"
if [[ "${rewritten[0]:-}" == "compile" ]] \
   && [[ "${CXC_NO_DAEMON:-0}" != "1" ]] \
   && [ -S "$SOCK" ]; then
  # Build JSON request. args[] excludes the "compile" subcommand itself.
  payload=$(python3 - "${rewritten[@]:1}" <<'PY' 2>/dev/null
import json, sys
print(json.dumps({"cmd": "compile", "args": sys.argv[1:]}))
PY
)
  if [ -n "$payload" ]; then
    resp=$(printf '%s\n' "$payload" | nc -U "$SOCK" 2>/dev/null)
    if [ -n "$resp" ]; then
      # Parse { exit, stdout, stderr }
      exit_code=$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(d.get('exit',1))" "$resp" 2>/dev/null)
      if [ -n "$exit_code" ]; then
        python3 -c "import json,sys; d=json.loads(sys.argv[1]); sys.stdout.write(d.get('stdout','')); sys.stderr.write(d.get('stderr',''))" "$resp"
        exit "$exit_code"
      fi
    fi
    # If we reach here, daemon call failed. Fall through to cold start below.
  fi
fi

exec clj -M -m cxc.core "${rewritten[@]}"
