def main:
    use console: Console
    -> running
        let a: Int = -7
        let b: Int = 3
        let c: Int = 10
        console.write(a.abs().to_string())
        console.write(b.abs().to_string())
        console.write(a.min(b).to_string())
        console.write(a.max(b).to_string())
        console.write(b.min(c).to_string())
        console.write(b.max(c).to_string())
