def Counter:
    raw_n: Int = 0
    max:   Int = 3

    n :< raw_n

    -> alive
        do:
            self |> bump
            self |> bump
            self |> bump
            self |> bump

    alive <: bump when: raw_n < max -> alive
        then: raw_n => raw_n + 1

def main:
    -> running
        do: print(Counter().n)
