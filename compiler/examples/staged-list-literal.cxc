def R:
    xs: List of Int = [1]
    -> idle
    idle <: reset -> ready
        xs => [10, 20, 30]
    -> ready

def main:
    use console: Console
    r: R! = R()
    -> running
        |> r.reset()
        console.write((r.xs.at(0) ?? 0).to_string())
        console.write((r.xs.at(1) ?? 0).to_string())
        console.write((r.xs.at(2) ?? 0).to_string())
    -> end
