def Thing:
    case alpha
    case beta(v: Int!)

def R:
    xs: List of Thing = [Thing.alpha, Thing.beta(v: 7), Thing.beta(v: 42)]
    -> running

def main:
    r: R! = R()
    -> running
        then:
            let t: Thing = r.xs.at(1) ?? Thing.alpha
            t:
                <: alpha:
                    print(0)
                <: beta(v: let i):
                    print(i)
    -> end
