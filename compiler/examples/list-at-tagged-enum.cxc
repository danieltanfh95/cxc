def Thing:
    case alpha
    case beta(v: Int!)

def R:
    xs: List of Thing = [Thing.alpha, Thing.beta(v: 7), Thing.beta(v: 42)]
    -> running

def main:
    use console: Console
    r: R! = R()
    -> running
        let t: Thing = r.xs.at(1) ?? Thing.alpha
        t:
            <: alpha:
                console.write((0).to_string())
            <: beta(v: let i):
                console.write(i.to_string())
    -> end
