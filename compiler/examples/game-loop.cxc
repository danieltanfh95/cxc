def main:
    clock: Clock = Clock()
    input: TestKeyboardInput = TestKeyboardInput(events: 2)

    n: Int = 0
    ticks: Int = 0

    -> running

    -> end
        do: print(n)

    running <: clock.every(rate_ms: 5){t: Instant} -> running
        when: ticks < 4
        then:
            n => n + 1
            ticks => ticks + 1

    running <: input.pressed{key: Int} -> running
        then: n => n + 1

    running <: input.done -> running

    running <: clock.every(rate_ms: 5){t: Instant} -> end
        when: ticks == 4
