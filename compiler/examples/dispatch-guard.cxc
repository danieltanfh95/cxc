def Level:
    case low
    case medium
    case high

def main:
    use console: Console
    -> running
        let l: Level = Level.medium
        let strict: Bool = true
        l:
            <: high when: strict:
                console.write((9).to_string())
            <: medium when: strict:
                console.write((5).to_string())
            <: *:
                console.write((0).to_string())
