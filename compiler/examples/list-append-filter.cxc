def main:
    use console: Console
    xs: List of Int = [1, 2, 3, 4, 5]

    -> running
        let ys: List of Int = xs.append(6)
        let evens: List of Int = xs.filter(x => x % 2 == 0)
        let large: List of Int = ys.filter(x => x > 3)

        console.write("xs.count:    " + xs.count.to_string())
        console.write("ys.count:    " + ys.count.to_string())
        console.write("evens.count: " + evens.count.to_string())
        console.write("large.count: " + large.count.to_string())
        console.write("ys[5]:       " + (ys.at(5) ?? -1).to_string())
        console.write("xs[5]:       " + (xs.at(5) ?? -1).to_string())
        console.write("evens[0]:    " + (evens.at(0) ?? -1).to_string())
        console.write("evens[1]:    " + (evens.at(1) ?? -1).to_string())
        console.write("large[0]:    " + (large.at(0) ?? -1).to_string())
