def Msg:
    case ping
    case pong(seq: Int32!)

def R:
    msg: Msg!

def main:
    -> running
        # F37 L6 tagged-enum extension — round-trip on a record with
        # a tagged enum field. `R(msg: Msg.pong(seq: 42)).as()`
        # produces 1 discriminator byte + 4 payload bytes = 5 bytes.
        # `R.from(source: b)` reads the discriminator, range-checks
        # against case count 2, writes the tag, then dispatches to
        # the per-case payload decoder into `.data.pong.seq`.
        # DecodeOutcome discarded; `b.length` prints 5.
        then:
            let b: Bytes = R(msg: Msg.pong(seq: 42)).as()
            R.from(source: b)
            print(b.length)
