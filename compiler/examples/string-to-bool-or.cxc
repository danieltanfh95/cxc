def main:
    use console: Console
    -> running
        console.write("true".to_bool_or(false).to_string())
        console.write("false".to_bool_or(true).to_string())
        console.write("TRUE".to_bool_or(false).to_string())
        console.write("yes".to_bool_or(false).to_string())
        console.write("no".to_bool_or(true).to_string())
        console.write("1".to_bool_or(false).to_string())
        console.write("0".to_bool_or(true).to_string())
        console.write("on".to_bool_or(false).to_string())
        console.write("Off".to_bool_or(true).to_string())
        console.write("garbage".to_bool_or(true).to_string())
        console.write("garbage".to_bool_or(false).to_string())
        console.write("".to_bool_or(true).to_string())
