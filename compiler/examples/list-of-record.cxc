def Pair:
    x: Int!
    y: Int!

def main:
    use console: Console
    pairs: List of Pair = [
        Pair(x: 1, y: 10),
        Pair(x: 2, y: 20),
        Pair(x: 3, y: 30)
    ]

    -> running
        console.write(pairs.count.to_string())
        pairs.for_each(p => console.write((p.x + p.y).to_string()))
