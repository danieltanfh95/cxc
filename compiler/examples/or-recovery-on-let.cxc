def Boom:
    msg: String

def Wrapper:
    label: String = "boom-happened"

    might_fail() :- Int
        raise Boom(msg: label)

    -> ready

def main:
    use console: Console
    w: Wrapper = Wrapper()

    -> running
        let x: Int = w.might_fail()
        or Boom(msg: let m):
            console.write(m.to_string())
            -1
        console.write(x.to_string())

    -> end
