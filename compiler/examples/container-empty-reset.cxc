def R:
    xs: List of Int = [1, 2]
    m: Map of (String, Int)
    s: Set of String
    -> idle
    idle <: wipe -> ready
        xs => xs.empty()
        m => m.empty()
        s => s.empty()
    -> ready

def main:
    use console: Console
    r: R! = R()
    -> running
        |> r.wipe()
        console.write(r.xs.count.to_string())
        console.write(r.m.count.to_string())
        console.write(r.s.count.to_string())
    -> end
