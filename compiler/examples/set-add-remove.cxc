def main:
    use console: Console
    s: Set of String

    -> running
        alias s2 :- s.insert("alpha").insert("beta").insert("alpha").without("beta")
        s => s2
        console.write(s2.count.to_string())
        console.write((s2.contains("alpha")).to_string())
        console.write((s2.contains("beta")).to_string())

    -> end
