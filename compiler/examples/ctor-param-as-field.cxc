def Counter(start: Int!):
    n: Int! = start

    -> running

    running <: bump -> running
        |: n < start + 3
        n => n + 1

def main:
    c: Counter = Counter(start: 10)

    -> running
        |> c.bump()
        |> c.bump()
        |> c.bump()
        print(c.n)
        print(c.start)
