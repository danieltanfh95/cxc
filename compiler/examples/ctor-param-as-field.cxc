def Counter(start: Int!):
    n: Int! = start

    -> running

    running <: bump -> running
        |: n < start + 3
        n => n + 1

def main:
    use console: Console
    c: Counter = Counter(start: 10)

    -> running
        |> c.bump()
        |> c.bump()
        |> c.bump()
        console.write(c.n.to_string())
        console.write(c.start.to_string())
