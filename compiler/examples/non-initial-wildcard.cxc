def Machine:
    data:
        raw_n: Int = 0

    n :< raw_n

    -> ready
        do:
            self |> arm
            self |> fire

    # Wildcard on `armed`: sets n to 100 on entry.
    # Fires when `arm` transitions us in — not on init (init lands us in `ready`).
    -> armed
        then: raw_n => 100

    ready <: arm  -> armed
    armed <: fire -> done
        then: raw_n => raw_n + 1

def main:
    -> running
        do: print(Machine().n)
