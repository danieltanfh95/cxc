def Machine:
    raw_n: Int = 0

    n :- raw_n

    -> ready
        |> self.arm()
        |> self.fire()

    # Wildcard on `armed`: sets n to 100 on entry.
    # Fires when `arm` transitions us in — not on init (init lands us in `ready`).
    -> armed
        raw_n => 100

    ready <: arm  -> armed
    armed <: fire -> done
        raw_n => raw_n + 1

def main:
    use console: Console
    -> running
        console.write((Machine().n).to_string())
