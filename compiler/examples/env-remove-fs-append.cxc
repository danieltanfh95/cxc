def main:
    use env_vars: EnvVars
    use env_mut:  EnvMut
    use fs:       FileSystem
    use console:  Console

    -> running
        then:
            env_mut.set("CXC_REMOVE_ME", "temp")
            let got1: String = env_vars.get_or("CXC_REMOVE_ME", "GONE")
            env_mut.remove("CXC_REMOVE_ME")
            let got2: String = env_vars.get_or("CXC_REMOVE_ME", "GONE")
            console.write("before_rm: " + got1)
            console.write("after_rm: " + got2)
            let path: String = "/tmp/cxc-append-example.log"
            let _rm_file: Bool = fs.remove(path)
            let ap1: Int = fs.append_text(path, "line one\n")
            let ap2: Int = fs.append_text(path, "line two\n")
            let contents: String = fs.read_text(path)
            let _cleanup: Bool = fs.remove(path)
            console.write("append_rc1: " + ap1.to_string())
            console.write("append_rc2: " + ap2.to_string())
            console.write("read_back: " + contents)

    -> end
