def Foo(k: Int!):
    scale :- Int! = k * 2
    -> running

def R:
    xs: List of Int = [-1, 0 - 7, Foo(k: 3).scale, 42]
    -> running

def main:
    use console: Console
    r: R! = R()
    -> running
        console.write((r.xs.at(0) ?? 0).to_string())
        console.write((r.xs.at(1) ?? 0).to_string())
        console.write((r.xs.at(2) ?? 0).to_string())
        console.write((r.xs.at(3) ?? 0).to_string())
    -> end
