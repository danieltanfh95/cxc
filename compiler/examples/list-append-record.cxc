def Pair:
    x: Int!
    y: Int!

def main:
    use console: Console
    seed:  List of Pair = [Pair(x: 1, y: 10)]
    grown: List of Pair = seed.append(Pair(x: 2, y: 20))
    two:   List of Pair = grown.append(Pair(x: 3, y: 30))

    -> running
        console.write(two.count.to_string())
        two.for_each(p => console.write((p.x + p.y).to_string()))
