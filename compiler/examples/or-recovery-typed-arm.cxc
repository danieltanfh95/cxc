def MyError:
    msg: String

def R:
    n: Int! = 0
    |: n < 3 as MyError(msg: "boom")

    -> running

    running <: pulse -> running
        n => n + 1

def main:
    use console: Console
    r: R = R()
    -> running
        |> r.pulse()
        |> r.pulse()
        |> r.pulse()
        or MyError(msg: let m):
            console.write(m.to_string())
