def main:
    use console: Console
    flags: Map of (String, Bool)

    -> running
        alias next_flags :- flags.assoc("verbose", true).assoc("dry_run", false)
        flags => next_flags
        console.write((next_flags.get("verbose") ?? false).to_string())
        console.write((next_flags.get("dry_run") ?? true).to_string())
        console.write((next_flags.get("missing") ?? true).to_string())
        console.write((next_flags.get("missing") ?? false).to_string())

    -> end
