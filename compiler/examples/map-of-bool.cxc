def main:
    flags: Map of (String, Bool)

    -> running
        then:
            flags => flags.assoc("verbose", true).assoc("dry_run", false)
            print((flags.get("verbose") ?? false).to_string())
            print((flags.get("dry_run") ?? true).to_string())
            print((flags.get("missing") ?? true).to_string())
            print((flags.get("missing") ?? false).to_string())

    -> end
