def main:
    flags: Map of (String, Bool)

    -> running
        then:
            flags.add("verbose", true)
            flags.add("dry_run", false)
            print(flags.get_or("verbose", false).to_string())
            print(flags.get_or("dry_run", true).to_string())
            print(flags.get_or("missing", true).to_string())
            print(flags.get_or("missing", false).to_string())

    -> end
