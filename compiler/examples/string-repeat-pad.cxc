def main:
    use console: Console
    -> running
        console.write("=".repeat(5).length().to_string())
        console.write("ab".repeat(3).length().to_string())
        console.write("x".repeat(0).length().to_string())
        console.write("5".pad_left(3, "0"))
        console.write("hello".pad_left(3, "0"))
        console.write("5".pad_right(3, "."))
        console.write("hello".pad_right(3, "."))
        console.write("abc".pad_left(6, " ").length().to_string())
        console.write("abc".pad_right(6, " ").length().to_string())
