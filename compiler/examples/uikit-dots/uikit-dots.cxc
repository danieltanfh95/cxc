# uikit-dots — tap-anywhere paint toy. Three plugins: canvas
# (bitmap-free drawing surface + multi-touch stream), audio
# (AVAudioPlayer SFX), prefs (NSUserDefaults persistence).
#
# Each touch drops a colored circle, plays a beep, and bumps the
# lifetime counter persisted via prefs. Drag paints a smaller
# trail. The counter survives app relaunch.

from canvas import Canvas
from audio import Audio
from prefs import Prefs

def main:
    use canvas: Canvas
    use audio:  Audio
    use prefs:  Prefs

    total_dots: Int32! = 0

    -> running
    running <: did_launch(window: Any!) -> playing
        canvas.install(window)
        canvas.clear(20, 20, 24)
        audio.load("beep", "beep.wav")
        total_dots => prefs.get_int("total_dots", 0)

    playing <: on_touch_begin(id: Int32!, x: Int32!, y: Int32!) -> playing
        canvas.fill_circle(x, y, 22,
                           ((total_dots + 1) * 53 + 90) % 180 + 60,
                           ((total_dots + 1) * 97 + 30) % 180 + 60,
                           ((total_dots + 1) * 29 + 150) % 180 + 60)
        audio.play("beep")
        total_dots => total_dots + 1
        prefs.set_int("total_dots", total_dots + 1)

    playing <: on_touch_move(id: Int32!, x: Int32!, y: Int32!) -> playing
        canvas.fill_circle(x, y, 10,
                           ((total_dots + 1) * 53 + 90) % 180 + 60,
                           ((total_dots + 1) * 97 + 30) % 180 + 60,
                           ((total_dots + 1) * 29 + 150) % 180 + 60)
        total_dots => total_dots + 1
        prefs.set_int("total_dots", total_dots + 1)
