def main:
    use args:    Args
    use env:     Env
    use http:    Http
    use json:    Json
    use console: Console

    -> running
        then:
            let task: String = args.get_or(1, "Say hello in one word")
            let key:  String = env.get_or("ANTHROPIC_API_KEY", "")
            let model: String = env.get_or("ANTHROPIC_MODEL", "claude-haiku-4-5-20251001")
            let headers: String = "{\"x-api-key\":" + json.encode_str(key) + ",\"anthropic-version\":\"2023-06-01\",\"content-type\":\"application/json\"}"
            let body: String = "{\"model\":" + json.encode_str(model) + ",\"max_tokens\":128,\"messages\":[{\"role\":\"user\",\"content\":" + json.encode_str(task) + "}]}"
            let envelope: String = http.post_envelope("https://api.anthropic.com/v1/messages", headers, body)
            let status: Int = json.field_int_or(envelope, "status", -1)
            let resp: String = json.field_string(envelope, "body")
            let ok: String = ||: status == 200 : "ok" ||: else : "http " + status.to_string()
            let stop: String = json.field_string(resp, "stop_reason")
            let type_field: String = json.field_string(resp, "type")
            let in_tok:  Int = json.field_int_or(resp, "input_tokens", 0)
            let out_tok: Int = json.field_int_or(resp, "output_tokens", 0)
            let text_key: String = "\"text\":\""
            let text_at: Int = resp.index_of(text_key)
            let after_start: Int = text_at + text_key.length()
            let tail: String = resp.substring(after_start, resp.length() - after_start)
            let close_offset: Int = tail.index_of("\"")
            let claude_text: String = ||: text_at >= 0 : resp.substring(after_start, close_offset) ||: else : "(no text field)"
            console.write("task: " + task)
            console.write("model: " + model)
            console.write("http: " + ok)
            console.write("stop_reason: " + stop)
            console.write("type: " + type_field)
            console.write("input_tokens: " + in_tok.to_string())
            console.write("output_tokens: " + out_tok.to_string())
            console.write("claude: " + claude_text)

    -> end
