def main:
    use env: Env

    -> running
        then:
            let _s1: Int = env.set("MY_PORT", "8080")
            let _s2: Int = env.set("MY_FLAG", "true")
            let _s3: Int = env.set("MY_BAD", "not-a-number")

            print(env.get_or_int("MY_PORT", -1).to_string())
            print(env.get_or_int("MY_MISSING", 42).to_string())
            print(env.get_or_int("MY_BAD", 99).to_string())

            print(env.get_or_bool("MY_FLAG", false).to_string())
            print(env.get_or_bool("MY_MISSING", true).to_string())
            print(env.get_or_bool("MY_BAD", false).to_string())
