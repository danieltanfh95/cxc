def Emitter(seed: Int):
    data:
        val: Int = seed

    -> running
        do: :> beep(v: val)

    -> end

def main:
    def clock: Clock

    data:
        xs: List of Emitter = [Emitter(seed: 10), Emitter(seed: 20)]
        total: Int = 0
        bound_ticks: Int = 0

    -> running

    -> end
        do: print(total)

    running <: xs.beep{e: Emitter, v: Int} -> running
        then:
            total => total + v

    running <: clock.every(rate_ms: 50){t: Instant} -> running
        when: bound_ticks == 0
        then: bound_ticks => bound_ticks + 1

    running <: clock.every(rate_ms: 50){t: Instant} -> end
        when: bound_ticks >= 1
