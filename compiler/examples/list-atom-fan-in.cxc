def Emitter(seed: Int!):
    val: Int! = seed

    -> running
        :> beep(v: val)

    -> end

def main:
    use console: Console
    clock: Clock = Clock()

    xs: List of Emitter = [Emitter(seed: 10), Emitter(seed: 20)]
    total: Int! = 0
    bound_ticks: Int! = 0

    -> running

    -> end
        console.write(total.to_string())

    running <: xs.beep(e: Emitter, v: Int) -> running
        total => total + v

    running <: clock.every(rate_ms: 50)(t: Instant) -> running
        |: bound_ticks == 0
        bound_ticks => bound_ticks + 1

    running <: clock.every(rate_ms: 50)(t: Instant) -> end
        |: bound_ticks >= 1
