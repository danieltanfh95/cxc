# hickey-cycle-271 (2026-11-20) — D (grouped transition arms).
#
# Shape:
#   <source> <: <msg>(<args>):
#       |: <guard>  -> <target>  then: <body>
#       |: <guard2> -> <target2> then: <body2>
#       |: else     -> <target3> then: <body3>
#
# Pure parse-time sugar. Lowers to today's N-arm form:
#   <source> <: <msg>(<args>) -> <target>  |: <guard>  then: <body>
# (one transition node per arm, each inheriting the group's shared
# source + receive).
#
# Expected output:
#   fire shot=5 -> firing
#   fire shot=0 -> dry
#   fire shot=-3 -> error

def main:
    -> idle
        self :> fire(shot: 5)
        self :> fire(shot: 0)
        self :> fire(shot: -3)
        self :> finish

    idle <: fire(shot: Int!):
        |: shot > 0  -> idle then: print("fire shot=" + shot.to_string() + " -> firing")
        |: shot == 0 -> idle then: print("fire shot=" + shot.to_string() + " -> dry")
        |: else      -> idle then: print("fire shot=" + shot.to_string() + " -> error")

    idle <: finish -> end
