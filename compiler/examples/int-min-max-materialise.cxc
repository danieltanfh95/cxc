def R:
    a: Int! = 7
    b: Int! = 3
    -> running

def main:
    use console: Console
    r: R! = R()
    -> running
        console.write((r.a.min(r.b)).to_string())
        console.write((r.a.max(r.b)).to_string())
        console.write(((0 - 5).abs()).to_string())
        console.write((r.a.min(r.a + r.b).max(r.a - r.b)).to_string())
    -> end
