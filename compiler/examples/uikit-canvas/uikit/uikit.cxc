# uikit module — the smallest useful UIKit cxc binding. Pairs with
# libuikit.m next to it; cxc compile's directory mode auto-discovers
# the .m and co-compiles it with the generated code.
#
# API model: the user calls `uikit.init(window)` from `did_launch`
# to hand the UIWindow to the shim. Everything else reads from the
# shim's cached window, so arms that fire later (`on_tap`, periodic
# timers) can paint without threading the window field themselves.

def plugin:
    name:    String!       = "uikit"
    version: SemVer!       = SemVer(0, 1, 0)
    compat:  VersionRange! = VersionRange(min: SemVer(1, 0, 0),
                                          max: SemVer(2, 0, 0))

    foreign "cxc_uikit":
        symbol "cxc_uikit_init"                 -> (Any) -> Int32
        symbol "cxc_uikit_paint_background"     -> (Int32, Int32, Int32) -> Int32
        symbol "cxc_uikit_paint_label"          -> (CString, Int32, Int32, Int32) -> Int32
        symbol "cxc_uikit_install_tap_handler"  -> () -> Int32

def UIKit:
    use plugin: Plugin

    init(window: Any!) :- plugin.get("cxc_uikit_init")(window)

    paint_background(r: Int32!, g: Int32!, b: Int32!) :- plugin.get("cxc_uikit_paint_background")(r, g, b)

    paint_label(text: String!, r: Int32!, g: Int32!, b: Int32!) :- plugin.get("cxc_uikit_paint_label")(text, r, g, b)

    install_tap_handler() :- plugin.get("cxc_uikit_install_tap_handler")()
