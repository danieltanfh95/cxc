# uikit-canvas — a cxc program that owns its own window content.
#
# did_launch(window: Any!) fires once UIApplication has handed the
# UIWindow to the delegate. The main atom paints a teal background
# and places a label — all via the UIKit cap, zero ObjC in this file.

from uikit import UIKit

def main:
    use uikit: UIKit

    -> running
    running <: did_launch(window: Any!) -> painted
        then:
            uikit.set_window_background(window, 30, 120, 140)
            uikit.set_root_label(window, "hello from cxc", 240, 240, 240)
            print("uikit-canvas: painted")
    painted <: will_resign -> painted
        then: print("uikit-canvas: will_resign")
    painted <: did_activate -> painted
        then: print("uikit-canvas: did_activate")
