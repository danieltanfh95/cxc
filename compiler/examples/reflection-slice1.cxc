# §4.18.3 slice 1 — runtime metadata queries. The Reflection cap is
# shipped in the prelude (target/shared/reflection.cxc); it dispatches
# into compile-emitted lookup tables (emit.clj reflection-table block)
# that enumerate every user-authored class and record plus the prelude's
# shared records. Slice 1 ships names only; methods / invariants /
# conformances land in later slices.

def Garden:
    plot_count: Int! = 9
    seed:       Int! = 42
    name:       String! = "home"

def Counter:
    n: Int! = 0

    doubled() :- self.n * 2
    label()   :- "counter"

    -> running
    -> end

def main:
    use console: Console
    use r: Reflection

    -> running
        console.write((r.field_names_of("Garden")).to_string())
        console.write("---")
        console.write((r.field_names_of("SemVer")).to_string())
        console.write("---")
        console.write("[" + r.field_names_of("DoesNotExist") + "]")
        console.write("---")
        console.write((r.class_names.contains("Garden")).to_string())
        console.write((r.class_names.contains("SemVer")).to_string())
        console.write((r.class_names.contains("Nope")).to_string())
        console.write("---")
        console.write((r.method_names_of("Counter")).to_string())
        console.write("---")
        console.write("[" + r.method_names_of("Garden") + "]")

    -> end
