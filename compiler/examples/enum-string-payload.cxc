def Msg:
    case text(s: String!)
    case ping

def main:
    use console: Console
    -> running
        let a: Msg = Msg.text(s: "hello world")
        let b: Msg = Msg.ping
        a:
            <: text(s: let x):
                console.write(x.to_string())
            <: ping:
                console.write("no-payload")
        b:
            <: text(s: let y):
                console.write(y.to_string())
            <: ping:
                console.write("pong")
    -> end
