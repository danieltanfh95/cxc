def main:
    use console: Console
    use json: Json

    -> running
        let doc: String = "{\"name\":\"claude\",\"tools\":[{\"name\":\"bash\",\"input\":{\"cmd\":\"ls\"}}]}"
        console.write((json.field_string_or(doc, "name", "?")).to_string())
        console.write((json.field_string_or(doc, "missing", "fallback")).to_string())
        console.write((json.field_string_or_path(doc, "tools.0.name", "?")).to_string())
        console.write((json.field_string_or_path(doc, "tools.0.input.cmd", "?")).to_string())
        console.write((json.field_string_or_path(doc, "tools.9.name", "not-there")).to_string())
        console.write((json.field_string_or_path(doc, "does.not.exist", "fallback")).to_string())
