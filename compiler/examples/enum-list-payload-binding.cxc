def Leaf:
    id: Int!

def Tree:
    case root
    case branch(items: List of Leaf)

def R:
    xs: List of Leaf = [Leaf(id: 7), Leaf(id: 11)]
    -> running

def main:
    use console: Console
    r: R! = R()
    -> running
        let a: Tree = Tree.branch(items: r.xs)
        a:
            <: root:
                console.write((0).to_string())
            <: branch(items: let xs):
                console.write(xs.count.to_string())
    -> end
