def JsonValue:
    case null_v
    case bool_v(v: Bool!)
    case int_v(v: Int!)
    case list_v(items: List of JsonValue)

def R:
    xs: List of JsonValue = [JsonValue.int_v(v: 1), JsonValue.int_v(v: 2), JsonValue.int_v(v: 3)]
    -> running

def main:
    use console: Console
    r: R! = R()
    -> running
        let a: JsonValue = JsonValue.list_v(items: r.xs)
        a:
            <: null_v:
                console.write((0).to_string())
            <: bool_v(v: let _b):
                console.write((0).to_string())
            <: int_v(v: let i):
                console.write(i.to_string())
            <: list_v(items: let xs):
                console.write(xs.count.to_string())
    -> end
