def Warmth:
    case red
    case orange
    case yellow
    case blue
    case purple
    case green

def main:
    use console: Console
    -> running
        let c: Warmth = Warmth.orange
        c:
            <: red, orange, yellow:
                console.write((1).to_string())
            <: blue, purple:
                console.write((2).to_string())
            <: *:
                console.write((0).to_string())
