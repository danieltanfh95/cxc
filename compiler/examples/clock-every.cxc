def main:
    def clock: Clock

    data:
        beats: Int = 0

    -> running

    -> end
        do: print(beats > 0)

    running <: clock.every(rate_ms: 5){t: Instant} -> running
        when: beats < 1
        then: beats => beats + 1

    running <: clock.every(rate_ms: 5){t: Instant} -> end
        when: beats == 1
