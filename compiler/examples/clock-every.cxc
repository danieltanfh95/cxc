def main:
    use console: Console
    clock: Clock = Clock()

    beats: Int! = 0

    -> running

    -> end
        console.write((beats > 0).to_string())

    running <: clock.every(rate_ms: 5)(t: Instant) -> running
        |: beats < 1
        beats => beats + 1

    running <: clock.every(rate_ms: 5)(t: Instant) -> end
        |: beats == 1
