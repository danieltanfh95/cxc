def main:
    use console: Console
    m: Map of (Int, String)

    -> running
        alias m2 :- m.assoc(200, "ok").assoc(404, "not-found").assoc(500, "error")
        m => m2
        console.write((m2.get(200) ?? "?").to_string())
        console.write((m2.get(404) ?? "?").to_string())
        console.write((m2.get(418) ?? "?").to_string())
