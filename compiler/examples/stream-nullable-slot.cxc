def Emitter:
    -> running
        self :> fire

    -> end
        :> beep

    running <: fire -> end

def main:
    use console: Console
    source: Emitter = nil

    -> running
        self :> setup

    -> end
        console.write((9).to_string())

    running <: setup -> awaiting
        source => Emitter()

    awaiting <: source.beep -> end
