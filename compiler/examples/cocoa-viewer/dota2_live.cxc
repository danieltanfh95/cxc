# dota2_live.cxc — Pocket MOBA sim with a snapshot-based visual layer.
#
# The sim body is a verbatim copy of ../cards.cxc (dota2 repo). The
# viewer layer adds one Renderer sub-atom that walks the sim state at
# each phase boundary and writes a PNG under /tmp/dota2-frames/. Byte
# parity with cards.cxc's Python-parity output is preserved.
#
# Why snapshot-only: an earlier iteration tried to drive a live
# NSWindow via cv_present + cv_next_key. That path is unworkable in
# the current Corvid runtime — see libcocoa_viewer.m's header comment
# for the four-way threading dead end. Preview.app + arrow keys is
# the substitute UX.
#
# Build:  ./build.sh dota2_live.cxc
# Run:    mkdir -p /tmp/dota2-frames && /tmp/cocoa-viewer-out/dota2_live
# Watch:  ./watch           # runs the sim then opens PNGs in Preview

def plugin:
    name:    String!       = "cocoa_viewer"
    version: SemVer!       = SemVer(0, 2, 0)
    compat:  VersionRange! = VersionRange(min: SemVer(1, 0, 0),
                                          max: SemVer(2, 0, 0))

    foreign "cocoa_viewer":
        symbol "cv_open_offscreen" -> (Int32, Int32) -> Int32
        symbol "cv_clear"          -> (Int32, Int32, Int32) -> Int32
        symbol "cv_rect"           -> (Int32, Int32, Int32, Int32, Int32, Int32, Int32) -> Int32
        symbol "cv_line"           -> (Int32, Int32, Int32, Int32, Int32, Int32, Int32) -> Int32
        symbol "cv_text"           -> (Int32, Int32, CString, Int32, Int32, Int32, Int32) -> Int32
        symbol "cv_snapshot"       -> (CString) -> Int32

def CardType:
    case hero
    case neutral
    case item
    case scroll

# A side-scoped deploy effect on a Card. `EffectKind.none` means "no
# effect at this timing", so every card carries Effect values without a
# nullable wrapper.
def EffectKind:
    case none
    # Side-scoped deploy effects (Lane consumes these).
    case damage_all
    case heal_all
    case silence_all
    case buff_all
    case clear_all
    case attach_thorn_all
    # Cross-lane / deploy-orchestration effects (Player consumes these).
    case cross_damage_all           # Storm Spirit  — damage every other lane
    case move_from_next_lane_front  # Blink Blade   — pull the next lane's front unit onto this lane
    case draw_n_discard_weakest     # Occultist     — draw `.amount` cards then discard the weakest
    # Combat-time modifiers (PlayableUnit / Lane read these on `.combat_effect`).
    case damage_cap      # cap incoming damage at `.amount`
    case reflect_bonus   # attacker takes an extra `.amount` damage
    case attack_bypass   # front attacker skips the enemy front and hits behind
    case tower_bonus     # front attacker adds `.amount` to tower damage

def EffectScope:
    case own_side
    case enemy_side

# DeployEffect fires at deploy time and targets one side of the lane
# (its own or the enemy). CombatEffect fires during combat / tower
# resolution and modifies the card's own attack or defence — scope is
# not meaningful, so it isn't carried.
def DeployEffect:
    kind:   EffectKind
    scope:  EffectScope
    amount: Int!

def CombatEffect:
    kind:   EffectKind
    amount: Int!

def Card:
    name:       String
    type:       CardType
    attack:     Int!
    hp:         Int!
    coin:       Int!
    pre_deploy:    DeployEffect!  # fires before the unit lands (Fallen Warlock's clear)
    on_deploy:     DeployEffect!  # fires after the unit lands (Blood Demon, Satyr Torturer, ...)
    combat_effect: CombatEffect!  # combat-time modifier (Marksman bypass, Faerie Dragon cap, ...)

# Per-player hand. `begin_draw` pulls from Deck until the hand holds 3
# cards or Deck runs dry, then emits `draw_done`. Deck broadcasts
# `drew_hand` to both hands, so each keeps only its own seat's draws.
def Hand(deck: Deck, owner_seat: Int!):
    cards: List of Card = []

    -> idle

    idle <: begin_draw -> drawing
        then: self :> pull

    drawing <: pull -> drawing
        |: cards.count < 3
        then: |> deck.try_draw_hand(seat: owner_seat)

    drawing <: pull -> idle
        then: :> draw_done

    drawing <: deck.drew_hand(card: Card, seat: Int!) -> drawing
        |: seat == owner_seat
        then:
            cards => cards.append(card)
            self :> pull

    drawing <: deck.drew_hand(card: Card, seat: Int!) -> drawing

    drawing <: deck.hand_empty(seat: Int!) -> idle
        |: seat == owner_seat
        then: :> draw_done

    drawing <: deck.hand_empty(seat: Int!) -> drawing

    # Cards come back from lanes and leave on deploy or discard, in
    # either phase.
    * <: append(card: Card) -> self
        then: cards => cards.append(card)

    * <: remove_by_name(name: String) -> self
        then: cards => cards.filter(c => c.name != name)

    -> end

def Player(seat: Int!, deck: Deck, lane0: Lane, lane1: Lane, lane2: Lane):
    hand:               Hand = Hand(deck: deck, owner_seat: seat)
    won:                List of Card = []
    mulligans:          Int! = 0
    total_deploys:      Int! = 0
    total_auction_wins: Int! = 0
    # Every placement ever made, so a destroyed tower does not reopen a
    # quota slot (Python parity).
    towers_placed:      Int! = 0
    towers_lost:        Int! = 0
    # Occultist deploy state: remaining draws, the card that triggered,
    # and the lane its follow-up try_place returns to. Nonzero only
    # mid-Occultist-effect (deploying phase).
    occult_remaining:   Int! = 0
    _no_effect:         DeployEffect! = DeployEffect(kind: EffectKind.none, scope: EffectScope.own_side, amount: 0)
    _no_combat:         CombatEffect! = CombatEffect(kind: EffectKind.none, amount: 0)
    _sentinel_card:     Card!         = Card(name: "?", type: CardType.hero, attack: 0, hp: 0, coin: 0, pre_deploy: _no_effect, on_deploy: _no_effect, combat_effect: _no_combat)
    occult_card:        Card! = _sentinel_card
    occult_lane:        Int! = 0

    -> idle

    # main starts the draw here, and the hand's `draw_done` goes back
    # up as `p_draw_done(seat:)`.
    idle <: begin_draw -> idle
        then: |> hand.begin_draw()

    idle <: hand.draw_done -> idle
        then: :> p_draw_done(seat: seat)

    idle <: win_target(card: Card) -> idle
        then:
            won                => won.append(card)
            total_auction_wins => total_auction_wins + 1

    idle <: inc_towers_lost -> idle
        then: towers_lost => towers_lost + 1

    # Round 0 only: count a mulligan when the hand holds no heroes. The
    # Python reference also redraws the hand, which this port skips.
    idle <: check_mulligan(round: Int!) -> idle
        |: round == 0 and hand.cards.filter(c => c.type == CardType.hero).count == 0
        then: mulligans => mulligans + 1

    idle <: check_mulligan(round: Int!) -> idle

    # Place and record the top card until no placement arm matches
    # (empty hand or no eligible lane), then emit `deploy_done`.
    idle <: begin_deploy_round(dl: Int!) -> deploying
        then: self :> try_place(lane: dl)

    # Storm Spirit fans cross-lane damage: on_deploy.kind is
    # `cross_damage_all` with amount, and the card lands on the rolled
    # lane, with or without a tower there.
    deploying <: try_place(lane: Int!) -> deploying
        |: hand.cards.count > 0 and top_hand.on_deploy.kind == EffectKind.cross_damage_all
        then:
            alias card :- top_hand
            self.others(lane).for_each(l => |> self.lane(l).cross_damage(enemy_team: enemy_seat, amount: card.on_deploy.amount))
            |> self.lane(lane).place_hero(card: card, team: seat)
            self :> record_and_next(card: card, lane: lane)

    # Blink Blade moves this player's first unit in the next lane over
    # onto the rolled lane.
    deploying <: try_place(lane: Int!) -> deploying
        |: hand.cards.count > 0 and top_hand.on_deploy.kind == EffectKind.move_from_next_lane_front and self.lane(self.next_lane(lane)).side(seat).units.count > 0
        then:
            alias src  :- self.next_lane(lane)
            alias unit :- self.lane(src).side(seat).units.at(0)
            alias card :- top_hand
            |> self.lane(lane).place_hero(card: unit.card, team: seat)
            |> self.lane(src).remove_hero_by_name(team: seat, name: unit.card.name)
            self :> record_and_next(card: card, lane: lane)

    # Occultist deploys, then draws 2 cards; deploy loop resumes only
    # after the async draws land and the weakest card is discarded.
    deploying <: try_place(lane: Int!) -> deploying
        |: hand.cards.count > 0 and top_hand.on_deploy.kind == EffectKind.draw_n_discard_weakest and self.first_deployable_lane(lane) >= 0
        then:
            alias slot :- self.first_deployable_lane(lane)
            alias card :- top_hand
            |> self.lane(slot).place_hero(card: card, team: seat)
            occult_card      => card
            occult_remaining => 2
            occult_lane      => lane
            |> deck.try_draw_hand(seat: seat)

    deploying <: try_place(lane: Int!) -> deploying
        |: hand.cards.count > 0 and self.first_deployable_lane(lane) >= 0
        then:
            alias slot :- self.first_deployable_lane(lane)
            alias card :- top_hand
            |> self.lane(slot).place_hero(card: card, team: seat)
            self :> record_and_next(card: card, lane: lane)

    deploying <: try_place(lane: Int!) -> idle
        then: :> deploy_done(seat: seat)

    deploying <: record_and_next(card: Card, lane: Int!) -> deploying
        then:
            total_deploys => total_deploys + 1
            |> hand.remove_by_name(name: card.name)
            :> card_deployed(card: card, seat: seat)
            self :> try_place(lane: lane)

    # Occultist mid-effect: append the freshly-drawn card and pull another.
    deploying <: deck.drew_hand(card: Card, seat: Int!) -> deploying
        |: seat == self.seat and occult_remaining > 1
        then:
            |> hand.append(card: card)
            occult_remaining => occult_remaining - 1
            |> deck.try_draw_hand(seat: self.seat)

    # Occultist final draw: append, then discard the weakest card and
    # finish the deploy as `record_and_next` would.
    deploying <: deck.drew_hand(card: Card, seat: Int!) -> deploying
        |: seat == self.seat and occult_remaining == 1
        then:
            alias weakest :- hand.cards.append(card).sort_by(c => c.coin + c.attack + c.hp).at(0) ?? occult_card
            |> hand.append(card: card)
            occult_remaining => 0
            |> hand.remove_by_name(name: weakest.name)
            |> deck.add_discard(card: weakest)
            total_deploys => total_deploys + 1
            |> hand.remove_by_name(name: occult_card.name)
            :> card_deployed(card: occult_card, seat: self.seat)
            self :> try_place(lane: occult_lane)

    # Deck ran empty mid-Occultist: still finish the deploy cleanly.
    deploying <: deck.hand_empty(seat: Int!) -> deploying
        |: seat == self.seat and occult_remaining > 0
        then:
            occult_remaining => 0
            total_deploys => total_deploys + 1
            |> hand.remove_by_name(name: occult_card.name)
            :> card_deployed(card: occult_card, seat: self.seat)
            self :> try_place(lane: occult_lane)

    # Non-Occultist drew_hand / hand_empty during deploying — silent drop.
    deploying <: deck.drew_hand(card: Card, seat: Int!) -> deploying

    deploying <: deck.hand_empty(seat: Int!) -> deploying

    # Place towers from the hand's heroes until this player has placed
    # min(round + 1, 3) in total, or runs out of heroes or open lanes.
    idle <: begin_tower_quota(round: Int!) -> placing_towers
        then: self :> try_place_tower(round: round)

    placing_towers <: try_place_tower(round: Int!) -> placing_towers
        |: towers_placed < (round + 1).min(3) and tower_eligible.count > 0 and first_open_lane >= 0
        then:
            alias hero :- top_tower_fodder
            |> self.lane(first_open_lane).place_tower(team: seat, card: hero)
            towers_placed => towers_placed + 1
            |> hand.remove_by_name(name: hero.name)
            self :> try_place_tower(round: round)

    placing_towers <: try_place_tower(round: Int!) -> idle
        then: :> tower_quota_done(seat: seat)

    # Discard from the top of the hand until 3 cards remain. main moves
    # each `hand_overflow_discard` card to the discard pile.
    idle <: begin_hand_cap -> capping_hand
        then: self :> try_cap

    capping_hand <: try_cap -> capping_hand
        |: hand.cards.count > 3
        then:
            alias card :- top_hand
            :> hand_overflow_discard(card: card, seat: seat)
            |> hand.remove_by_name(name: card.name)
            self :> try_cap

    capping_hand <: try_cap -> idle
        then: :> hand_cap_done(seat: seat)

    # `_sentinel_card` stands in when the hand has no card, or no hero
    # or neutral tower-fodder, to return. Guards upstream keep it out of
    # live flow.
    tower_eligible    :- hand.cards.filter(c => c.type == CardType.hero or c.type == CardType.neutral)
    top_hand          :- hand.cards.at(0) ?? _sentinel_card
    top_tower_fodder  :- tower_eligible.at(0) ?? _sentinel_card

    enemy_seat :- 1 - seat

    # A lane by index, the two other lanes as a list, and the next lane
    # cyclically (Blink Blade's pull source). The three `_others_of_*`
    # fields carry `List of Int` type context because a bare `[…]` in an
    # observation body can't be type-inferred.
    _others_of_0: List of Int = [1, 2]
    _others_of_1: List of Int = [0, 2]
    _others_of_2: List of Int = [0, 1]

    lane(idx: Int)      :- ||: idx == 0 : lane0 ||: idx == 1 : lane1 ||: else : lane2
    others(idx: Int)    :- ||: idx == 0 : _others_of_0 ||: idx == 1 : _others_of_1 ||: else : _others_of_2
    next_lane(idx: Int) :- (idx + 1) % 3

    # First lane where this player has no tower, or -1 when all three have one.
    first_open_lane :- ||: lane0.side(seat).tower_placed == false : 0 ||: lane1.side(seat).tower_placed == false : 1 ||: lane2.side(seat).tower_placed == false : 2 ||: else : -1

    # A card with no placement rule of its own goes to the rolled lane if
    # this player has a tower there, else to the first of lanes 2, 0, 1
    # with one. -1 means no lane has one.
    first_deployable_lane(rolled: Int!) :- ||: self.lane(rolled).side(seat).tower_placed : rolled ||: lane2.side(seat).tower_placed : 2 ||: lane0.side(seat).tower_placed : 0 ||: lane1.side(seat).tower_placed : 1 ||: else : -1

    -> end

# A Card in play on a lane. `dead` is a phase of its own, not `end`, so
# the lane can still find units at 0 hp when it filters its lists.
def PlayableUnit(card: Card!, owner_seat: Int!):
    current_hp:     Int!  = card.hp
    silenced:       Bool! = false
    thorn_attached: Bool! = false
    atk_bonus:      Int!  = 0

    total_attack :- card.attack + atk_bonus
    # Reflect adds the attacker-taken bonus damage. Centaur Champion
    # carries this natively via combat_effect; Thorn Armor grants it at
    # deploy time via the `thorn_attached` flag.
    reflect_bonus :- ||: card.combat_effect.kind == EffectKind.reflect_bonus : card.combat_effect.amount ||: thorn_attached : 1 ||: else : 0
    # Faerie Dragon caps incoming damage at its combat_effect.amount.
    effective_damage(amount: Int!) :- ||: card.combat_effect.kind == EffectKind.damage_cap : amount.min(card.combat_effect.amount) ||: else : amount

    -> alive

    alive <: take_damage(amount: Int!) -> alive
        |: self.effective_damage(amount) < current_hp
        then: current_hp => current_hp - self.effective_damage(amount)

    alive <: take_damage(amount: Int!) -> dead
        |: self.effective_damage(amount) >= current_hp
        then: current_hp => 0

    alive <: heal(amount: Int!) -> alive
        then: current_hp => (current_hp + amount).min(card.hp)

    alive <: silence -> alive
        then: silenced => true

    alive <: buff_atk(amount: Int!) -> alive
        then: atk_bonus => atk_bonus + amount

    alive <: attach_thorn -> alive
        then: thorn_attached => true

    dead <: * -> dead

    -> end

# One team's half of a lane: its units and its tower.
# Kept as a sub-atom (not folded into Lane) because corvid's `=>` staging
# targets a compile-time field name, so parameterizing by-team at the
# outer Lane level would double every arm.
def LaneSide(team: Int!):
    units:          List of PlayableUnit = []
    tower_placed:   Bool! = false
    _no_effect:     DeployEffect! = DeployEffect(kind: EffectKind.none, scope: EffectScope.own_side, amount: 0)
    _no_combat:     CombatEffect! = CombatEffect(kind: EffectKind.none, amount: 0)
    _sentinel_card: Card!         = Card(name: "?", type: CardType.hero, attack: 0, hp: 0, coin: 0, pre_deploy: _no_effect, on_deploy: _no_effect, combat_effect: _no_combat)
    _sentinel_unit: PlayableUnit! = PlayableUnit(card: _sentinel_card, owner_seat: team)
    tower_card:     Card! = _sentinel_card

    # Viewer helpers — for dota2_live's Renderer. Off the hot path.
    # Kept as one flat expression: chaining `self._helper` observations
    # trips the compiler's state-snapshot lowering (tries to access
    # non-state fields on __cxc_snap).
    tower_str :- ||: tower_placed : "tower " + tower_hp.to_string() + " (" + (tower_card.name ?? "?") + ")" ||: else : "no tower"
    unit_line :- (||: units.count > 0 : "[" + (units.at(0) ?? _sentinel_unit).card.name + " " + (units.at(0) ?? _sentinel_unit).current_hp.to_string() + "/" + (units.at(0) ?? _sentinel_unit).card.hp.to_string() + "] " ||: else : "") + (||: units.count > 1 : "[" + (units.at(1) ?? _sentinel_unit).card.name + " " + (units.at(1) ?? _sentinel_unit).current_hp.to_string() + "/" + (units.at(1) ?? _sentinel_unit).card.hp.to_string() + "] " ||: else : "") + (||: units.count > 2 : "[" + (units.at(2) ?? _sentinel_unit).card.name + " " + (units.at(2) ?? _sentinel_unit).current_hp.to_string() + "/" + (units.at(2) ?? _sentinel_unit).card.hp.to_string() + "] " ||: else : "") + (||: units.count > 3 : "[" + (units.at(3) ?? _sentinel_unit).card.name + " " + (units.at(3) ?? _sentinel_unit).current_hp.to_string() + "/" + (units.at(3) ?? _sentinel_unit).card.hp.to_string() + "] " ||: else : "") + (||: units.count > 4 : "+" + (units.count - 4).to_string() + " more" ||: else : "")
    tower_hp:       Int!  = 0

    -> idle

    idle <: append(card: Card) -> idle
        then: units => units.append(PlayableUnit(card: card, owner_seat: team))

    idle <: damage_all(amount: Int!) -> idle
        then: units.for_each(u => |> u.take_damage(amount: amount))

    idle <: heal_all(amount: Int!) -> idle
        then: units.for_each(u => |> u.heal(amount: amount))

    idle <: silence_all -> idle
        then: units.for_each(u => |> u.silence())

    idle <: attach_thorn_all -> idle
        then: units.for_each(u => |> u.attach_thorn())

    idle <: buff_all(amount: Int!) -> idle
        then: units.for_each(u => |> u.buff_atk(amount: amount))

    idle <: remove_by_name(name: String) -> idle
        then: units => units.filter(u => u.card.name != name)

    idle <: filter_dead -> idle
        then: units => units.filter(u => u.current_hp > 0)

    idle <: clear_units -> idle
        then: units => units.empty()

    idle <: place_tower(card: Card) -> idle
        |: tower_placed == false
        then:
            tower_placed => true
            tower_card   => card
            tower_hp     => 5

    idle <: place_tower(card: Card) -> idle

    idle <: clear_tower -> idle
        then:
            tower_placed => false
            tower_hp     => 0

    idle <: damage_tower(amount: Int!) -> idle
        then: tower_hp => (tower_hp - amount).max(0)

    # Attack left over from the paired fights goes to the tower when
    # this side has no living units.
    idle <: absorb_overkill_if_unopposed(overkill: Int!) -> idle
        |: tower_placed and units.filter(u => u.current_hp > 0).count == 0
        then: tower_hp => (tower_hp - overkill).max(0)

    idle <: absorb_overkill_if_unopposed(overkill: Int!) -> idle

    -> end

# A lane holds two LaneSides and runs combat. Cards leaving the lane are
# reported as `unit_gone`, with hp 0 for deaths and spent items, and main
# sends them to the discard pile or back to the owner's hand.
def Lane(idx: Int!):
    side_0:      LaneSide = LaneSide(team: 0)
    side_1:      LaneSide = LaneSide(team: 1)
    combat_idx:  Int!     = 0
    overkill_0:  Int!     = 0
    overkill_1:  Int!     = 0

    side(team: Int)       :- ||: team == 0 : side_0 ||: else : side_1
    enemy_side(team: Int) :- ||: team == 0 : side_1 ||: else : side_0

    # Seat whose tower just reached 0 hp, checking side 0 first, or -1.
    tower_lost_seat :- ||: side_0.tower_placed and side_0.tower_hp == 0 : 0 ||: side_1.tower_placed and side_1.tower_hp == 0 : 1 ||: else : -1

    # The unit at the combat index on `team`'s side, and the one behind it.
    front(team: Int)  :- self.side(team).units.at(combat_idx)
    behind(team: Int) :- self.side(team).units.at(combat_idx + 1)
    paired            :- combat_idx < side_0.units.count and combat_idx < side_1.units.count
    # Damage `team`'s front unit does to an undefended tower. Phantom
    # Blade adds 2.
    tower_damage(team: Int) :- self.front(team).total_attack + (||: self.front(team).card.combat_effect.kind == EffectKind.tower_bonus : self.front(team).card.combat_effect.amount ||: else : 0)


    -> idle

    # Scroll with heal_all on_deploy (Return Scroll): heal own side, no
    # unit_gone (Python parity — scrolls dissolve silently).
    idle <: place_hero(card: Card, team: Int!) -> idle
        |: card.type == CardType.scroll and card.on_deploy.kind == EffectKind.heal_all
        then: |> self.side(team).heal_all(amount: card.on_deploy.amount)

    # Item with attach_thorn on_deploy (Thorn Armor): attach and discard.
    idle <: place_hero(card: Card, team: Int!) -> idle
        |: card.type == CardType.item and card.on_deploy.kind == EffectKind.attach_thorn_all
        then:
            |> self.side(team).attach_thorn_all()
            :> unit_gone(card: card, seat: team, hp: 0)

    # Any other item or scroll (no live effect handler): discard.
    idle <: place_hero(card: Card, team: Int!) -> idle
        |: card.type == CardType.item or card.type == CardType.scroll
        then: :> unit_gone(card: card, seat: team, hp: 0)

    # Pre-append clear: Fallen Warlock's `clear_all` fires first, then the
    # card lands. The cleared cards leave the game instead of returning to
    # their owners' hands (the Python reference never implemented that
    # half of the card).
    idle <: place_hero(card: Card, team: Int!) -> idle
        |: card.pre_deploy.kind == EffectKind.clear_all and card.pre_deploy.scope == EffectScope.enemy_side
        then:
            |> self.enemy_side(team).clear_units()
            |> self.side(team).append(card: card)

    # Post-append dispatch is keyed by the card's `on_deploy.kind`.
    # Blood Demon, Hell Bear (damage 2), and Mage Slayer (damage 5)
    # share one arm; Wolf Leader and Kobold Boss share the buff arm.
    # The vanilla arm (EffectKind.none) is explicit.
    idle <: place_hero(card: Card, team: Int!) -> idle
        |: card.on_deploy.kind == EffectKind.damage_all
        then:
            |> self.side(team).append(card: card)
            |> self.enemy_side(team).damage_all(amount: card.on_deploy.amount)

    idle <: place_hero(card: Card, team: Int!) -> idle
        |: card.on_deploy.kind == EffectKind.heal_all
        then:
            |> self.side(team).append(card: card)
            |> self.side(team).heal_all(amount: card.on_deploy.amount)

    idle <: place_hero(card: Card, team: Int!) -> idle
        |: card.on_deploy.kind == EffectKind.silence_all
        then:
            |> self.side(team).append(card: card)
            |> self.enemy_side(team).silence_all()

    idle <: place_hero(card: Card, team: Int!) -> idle
        |: card.on_deploy.kind == EffectKind.buff_all
        then:
            |> self.side(team).append(card: card)
            |> self.side(team).buff_all(amount: card.on_deploy.amount)

    # Vanilla deploy (EffectKind.none): explicit fall-through case.
    idle <: place_hero(card: Card, team: Int!) -> idle
        then: |> self.side(team).append(card: card)

    # Blink Blade's source lane drops the moved unit.
    idle <: remove_hero_by_name(team: Int!, name: String) -> idle
        then: |> self.side(team).remove_by_name(name: name)

    # Storm Spirit's cross-lane damage: fires on the two lanes the card
    # did NOT land in, with amount supplied by the caller.
    idle <: cross_damage(enemy_team: Int!, amount: Int!) -> idle
        then: |> self.side(enemy_team).damage_all(amount: amount)

    idle <: place_tower(team: Int!, card: Card) -> idle
        then: |> self.side(team).place_tower(card: card)

    # Combat pairs units by index and both hits of a pair land at once.
    # `preparing` reports units already killed by deploy damage, then
    # `begin_pairing` drops them from both sides.
    idle <: begin_combat -> preparing
        then:
            side_0.units.filter(u => u.current_hp == 0).for_each(u => :> unit_gone(card: u.card, seat: u.owner_seat, hp: 0))
            side_1.units.filter(u => u.current_hp == 0).for_each(u => :> unit_gone(card: u.card, seat: u.owner_seat, hp: 0))
            self :> begin_pairing

    preparing <: begin_pairing -> combatting
        then:
            |> side_0.filter_dead()
            |> side_1.filter_dead()
            combat_idx => 0
            overkill_0 => 0
            overkill_1 => 0
            self :> pair_step

    # Marksman on side_0 skips side_1's front unit and hits the one behind it.
    combatting <: pair_step -> combatting
        |: paired and self.front(0).card.combat_effect.kind == EffectKind.attack_bypass and combat_idx + 1 < side_1.units.count
        then:
            |> self.behind(1).take_damage(amount: self.front(0).total_attack + self.behind(1).reflect_bonus)
            |> self.front(0).take_damage(amount: self.front(1).total_attack + self.front(1).reflect_bonus)
            combat_idx => combat_idx + 1
            self :> pair_step

    combatting <: pair_step -> combatting
        |: paired and self.front(1).card.combat_effect.kind == EffectKind.attack_bypass and combat_idx + 1 < side_0.units.count
        then:
            |> self.behind(0).take_damage(amount: self.front(1).total_attack + self.behind(0).reflect_bonus)
            |> self.front(1).take_damage(amount: self.front(0).total_attack + self.front(0).reflect_bonus)
            combat_idx => combat_idx + 1
            self :> pair_step

    # Attack beyond the defender's hp is overkill, which can carry to the
    # tower once the pairs run out.
    combatting <: pair_step -> combatting
        |: paired
        then:
            overkill_0 => overkill_0 + (self.front(0).total_attack - self.front(1).current_hp).max(0)
            overkill_1 => overkill_1 + (self.front(1).total_attack - self.front(0).current_hp).max(0)
            |> self.front(0).take_damage(amount: self.front(1).total_attack + self.front(1).reflect_bonus)
            |> self.front(1).take_damage(amount: self.front(0).total_attack + self.front(0).reflect_bonus)
            combat_idx => combat_idx + 1
            self :> pair_step

    # Once the pairs run out, leftover overkill reaches an undefended
    # tower and the unpaired units hit the enemy tower one index at a time.
    combatting <: pair_step -> unopposed
        |: not paired
        then:
            |> side_1.absorb_overkill_if_unopposed(overkill: overkill_0)
            |> side_0.absorb_overkill_if_unopposed(overkill: overkill_1)

    -> unopposed
        then: self :> tower_hit

    unopposed <: tower_hit -> unopposed
        |: combat_idx < side_0.units.count
        then:
            |> side_1.damage_tower(amount: self.tower_damage(0))
            combat_idx => combat_idx + 1
            self :> check_towers

    unopposed <: tower_hit -> unopposed
        |: combat_idx < side_1.units.count
        then:
            |> side_0.damage_tower(amount: self.tower_damage(1))
            combat_idx => combat_idx + 1
            self :> check_towers

    # A tower at 0 hp is lost: emit `tower_lost`, send every unit on the
    # lane back through `unit_gone`, then clear the tower and both sides.
    unopposed <: check_towers -> destroying
        |: tower_lost_seat >= 0
        then:
            :> tower_lost(seat: tower_lost_seat, card: self.side(tower_lost_seat).tower_card)
            side_0.units.for_each(u => :> unit_gone(card: u.card, seat: u.owner_seat, hp: u.current_hp))
            side_1.units.for_each(u => :> unit_gone(card: u.card, seat: u.owner_seat, hp: u.current_hp))
            self :> finish_destroy(seat: tower_lost_seat)

    destroying <: finish_destroy(seat: Int!) -> unopposed
        then:
            |> self.side(seat).clear_tower()
            |> side_0.clear_units()
            |> side_1.clear_units()

    unopposed <: check_towers -> unopposed
        then: self :> tower_hit

    unopposed <: tower_hit -> finalizing
        |: combat_idx >= side_0.units.count and combat_idx >= side_1.units.count
        then:
            side_0.units.filter(u => u.current_hp == 0).for_each(u => :> unit_gone(card: u.card, seat: u.owner_seat, hp: 0))
            side_1.units.filter(u => u.current_hp == 0).for_each(u => :> unit_gone(card: u.card, seat: u.owner_seat, hp: 0))
            self :> finalize

    finalizing <: finalize -> idle
        then:
            |> side_0.filter_dead()
            |> side_1.filter_dead()
            :> combat_done

    -> end

# The face-up auction row. `begin_refill` pulls from Deck until the row
# holds 3 cards or Deck runs dry, then emits `refill_done`.
def Market(deck: Deck):
    cards: List of Card = []

    -> idle

    idle <: begin_refill -> refilling
        then: self :> pull

    refilling <: pull -> refilling
        |: cards.count < 3
        then: |> deck.try_draw_market()

    refilling <: pull -> idle
        then: :> refill_done

    refilling <: deck.drew_market(card: Card) -> refilling
        then:
            cards => cards.append(card)
            self :> pull

    refilling <: deck.market_empty -> idle
        then: :> refill_done

    # Each auctioned card leaves the row, sold or not.
    * <: remove_by_name(name: String) -> self
        then: cards => cards.filter(c => c.name != name)

    -> end

# Deck holds the draw and discard piles and the prng that picks draws.
# Hand and Market ask with `try_draw_hand(seat)` / `try_draw_market`,
# and Deck answers with `drew_hand(card, seat)` / `drew_market(card)`,
# or with `hand_empty(seat)` / `market_empty` once both piles are empty.
# An empty draw pile is refilled from the discard pile first.
def Deck(prng: SeededPrng):
    cards:          List of Card = []
    discard:        List of Card = []
    _no_effect:     DeployEffect! = DeployEffect(kind: EffectKind.none, scope: EffectScope.own_side, amount: 0)
    _no_combat:     CombatEffect! = CombatEffect(kind: EffectKind.none, amount: 0)
    _sentinel_card: Card!         = Card(name: "?", type: CardType.hero, attack: 0, hp: 0, coin: 0, pre_deploy: _no_effect, on_deploy: _no_effect, combat_effect: _no_combat)

    -> idle

    idle <: seed(initial: List of Card) -> idle
        then: cards => initial

    idle <: add_discard(card: Card) -> idle
        then: discard => discard.append(card)

    idle <: try_draw_hand(seat: Int!) -> idle
        |: cards.count == 0 and discard.count > 0
        then:
            cards   => discard
            discard => discard.empty()
            self :> try_draw_hand(seat: seat)

    idle <: try_draw_hand(seat: Int!) -> idle
        |: cards.count == 0
        then: :> hand_empty(seat: seat)

    idle <: try_draw_hand(seat: Int!) -> idle
        then:
            alias card :- cards.at(prng.below(cards.count)) ?? _sentinel_card
            cards => cards.filter(c => c.name != card.name)
            :> drew_hand(card: card, seat: seat)

    idle <: try_draw_market -> idle
        |: cards.count == 0 and discard.count > 0
        then:
            cards   => discard
            discard => discard.empty()
            self :> try_draw_market

    idle <: try_draw_market -> idle
        |: cards.count == 0
        then: :> market_empty

    idle <: try_draw_market -> idle
        then:
            alias card :- cards.at(prng.below(cards.count)) ?? _sentinel_card
            cards => cards.filter(c => c.name != card.name)
            :> drew_market(card: card)

    -> end

# Viewer sub-atom. Reads the sim state through the atom refs it was
# constructed with, and issues plugin draw calls for one full frame
# per `draw_frame` message. `snap_mode` writes a PNG under `snap_dir`
# per frame, `step_mode` blocks until the user hits a key.
def Renderer(lane_0: Lane, lane_1: Lane, lane_2: Lane, p0: Player, p1: Player, deck: Deck):
    use plugin: Plugin
    frame_no: Int!    = 0
    snap_dir: String! = "/tmp/dota2-frames"

    _side_summary(side: LaneSide) :- side.tower_str

    -> idle

    # One full frame. Header (round, phase, scoreboard) + three lane
    # strips + present + snapshot + optional keyboard wait. All plugin
    # calls run as aliases at the head of the arm, since Corvid requires
    # aliases before non-alias statements and the plugin FFI is a value
    # expression, not a bare statement.
    idle <: draw_frame(round: Int!, phase: String) -> idle
        then:
            # Phase-derived colours + endgame flag, computed inline as
            # aliases. Field-then-observation would lag one frame under
            # snapshot-transaction semantics.
            alias is_combat :- phase == "before combat" or phase == "combat done"
            alias is_final  :- phase == "p0 wins" or phase == "p1 wins" or phase == "draw"
            alias cc        :- ||: is_combat : 170 ||: else : 80

            alias _clr  :- plugin.get("cv_clear")(24, 26, 32)
            alias _hdr  :- plugin.get("cv_text")(20, 8,  "round " + round.to_string() + "   " + phase, 20, 230, 230, 230)
            alias _hp   :- plugin.get("cv_text")(20, 36, "p0 hand=" + p0.hand.cards.count.to_string() + "  towers_lost=" + p0.towers_lost.to_string() + "  auction_wins=" + p0.total_auction_wins.to_string() + "     p1 hand=" + p1.hand.cards.count.to_string() + "  towers_lost=" + p1.towers_lost.to_string() + "  auction_wins=" + p1.total_auction_wins.to_string(), 12, 180, 180, 180)
            alias _dk   :- plugin.get("cv_text")(20, 54, "deck " + deck.cards.count.to_string() + "   discard " + deck.discard.count.to_string() + "   frame " + frame_no.to_string(), 12, 140, 140, 140)

            alias _r0   :- plugin.get("cv_rect")(20, 78, 680, 120, 40, 44, 56)
            alias _l0h  :- plugin.get("cv_text")(28, 82,  "lane 0", 14, 230, 230, 230)
            alias _l0a  :- plugin.get("cv_text")(28, 102, "p0  " + self._side_summary(lane_0.side_0), 11, 100, 180, 255)
            alias _l0u0 :- plugin.get("cv_text")(28, 118, "    " + lane_0.side_0.unit_line, 10, 150, 200, 240)
            alias _l0b  :- plugin.get("cv_text")(28, 138, "p1  " + self._side_summary(lane_0.side_1), 11, 255, 100, 100)
            alias _l0u1 :- plugin.get("cv_text")(28, 154, "    " + lane_0.side_1.unit_line, 10, 240, 150, 150)
            alias _l0c  :- plugin.get("cv_text")(28, 176, "combat_idx " + lane_0.combat_idx.to_string() + "   overkill " + lane_0.overkill_0.to_string() + "/" + lane_0.overkill_1.to_string(), 9, cc, cc, cc)

            alias _r1   :- plugin.get("cv_rect")(20, 210, 680, 120, 40, 44, 56)
            alias _l1h  :- plugin.get("cv_text")(28, 214, "lane 1", 14, 230, 230, 230)
            alias _l1a  :- plugin.get("cv_text")(28, 234, "p0  " + self._side_summary(lane_1.side_0), 11, 100, 180, 255)
            alias _l1u0 :- plugin.get("cv_text")(28, 250, "    " + lane_1.side_0.unit_line, 10, 150, 200, 240)
            alias _l1b  :- plugin.get("cv_text")(28, 270, "p1  " + self._side_summary(lane_1.side_1), 11, 255, 100, 100)
            alias _l1u1 :- plugin.get("cv_text")(28, 286, "    " + lane_1.side_1.unit_line, 10, 240, 150, 150)
            alias _l1c  :- plugin.get("cv_text")(28, 308, "combat_idx " + lane_1.combat_idx.to_string() + "   overkill " + lane_1.overkill_0.to_string() + "/" + lane_1.overkill_1.to_string(), 9, cc, cc, cc)

            alias _r2   :- plugin.get("cv_rect")(20, 342, 680, 120, 40, 44, 56)
            alias _l2h  :- plugin.get("cv_text")(28, 346, "lane 2", 14, 230, 230, 230)
            alias _l2a  :- plugin.get("cv_text")(28, 366, "p0  " + self._side_summary(lane_2.side_0), 11, 100, 180, 255)
            alias _l2u0 :- plugin.get("cv_text")(28, 382, "    " + lane_2.side_0.unit_line, 10, 150, 200, 240)
            alias _l2b  :- plugin.get("cv_text")(28, 402, "p1  " + self._side_summary(lane_2.side_1), 11, 255, 100, 100)
            alias _l2u1 :- plugin.get("cv_text")(28, 418, "    " + lane_2.side_1.unit_line, 10, 240, 150, 150)
            alias _l2c  :- plugin.get("cv_text")(28, 440, "combat_idx " + lane_2.combat_idx.to_string() + "   overkill " + lane_2.overkill_0.to_string() + "/" + lane_2.overkill_1.to_string(), 9, cc, cc, cc)

            # Endgame overlay. Big centred banner in a warm colour so
            # the terminal frame reads distinct from any interior phase.
            alias _end_bg :- ||: is_final : plugin.get("cv_rect")(160, 200, 400, 80, 200, 160, 60) ||: else : 0
            alias _end_tx :- ||: is_final : plugin.get("cv_text")(200, 220, "GAME OVER — " + phase, 26, 30, 20, 10) ||: else : 0

            alias _snap :- plugin.get("cv_snapshot")(snap_dir + "/f" + frame_no.to_string() + ".png")
            frame_no => frame_no + 1

    -> end

def main(args: Args):
    use plugin: Plugin

    # Effect-record shorthands: each card lists its pre- and on-deploy
    # side-effects as data. `_no_effect` stands for "no side-effect at
    # this timing"; passives, combat modifiers, and Player-level cards
    # (Storm Spirit, Blink Blade, Occultist) all read _no_effect here.
    _no_effect:     DeployEffect! = DeployEffect(kind: EffectKind.none,             scope: EffectScope.own_side,   amount: 0)
    _dmg_enemy_2:   DeployEffect! = DeployEffect(kind: EffectKind.damage_all,       scope: EffectScope.enemy_side, amount: 2)
    _dmg_enemy_5:   DeployEffect! = DeployEffect(kind: EffectKind.damage_all,       scope: EffectScope.enemy_side, amount: 5)
    _heal_own_2:    DeployEffect! = DeployEffect(kind: EffectKind.heal_all,         scope: EffectScope.own_side,   amount: 2)
    _silence_enemy: DeployEffect! = DeployEffect(kind: EffectKind.silence_all,      scope: EffectScope.enemy_side, amount: 0)
    _buff_own_1:    DeployEffect! = DeployEffect(kind: EffectKind.buff_all,         scope: EffectScope.own_side,   amount: 1)
    _clear_enemy:   DeployEffect! = DeployEffect(kind: EffectKind.clear_all,        scope: EffectScope.enemy_side, amount: 0)
    _thorn_own:     DeployEffect! = DeployEffect(kind: EffectKind.attach_thorn_all, scope: EffectScope.own_side,   amount: 0)
    _cross_dmg_2:      DeployEffect! = DeployEffect(kind: EffectKind.cross_damage_all,          scope: EffectScope.enemy_side, amount: 2)
    _move_next_lane:   DeployEffect! = DeployEffect(kind: EffectKind.move_from_next_lane_front, scope: EffectScope.own_side,   amount: 0)
    _draw_2_discard_1: DeployEffect! = DeployEffect(kind: EffectKind.draw_n_discard_weakest,    scope: EffectScope.own_side,   amount: 2)
    _no_combat:     CombatEffect! = CombatEffect(kind: EffectKind.none,          amount: 0)
    _bypass:        CombatEffect! = CombatEffect(kind: EffectKind.attack_bypass, amount: 0)
    _dmg_cap_2:     CombatEffect! = CombatEffect(kind: EffectKind.damage_cap,    amount: 2)
    _reflect_1:     CombatEffect! = CombatEffect(kind: EffectKind.reflect_bonus, amount: 1)
    _tower_plus_2:  CombatEffect! = CombatEffect(kind: EffectKind.tower_bonus,   amount: 2)

    # The order matches pocket_moba_sim.py::make_deck() for uid parity.
    initial_deck: List of Card = [
        Card(name: "Blood Demon",      type: CardType.hero,    attack: 5, hp: 4, coin: 3, pre_deploy: _no_effect,   on_deploy: _dmg_enemy_2,   combat_effect: _no_combat),
        Card(name: "Storm Spirit",     type: CardType.hero,    attack: 5, hp: 3, coin: 3, pre_deploy: _no_effect,   on_deploy: _cross_dmg_2,   combat_effect: _no_combat),
        Card(name: "Marksman",         type: CardType.hero,    attack: 4, hp: 4, coin: 4, pre_deploy: _no_effect,   on_deploy: _no_effect,     combat_effect: _bypass),
        # Axe King's `passive_target_first` was never implemented in the
        # Python reference and never guarded in this port; combat_effect
        # stays `_no_effect` until a real combat-time hook is added.
        Card(name: "Axe King",         type: CardType.hero,    attack: 4, hp: 8, coin: 4, pre_deploy: _no_effect,   on_deploy: _no_effect,     combat_effect: _no_combat),
        Card(name: "Tide Beast",       type: CardType.hero,    attack: 3, hp: 9, coin: 5, pre_deploy: _no_effect,   on_deploy: _silence_enemy, combat_effect: _no_combat),
        Card(name: "Fallen Warlock",   type: CardType.hero,    attack: 4, hp: 5, coin: 5, pre_deploy: _clear_enemy, on_deploy: _no_effect,     combat_effect: _no_combat),
        Card(name: "Occultist",        type: CardType.hero,    attack: 3, hp: 4, coin: 4, pre_deploy: _no_effect,   on_deploy: _draw_2_discard_1, combat_effect: _no_combat),
        Card(name: "Faerie Dragon",    type: CardType.hero,    attack: 3, hp: 4, coin: 3, pre_deploy: _no_effect,   on_deploy: _no_effect,     combat_effect: _dmg_cap_2),
        Card(name: "Mage Slayer",      type: CardType.hero,    attack: 6, hp: 6, coin: 5, pre_deploy: _no_effect,   on_deploy: _dmg_enemy_5,   combat_effect: _no_combat),
        Card(name: "Phantom Blade",    type: CardType.hero,    attack: 8, hp: 6, coin: 6, pre_deploy: _no_effect,   on_deploy: _no_effect,     combat_effect: _tower_plus_2),
        Card(name: "Kobold Boss",      type: CardType.neutral, attack: 1, hp: 2, coin: 2, pre_deploy: _no_effect,   on_deploy: _buff_own_1,    combat_effect: _no_combat),
        Card(name: "Wolf Leader",      type: CardType.neutral, attack: 3, hp: 2, coin: 3, pre_deploy: _no_effect,   on_deploy: _buff_own_1,    combat_effect: _no_combat),
        Card(name: "Satyr Torturer",   type: CardType.neutral, attack: 2, hp: 3, coin: 2, pre_deploy: _no_effect,   on_deploy: _heal_own_2,    combat_effect: _no_combat),
        Card(name: "Centaur Champion", type: CardType.neutral, attack: 2, hp: 5, coin: 3, pre_deploy: _no_effect,   on_deploy: _no_effect,     combat_effect: _reflect_1),
        Card(name: "Hell Bear",        type: CardType.neutral, attack: 4, hp: 3, coin: 3, pre_deploy: _no_effect,   on_deploy: _dmg_enemy_2,   combat_effect: _no_combat),
        Card(name: "Blink Blade",      type: CardType.item,    attack: 0, hp: 0, coin: 3, pre_deploy: _no_effect,   on_deploy: _move_next_lane,   combat_effect: _no_combat),
        Card(name: "Thorn Armor",      type: CardType.item,    attack: 0, hp: 0, coin: 3, pre_deploy: _no_effect,   on_deploy: _thorn_own,     combat_effect: _no_combat),
        Card(name: "Return Scroll",    type: CardType.scroll,  attack: 0, hp: 0, coin: 3, pre_deploy: _no_effect,   on_deploy: _heal_own_2,    combat_effect: _no_combat)
    ]

    _sentinel_card: Card!   = Card(name: "?", type: CardType.hero, attack: 0, hp: 0, coin: 0, pre_deploy: _no_effect, on_deploy: _no_effect, combat_effect: _no_combat)
    prng:   SeededPrng    = SeededPrng(seed: 42)
    deck:   Deck          = Deck(prng: prng)
    lane0:  Lane          = Lane(idx: 0)
    lane1:  Lane          = Lane(idx: 1)
    lane2:  Lane          = Lane(idx: 2)
    p0:     Player        = Player(seat: 0, deck: deck, lane0: lane0, lane1: lane1, lane2: lane2)
    p1:     Player        = Player(seat: 1, deck: deck, lane0: lane0, lane1: lane1, lane2: lane2)

    # An arm on `lanes.msg` or `players.msg` receives from every atom in
    # the list, so one arm covers all three lanes or both players.
    lanes:   List of Lane   = [lane0, lane1, lane2]
    players: List of Player = [p0, p1]

    combat_dones:  Int!   = 0
    # Per-card totals over both players, printed at the end in deck order.
    deploy_counts: Map of (String, Int)
    auction_wins:  Map of (String, Int)
    market: Market = Market(deck: deck)
    round: Int! = 0
    auctions_run:  Int!  = 0
    auction_pass_streak: Int! = 0

    # Renderer walks lane/player/deck state at each phase boundary and
    # writes a PNG per frame under /tmp/dota2-frames/.
    renderer: Renderer = Renderer(lane_0: lane0, lane_1: lane1, lane_2: lane2,
                                  p0: p0, p1: p1, deck: deck)

    at_seat(seat: Int) :- ||: seat == 0 : p0 ||: else : p1
    # The winning seat, or -1 for a draw when both players lose their
    # second tower in the same round or the round cap comes first.
    game_winner :- ||: p0.towers_lost >= 2 and p1.towers_lost >= 2 : -1 ||: p0.towers_lost >= 2 : 1 ||: p1.towers_lost >= 2 : 0 ||: else : -1

    # Print-boundary formatting for lane tower state. Lane exposes the
    # numbers (side_0.tower_hp) and cards (side_0.tower_card) as data;
    # the "N/M" and "name/name" joins live at the caller (`print`).
    lane_tw_str(l: Lane)    :- l.side_0.tower_hp.to_string() + "/" + l.side_1.tower_hp.to_string()
    lane_names_str(l: Lane) :- (l.side_0.tower_card.name ?? "?") + "/" + (l.side_1.tower_card.name ?? "?")

    -> idle
        then:
            alias _open :- plugin.get("cv_open_offscreen")(720, 480)
            |> deck.seed(initial: initial_deck)
            self :> kickoff

    # Each round runs draws (p0 then p1), the round-0 mulligan check,
    # market refill, auction, deploys (p0 then p1), tower quotas, hand
    # caps, and combat.
    idle <: kickoff -> dealing
        then:
            |> renderer.draw_frame(round: round, phase: "start")
            |> p0.begin_draw()

    dealing <: players.p_draw_done(e: Player, seat: Int!) -> dealing
        |: seat == 0
        then: |> p1.begin_draw()

    dealing <: players.p_draw_done(e: Player, seat: Int!) -> refilling
        |: seat == 1
        then:
            |> p0.check_mulligan(round: round)
            |> p1.check_mulligan(round: round)
            |> renderer.draw_frame(round: round, phase: "drew hands")
            |> market.begin_refill()

    refilling <: market.refill_done -> auctioning
        then: |> renderer.draw_frame(round: round, phase: "market refilled")

    # Auction the front card of the row, up to 8 cards a round, stopping
    # early on an empty row or two passes in a row. Each seat rolls
    # prng.below(2): 0 passes, 1 bids its hand size. The higher bid wins
    # if it covers the card's coin cost, a tie goes to seat 0, and -1
    # means nobody bought. The card leaves the row either way.
    -> auctioning
        then: self :> next_auction

    auctioning <: next_auction -> bidding
        |: market.cards.count > 0 and auctions_run < 8 and auction_pass_streak < 2
        then:
            alias card   :- market.cards.at(0) ?? _sentinel_card
            alias p0_bid :- ||: prng.below(2) == 0 : 0 ||: else : p0.hand.cards.count
            alias p1_bid :- ||: prng.below(2) == 0 : 0 ||: else : p1.hand.cards.count
            |> market.remove_by_name(name: card.name)
            self :> settle(card: card, winner: ||: p0_bid >= card.coin and p0_bid >= p1_bid : 0 ||: p1_bid >= card.coin and p1_bid > p0_bid : 1 ||: else : -1)

    auctioning <: next_auction -> deploying
        |: market.cards.count == 0 or auctions_run >= 8 or auction_pass_streak >= 2
        then:
            |> renderer.draw_frame(round: round, phase: "auctions done")
            |> p0.begin_deploy_round(dl: prng.below(3))

    bidding <: settle(card: Card, winner: Int!) -> auctioning
        |: winner >= 0
        then:
            |> self.at_seat(winner).win_target(card: card)
            auctions_run => auctions_run + 1
            auction_pass_streak => 0
            auction_wins => auction_wins.assoc(card.name, (auction_wins.get(card.name) ?? 0) + 1)

    bidding <: settle(card: Card, winner: Int!) -> auctioning
        then:
            auctions_run => auctions_run + 1
            auction_pass_streak => auction_pass_streak + 1

    deploying <: players.deploy_done(e: Player, seat: Int!) -> deploying
        |: seat == 0
        then: |> p1.begin_deploy_round(dl: prng.below(3))

    deploying <: players.deploy_done(e: Player, seat: Int!) -> placing_towers
        |: seat == 1
        then:
            |> renderer.draw_frame(round: round, phase: "deploys done")
            |> p0.begin_tower_quota(round: round)

    * <: players.card_deployed(e: Player, card: Card, seat: Int!) -> self
        then: deploy_counts => deploy_counts.assoc(card.name, (deploy_counts.get(card.name) ?? 0) + 1)

    placing_towers <: players.tower_quota_done(e: Player, seat: Int!) -> placing_towers
        |: seat == 0
        then: |> p1.begin_tower_quota(round: round)

    placing_towers <: players.tower_quota_done(e: Player, seat: Int!) -> capping_hand
        |: seat == 1
        then:
            |> renderer.draw_frame(round: round, phase: "towers placed")
            |> p0.begin_hand_cap()

    capping_hand <: players.hand_cap_done(e: Player, seat: Int!) -> capping_hand
        |: seat == 0
        then: |> p1.begin_hand_cap()

    capping_hand <: players.hand_cap_done(e: Player, seat: Int!) -> combatting
        |: seat == 1
        then:
            |> renderer.draw_frame(round: round, phase: "before combat")
            self :> resolve_combat

    * <: players.hand_overflow_discard(e: Player, card: Card, seat: Int!) -> self
        then: |> deck.add_discard(card: card)

    # A lost tower's card goes back to its owner's hand.
    * <: lanes.tower_lost(e: Lane, seat: Int!, card: Card) -> self
        then:
            |> self.at_seat(seat).inc_towers_lost()
            |> self.at_seat(seat).hand.append(card: card)

    # A card leaving a lane goes to the discard pile if its unit died
    # (hp 0), or back to its owner's hand if the unit was alive (hp > 0).
    * <: lanes.unit_gone(e: Lane, card: Card, seat: Int!, hp: Int!) -> self
        |: hp == 0
        then: |> deck.add_discard(card: card)

    * <: lanes.unit_gone(e: Lane, card: Card, seat: Int!, hp: Int!) -> self
        |: hp > 0
        then: |> self.at_seat(seat).hand.append(card: card)

    combatting <: resolve_combat -> combatting
        then:
            print("-- combat -- l0 tw=" + self.lane_tw_str(lane0) + " l1 tw=" + self.lane_tw_str(lane1) + " l2 tw=" + self.lane_tw_str(lane2))
            lanes.for_each(l => def:
                alias idx :- l.idx.to_string()
                l.side_0.units.for_each(u => print("  l" + idx + " t0: " + u.card.name + " hp=" + u.current_hp.to_string()))
                l.side_1.units.for_each(u => print("  l" + idx + " t1: " + u.card.name + " hp=" + u.current_hp.to_string()))
            )
            combat_dones => 0
            lanes.for_each(l => |> l.begin_combat())

    combatting <: lanes.combat_done(e: Lane) -> combatting
        |: combat_dones + 1 < lanes.count
        then: combat_dones => combat_dones + 1

    combatting <: lanes.combat_done(e: Lane) -> resolving_round
        |: combat_dones + 1 >= lanes.count
        then:
            |> renderer.draw_frame(round: round, phase: "combat done")
            self :> end_round

    # The game ends once a player has lost 2 towers, or after round 11
    # (rounds count from 0, so 12 rounds as in the Python reference).
    resolving_round <: end_round -> end
        |: p0.towers_lost >= 2 or p1.towers_lost >= 2 or round >= 11

    resolving_round <: end_round -> dealing
        |: p0.towers_lost < 2 and p1.towers_lost < 2 and round < 11
        then:
            round => round + 1
            auctions_run => 0
            auction_pass_streak => 0
            |> p0.begin_draw()

    -> end
        then:
            players.for_each(p => def:
                alias name :- "p" + p.seat.to_string()
                print(name + " hand:")
                p.hand.cards.for_each(c => print(c.name))
                print(name + " won:")
                p.won.for_each(c => print(c.name))
            )
            print("market:")
            market.cards.for_each(c => print(c.name))
            print("discard:")
            deck.discard.for_each(c => print(c.name))
            print("deck:")
            deck.cards.for_each(c => print(c.name))
            lanes.for_each(l => def:
                print("lane" + l.idx.to_string() + " t0/t1:")
                l.side_0.units.for_each(u => print(u.card.name))
                l.side_1.units.for_each(u => print(u.card.name))
            )
            print("towers l0 " + self.lane_tw_str(lane0) + " l1 " + self.lane_tw_str(lane1) + " l2 " + self.lane_tw_str(lane2))
            print("tower cards: l0[" + self.lane_names_str(lane0) + "] l1[" + self.lane_names_str(lane1) + "] l2[" + self.lane_names_str(lane2) + "]")
            print("")
            print("=== game result (Python-parity output) ===")
            print("winner: " + game_winner.to_string() + ", rounds: " + (round + 1).to_string())
            # Python counts towers by the attacker that destroyed them, so
            # each player's figure is the other player's towers lost.
            print("towers_destroyed p0: " + p1.towers_lost.to_string() + ", p1: " + p0.towers_lost.to_string())
            print("deploy_counts (total p0=" + p0.total_deploys.to_string() + " p1=" + p1.total_deploys.to_string() + "):")
            initial_deck.for_each(c => print("  " + (c.name + ":").pad_right(18, " ") + (deploy_counts.get(c.name) ?? 0).to_string()))
            print("auction_wins (total p0=" + p0.total_auction_wins.to_string() + " p1=" + p1.total_auction_wins.to_string() + "):")
            initial_deck.for_each(c => print("  " + (c.name + ":").pad_right(18, " ") + (auction_wins.get(c.name) ?? 0).to_string()))
            print("mulligans: [" + p0.mulligans.to_string() + ", " + p1.mulligans.to_string() + "]")
            |> renderer.draw_frame(round: round, phase: ||: game_winner == 0 : "p0 wins" ||: game_winner == 1 : "p1 wins" ||: else : "draw")
