#!/usr/bin/env bash
# watch — runs the dota2_live sim and displays the frames.
#
# Usage:
#   ./watch                 # auto mode (default) — viewerd window auto-advances
#   ./watch --step          # step mode — viewerd window, Left/Right arrow to advance
#   ./watch --preview       # open all PNGs in Preview.app for arrow-key stepping
#   ./watch --mp4           # encode via ffmpeg, open in QuickTime (loops with Cmd-L)
#   ./watch --rebuild       # force rebuild of dylib + sim + viewerd first
#   ./watch --fps 6         # set auto-mode framerate (default 4)
#
# Auto and step modes open viewerd, a small standalone Cocoa app that
# reads /tmp/dota2-frames/f*.png. viewerd runs in its own process
# with its own NSApplication, so it sidesteps Corvid's runtime
# incompatibility with in-process AppKit (see libcocoa_viewer.m for
# the details).
#
# --preview replays the pre-viewerd shell of this script: open every
# PNG in Preview.app and let its sidebar + arrow keys do the stepping.
#
# --mp4 encodes to an mp4 with ffmpeg and opens QuickTime, which
# auto-plays and can loop with Cmd-L. Requires ffmpeg installed.

set -euo pipefail

HERE="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
FRAMES_DIR="/tmp/dota2-frames"
BIN="/tmp/cocoa-viewer-out/dota2_live"
VIEWERD="$HERE/viewerd"

MODE="auto"
FPS="4"
REBUILD=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --auto)     MODE="auto"; shift ;;
        --step)     MODE="step"; shift ;;
        --preview)  MODE="preview"; shift ;;
        --mp4)      MODE="mp4"; shift ;;
        --fps)      FPS="$2"; shift 2 ;;
        --rebuild)  REBUILD=1; shift ;;
        -h|--help)
            grep '^#' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)          echo "unknown arg: $1" >&2; exit 1 ;;
    esac
done

if [[ "$REBUILD" == 1 ]] || [[ ! -x "$BIN" ]] || [[ ! -x "$VIEWERD" ]]; then
    echo "==> building dota2_live + viewerd"
    "$HERE/build.sh" "$HERE/dota2_live.cxc" > /tmp/dota2-build.log 2>&1 || {
        echo "build failed; see /tmp/dota2-build.log" >&2
        tail -20 /tmp/dota2-build.log >&2
        exit 1
    }
fi

echo "==> running sim"
mkdir -p "$FRAMES_DIR"
rm -f "$FRAMES_DIR"/f*.png
"$BIN" > /tmp/dota2-live.log 2>&1

FRAME_COUNT=$( ls "$FRAMES_DIR"/f*.png 2>/dev/null | wc -l | tr -d ' ' )
if [[ "$FRAME_COUNT" -eq 0 ]]; then
    echo "no frames rendered; see /tmp/dota2-live.log" >&2
    tail -20 /tmp/dota2-live.log >&2
    exit 1
fi
echo "==> $FRAME_COUNT frames rendered"

case "$MODE" in
    auto|step)
        echo "==> opening viewerd (mode=$MODE, fps=$FPS)"
        exec "$VIEWERD" --dir "$FRAMES_DIR" --fps "$FPS" --mode "$MODE"
        ;;
    preview)
        # Numeric-sort by frame index so Preview opens in play order.
        FRAMES=()
        while IFS= read -r p; do FRAMES+=("$p"); done < <(
            ls "$FRAMES_DIR"/f*.png \
                | sed -E 's|.*/f([0-9]+)\.png|\1 &|' \
                | sort -n \
                | awk '{print $2}'
        )
        echo "==> opening Preview.app"
        open -a Preview "${FRAMES[@]}"
        ;;
    mp4)
        if ! command -v ffmpeg > /dev/null; then
            echo "ffmpeg not found; install via 'brew install ffmpeg' or use another mode" >&2
            exit 1
        fi
        OUT="/tmp/dota2.mp4"
        echo "==> encoding $OUT (fps=$FPS)"
        # -y overwrite; -framerate on input controls playback rate.
        ffmpeg -y -framerate "$FPS" \
               -i "$FRAMES_DIR/f%d.png" \
               -pix_fmt yuv420p \
               -vf "pad=ceil(iw/2)*2:ceil(ih/2)*2" \
               "$OUT" > /tmp/dota2-ffmpeg.log 2>&1 || {
            echo "ffmpeg failed; see /tmp/dota2-ffmpeg.log" >&2
            tail -20 /tmp/dota2-ffmpeg.log >&2
            exit 1
        }
        echo "==> opening QuickTime (Cmd-L to loop)"
        open -a "QuickTime Player" "$OUT"
        ;;
esac
