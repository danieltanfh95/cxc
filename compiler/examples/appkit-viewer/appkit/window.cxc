# appkit/window.cxc — the AppKit plugin module.
#
# Exposes a `Window` capability atom whose methods wrap the underlying
# libappkit.dylib FFI symbols. Consumers `from appkit import Window`,
# `use window: Window`, and call `window.rect(...)` — the plugin
# manifest is invisible to them. The manifest's
# `runtime_shape: RuntimeShape.main_runloop` field flows through the
# multi-file compile to change `main()`'s tail from `dispatch_main()`
# to `[NSApp run]` even though the consumer never mentions it.
#
# Path-derived module name is `appkit` (dir under src-dir root).

def plugin:
    name:          String!       = "appkit"
    version:       SemVer!       = SemVer(0, 1, 0)
    compat:        VersionRange! = VersionRange(min: SemVer(1, 0, 0),
                                                max: SemVer(2, 0, 0))
    runtime_shape: RuntimeShape! = RuntimeShape.main_runloop

    foreign "appkit":
        symbol "ak_prep"        -> () -> Int32
        symbol "ak_window_open" -> (Int32, Int32, CString) -> Int32
        symbol "ak_clear"       -> (Int32, Int32, Int32) -> Int32
        symbol "ak_gradient"    -> (Int32, Int32, Int32, Int32, Int32, Int32, Int32, Int32, Int32, Int32) -> Int32
        symbol "ak_rect"        -> (Int32, Int32, Int32, Int32, Int32, Int32, Int32) -> Int32
        symbol "ak_round_rect"  -> (Int32, Int32, Int32, Int32, Int32, Int32, Int32, Int32) -> Int32
        symbol "ak_line"        -> (Int32, Int32, Int32, Int32, Int32, Int32, Int32, Int32) -> Int32
        symbol "ak_text"        -> (Int32, Int32, CString, Int32, Int32, Int32, Int32) -> Int32
        symbol "ak_text_bold"   -> (Int32, Int32, CString, Int32, Int32, Int32, Int32) -> Int32
        symbol "ak_image"       -> (Int32, Int32, Int32, Int32, CString) -> Int32
        symbol "ak_present"     -> () -> Int32

def Window:
    use plugin: Plugin

    prep()                                                                 :- plugin.get("ak_prep")()
    open(w: Int32!, h: Int32!, title: String!)                             :- plugin.get("ak_window_open")(w, h, title)
    clear(r: Int32!, g: Int32!, b: Int32!)                                 :- plugin.get("ak_clear")(r, g, b)
    gradient(x: Int32!, y: Int32!, w: Int32!, h: Int32!,
             r1: Int32!, g1: Int32!, b1: Int32!,
             r2: Int32!, g2: Int32!, b2: Int32!)                           :- plugin.get("ak_gradient")(x, y, w, h, r1, g1, b1, r2, g2, b2)
    rect(x: Int32!, y: Int32!, w: Int32!, h: Int32!,
         r: Int32!, g: Int32!, b: Int32!)                                  :- plugin.get("ak_rect")(x, y, w, h, r, g, b)
    round_rect(x: Int32!, y: Int32!, w: Int32!, h: Int32!, radius: Int32!,
               r: Int32!, g: Int32!, b: Int32!)                            :- plugin.get("ak_round_rect")(x, y, w, h, radius, r, g, b)
    line(x1: Int32!, y1: Int32!, x2: Int32!, y2: Int32!, thickness: Int32!,
         r: Int32!, g: Int32!, b: Int32!)                                  :- plugin.get("ak_line")(x1, y1, x2, y2, thickness, r, g, b)
    text(x: Int32!, y: Int32!, s: String!, size: Int32!,
         r: Int32!, g: Int32!, b: Int32!)                                  :- plugin.get("ak_text")(x, y, s, size, r, g, b)
    text_bold(x: Int32!, y: Int32!, s: String!, size: Int32!,
              r: Int32!, g: Int32!, b: Int32!)                             :- plugin.get("ak_text_bold")(x, y, s, size, r, g, b)
    image(x: Int32!, y: Int32!, w: Int32!, h: Int32!, path: String!)       :- plugin.get("ak_image")(x, y, w, h, path)
    present()                                                              :- plugin.get("ak_present")()
