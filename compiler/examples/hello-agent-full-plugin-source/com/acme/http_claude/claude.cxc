def plugin:
    name:    String!       = "com.acme.http_claude"
    version: SemVer!       = SemVer(0, 1, 0)
    compat:  VersionRange! = VersionRange(min: SemVer(1, 0, 0),
                                          max: SemVer(2, 0, 0))

# Backend: DeepSeek's Anthropic-compatible endpoint (Bearer auth via
# `Authorization: Bearer <DEEPSEEK_API_KEY>`; request/response bodies
# identical to Anthropic Messages API). Plugin name kept as
# `com.acme.http_claude` to avoid re-testing the whole R3 dep-fetch
# path; the atom name `Claude` is retained for the same reason but
# stands for "chat capability" here rather than the Anthropic vendor.

def Role:
    case system
    case user
    case assistant
    case tool

def Message:
    role:    Role!
    content: String!

def StopReason:
    case end
    case tool_use
    case max_tokens
    case other(reason: String!)

def ToolAction:
    case shell(cmd: String!)
    case read(path: String!)
    case write(path: String!, content: String!)
    case env_var(name: String!)

def ToolCall:
    id:     String!
    action: ToolAction!

def ChatResponse:
    text:        String!
    stop_reason: StopReason!
    tool_calls:  List of ToolCall

def Claude:
    use http:     Http
    use json:     Json
    use env_vars: EnvVars

    model:    String = "deepseek-chat"
    endpoint: String = "https://api.deepseek.com/anthropic/v1/messages"
    key_var:  String = "DEEPSEEK_API_KEY"

    ask(prompt: String) :- String
        let key: String = env_vars.get_or(key_var, "")
        let headers: String = "{\"authorization\":\"Bearer " + key + "\",\"anthropic-version\":\"2023-06-01\",\"content-type\":\"application/json\"}"
        let body: String = "{\"model\":" + json.encode_str(model) + ",\"max_tokens\":128,\"messages\":[{\"role\":\"user\",\"content\":" + json.encode_str(prompt) + "}]}"
        let envelope: String = http.post_envelope(endpoint, headers, body)
        let status: Int = json.field_int_or(envelope, "status", -1)
        let resp: String = json.field_string(envelope, "body")
        let text: String = json.field_string_path(resp, "content.0.text")
        ||: status != 200 : "[http " + status.to_string() + "] " + resp
        ||: text == nil   : "(no text)"
        ||: else          : text

    # `chat` returns a typed `ChatResponse` instead of the flattened
    # String `ask` produces. Consumers walk `.text` / `.stop_reason`
    # instead of parsing the response inline. tool-use extraction into
    # `tool_calls` isn't landed at v1.0 (needs a json array-index
    # intrinsic + variant construction from a String tag); the field
    # is constructed as `[]` at every call site.
    chat(prompt: String) :- ChatResponse
        let key: String = env_vars.get_or(key_var, "")
        let headers: String = "{\"authorization\":\"Bearer " + key + "\",\"anthropic-version\":\"2023-06-01\",\"content-type\":\"application/json\"}"
        let body: String = "{\"model\":" + json.encode_str(model) + ",\"max_tokens\":128,\"messages\":[{\"role\":\"user\",\"content\":" + json.encode_str(prompt) + "}]}"
        let envelope: String = http.post_envelope(endpoint, headers, body)
        let status: Int = json.field_int_or(envelope, "status", -1)
        let resp: String = json.field_string(envelope, "body")
        let text: String = json.field_string_path(resp, "content.0.text")
        let reason: String = json.field_string(resp, "stop_reason")
        let reason_nz: String = reason ?? "unknown"
        let stop_variant: StopReason = ||: reason_nz == "end_turn"   : StopReason.end
                                       ||: reason_nz == "tool_use"   : StopReason.tool_use
                                       ||: reason_nz == "max_tokens" : StopReason.max_tokens
                                       ||: else                      : StopReason.other(reason: reason_nz)
        let final_text: String = ||: status != 200 : "[http " + status.to_string() + "] " + resp
                                 ||: text == nil   : "(no text)"
                                 ||: else          : text
        ChatResponse(text: final_text, stop_reason: stop_variant, tool_calls: [])

    -> ready
