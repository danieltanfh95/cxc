def main:
    use console: Console
    ns: List of Int    = [10, 20, 30]
    ss: List of String = ["alpha", "beta"]
    bs: List of Bool   = [true]

    -> running
        console.write(ns.contains(20).to_string())
        console.write(ns.contains(99).to_string())
        console.write(ss.contains("alpha").to_string())
        console.write(ss.contains("gamma").to_string())
        console.write(bs.contains(true).to_string())
        console.write(bs.contains(false).to_string())
