def Counter:
    raw_n: Int = 0

    n :- raw_n

    -> alive
        |> self.add(by: 5)
        |> self.add(by: 10)
        |> self.add(by: 3)

    alive <: add(by: Int) -> alive
        |: by > 0
        raw_n => raw_n + by

def main:
    use console: Console
    -> running
        console.write((Counter().n).to_string())
