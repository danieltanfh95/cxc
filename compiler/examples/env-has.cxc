def main:
    use env:     Env
    use console: Console

    -> running
        then:
            let _rm: Int = env.remove("CXC_HAS_TEST")
            let h1: Bool = env.has("CXC_HAS_TEST")
            let _st: Int = env.set("CXC_HAS_TEST", "")
            let h2: Bool = env.has("CXC_HAS_TEST")
            let g:  String = env.get_or("CXC_HAS_TEST", "MISSING")
            let _rm2: Int = env.remove("CXC_HAS_TEST")
            let h3: Bool = env.has("CXC_HAS_TEST")
            let h_path: Bool = env.has("PATH")
            console.write("has_after_remove: " + h1.to_string())
            console.write("has_after_set_empty: " + h2.to_string())
            console.write("get_after_set_empty: [" + g + "]")
            console.write("has_after_second_remove: " + h3.to_string())
            console.write("has_path: " + h_path.to_string())

    -> end
