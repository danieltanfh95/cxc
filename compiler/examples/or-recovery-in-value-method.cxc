def Boom:
    msg: String

def Wrapper:
    label: String! = "fallback"

    might_fail() :- Int
        raise Boom(msg: label)

    summary() :- String!
        let x: Int = self.might_fail()
        or Boom(msg: let _m):
            -1
        "x=" + x.to_string()

    -> ready

def main:
    use console: Console
    w: Wrapper = Wrapper()

    -> running
        console.write((w.summary()).to_string())

    -> end
