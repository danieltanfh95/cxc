def main:
    use console: Console
    clock: Clock = Clock()

    got_millis: Int! = 0

    -> running

    -> end
        console.write((got_millis > 0).to_string())

    running <: clock.every(rate_ms: 5)(t: Instant) -> running
        |: got_millis == 0
        got_millis => t.millis

    running <: clock.every(rate_ms: 5)(t: Instant) -> end
        |: got_millis > 0
