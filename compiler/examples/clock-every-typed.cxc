def main:
    def clock: Clock(ticks: 1)
    def limit: Ticker(rate_ms: 50, count: 1)

    data:
        got_millis: Int = 0

    -> running

    -> end
        do: print(got_millis > 0)

    running <: clock.every(rate_ms: 5){t: Instant} -> running
        then: got_millis => t.millis

    running <: limit.done -> end
