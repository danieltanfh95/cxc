def Emitter:
    -> running
        self :> fire

    -> end
        :> value(n: 42)

    running <: fire -> end

def main:
    source: Emitter = Emitter()

    last_n: Int = 0

    -> running

    -> end
        print(last_n)

    running <: source.value(n: Int) -> received
        last_n => n
        self :> done

    received <: done -> end
