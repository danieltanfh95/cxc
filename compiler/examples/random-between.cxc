def main:
    use random: Random

    -> running
        then:
            let a: Int = random.between(10, 20)
            let b: Int = random.between(10, 20)
            let c: Int = random.between(10, 20)
            let d: Int = random.between(-5, 5)

            print((a >= 10 and a < 20).to_string())
            print((b >= 10 and b < 20).to_string())
            print((c >= 10 and c < 20).to_string())
            print((d >= -5 and d < 5).to_string())
            print(random.between(100, 101).to_string())
