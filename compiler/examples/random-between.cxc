def main:
    use console: Console
    use random: Random

    -> running
        let a: Int = random.between(10, 20)
        let b: Int = random.between(10, 20)
        let c: Int = random.between(10, 20)
        let d: Int = random.between(-5, 5)

        console.write((a >= 10 and a < 20).to_string())
        console.write((b >= 10 and b < 20).to_string())
        console.write((c >= 10 and c < 20).to_string())
        console.write((d >= -5 and d < 5).to_string())
        console.write(random.between(100, 101).to_string())
