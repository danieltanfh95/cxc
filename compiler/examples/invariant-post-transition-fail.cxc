def Gauge:
    raw_value: Int = 3
    max:       Int = 5

    value :< raw_value

    invariants:
        raw_value <= max

    -> alive
        do:
            self |> bump
            self |> bump
            self |> bump

    alive <: bump -> alive
        then: raw_value => raw_value + 1

def main:
    -> running
        do: print(Gauge().value)
