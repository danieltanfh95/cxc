def Gauge:
    raw_value: Int = 3
    max:       Int = 5

    value :- raw_value

    |: raw_value <= max

    -> alive
        |> self.bump()
        |> self.bump()
        |> self.bump()

    alive <: bump -> alive
        raw_value => raw_value + 1

def main:
    use console: Console
    -> running
        console.write((Gauge().value).to_string())
