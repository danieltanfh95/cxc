def Vec2:
    x: Int
    y: Int

def Line:
    start: Vec2
    stop:  Vec2

def main:
    use console: Console
    -> running
        console.write((Vec2(x: 1, y: 2) == Vec2(x: 1, y: 2)).to_string())
        console.write((Vec2(x: 1, y: 2) == Vec2(x: 1, y: 3)).to_string())
        console.write((Line(start: Vec2(x: 1, y: 2), stop: Vec2(x: 3, y: 4))
                == Line(start: Vec2(x: 1, y: 2), stop: Vec2(x: 3, y: 4))).to_string())
