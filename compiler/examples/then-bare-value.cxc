def Child:
    n: Int! = 0

    -> idle

    idle <: int_msg -> idle
        42

    idle <: nil_msg -> idle
        nil

    idle <: float_msg -> idle
        3.14

    idle <: bool_msg -> idle
        true

    idle <: field_msg -> idle
        self.n

    idle <: binop_msg -> idle
        self.n + 1

    idle <: unary_msg -> idle
        -self.n

def main:
    use console: Console
    -> running
        let c: Child = Child()
        console.write((99).to_string())
