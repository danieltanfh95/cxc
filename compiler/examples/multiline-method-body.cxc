def Formatter:
    kind: String = "default"

    label(prefix: String, value: Int) :- String
        let head: String = "[" + kind + "] " + prefix
        let tail: String = value.to_string()
        head + " " + tail

def main:
    use console: Console
    -> running
        console.write((Formatter().label("count", 42)).to_string())
        console.write((Formatter(kind: "debug").label("n", 7)).to_string())
