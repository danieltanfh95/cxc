def main:
    use console: Console
    m: Map of (String, Int)

    -> running
        alias m2 :- m.assoc("apples", 3).assoc("pears", 7).dissoc("apples")
        m => m2
        console.write(m2.count.to_string())
        console.write((m2.contains("apples")).to_string())
        console.write((m2.contains("pears")).to_string())

    -> end
