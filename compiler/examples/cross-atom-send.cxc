def Sink:
    data:
        raw_total: Int = 0

    total :< raw_total

    -> alive

    alive <: absorb{amount: Int} -> alive
        then: raw_total => raw_total + amount

def Source:
    use:
        sink: Sink

    -> running
        do:
            sink |> absorb(amount: 7)
            sink |> absorb(amount: 5)

def main:
    def sink: Sink
    def src: Source(sink: sink)

    -> running
        do: print(sink.total)
