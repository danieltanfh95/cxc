def Sink:
    raw_total: Int = 0

    total :- raw_total

    -> alive

    alive <: absorb(amount: Int) -> alive
        raw_total => raw_total + amount

def Source:
    use sink: Sink

    -> running
        |> sink.absorb(amount: 7)
        |> sink.absorb(amount: 5)

def main:
    use console: Console
    sink: Sink = Sink()
    src: Source = Source(sink: sink)

    -> running
        console.write(sink.total.to_string())
