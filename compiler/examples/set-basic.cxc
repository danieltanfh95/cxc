def main:
    xs: Set of String
    ys: Set of Int

    -> running
        then:
            let xs2 = xs.insert("a").insert("b").insert("a")
            let ys2 = ys.insert(10).insert(20).insert(10)
            print(xs2.count.to_string())
            print(ys2.count.to_string())
            print(xs2.contains("a").to_string())
            print(xs2.contains("z").to_string())
            print(ys2.contains(20).to_string())
            print(ys2.contains(99).to_string())
            let xs3 = xs2.without("a")
            let ys3 = ys2.without(10)
            print(xs3.count.to_string())
            print(ys3.count.to_string())
