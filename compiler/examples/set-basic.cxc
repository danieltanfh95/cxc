def main:
    use console: Console
    xs: Set of String
    ys: Set of Int

    -> running
        let xs2 = xs.insert("a").insert("b").insert("a")
        let ys2 = ys.insert(10).insert(20).insert(10)
        console.write(xs2.count.to_string())
        console.write(ys2.count.to_string())
        console.write(xs2.contains("a").to_string())
        console.write(xs2.contains("z").to_string())
        console.write(ys2.contains(20).to_string())
        console.write(ys2.contains(99).to_string())
        let xs3 = xs2.without("a")
        let ys3 = ys2.without(10)
        console.write(xs3.count.to_string())
        console.write(ys3.count.to_string())
