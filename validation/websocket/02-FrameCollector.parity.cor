# Starscream parity translation — FrameCollector.swift → FrameCollector.cor
# Original: Copyright © 2019 Vluxe / Dalton Cherry, Apache 2.0 license.
# Parity: line-by-line translation with FRICTION: notes. Correctness prioritized
# over idiom; the idiomatic pass will restructure.
#
# Depends on symbols from 01-Framer.parity.cor:
#   Frame (struct), FrameOpCode (enum), CloseCode (enum), WSError (inferred).
# FrameCollector consumes Frame values produced by WSFramer.process().

module com.starscream.framer

import objc "Foundation"

# FRICTION #W-1 (PROTOCOL-CLASS RESTRICTION, `AnyObject`):
# Swift: `public protocol FrameCollectorDelegate: AnyObject`.
# The `AnyObject` supertype constrains the protocol to class-only conformance,
# which is what allows Swift to hold a `weak` reference to it (weak requires
# class semantics). Corvid weak references (per spec §6.3) apply to class
# handles; there is no explicit spec syntax for constraining a protocol to
# class-only conformance. Whether Corvid enforces this by inference (weak
# field implies class-only protocol) or requires an annotation is not
# specified. Grammar §10 shows no class-constrained protocol form.
#
# For parity: drop the constraint, assume compiler infers from `weak` usage.
expose protocol FrameCollectorDelegate:
    # FRICTION #W-2 (NESTED TYPE REFERENCE):
    # Swift: `func didForm(event: FrameCollector.Event)`. The parameter type
    # references a nested enum. Corvid spec (§3.3, §6.3) does not commit to
    # a syntax for nesting enums inside classes, and does not commit to a
    # dotted-path syntax for referring to nested types from outside their
    # scope. For parity: promote Event to a top-level enum in the module.
    # This preserves reference semantics but loses Swift's namespacing.
    accepts did_form(event: FrameCollectorEvent)

    # FRICTION #W-3 (OPTIONAL RETURN FROM PROTOCOL METHOD):
    # Swift: `func decompress(data: Data, isFinal: Bool) -> Data?`. Optional
    # return from a protocol method — direct translation, spec supports `?`
    # suffix (§3.2). No friction on the mechanism, but note the protocol
    # doesn't specify whether returning `nil` means "cannot decompress"
    # (soft) or "reject" (hard) — Corvid's contract system (§3.4.2) could
    # make this explicit via `ensures returns nil implies not_decompressed`.
    # Idiomatic pass should tighten.
    accepts decompress(data: Bytes, is_final: Bool) -> Bytes?


# FRICTION #W-2 (continued): Event lifted to module level.
# Swift Event was nested inside FrameCollector; Corvid definition here.
expose enumeration FrameCollectorEvent:
    case text(String)
    case binary(Bytes)
    # FRICTION #W-4 (OPTIONAL ASSOCIATED VALUES IN ENUM VARIANT):
    # Swift: `case pong(Data?)`. Optional associated value on an enum case.
    # Spec §3.3 enum examples don't show optional associated values, but
    # since `?` is a type suffix (§3.2), `Bytes?` should be legal wherever
    # a type appears. Assuming this works; parity translation uses it.
    case pong(Bytes?)
    case ping(Bytes?)
    # FRICTION #W-5 (ERROR AS ENUM ASSOCIATED VALUE):
    # Swift: `case error(Error)`. Any conforming Error can be carried in
    # the variant. Corvid's typed-throws (§3.5) means "Error" isn't a type;
    # errors are declared per throwing function. What type should this
    # case carry? Options:
    #   (a) `case error(WSError)` — specific to this domain
    #   (b) `case error(Any)` — loses type info
    #   (c) Introduce an error protocol and use existential
    # Choosing (a) for parity — WSError is the only error type produced in
    # this codebase.
    case error(WSError)
    # FRICTION #W-6 (MULTI-FIELD ASSOCIATED VALUE):
    # Swift: `case closed(String, UInt16)`. Positional tuple associated
    # values. Spec §3.3 shows named associated values (`case invalid_data(reason: String)`).
    # Whether positional (unnamed) forms are supported alongside named is
    # not specified. For parity: give the fields names.
    case closed(reason: String, code: UInt16)


expose class FrameCollector:
    state:
        # FRICTION #W-7 (WEAK ON PROTOCOL-TYPED FIELD):
        # Swift: `weak var delegate: FrameCollectorDelegate?`. Direct
        # translation to Corvid's `weak <name>: T?` in state:. Requires the
        # protocol type to be class-only (see #W-1).
        weak delegate: FrameCollectorDelegate?

        # FRICTION #W-8 (DEFAULT VALUES FOR STATE FIELDS):
        # Swift: `var buffer = Data()`. Field with initializer expression.
        # Spec §6.3 shows `read_buffer: Bytes = Bytes()` as legal, so this
        # translates directly. Data → Bytes per the reference card.
        buffer: Bytes = Bytes()
        frame_count: Int = 0
        # FRICTION #W-9 (INLINE-COMMENTED STATE INTENT):
        # Swift source has an inline comment "was the first frame a text
        # frame or a binary frame?" — this is really a spec of what the
        # field represents. In Corvid, an `invariants:` clause could
        # express: frame_count == 0 implies is_text is uninitialized-meaning.
        # For parity: preserve the comment.
        is_text: Bool = false  # was the first frame text or binary
        needs_decompression: Bool = false

    # FRICTION #W-10 (STATE MACHINE INVARIANTS — MISSING FROM SWIFT):
    # This class enforces three invariants implicitly through branches in
    # add():
    #   (a) frame_count == 0 implies buffer.count == 0
    #   (b) first-frame opcode must not be .continue_frame
    #   (c) subsequent-frame opcode must be .continue_frame (until fin)
    # In Swift these are inline branches that produce errors. In Corvid
    # they could be `invariants:` clauses. Deferring to idiomatic pass —
    # in parity, we preserve Swift's inline-check structure. This is a
    # WIN candidate for the idiomatic pass.
    #
    # invariants:
    #     frame_count == 0 implies buffer.count == 0

    methods:
        # FRICTION #W-11 (PUBLIC MODIFIER GRANULARITY):
        # Swift `public func add(...)`. Corvid uses `expose` (spec §7).
        # `expose` on a single method: not explicitly shown in §7 examples
        # but the reference card says "expose applies independently to
        # the class name, section headers, or individual methods/fields."
        # Assuming per-method `expose` works.
        expose function add(self, frame: Frame):
            # check single frame action and out of order frames

            # FRICTION #W-12 (LEADING-DOT ENUM SHORTHAND CONTEXT):
            # Swift: `if frame.opcode == .connectionClose`. `.connectionClose`
            # relies on type inference from frame.opcode's declared type
            # (FrameOpCode). Reference card says leading-dot works "where
            # type is inferrable" — this qualifies. Direct translation.
            if frame.opcode == .connection_close:
                # FRICTION #W-13 (LOCAL VAR SHADOWING FIELD SEMANTICS):
                # Swift: `var code = frame.closeCode` — local mutable
                # initialized from an immutable field on a value type.
                # Corvid locals are mutable by default (§6.15 per Ink log).
                # Direct translation.
                var code = frame.close_code
                var reason = "connection closed by server"

                # FRICTION #W-14 (STRING-FROM-BYTES WITH ENCODING):
                # Swift: `String(data: frame.payload, encoding: .utf8)`.
                # Returns String? (fails on invalid UTF-8). This is a
                # Foundation constructor with a labeled parameter. Corvid
                # has no argument labels (Ink FRICTION #21). Also, the
                # spec does not specify String's construction API — is
                # there a canonical `String.from(bytes:encoding:)` or is
                # it a raw Foundation binding?
                # For parity: assume String has a class function
                # `try_from(bytes:encoding:)` returning Bytes? and use
                # if-let (§6.14).
                if let custom_close_reason = String.try_from(bytes: frame.payload, encoding: .utf8):
                    reason = custom_close_reason
                else:
                    # FRICTION #W-15 (ENUM RAW VALUE ACCESS, `.rawValue`):
                    # Swift: `CloseCode.protocolError.rawValue` — extracts
                    # the raw UInt16 backing value. This depends on Swift's
                    # raw-value enum feature: `enum CloseCode: UInt16 { case protocolError = 1002 }`.
                    # Reference card: "Integer-backed enumerations with raw
                    # values — spec does not specify. Treat as gap."
                    # For parity: use a placeholder .raw_value accessor.
                    # Idiomatic pass may replace with a companion function
                    # `close_code_to_uint16(.protocol_error)`.
                    code = CloseCode.protocol_error.raw_value

                # FRICTION #W-16 (OPTIONAL-CHAINED METHOD CALL WITH ARG):
                # Swift: `delegate?.didForm(event: .closed(reason, code))`.
                # `?.` short-circuits if delegate is nil. Reference card
                # confirms `?.` chaining (§11 worked example).
                #
                # ALSO FRICTION #W-6-related: constructing `.closed(reason, code)`
                # relies on positional args. Since we named the fields
                # (#W-6), use named-arg form.
                self.delegate?.did_form(event: .closed(reason: reason, code: code))
                return

            else if frame.opcode == .pong:
                self.delegate?.did_form(event: .pong(frame.payload))
                return

            else if frame.opcode == .ping:
                self.delegate?.did_form(event: .ping(frame.payload))
                return

            # FRICTION #W-17 (ELSE-IF SEQUENCING vs SWITCH):
            # Swift stacks a chain of else-if statements dispatching on the
            # same value (frame.opcode). This is the classic case for a
            # switch, but the branches also test frame_count in some cases
            # and act differently (return vs. call reset+return). Swift's
            # switch can guard, but here the guard is on a different value.
            # Corvid supports `case Pattern if condition:` (reference card
            # §3.7). Idiomatic pass should collapse. Parity keeps chain.

            else if frame.opcode == .continue_frame and self.frame_count == 0:
                let err_code = CloseCode.protocol_error.raw_value
                # FRICTION #W-18 (INFERRED TYPE, WSError):
                # WSError is defined outside these four files (per Framer.swift
                # usage). We don't have the definition. For parity, we assume
                # its shape from usage:
                #   struct WSError:
                #     data:
                #       type: WSErrorType  (enum with .protocol_error, etc.)
                #       message: String
                #       code: UInt16
                # Documenting as inferred, mirroring how Ink treated Reader.
                self.delegate?.did_form(event: .error(WSError(
                    type: .protocol_error,
                    message: "first frame can't be a continue frame",
                    code: err_code
                )))
                self.reset()
                return

            else if self.frame_count > 0 and frame.opcode != .continue_frame:
                let err_code = CloseCode.protocol_error.raw_value
                self.delegate?.did_form(event: .error(WSError(
                    type: .protocol_error,
                    message: "second and beyond of fragment message must be a continue frame",
                    code: err_code
                )))
                self.reset()
                return

            if self.frame_count == 0:
                # FRICTION #W-19 (FIELD-ASSIGNMENT-FROM-EXPRESSION):
                # Swift: `isText = frame.opcode == .textFrame`. Assigns the
                # boolean result of an equality comparison. Reads oddly but
                # is standard Swift. Corvid grammar should support this
                # directly.
                self.is_text = (frame.opcode == .text_frame)
                self.needs_decompression = frame.needs_decompression

            # FRICTION #W-20 (LET-BINDING AT INTERMEDIATE STATEMENT):
            # Swift: `let payload: Data` declared without initializer,
            # then assigned in the if/else below. Swift's "definite
            # assignment" ensures it's set before use. Corvid's spec does
            # not commit to definite-assignment analysis for `let`. For
            # parity: use `var` (mutable) and rely on runtime assignment.
            # Loses the "assigned once" guarantee.
            var payload: Bytes
            if self.needs_decompression:
                # FRICTION #W-21 (OPTIONAL-CHAINED RETURN WITH DEFAULT via ??):
                # Swift: `delegate?.decompress(...) ?? frame.payload`. The
                # `??` operator supplies a fallback when the optional is nil.
                # Spec does not specify `??` (nil-coalescing). Alternatives:
                #   (a) `if let d = delegate?.decompress(...): payload = d else: payload = frame.payload`
                #   (b) some `.or_default(frame.payload)` method on Optional
                # Using (a) for parity — verbose but no spec-gap dependency.
                if let decompressed = self.delegate?.decompress(data: frame.payload, is_final: frame.is_fin):
                    payload = decompressed
                else:
                    payload = frame.payload
            else:
                payload = frame.payload

            # FRICTION #W-22 (MUTATING METHOD ON REFERENCE-LIKE VALUE):
            # Swift: `buffer.append(payload)`. In Foundation, Data is a value
            # type with copy-on-write semantics; `append` mutates the local
            # storage. Corvid maps Data → Bytes; the spec does not commit to
            # Bytes being value or reference, nor to whether it has an
            # `append` method or an `appending` non-mutating counterpart.
            # Reference card notes Bytes is a primitive type (§3.1) with no
            # further detail. For parity: assume Bytes has a mutating
            # append; if idiomatic, this becomes construction of a new value.
            self.buffer.append(payload)
            self.frame_count = self.frame_count + 1

            if frame.is_fin:
                if self.is_text:
                    # See #W-14 for String.try_from justification.
                    if let string = String.try_from(bytes: self.buffer, encoding: .utf8):
                        self.delegate?.did_form(event: .text(string))
                    else:
                        let err_code = CloseCode.protocol_error.raw_value
                        self.delegate?.did_form(event: .error(WSError(
                            type: .protocol_error,
                            message: "not valid UTF-8 data",
                            code: err_code
                        )))
                else:
                    self.delegate?.did_form(event: .binary(self.buffer))
                self.reset()

        # FRICTION #W-23 (INTERNAL-VISIBILITY BOUNDARY):
        # Swift: `func reset()` without a modifier is internal-by-default.
        # Corvid without `expose` is internal-by-convention (compiler warns,
        # doesn't error, per §7). Direct translation — omit `expose`.
        function reset(self):
            self.buffer = Bytes()
            self.frame_count = 0
