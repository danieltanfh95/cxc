# Ink parity - Reader.cor (INTERFACE INFERRED)
# 
# METHODOLOGICAL NOTE: Reader.swift's URL was not returnable via web search
# tools available in this session. This file reconstructs Reader's interface
# from its usage in Blockquote.swift and the architecture description in the
# Ink README (Reader is used with "errors as control flow" for parsing).
# 
# This is honest data about the translation exercise: real-world translation
# projects often work from partial sources. Missing sources = friction. 
# The friction of inferring a stable interface from usage patterns is 
# itself a translation experience worth logging.

module com.ink.internal

# From Blockquote.swift usage, Reader appears to have:
#   - reader.read(">")             — throw-based match-and-consume
#   - reader.readWhitespaces()     — throw-based, consume whitespace
#   - reader.didReachEnd           — read-only Bool
#   - reader.currentCharacter      — read-only Character
#   - reader.advanceIndex()        — mutating, move position forward
# 
# Passed as `inout Reader` in Swift = reference-shared mutation of value type.
# In Corvid, we model as `class Reader` (reference type by default).

# FRICTION #24 (READER AS CLASS vs STRUCT): Swift's Reader is likely a struct
# (based on `inout` parameter passing). Structs with `inout` give Swift 
# value-semantics-with-explicit-mutation.
# 
# In Corvid, our struct discipline forbids mutation. So Reader has to be a 
# class. This changes the semantic model — every reference to Reader is 
# potentially shared, whereas Swift's inout is explicit about who's mutating.
# 
# For parity: use class. Note that the aliasing model differs.
# For idiomatic: class is the right choice regardless — mutable cursor 
# is fundamentally reference-shaped.

class Reader:
    # FRICTION #25 (STRING INDEX POSITION):
    # Reader tracks a position within a String. Swift uses `String.Index`
    # (a stable position that's Unicode-aware). Corvid's string API isn't
    # specified in detail. 
    # 
    # NOTE: A markdown parser depends heavily on string position primitives:
    # - Advancing by character (not by byte — must respect grapheme clusters)
    # - Substring extraction between two positions
    # - Comparison of positions
    # 
    # §6 mentions String as a value type but doesn't specify the position/
    # index API. This is a spec gap for a language claiming Foundation
    # interop.
    
    data:
        string: String
    
    state:
        current_index: StringIndex
    
    invariants:
        # FRICTION #26 (INVARIANT ON MUTABLE STATE):
        # Reader's position must be within bounds. This is exactly the kind 
        # of thing our invariants: section is for (§3.4.2).
        # 
        # Swift's Reader implicitly maintains this via its API surface (no
        # public setter that could violate). Corvid makes it explicit. 
        # This is a genuine expressive win — the invariant is now enforceable
        # and documented in the type.
        current_index >= string.start_index
        current_index <= string.end_index
    
    methods:
        function init(string: String) -> Reader:
            return Reader(string: string, current_index: string.start_index)
        
        # Read-only properties (computed)
        function did_reach_end(self) -> Bool:
            return self.current_index >= self.string.end_index
        
        function current_character(self) -> Character
            requires !self.did_reach_end():
            # FRICTION #27 (PRECONDITION AS CONTRACT):
            # Reading a character requires we haven't reached end. Swift
            # relies on runtime crash if this is violated. Corvid's contract
            # system makes this explicit.
            # 
            # This is a real expressive win — the failure mode is documented
            # and enforced. Callers know they must check did_reach_end first.
            return self.string.character_at(self.current_index)
        
        # Mutating methods
        function advance_index(self)
            requires !self.did_reach_end()
            ensures self.current_index > old(self.current_index):
            # FRICTION #28 (OLD() IN ENSURES):
            # ensures clauses need to reference the pre-state to say
            # "index moved forward". Swift/Rust use various syntaxes for 
            # this: `old(x)`, `\old(x)`, `x'` (Alloy). 
            # 
            # §3.4 doesn't specify old-value syntax for ensures clauses.
            # This is a spec gap for meaningful state-transition contracts.
            self.current_index = self.string.index_after(self.current_index)
        
        # Match-and-consume: reads expected string or throws
        function read(self, expected: String) throws ParseError
            ensures old(self.current_index) < self.current_index or throws:
            # FRICTION #29 (CONDITIONAL ENSURES):
            # This says "either the index advanced, or the method threw."
            # Some contract systems support "throws" as a valid ensures 
            # branch; others don't. §3.5 mentions throws effect but doesn't
            # detail interaction with ensures clauses.
            for expected_char in expected.characters:
                if self.did_reach_end():
                    throw ParseError.unexpected_end
                if self.current_character() != expected_char:
                    throw ParseError.mismatch
                self.advance_index()
        
        function read_whitespaces(self) throws ParseError:
            # Consume zero-or-more whitespace characters. 
            # Note: doesn't throw in practice (zero matches is fine),
            # but marked throws for interface consistency? Check Swift 
            # source when accessible.
            while !self.did_reach_end() and self.current_character().is_whitespace():
                self.advance_index()

# FRICTION #30 (ERROR TYPES): Swift's `throws` doesn't require declaring
# the error type. Corvid uses `throws ErrorType` (§3.5). This means:
#   - Every throwing function must name its error type.
#   - Refactoring error types is more visible (changing throws E1 to 
#     throws E2 breaks callers).
# 
# This is intentional per §3.5.1 ("advisory effects" vs "semantic effects").
# Throws is semantic. Callers know exactly what to expect. 
# 
# Swift's untyped throws is more flexible; ours is more precise.
# Aligned with legibility premise (§1.6).

sealed protocol ParseError:
    case unexpected_end
    case mismatch
    # Other cases would emerge from full Reader translation
